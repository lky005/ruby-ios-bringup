+/* 0265: read-only TX handoff black box (16 words, 0xC0/0x29). */
+static void
+ruby_ep0_vendor_txprobe(vm_offset_t mac, uint32_t t, uint32_t wlen)
+{
+    uint32_t v[16];
+
+    v[0] = 0x35325854u;         /* "TX25" */
+    v[1] = ruby_tx_kick_cnt;
+    v[2] = ruby_tx_kick_src;
+    v[3] = ruby_tx_kick_cnt ?
+        (uint32_t)(ruby_ms - ruby_tx_kick_ms) : 0xffffffffu;
+    v[4] = ruby_rd32(mac, TQCSR1_OFF);
+    v[5] = ruby_rd32(mac, TQCPR1_OFF);
+    v[6] = ruby_rd32(mac, TQHIAR1_OFF);
+    v[7] = ruby_rd32(mac, TX1CSR0_OFF);
+    v[8] = ruby_inflight;
+    v[9] = (ruby_gpd_enq & 0xffu) | ((ruby_gpd_deq & 0xffu) << 8);
+    v[10] = (uint32_t)ruby_ep2_hwo_bits();
+    v[11] = ruby_rd32(mac, QISAR0_OFF);
+    v[12] = ruby_rd32(mac, QISAR1_OFF);
+    v[13] = ruby_bulk_dup_cnt;
+    v[14] = ruby_bulk_dup_a;
+    v[15] = ruby_bulk_dup_b;
+    ruby_ep0_send(mac, t, 0xc029, (const uint8_t *)v, sizeof(v), wlen);
+}
