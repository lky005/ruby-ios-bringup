+/*
+ * Advance a pending IN data stage by one hardware action: load the next
+ * packet, or write DATAEND after the last one.
+ *
+ * strict=1 runs inline, right after a packet was loaded.  It waits for the
+ * condition the vendor ISR tests before it loads another packet -- TXPKTRDY
+ * clear (the SIE took the packet) and, before another packet, EP0_FIFOFULL
+ * clear (the FIFO has room again) -- for RUBY_EP0_SPINS x 10 us, then gives
+ * up: no STALL, the stage stays pending.
+ *
+ * strict=0 is the 1 ms service tick, kept at the 0113b rule that TXPKTRDY
+ * clear alone is enough.  So the strict test can only ever cost a tick, it
+ * can never strand a transfer that the old path would have finished.
+ *
+ * Returns 1 when the hardware was touched, 0 when the caller should wait.
+ */
+static int
+ruby_ep0_tx_step(vm_offset_t mac, uint32_t t, int strict)
+{
+    uint32_t csr, n, i;
+
+    if (!ruby_ep0_tx_pending)
+        return 0;
+
+    for (i = 0;; i++) {
+        csr = ruby_rd32(mac, EP0CSR_OFF);
+        if (!(csr & EP0_TXPKTRDY))
+            break;
+        if (!strict || i >= RUBY_EP0_SPINS) {
+            if (strict)
+                ruby_ep0_tx_waits++;
+            return 0;
+        }
+        delay(RUBY_EP0_SPIN_US);
+    }
+
+    if (ruby_ep0_tx_sent < ruby_ep0_tx_total) {
+        if (strict && (csr & EP0_FIFOFULL)) {
+            ruby_ep0_fifo_blocked++;
+            return 0;
+        }
+        n = ruby_ep0_tx_total - ruby_ep0_tx_sent;
+        if (n > 64)
+            n = 64;
+        ruby_ep0_write_fifo(mac, ruby_ep0_txbuf + ruby_ep0_tx_sent, n);
+        csr = ruby_rd32(mac, EP0CSR_OFF) & EP0_W1C_BITS;
+        ruby_wr32(mac, EP0CSR_OFF, csr | EP0_TXPKTRDY);
+        ruby_ep0_tx_sent += n;
+        ruby_ep0_txpkts++;
+        return 1;
+    }
+    /*
+     * On this IP EP0_FIFOFULL remains set until DATAEND is written
+     * (0105/0107 finding).  Gating DATAEND on it deadlocks short and
+     * multi-packet transfers, so count it and terminate anyway.
+     */
+    if (csr & EP0_FIFOFULL)
+        ruby_ep0_fifo_waits++;
+    csr = ruby_rd32(mac, EP0CSR_OFF) & EP0_W1C_BITS;
+    ruby_wr32(mac, EP0CSR_OFF, csr | EP0_DATAEND);
+    ruby_ep0_tx_pending = 0;
+    ruby_ep0_dataends++;
+    ruby_trace(t, RUBY_TR_SEND, 0, ruby_ep0_tx_total, 0,
+        ruby_ep0_tx_sent);
+    return 1;
+}
+
+static void
+ruby_ep0_tx_pump(vm_offset_t mac, uint32_t t)
+{
+    while (ruby_ep0_tx_step(mac, t, 1))
+        ;
+}
