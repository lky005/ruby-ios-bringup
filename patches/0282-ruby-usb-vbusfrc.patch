diff --git a/bsd/dev/ruby_usb.c b/bsd/dev/ruby_usb.c
index 0ac1d51..b11b56c 100644
--- a/bsd/dev/ruby_usb.c
+++ b/bsd/dev/ruby_usb.c
@@ -2076,6 +2076,7 @@ static int ruby_txreplay_en = 1;    /* 0277: replay preserved TX payloads */
 static int ruby_txdone_en = 1;      /* 0279: per-TX-done register snapshot */
 static int ruby_tx_kick_en;         /* 0280: faithful per-done send kick */
 static uint32_t ruby_tx_k2_kicks;
+static int ruby_vbusfrc_keep;       /* 0282: set = leave bootloader value */
 static uint8_t ruby_tx_replay_buf[4096];
 static uint32_t ruby_tx_replay_len;
 static uint32_t ruby_tx_replay_bytes;
@@ -5838,6 +5839,7 @@ ruby_usb_probe(void)
     int txreplay = 1;
     int txdone = 1;
     int txkick2 = 0;
+    int vbusfrc = 0;
     vm_offset_t ippc, mac, phy, gpio, ifrao;
     uint32_t c0, c2, u3, u2, rst;
     uint32_t s1, s2, v;
@@ -5874,6 +5876,8 @@ ruby_usb_probe(void)
     ruby_txdone_en = (txdone == 1);
     PE_parse_boot_argn("ruby_tx_kick", &txkick2, sizeof(txkick2));
     ruby_tx_kick_en = (txkick2 == 1);
+    PE_parse_boot_argn("ruby_vbusfrc", &vbusfrc, sizeof(vbusfrc));
+    ruby_vbusfrc_keep = (vbusfrc == 1);
     ruby_probe_enabled = (probe == 1);
     ruby_ep2log_on = (ep2log >= 0) ? (ep2log != 0) : !ruby_acm_cmd;
     printf("RUBY USB: 0265 tx probe ready (read-only)\n");
@@ -5889,6 +5893,7 @@ ruby_usb_probe(void)
     printf("RUBY USB: 0277 tx replay=%d\n", ruby_txreplay_en);
     printf("RUBY USB: 0279 txdone snap=%d\n", ruby_txdone_en);
     printf("RUBY USB: 0280 tx_kick=%d\n", ruby_tx_kick_en);
+    printf("RUBY USB: 0282 vbus_frc_keep=%d\n", ruby_vbusfrc_keep);
     printf("RUBY USB: probe writes %s\n",
         ruby_probe_enabled ? "enabled" : "locked");
     printf("RUBY USB: EP2 log %s (rubyep2log=%d)\n",
@@ -6014,6 +6019,15 @@ ruby_usb_probe(void)
     ruby_wr32(mac, PM_CTRL - MTU3_PA,
         (v | (1u << 5)) & ~((1u << 6) | (1u << 0)));
     ruby_wr32(mac, DEVICE_CONF - MTU3_PA, 0);
+    /* 0282: vendor device-mode init clears MISC_CTRL VBUS_FRC_EN/VBUS_ON;
+     * the bootloader leaves VBUS_FRC_EN set (misc readback 0x80405103). */
+    if (!ruby_vbusfrc_keep) {
+        uint32_t mv = ruby_rd32(mac, MISC_CTRL - MTU3_PA);
+
+        ruby_wr32(mac, MISC_CTRL - MTU3_PA, mv & ~0x3u);
+        printf("RUBY USB: misc 0x%08x -> 0x%08x\n", mv,
+            ruby_rd32(mac, MISC_CTRL - MTU3_PA));
+    }
 
     /* 0185/0272: the vendor runs with bit21 clear; the old noise quirk
      * stays behind ruby_noise=1 for A/B. */
