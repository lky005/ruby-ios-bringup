 }
+
+/*
+ * 0291: single owner for the shared QCR0/QCR1 programming so a later RX
+ * init cannot clear the TX per-EP enables.  Both helpers keep the 0249
+ * default (CS engine off) unless their boot-arg is set.
+ */
+static void
+ruby_qcr0_program(vm_offset_t mac)
+{
+    uint32_t v = 1u;
+
+    if (ruby_qcr0cs_en)
+        v |= (1u << 1);     /* QMU_TX_CS_EN(EP1), vendor qmu_start parity */
+    ruby_wr32(mac, QCR0_OFF, v);
+    ruby_seq("QCR0P", v, ruby_rd32(mac, QCR0_OFF));
+}
+
+static void
+ruby_qcr1_program(vm_offset_t mac)
+{
+    uint32_t v = ruby_rd32(mac, QCR1_OFF) | 0x0006000eu;
+
+    if (ruby_qcr1zlp_en)
+        v |= 0x1u;          /* QMU_TX_ZLP(EP1) */
+    ruby_wr32(mac, QCR1_OFF, v);
+    ruby_seq("QCR1P", v, ruby_rd32(mac, QCR1_OFF));
+}
