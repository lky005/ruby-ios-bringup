+#ifndef _RUBYGPU_USERCLIENT_H
+#define _RUBYGPU_USERCLIENT_H
+
+#include <IOKit/IOUserClient.h>
+
+#include "RubyGPUUserAPI.h"
+
+class RubyGPUUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(RubyGPUUserClient);
+
+public:
+	bool initWithTask(task_t owningTask, void *securityToken, UInt32 type,
+	    OSDictionary *properties) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn clientDied(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+	IOReturn clientMemoryForType(UInt32 type, IOOptionBits *options,
+	    IOMemoryDescriptor **memory) APPLE_KEXT_OVERRIDE;
+
+	void setClientID(uint32_t id) { fClientID = id; }
+	uint32_t clientID(void) const { return fClientID; }
+
+	static IOReturn methodGetParam(OSObject *target, void *reference,
+	    IOExternalMethodArguments *args);
+	static IOReturn methodBOCreate(OSObject *target, void *reference,
+	    IOExternalMethodArguments *args);
+	static IOReturn methodBOCreateFromSurface(OSObject *target,
+	    void *reference, IOExternalMethodArguments *args);
+	static IOReturn methodBORelease(OSObject *target, void *reference,
+	    IOExternalMethodArguments *args);
+	static IOReturn methodBOSync(OSObject *target, void *reference,
+	    IOExternalMethodArguments *args);
+	static IOReturn methodVMCreate(OSObject *target, void *reference,
+	    IOExternalMethodArguments *args);
+	static IOReturn methodVMDestroy(OSObject *target, void *reference,
+	    IOExternalMethodArguments *args);
+	static IOReturn methodVMBind(OSObject *target, void *reference,
+	    IOExternalMethodArguments *args);
+	static IOReturn methodVMUnbind(OSObject *target, void *reference,
+	    IOExternalMethodArguments *args);
+	static IOReturn methodSubmit(OSObject *target, void *reference,
+	    IOExternalMethodArguments *args);
+
+private:
+	uint32_t fClientID;
+};
+
+#endif /* _RUBYGPU_USERCLIENT_H */
