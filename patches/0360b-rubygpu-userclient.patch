+#ifndef _RUBYGPU_USERAPI_H
+#define _RUBYGPU_USERAPI_H
+
+/*
+ * RubyGPU user client ABI (P3.2). Plain C types so the same header
+ * compiles in the XNU kernel and in the iOS test program.
+ */
+
+#define RUBYGPU_UC_VERSION     1u
+#define RUBYGPU_MAX_BO_SIZE    (64ull << 20)
+#define RUBYGPU_JOB_TIMEOUT_MS 1000u
+
+enum {
+	RUBYGPU_OK = 0,
+	RUBYGPU_E_ARG = 1,
+	RUBYGPU_E_NORES = 2,
+	RUBYGPU_E_NOPWR = 3,
+	RUBYGPU_E_TIMEOUT = 4,
+	RUBYGPU_E_NOENT = 5,
+	RUBYGPU_E_BUSY = 6,
+	RUBYGPU_E_IO = 7,
+	RUBYGPU_E_PERM = 8,
+};
+
+enum {
+	kRubyGPUMethodGetParam = 0,
+	kRubyGPUMethodBOCreate = 1,
+	kRubyGPUMethodBORelease = 2,
+	kRubyGPUMethodBOSync = 3,
+	kRubyGPUMethodVMCreate = 4,
+	kRubyGPUMethodVMDestroy = 5,
+	kRubyGPUMethodVMBind = 6,
+	kRubyGPUMethodVMUnbind = 7,
+	kRubyGPUMethodSubmit = 8,
+	kRubyGPUMethodBOCreateFromSurface = 9,
+	kRubyGPUMethodCount
+};
+
+enum {
+	kRubyGPUParamVAStart = 0,
+	kRubyGPUParamVARange = 1,
+	kRubyGPUParamPowered = 2,
+	kRubyGPUParamIRQIntID = 3,
+	kRubyGPUParamVersion = 4,
+};
+
+enum {
+	kRubyGPUBOFlagLow4G = 1u << 0,
+};
+
+enum {
+	kRubyGPUSyncOut = 0,
+	kRubyGPUSyncIn = 1,
+	kRubyGPUSyncInOut = 2,
+};
+
+struct ruby_gpu_get_param_req {
+	unsigned int param;
+	unsigned int reserved;
+};
+
+struct ruby_gpu_get_param_rep {
+	unsigned long long value;
+};
+
+struct ruby_gpu_bo_create_req {
+	unsigned long long size;
+	unsigned int flags;
+	unsigned int reserved;
+};
+
+struct ruby_gpu_bo_create_rep {
+	unsigned int handle;
+	unsigned int status;
+	unsigned long long phys;
+};
+
+struct ruby_gpu_bo_create_from_surface_req {
+	unsigned int surface_id;
+	unsigned int flags;
+	unsigned long long size;        /* 0 = surface allocSize */
+};
+
+struct ruby_gpu_bo_create_from_surface_rep {
+	unsigned int handle;
+	unsigned int status;
+	unsigned long long size;
+};
+
+struct ruby_gpu_bo_release_req {
+	unsigned int handle;
+	unsigned int reserved;
+};
+
+struct ruby_gpu_bo_sync_req {
+	unsigned int handle;
+	unsigned int dir;
+	unsigned long long offset;
+	unsigned long long size;
+};
+
+struct ruby_gpu_vm_create_req {
+	unsigned long long va_start;
+	unsigned long long va_size;
+	unsigned int flags;
+	unsigned int reserved;
+};
+
+struct ruby_gpu_vm_create_rep {
+	unsigned int handle;
+	unsigned int status;
+};
+
+struct ruby_gpu_vm_destroy_req {
+	unsigned int handle;
+	unsigned int reserved;
+};
+
+struct ruby_gpu_vm_bind_req {
+	unsigned int vm;
+	unsigned int bo;
+	unsigned long long va;
+	unsigned long long bo_offset;
+	unsigned long long size;
+};
+
+struct ruby_gpu_vm_unbind_req {
+	unsigned int vm;
+	unsigned int reserved;
+	unsigned long long va;
+	unsigned long long size;
+};
+
+struct ruby_gpu_submit_req {
+	unsigned int vm;
+	unsigned int flags;
+	unsigned long long job_va;
+	unsigned int timeout_ms;
+	unsigned int reserved;
+};
+
+struct ruby_gpu_submit_rep {
+	unsigned int status;
+	unsigned int hits;
+	unsigned int spur;
+	unsigned int raw;
+	unsigned int jstat;
+	unsigned int js;
+	unsigned int girq;
+	unsigned int mirq;
+};
+
+#endif /* _RUBYGPU_USERAPI_H */
