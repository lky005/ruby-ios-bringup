+/* 0260: read-only RX stall snapshot.  No queue mutation. */
+static void
+ruby_ep2_rx_stall_dump(vm_offset_t mac)
+{
+    uint32_t i, cur, hwo = 0;
+
+    if (!ruby_rx_ready)
+        return;
+    ruby_dc_civac(ruby_rx_gpd_ring, sizeof(ruby_rx_gpd_ring));
+    for (i = 0; i < RUBY_RX_GPD_NUM; i++)
+        if (ruby_rx_gpd_ring[i * 16] & 1u)
+            hwo |= 1u << i;
+    cur = ruby_ep2_rx_cur_slot(mac);
+    printf("RUBY USB RXSTALL pk=%u done=%u deq=%u cur=%02x rqcsr=%08x "
+        "rqhiar=%08x rqcpr=%08x hwo=%04x q0=%08x q1=%08x zlperr=%u "
+        "rxerr=%u sentstall=%u\n",
+        ruby_rx_packets, ruby_rx_done_events, ruby_rx_deq, cur,
+        ruby_rd32(mac, RQCSR1_OFF), ruby_rd32(mac, RQHIAR1_OFF),
+        ruby_rd32(mac, RQCPR1_OFF), hwo,
+        ruby_rd32(mac, QISAR0_OFF), ruby_rd32(mac, QISAR1_OFF),
+        ruby_rx_zlp_err, ruby_rx_errors, ruby_rx_stall_seen);
+    if (cur == 0xffu)
+        return;
+    for (i = 0; i < 4; i++) {
+        uint32_t sl = (cur + i) % RUBY_RX_GPD_NUM;
+        volatile uint8_t *g = ruby_rx_gpd_ring + sl * 16;
+
+        printf("RUBY USB RXGPD[%02u] f=%02x c=%02x len=%u next=%08x "
+            "buf=%08x\n", sl, g[0], g[1],
+            (uint32_t)(*(volatile uint16_t *)(g + 12)),
+            *(volatile uint32_t *)(g + 4),
+            *(volatile uint32_t *)(g + 8));
+    }
+}
