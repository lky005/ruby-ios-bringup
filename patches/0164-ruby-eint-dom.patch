+uint32_t
+ruby_eint_dom_read(uint32_t port)
+{
+	if (__atomic_load_n(&g_eint_state, __ATOMIC_ACQUIRE) != 2 ||
+	    !g_eint_base || port >= RUBY_EINT_PORTS)
+		return 0;
+	return ruby_rd32(g_eint_base, RUBY_EINT_DOM_EN + port * 4u);
+}
+
+void
+ruby_eint_dom_set(uint32_t line, int enable)
+{
+	uint32_t bit, off, val;
+
+	if (line >= RUBY_EINT_LINES)
+		return;
+	ruby_eint_init();
+	if (__atomic_load_n(&g_eint_state, __ATOMIC_ACQUIRE) != 2 ||
+	    !g_eint_base)
+		return;
+	bit = 1u << (line & 31u);
+	off = RUBY_EINT_DOM_EN + (line >> 5) * 4u;
+	RUBY_EINT_LOCK();
+	val = ruby_rd32(g_eint_base, off);
+	val = enable ? (val | bit) : (val & ~bit);
+	ruby_wr32(g_eint_base, off, val);
+	RUBY_EINT_UNLOCK();
+}
+
