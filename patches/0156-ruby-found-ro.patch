+/*
+ * R0 read-only foundation snapshot.  No writes: EINT ACK (+0x040) is never
+ * touched; I2C DATA_PORT/FIFO and SPI TX/RX DATA are never touched; pwrap
+ * uses only the known-safe PMIC read path; WDT is excluded.
+ */
+static void
+pr_snap_eint(void)
+{
+	uint32_t i;
+
+	if (!pr.eint) {
+		PR_LINE("RUBY SNAP: eint not mapped\n");
+		return;
+	}
+	for (i = 0; i < 7; i++)
+		PR_LINE("RUBY SNAP: eint%u sta=%08x mask=%08x sens=%08x pol=%08x\n",
+		    i, pr_rd32(pr.eint, PR_EINT_STA + i * 4),
+		    pr_rd32(pr.eint, PR_EINT_MASK + i * 4),
+		    pr_rd32(pr.eint, PR_EINT_SENS + i * 4),
+		    pr_rd32(pr.eint, PR_EINT_POL + i * 4));
+}
+
+static void
+pr_snap_i2c_ctrl(void)
+{
+	uint32_t i;
+	vm_offset_t base;
+
+	for (i = 0; i < 2; i++) {
+		base = i == 0 ? pr.i2c5 : pr.i2c6;
+		if (!base)
+			continue;
+		PR_LINE("RUBY SNAP: i2c%u ctrl=%04x timing=%04x hs=%04x clkdiv=%04x\n",
+		    5 + i, pr_rd16(base, PR_I2C_CTRL),
+		    pr_rd16(base, PR_I2C_TIMING), pr_rd16(base, PR_I2C_HS),
+		    pr_rd16(base, PR_I2C_CLKDIV));
+	}
+}
+
+static void
+pr_snap_spi_ctrl(void)
+{
+	if (!pr.spi3) {
+		PR_LINE("RUBY SNAP: spi3 not mapped\n");
+		return;
+	}
+	PR_LINE("RUBY SNAP: spi3 cfg0=%08x cfg1=%08x cfg2=%08x sta0=%08x sta1=%08x\n",
+	    pr_rd32(pr.spi3, PR_SPI_CFG0), pr_rd32(pr.spi3, PR_SPI_CFG1),
+	    pr_rd32(pr.spi3, PR_SPI_CFG2), pr_rd32(pr.spi3, PR_SPI_STA0),
+	    pr_rd32(pr.spi3, PR_SPI_STA1));
+}
+
+static void
+pr_snap_scpsys(void)
+{
+	if (!pr.scpsys) {
+		PR_LINE("RUBY SNAP: scpsys not mapped\n");
+		return;
+	}
+	PR_LINE("RUBY SNAP: scpsys pwr=%08x pwr2=%08x xpu=%08x xpu2=%08x other=%08x\n",
+	    pr_rd32(pr.scpsys, PR_SPM_PWR_STA),
+	    pr_rd32(pr.scpsys, PR_SPM_PWR_STA2),
+	    pr_rd32(pr.scpsys, PR_SPM_XPU_STA),
+	    pr_rd32(pr.scpsys, PR_SPM_XPU_STA2),
+	    pr_rd32(pr.scpsys, PR_SPM_OTHER_STA));
+}
+
+static void
+pr_snap_pmic_safe(void)
+{
+	uint16_t w;
+	int err;
+
+	if (pr_pwrap_check() != 0) {
+		PR_LINE("RUBY SNAP: pwrap not ready\n");
+		return;
+	}
+	if ((err = pr_pwrap_read(PR_PMIC_HWCID, &w)) == 0)
+		PR_LINE("RUBY SNAP: MT6359 HWCID=0x%04x\n", w);
+	if ((err = pr_pwrap_read(PR_PMIC_TOPSTATUS, &w)) == 0)
+		PR_LINE("RUBY SNAP: MT6359 TOPSTATUS=0x%04x\n", w);
+	if ((err = pr_pwrap_read(PR_PMIC_PWRKEY, &w)) == 0)
+		PR_LINE("RUBY SNAP: MT6359 PWRKEY=0x%04x\n", w);
+}
+
+static void
+pr_snap_found(void)
+{
+	PR_LINE("RUBY SNAP: -- clk --\n");
+	pr_snap_clk();
+	PR_LINE("RUBY SNAP: -- gpio --\n");
+	pr_snap_gpio();
+	PR_LINE("RUBY SNAP: -- eint --\n");
+	pr_snap_eint();
+	PR_LINE("RUBY SNAP: -- i2c ctrl --\n");
+	pr_snap_i2c_ctrl();
+	PR_LINE("RUBY SNAP: -- spi ctrl --\n");
+	pr_snap_spi_ctrl();
+	PR_LINE("RUBY SNAP: -- scpsys --\n");
+	pr_snap_scpsys();
+	PR_LINE("RUBY SNAP: -- pmic safe --\n");
+	pr_snap_pmic_safe();
+}
+
