+static int
+pr_pwrap_init_sistrobe(void)
+{
+	uint32_t si_en, si_ck, si_dly, i, sample = 0;
+	uint16_t rd;
+	bool found;
+	int err;
+
+	found = false;
+	for (si_en = 0; si_en < 8 && !found; si_en++) {
+		for (si_ck = 0; si_ck < 2; si_ck++) {
+			sample = (si_en << 6) | (si_ck << 5);
+			pr_wr32(pr.pwrap, PR_PWRAP_SI_SAMPLE, sample);
+			if ((err = pr_pwrap_nochk_read(PR_PMIC_DEW_READ_TEST,
+			    &rd)) != 0)
+				return err;
+			if (rd == PR_PMIC_READ_TEST_VAL) {
+				found = true;
+				break;
+			}
+		}
+	}
+	if (!found) {
+		printf("RUBY PMIC: init sistrobe no sampling clock\n");
+		return EPROTO;
+	}
+
+	found = false;
+	for (si_dly = 0; si_dly < 10 && !found; si_dly++) {
+		if ((err = pr_pwrap_nochk_write(PR_PMIC_RG_SPI_CON2,
+		    (uint16_t)si_dly)) != 0)
+			return err;
+		for (i = 0; i < 30; i++) {
+			if ((err = pr_pwrap_nochk_write(PR_PMIC_DEW_WRITE_TEST,
+			    pr_pwrap_test_data[i])) != 0)
+				return err;
+			if ((err = pr_pwrap_nochk_read(PR_PMIC_DEW_WRITE_TEST,
+			    &rd)) != 0)
+				return err;
+			if ((rd & 0x7fffu) !=
+			    (pr_pwrap_test_data[i] & 0x7fffu)) {
+				found = true;
+				break;
+			}
+		}
+		if (found)
+			break;
+	}
+	if (!found)
+		si_dly = 10;
+
+	pr_wr32(pr.pwrap, PR_PWRAP_SI_SAMPLE, sample + 0x20u);
+	if (si_dly == 10)
+		si_dly = 9;
+	if ((err = pr_pwrap_nochk_read(PR_PMIC_DEW_READ_TEST, &rd)) != 0)
+		return err;
+	if (rd != PR_PMIC_READ_TEST_VAL) {
+		printf("RUBY PMIC: init sistrobe read test=%04x\n", rd);
+		return EPROTO;
+	}
+	printf("RUBY PMIC: init sistrobe sample=%02x si_dly=%u\n",
+	    sample, si_dly);
+	return 0;
+}
+
+static int
+pr_pwrap_init_cipher(void)
+{
+	uint32_t i, v = 0;
+	uint16_t rd;
+	int err;
+
+	pr_wr32(pr.pwrap, PR_PWRAP_CIPHER_SWRST, 1);
+	pr_wr32(pr.pwrap, PR_PWRAP_CIPHER_SWRST, 0);
+	pr_wr32(pr.pwrap, PR_PWRAP_CIPHER_KEY_SEL, 1);
+	pr_wr32(pr.pwrap, PR_PWRAP_CIPHER_IV_SEL, 2);
+	pr_wr32(pr.pwrap, PR_PWRAP_CIPHER_EN, 1);
+
+	if ((err = pr_pwrap_nochk_write(PR_PMIC_DEW_CIPHER_SWRST, 1)) != 0)
+		return err;
+	if ((err = pr_pwrap_nochk_write(PR_PMIC_DEW_CIPHER_SWRST, 0)) != 0)
+		return err;
+	if ((err = pr_pwrap_nochk_write(PR_PMIC_DEW_CIPHER_KEY_SEL, 1)) != 0)
+		return err;
+	if ((err = pr_pwrap_nochk_write(PR_PMIC_DEW_CIPHER_IV_SEL, 2)) != 0)
+		return err;
+	if ((err = pr_pwrap_nochk_write(PR_PMIC_DEW_CIPHER_EN, 1)) != 0)
+		return err;
+
+	/* Vendor allows 10 ms for the AP cipher block to become ready. */
+	for (i = 0; i < 10; i++) {
+		v = pr_rd32(pr.pwrap, PR_PWRAP_CIPHER_RDY);
+		if (v == 3)
+			break;
+		delay(1000);
+	}
+	if (i == 10) {
+		printf("RUBY PMIC: init cipher ap rdy=%08x\n", v);
+		return ETIMEDOUT;
+	}
+
+	for (i = 0; i < 1000; i++) {
+		if ((err = pr_pwrap_nochk_read(PR_PMIC_DEW_CIPHER_RDY,
+		    &rd)) != 0)
+			return err;
+		if (rd == 1)
+			break;
+	}
+	if (i == 1000) {
+		printf("RUBY PMIC: init cipher pmic rdy=%04x\n", rd);
+		return ETIMEDOUT;
+	}
+
+	if ((err = pr_pwrap_nochk_write(PR_PMIC_DEW_CIPHER_MODE, 1)) != 0)
+		return err;
+	if ((err = pr_pwrap_wait_idle_sync(1000)) != 0)
+		return err;
+	pr_wr32(pr.pwrap, PR_PWRAP_CIPHER_MODE, 1);
+
+	if ((err = pr_pwrap_nochk_read(PR_PMIC_DEW_READ_TEST, &rd)) != 0)
+		return err;
+	if (rd != PR_PMIC_READ_TEST_VAL) {
+		printf("RUBY PMIC: init cipher read test=%04x\n", rd);
+		return EPROTO;
+	}
+	return 0;
+}
+
+static int
+pr_pwrap_init(void)
+{
+	uint64_t start, end;
+	uint32_t g0, g2, v;
+	uint16_t hwcid = 0, readtest = 0, top = 0, pwrkey = 0, w;
+	int err;
+
+	if (!pr.pwrap)
+		return pr_pwrap_init_fail("mapped", ENODEV);
+	if (!pr.wrap_init_allowed) {
+		printf("RUBY PMIC: init locked (rubypwrap=1)\n");
+		return EACCES;
+	}
+	if (!pr.ifrao)
+		return pr_pwrap_init_fail("ifrao", ENODEV);
+
+	if ((pr_rd32(pr.pwrap, PR_PWRAP_INIT_DONE2) & 1u) ||
+	    PR_WACS2_INIT_DONE(pr_rd32(pr.pwrap, PR_PWRAP_RDATA))) {
+		printf("RUBY PMIC: init already done\n");
+		if ((err = pr_pwrap_read(PR_PMIC_HWCID, &hwcid)) != 0)
+			return pr_pwrap_init_fail("already-hwcid", err);
+		printf("RUBY PMIC: init already hwcid=0x%04x\n", hwcid);
+		return 0;
+	}
+	if (pr.wrap_init_attempted) {
+		printf("RUBY PMIC: init busy (one attempt per boot)\n");
+		return EBUSY;
+	}
+
+	g0 = pr_rd32(pr.ifrao, 0x090u);
+	g2 = pr_rd32(pr.ifrao, 0x0acu);
+	printf("RUBY PMIC: init pre gates0=%08x gates2=%08x\n", g0, g2);
+	if ((g0 & 0x0fu) || (g2 & (1u << 8))) {
+		printf("RUBY PMIC: init refused: pmic clock gated\n");
+		return EAGAIN;
+	}
+
+	pr.wrap_init_attempted = true;
+	clock_get_uptime(&start);
+	printf("RUBY PMIC: init allow 0x0032 0x0042 0x0098 0x0408 0x040c 0x0410 0x0418 0x041a 0x041c 0x0420 0x0422 0x0424 0x0426 0x044a\n");
+
+	if ((err = pr_pwrap_reset_spislv()) != 0)
+		return pr_pwrap_init_fail("reset_spislv", err);
+	if ((err = pr_pwrap_budget(start, "reset_spislv")) != 0)
+		return err;
+	printf("RUBY PMIC: init reset_spislv ok\n");
+
+	pr_wr32(pr.pwrap, PR_PWRAP_WRAP_EN, 1);
+	pr_wr32(pr.pwrap, PR_PWRAP_HPRIO_ARB_EN, 4);
+	pr_wr32(pr.pwrap, PR_PWRAP_WACS2_EN, 1);
+	v = pr_rd32(pr.pwrap, PR_PWRAP_WACS2_EN);
+	printf("RUBY PMIC: init wacs2 ok en=%08x\n", v);
+
+	if ((err = pr_pwrap_init_reg_clock()) != 0)
+		return pr_pwrap_init_fail("reg_clock", err);
+	if ((err = pr_pwrap_budget(start, "reg_clock")) != 0)
+		return err;
+	printf("RUBY PMIC: init reg_clock ok\n");
+
+	if ((err = pr_pwrap_init_spislv()) != 0)
+		return pr_pwrap_init_fail("spislv", err);
+	if ((err = pr_pwrap_budget(start, "spislv")) != 0)
+		return err;
+	printf("RUBY PMIC: init spislv ok\n");
+
+	if ((err = pr_pwrap_init_dio()) != 0)
+		return pr_pwrap_init_fail("dio", err);
+	if ((err = pr_pwrap_budget(start, "dio")) != 0)
+		return err;
+	printf("RUBY PMIC: init dio ok\n");
+
+	if ((err = pr_pwrap_init_sistrobe()) != 0)
+		return pr_pwrap_init_fail("sistrobe", err);
+	if ((err = pr_pwrap_budget(start, "sistrobe")) != 0)
+		return err;
+	printf("RUBY PMIC: init sistrobe ok\n");
+
+	if ((err = pr_pwrap_init_cipher()) != 0)
+		return pr_pwrap_init_fail("cipher", err);
+	if ((err = pr_pwrap_budget(start, "cipher")) != 0)
+		return err;
+	printf("RUBY PMIC: init cipher ok\n");
+
+	if ((err = pr_pwrap_nochk_write(PR_PMIC_SPISLV_KEY, 0)) != 0)
+		return pr_pwrap_init_fail("lock", err);
+	if ((err = pr_pwrap_nochk_write(PR_PMIC_DEW_WRITE_TEST,
+	    PR_PMIC_WRITE_TEST_VAL)) != 0)
+		return pr_pwrap_init_fail("write_test", err);
+	if ((err = pr_pwrap_nochk_read(PR_PMIC_DEW_WRITE_TEST, &w)) != 0)
+		return pr_pwrap_init_fail("write_test_read", err);
+	if (w != PR_PMIC_WRITE_TEST_VAL) {
+		printf("RUBY PMIC: init write test=%04x\n", w);
+		return pr_pwrap_init_fail("write_test", EPROTO);
+	}
+	printf("RUBY PMIC: init write_test ok\n");
+
+	pr_wr32(pr.pwrap, PR_PWRAP_INIT_DONE2, 1);
+	v = pr_rd32(pr.pwrap, PR_PWRAP_INIT_DONE2);
+	if (!(v & 1u)) {
+		printf("RUBY PMIC: init init_done2=%08x\n", v);
+		return pr_pwrap_init_fail("init_done2", EPROTO);
+	}
+
+	if ((err = pr_pwrap_read(PR_PMIC_HWCID, &hwcid)) != 0)
+		return pr_pwrap_init_fail("hwcid", err);
+	if (hwcid != PR_PMIC_HWCID_VAL) {
+		printf("RUBY PMIC: init hwcid=0x%04x\n", hwcid);
+		return pr_pwrap_init_fail("hwcid", EPROTO);
+	}
+	if ((err = pr_pwrap_read(PR_PMIC_DEW_READ_TEST, &readtest)) != 0)
+		return pr_pwrap_init_fail("read_test", err);
+	if (readtest != PR_PMIC_READ_TEST_VAL) {
+		printf("RUBY PMIC: init read test=0x%04x\n", readtest);
+		return pr_pwrap_init_fail("read_test", EPROTO);
+	}
+	if ((err = pr_pwrap_read(PR_PMIC_TOPSTATUS, &top)) != 0)
+		return pr_pwrap_init_fail("topstatus", err);
+	if ((err = pr_pwrap_read(PR_PMIC_PWRKEY, &pwrkey)) != 0)
+		return pr_pwrap_init_fail("pwrkey", err);
+
+	clock_get_uptime(&end);
+	printf("RUBY PMIC: init PASS %llu ms hwcid=0x%04x readtest=0x%04x top=0x%04x pwrkey=0x%04x\n",
+	    (unsigned long long)((end - start) / 1000000ull),
+	    hwcid, readtest, top, pwrkey);
+	return 0;
+}
