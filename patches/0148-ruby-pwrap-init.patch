+#define PR_PWRAP_MONITOR_CTRL 0x484u
+#define PR_PWRAP_SWINF_ACC    0x880u
+#define PR_PWRAP_SWINF_WDATA  0x884u
+#define PR_PWRAP_SWINF_RDATA  0x894u
+#define PR_PWRAP_SWINF_VLDCLR 0x8a4u
+#define PR_PWRAP_SWINF_STA    0x8a8u
+
+#define PR_SWINF_FSM(v)       (((v) >> 1) & 7u)
