+
+static int
+pr_pwrap_reset_spislv(void)
+{
+	uint32_t i, v = 0;
+	int err = 0;
+
+	pr_wr32(pr.pwrap, PR_PWRAP_HPRIO_ARB_EN, 0);
+	pr_wr32(pr.pwrap, PR_PWRAP_WRAP_EN, 0);
+	pr_wr32(pr.pwrap, PR_PWRAP_MUX_SEL, 1);
+	pr_wr32(pr.pwrap, PR_PWRAP_MAN_EN, 1);
+	pr_wr32(pr.pwrap, PR_PWRAP_DIO_EN, 0);
+
+	/* OP_WR = bit13; CSL=1, OUTS=8, CSH=0, then four more OUTS. */
+	pr_wr32(pr.pwrap, PR_PWRAP_MAN_CMD, (1u << 13) | (1u << 8));
+	pr_wr32(pr.pwrap, PR_PWRAP_MAN_CMD, (1u << 13) | (8u << 8));
+	pr_wr32(pr.pwrap, PR_PWRAP_MAN_CMD, (1u << 13));
+	pr_wr32(pr.pwrap, PR_PWRAP_MAN_CMD, (1u << 13) | (8u << 8));
+	pr_wr32(pr.pwrap, PR_PWRAP_MAN_CMD, (1u << 13) | (8u << 8));
+	pr_wr32(pr.pwrap, PR_PWRAP_MAN_CMD, (1u << 13) | (8u << 8));
+	pr_wr32(pr.pwrap, PR_PWRAP_MAN_CMD, (1u << 13) | (8u << 8));
+
+	for (i = 0; i < 1000; i++) {
+		v = pr_rd32(pr.pwrap, PR_PWRAP_RDATA);
+		if (PR_WACS2_SYNC_IDLE(v))
+			break;
+	}
+	if (i == 1000) {
+		printf("RUBY PMIC: init reset_spislv timeout rd=%08x\n", v);
+		err = ETIMEDOUT;
+	}
+	pr_wr32(pr.pwrap, PR_PWRAP_MAN_EN, 0);
+	pr_wr32(pr.pwrap, PR_PWRAP_MUX_SEL, 0);
+	return err;
+}
+
+static int
+pr_pwrap_init_reg_clock(void)
+{
+	int err;
+
+	pr_wr32(pr.pwrap, PR_PWRAP_EXT_CK_WRITE, 1);
+	if ((err = pr_pwrap_nochk_write(PR_PMIC_DEW_RDDMY_NO, 8)) != 0)
+		return err;
+	pr_wr32(pr.pwrap, PR_PWRAP_RDDMY, 8);
+	pr_wr32(pr.pwrap, PR_PWRAP_CSHEXT_WRITE, 0);
+	pr_wr32(pr.pwrap, PR_PWRAP_CSHEXT_READ, 0);
+	pr_wr32(pr.pwrap, PR_PWRAP_CSLEXT_WRITE, 0);
+	pr_wr32(pr.pwrap, PR_PWRAP_CSLEXT_READ, 0);
+	return 0;
+}
+
+static int
+pr_pwrap_init_spislv(void)
+{
+	int err;
+
+	if ((err = pr_pwrap_nochk_write(PR_PMIC_FILTER_CON0, 0xf0)) != 0)
+		return err;
+	if ((err = pr_pwrap_nochk_write(PR_PMIC_SMT_CON1, 0x0f)) != 0)
+		return err;
+	if ((err = pr_pwrap_nochk_write(PR_PMIC_GPIO_PULLEN0_CLR, 0xf0)) != 0)
+		return err;
+	return pr_pwrap_nochk_write(PR_PMIC_RG_SPI_CON0, 0x1);
+}
+
+static int
+pr_pwrap_init_dio(void)
+{
+	int err;
+
+	if ((err = pr_pwrap_nochk_write(PR_PMIC_DEW_DIO_EN, 1)) != 0)
+		return err;
+	if ((err = pr_pwrap_wait_idle_sync(1000)) != 0)
+		return err;
+	pr_wr32(pr.pwrap, PR_PWRAP_DIO_EN, 1);
+	return 0;
+}
