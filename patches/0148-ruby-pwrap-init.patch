+static void
+pr_pwrap_dump(void)
+{
+	uint32_t sta;
+
+	if (!pr.pwrap) {
+		printf("RUBY PMIC: pwrap not mapped\n");
+		return;
+	}
+	printf("RUBY PMIC: dump wrapinit=%u attempted=%u pmic=%u\n",
+	    pr.wrap_init_allowed, pr.wrap_init_attempted, pr.pmic_writes);
+	printf("RUBY PMIC: dump init=%08x staupd=%08x crc=%08x timer=%08x\n",
+	    pr_rd32(pr.pwrap, PR_PWRAP_INIT_DONE),
+	    pr_rd32(pr.pwrap, PR_PWRAP_STAUPD_CTRL),
+	    pr_rd32(pr.pwrap, PR_PWRAP_CRC_CTRL),
+	    pr_rd32(pr.pwrap, PR_PWRAP_TIMER_CTRL));
+	printf("RUBY PMIC: dump irq3=%08x/%08x irq4=%08x/%08x monitor=%08x\n",
+	    pr_rd32(pr.pwrap, PR_PWRAP_IRQ_FLAG_3),
+	    pr_rd32(pr.pwrap, PR_PWRAP_IRQ_CLR_3),
+	    pr_rd32(pr.pwrap, PR_PWRAP_IRQ_FLAG_4),
+	    pr_rd32(pr.pwrap, PR_PWRAP_IRQ_CLR_4),
+	    pr_rd32(pr.pwrap, PR_PWRAP_MONITOR_CTRL));
+	printf("RUBY PMIC: dump acc=%08x wdata=%08x rdata=%08x vldclr=%08x\n",
+	    pr_rd32(pr.pwrap, PR_PWRAP_SWINF_ACC),
+	    pr_rd32(pr.pwrap, PR_PWRAP_SWINF_WDATA),
+	    pr_rd32(pr.pwrap, PR_PWRAP_SWINF_RDATA),
+	    pr_rd32(pr.pwrap, PR_PWRAP_SWINF_VLDCLR));
+	sta = pr_rd32(pr.pwrap, PR_PWRAP_SWINF_STA);
+	printf("RUBY PMIC: dump sta=%08x fsm=%u init_done=%u sync_idle=%u\n",
+	    sta, PR_SWINF_FSM(sta), (sta >> 15) & 1u, (sta >> 20) & 1u);
+	if (pr.ifrao)
+		printf("RUBY PMIC: dump ifrao gates0=%08x gates2=%08x (bit=1 gated)\n",
+		    pr_rd32(pr.ifrao, 0x090u), pr_rd32(pr.ifrao, 0x0acu));
+	else
+		printf("RUBY PMIC: dump ifrao not mapped\n");
+}
+
+static int
+pr_pwrap_init(void)
+{
+	uint64_t start, end;
+	uint32_t init, sta;
+	uint16_t hwcid = 0, readtest = 0, top = 0, pwrkey = 0;
+	int err;
+
+	if (!pr.pwrap) {
+		printf("RUBY PMIC: init FAIL mapped\n");
+		return ENODEV;
+	}
+	if (!pr.wrap_init_allowed) {
+		printf("RUBY PMIC: init locked (rubypwrap=1)\n");
+		return EACCES;
+	}
+	if (pr.wrap_init_attempted) {
+		printf("RUBY PMIC: init busy (one attempt per boot)\n");
+		return EBUSY;
+	}
+
+	init = pr_rd32(pr.pwrap, PR_PWRAP_INIT_DONE);
+	sta = pr_rd32(pr.pwrap, PR_PWRAP_SWINF_STA);
+	printf("RUBY PMIC: init pre init=%08x sta=%08x\n", init, sta);
+	clock_get_uptime(&start);
+	pr.wrap_init_attempted = true;
+
+	if (!(init & 1u)) {
+		pr_wr32(pr.pwrap, PR_PWRAP_INIT_DONE, 1);
+		init = pr_rd32(pr.pwrap, PR_PWRAP_INIT_DONE);
+		printf("RUBY PMIC: init set done=%08x\n", init);
+	} else {
+		printf("RUBY PMIC: init already done\n");
+	}
+
+	sta = pr_rd32(pr.pwrap, PR_PWRAP_SWINF_STA);
+	if (!(sta & PR_SWINF_INIT_DONE)) {
+		printf("RUBY PMIC: init FAIL sta=%08x\n", sta);
+		return ENODEV;
+	}
+	printf("RUBY PMIC: init ready sta=%08x\n", sta);
+
+	if ((err = pr_pwrap_read(PR_PMIC_HWCID, &hwcid)) != 0) {
+		printf("RUBY PMIC: init FAIL hwcid err=%d\n", err);
+		return err;
+	}
+	if (hwcid != PR_PMIC_HWCID_VAL) {
+		printf("RUBY PMIC: init FAIL hwcid=0x%04x\n", hwcid);
+		return EPROTO;
+	}
+	if ((err = pr_pwrap_read(PR_PMIC_READ_TEST, &readtest)) != 0) {
+		printf("RUBY PMIC: init FAIL read_test err=%d\n", err);
+		return err;
+	}
+	if (readtest != PR_PMIC_READ_TEST_VAL) {
+		printf("RUBY PMIC: init FAIL read_test=0x%04x\n", readtest);
+		return EPROTO;
+	}
+	if ((err = pr_pwrap_read(PR_PMIC_TOPSTATUS, &top)) != 0) {
+		printf("RUBY PMIC: init FAIL topstatus err=%d\n", err);
+		return err;
+	}
+	if ((err = pr_pwrap_read(PR_PMIC_PWRKEY, &pwrkey)) != 0) {
+		printf("RUBY PMIC: init FAIL pwrkey err=%d\n", err);
 		return err;
-	pr_wr32(pr.pwrap, PR_PWRAP_CMD,
-	    (1u << 31) | ((uint32_t)(reg >> 1) << 16) | val);
-	return pr_pwrap_wait(0);
+	}
+
+	clock_get_uptime(&end);
+	printf("RUBY PMIC: init PASS %llu ms hwcid=0x%04x readtest=0x%04x top=0x%04x pwrkey=0x%04x\n",
+	    (unsigned long long)((end - start) / 1000000ull),
+	    hwcid, readtest, top, pwrkey);
+	return 0;
 }
 
