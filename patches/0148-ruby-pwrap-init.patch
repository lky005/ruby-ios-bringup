+/*
+ * 0148: the explicit "pwrap init" path.  Only the PMIC SPI/cipher bootstrap
+ * registers are writable here; rails and functional PMIC registers are not
+ * in the allowlist.  The sequence follows the vendor pwrap HAL (reset SPISLV,
+ * enable WACS2, SPI waveform, SPI slave config, DIO, SI strobe, cipher, write
+ * test, INIT_DONE2), with short bounded waits and no EINT/WDT/sta-upd setup.
+ */
+static bool
+pr_pwrap_init_reg_ok(uint16_t reg)
+{
+	switch (reg) {
+	case PR_PMIC_SMT_CON1:
+	case PR_PMIC_FILTER_CON0:
+	case PR_PMIC_GPIO_PULLEN0_CLR:
+	case PR_PMIC_RG_SPI_CON0:
+	case PR_PMIC_DEW_DIO_EN:
+	case PR_PMIC_DEW_WRITE_TEST:
+	case PR_PMIC_DEW_CIPHER_KEY_SEL:
+	case PR_PMIC_DEW_CIPHER_IV_SEL:
+	case PR_PMIC_DEW_CIPHER_EN:
+	case PR_PMIC_DEW_CIPHER_MODE:
+	case PR_PMIC_DEW_CIPHER_SWRST:
+	case PR_PMIC_DEW_RDDMY_NO:
+	case PR_PMIC_RG_SPI_CON2:
+	case PR_PMIC_SPISLV_KEY:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static int
+pr_pwrap_wait_n(uint32_t fsm, uint32_t polls)
+{
+	uint32_t i, v = 0;
+
+	for (i = 0; i < polls; i++) {
+		v = pr_rd32(pr.pwrap, PR_PWRAP_RDATA);
+		if (PR_WACS2_FSM(v) == fsm)
+			return 0;
+	}
+	printf("RUBY PMIC: init wait fsm=%u timeout rd=%08x\n", fsm, v);
+	return ETIMEDOUT;
+}
+
+static int
+pr_pwrap_wait_idle_sync(uint32_t polls)
+{
+	uint32_t i, v = 0;
+
+	for (i = 0; i < polls; i++) {
+		v = pr_rd32(pr.pwrap, PR_PWRAP_RDATA);
+		if (PR_WACS2_FSM(v) == PR_WACS2_FSM_IDLE &&
+		    PR_WACS2_SYNC_IDLE(v))
+			return 0;
+	}
+	printf("RUBY PMIC: init wait idle/sync timeout rd=%08x\n", v);
+	return ETIMEDOUT;
+}
+
+static int
+pr_pwrap_nochk_read(uint16_t reg, uint16_t *val)
+{
+	uint32_t rd;
+	int err;
+
+	if ((err = pr_pwrap_wait_n(PR_WACS2_FSM_IDLE, 1000)) != 0)
+		return err;
+	pr_wr32(pr.pwrap, PR_PWRAP_CMD, (uint32_t)(reg >> 1) << 16);
+	if ((err = pr_pwrap_wait_n(PR_WACS2_FSM_VLDCLR, 1000)) != 0)
+		return err;
+	rd = pr_rd32(pr.pwrap, PR_PWRAP_RDATA);
+	*val = (uint16_t)(rd & 0xffffu);
+	pr_wr32(pr.pwrap, PR_PWRAP_VLDCLR, 1);
+	return 0;
+}
+
+static int
+pr_pwrap_nochk_write(uint16_t reg, uint16_t val)
+{
+	if (!pr_pwrap_init_reg_ok(reg)) {
+		printf("RUBY PMIC: init deny w 0x%04x (not bootstrap)\n", reg);
+		return EACCES;
+	}
+	if (pr_pwrap_wait_n(PR_WACS2_FSM_IDLE, 1000) != 0)
+		return ETIMEDOUT;
+	pr_wr32(pr.pwrap, PR_PWRAP_CMD,
+	    (1u << 31) | ((uint32_t)(reg >> 1) << 16) | val);
+	return pr_pwrap_wait_n(PR_WACS2_FSM_IDLE, 1000);
+}
+
+static int
+pr_pwrap_budget(uint64_t start, const char *step)
+{
+	uint64_t now;
+
+	clock_get_uptime(&now);
+	if (now - start > 500000000ull) {
+		printf("RUBY PMIC: init FAIL step=%s budget\n", step);
+		return ETIMEDOUT;
+	}
+	return 0;
+}
+
+static int
+pr_pwrap_init_fail(const char *step, int err)
+{
+	printf("RUBY PMIC: init FAIL step=%s err=%d\n", step, err);
+	return err;
+}
