+	if (pr.topckgen)
+		printf("RUBY PMIC: dump topckgen cfg7=%08x/%08x/%08x cfg8=%08x/%08x/%08x upd=%08x\n",
+		    pr_rd32(pr.topckgen, 0x080u), pr_rd32(pr.topckgen, 0x084u),
+		    pr_rd32(pr.topckgen, 0x088u), pr_rd32(pr.topckgen, 0x090u),
+		    pr_rd32(pr.topckgen, 0x094u), pr_rd32(pr.topckgen, 0x098u),
