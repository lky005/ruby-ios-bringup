+#define PR_PMIC_HWCID         0x0008u
+#define PR_PMIC_TOPSTATUS     0x002au
+#define PR_PMIC_PWRKEY        0x0a16u
+#define PR_PMIC_READ_TEST     0x040eu
+#define PR_PMIC_READ_TEST_VAL 0x5aa5u
+#define PR_PMIC_HWCID_VAL     0x5930u
 
