+const char *
+ruby_eint_state_name(uint32_t state)
+{
+	switch (state) {
+	case RUBY_EINT_FREE:
+		return "free";
+	case RUBY_EINT_RESERVED:
+		return "reserved";
+	case RUBY_EINT_ACTIVE:
+		return "active";
+	case RUBY_EINT_DEFERRED:
+		return "deferred";
+	case RUBY_EINT_STUCK:
+		return "stuck";
+	case RUBY_EINT_POLL_ONLY:
+		return "poll";
+	default:
+		return "?";
+	}
+}
+
+struct ruby_eint *
+ruby_eint_attach(uint32_t line, enum ruby_eint_trigger trig,
+    const struct ruby_eint_child *child)
+{
+	struct ruby_eint *e;
+	uint32_t bit, doff, dval, mask, ctl, isen, pnd;
+	uint32_t saved_mask, saved_sens, saved_pol;
+
+	ruby_eint_init();
+	if (__atomic_load_n(&g_eint_state, __ATOMIC_ACQUIRE) != 2 ||
+	    !g_eint_enabled || !g_eint_base || !g_gicd_base)
+		return NULL;
+	if (line >= RUBY_EINT_LINES || trig > RUBY_EINT_LEVEL_HIGH)
+		return NULL;
+
+	bit = ruby_eint_bit(line);
+	ruby_eint_gic_read(&ctl, &isen, &pnd);
+	if (ctl == 0 || ctl == 0xffffffffu || isen == 0xffffffffu)
+		return NULL;
+
+	RUBY_EINT_LOCK();
+	e = &g_eint_slots[line];
+	if (e->used) {
+		RUBY_EINT_UNLOCK();
+		return NULL;
+	}
+	e->line = line;
+	e->trigger = (uint32_t)trig;
+	saved_mask = (ruby_rd32(g_eint_base,
+	    ruby_eint_off(RUBY_EINT_MASK, line)) & bit) ? 1u : 0u;
+	saved_sens = (ruby_rd32(g_eint_base,
+	    ruby_eint_off(RUBY_EINT_SENS, line)) & bit) ? 1u : 0u;
+	saved_pol = (ruby_rd32(g_eint_base,
+	    ruby_eint_off(RUBY_EINT_POL, line)) & bit) ? 1u : 0u;
+	e->saved_mask = saved_mask;
+	e->saved_sens = saved_sens;
+	e->saved_pol = saved_pol;
+	e->pending_count = 0;
+	e->ack_count = 0;
+	e->state = RUBY_EINT_RESERVED;
+	e->child = child;
+	e->seq = 0;
+	e->isr_hits = 0;
+	e->service_ok = 0;
+	e->service_fail = 0;
+	e->stray = 0;
+	e->edge_rearm = 0;
+	e->poll_seen = 0;
+	e->win_start_ms = 0;
+	e->win_hits = 0;
+	e->win_service_base = 0;
+	e->fail_streak = 0;
+	e->poll_only = 0;
+
+	ruby_eint_apply_trigger(e);
+	ruby_wr32(g_eint_base, ruby_eint_off(RUBY_EINT_ACK, line), bit);
+	doff = ruby_eint_off(RUBY_EINT_DOM_EN, line);
+	dval = ruby_rd32(g_eint_base, doff);
+	ruby_wr32(g_eint_base, doff, dval & ~bit);
+	ruby_wr32(g_eint_base, ruby_eint_off(RUBY_EINT_MASK_SET, line), bit);
+	(void)ruby_rd32(g_eint_base, ruby_eint_off(RUBY_EINT_MASK, line));
+	e->used = true;
+	mask = ruby_rd32(g_eint_base, ruby_eint_off(RUBY_EINT_MASK, line));
+	RUBY_EINT_UNLOCK();
+
+	printf("RUBY EINT: attach line=%u trigger=%u child=%s saved=%u/%u/%u mask=%08x\n",
+	    line, (unsigned)trig, child && child->name ? child->name : "-",
+	    saved_mask, saved_sens, saved_pol, mask);
+	return e;
+}
+
+int
+ruby_eint_activate(struct ruby_eint *e)
+{
+	uint32_t bit, doff, dval, moff;
+	int rc;
+
+	if (!e || e->line >= RUBY_EINT_LINES)
+		return EINVAL;
+	ruby_eint_init();
+	if (__atomic_load_n(&g_eint_state, __ATOMIC_ACQUIRE) != 2 ||
+	    !g_eint_base || !e->used)
+		return ENODEV;
+
+	/* Parent start is lazy and idempotent; failure means poll-only. */
+	rc = ruby_irq_parent_start();
+	if (rc != 0) {
+		bit = ruby_eint_bit(e->line);
+		doff = ruby_eint_off(RUBY_EINT_DOM_EN, e->line);
+		moff = ruby_eint_off(RUBY_EINT_MASK, e->line);
+		RUBY_EINT_LOCK();
+		if (e->used) {
+			dval = ruby_rd32(g_eint_base, doff);
+			ruby_wr32(g_eint_base, doff, dval & ~bit);
+			ruby_wr32(g_eint_base,
+			    ruby_eint_off(RUBY_EINT_MASK_CLR, e->line), bit);
+			(void)ruby_rd32(g_eint_base, moff);
+			e->state = RUBY_EINT_POLL_ONLY;
+			e->poll_only = 1;
+			e->seq++;
+		}
+		RUBY_EINT_UNLOCK();
+		wakeup(&e->seq);
+		printf("RUBY EINT: line=%u parent unavailable rc=%d; poll\n",
+		    e->line, rc);
+		return rc;
+	}
+
+	bit = ruby_eint_bit(e->line);
+	doff = ruby_eint_off(RUBY_EINT_DOM_EN, e->line);
+	moff = ruby_eint_off(RUBY_EINT_MASK, e->line);
+	RUBY_EINT_LOCK();
+	if (!e->used) {
+		RUBY_EINT_UNLOCK();
+		return ENODEV;
+	}
+	/* Clear any latch accumulated while gated, then open DOM + line. */
+	ruby_wr32(g_eint_base, ruby_eint_off(RUBY_EINT_ACK, e->line), bit);
+	dval = ruby_rd32(g_eint_base, doff);
+	ruby_wr32(g_eint_base, doff, dval | bit);
+	ruby_wr32(g_eint_base, ruby_eint_off(RUBY_EINT_MASK_CLR, e->line), bit);
+	(void)ruby_rd32(g_eint_base, moff);	/* flush gates */
+	dval = ruby_rd32(g_eint_base, doff);
+	if ((dval & bit) == 0) {
+		ruby_wr32(g_eint_base, doff, dval & ~bit);
+		ruby_wr32(g_eint_base,
+		    ruby_eint_off(RUBY_EINT_MASK_CLR, e->line), bit);
+		(void)ruby_rd32(g_eint_base, moff);
+		e->state = RUBY_EINT_POLL_ONLY;
+		e->poll_only = 1;
+		e->service_fail++;
+		RUBY_EINT_UNLOCK();
+		printf("RUBY EINT: line=%u dom readback failed; poll\n", e->line);
+		return EIO;
+	}
+	e->state = RUBY_EINT_ACTIVE;
+	e->poll_only = 0;
+	e->fail_streak = 0;
+	RUBY_EINT_UNLOCK();
+	printf("RUBY EINT: line=%u active\n", e->line);
+	return 0;
+}
+
+void
+ruby_eint_deactivate(struct ruby_eint *e)
+{
+	uint32_t bit, doff, dval, moff;
+
+	if (!e || e->line >= RUBY_EINT_LINES)
+		return;
+	ruby_eint_init();
+	if (__atomic_load_n(&g_eint_state, __ATOMIC_ACQUIRE) != 2 ||
+	    !g_eint_base)
+		return;
+	bit = ruby_eint_bit(e->line);
+	doff = ruby_eint_off(RUBY_EINT_DOM_EN, e->line);
+	moff = ruby_eint_off(RUBY_EINT_MASK, e->line);
+	RUBY_EINT_LOCK();
+	if (!e->used) {
+		RUBY_EINT_UNLOCK();
+		return;
+	}
+	ruby_wr32(g_eint_base, ruby_eint_off(RUBY_EINT_MASK_SET, e->line),
+	    bit);
+	ruby_wr32(g_eint_base, ruby_eint_off(RUBY_EINT_ACK, e->line), bit);
+	dval = ruby_rd32(g_eint_base, doff);
+	ruby_wr32(g_eint_base, doff, dval & ~bit);
+	(void)ruby_rd32(g_eint_base, moff);
+	e->state = RUBY_EINT_RESERVED;
+	e->poll_only = 0;
+	RUBY_EINT_UNLOCK();
+	printf("RUBY EINT: line=%u deactivated\n", e->line);
+}
+
+void
+ruby_eint_detach(struct ruby_eint *e)
+{
+	/* release() restores the saved pin state and frees the slot. */
+	ruby_eint_release(e);
+}
+
+int
+ruby_eint_wait(struct ruby_eint *e, unsigned ms)
+{
+	uint64_t deadline, now;
+	uint32_t seen;
+	boolean_t intr;
+
+	if (!e || e->line >= RUBY_EINT_LINES)
+		return 0;
+	if (__atomic_load_n(&g_eint_state, __ATOMIC_ACQUIRE) != 2)
+		return 0;
+	if (ms == 0)
+		ms = 8;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+
+	RUBY_EINT_LOCK();
+	seen = e->seq;
+	RUBY_EINT_UNLOCK();
+
+	for (;;) {
+		intr = ml_set_interrupts_enabled(FALSE);
+		lck_spin_lock(&g_eint_lock);
+		if (!e->used || e->state == RUBY_EINT_FREE) {
+			lck_spin_unlock(&g_eint_lock);
+			ml_set_interrupts_enabled(intr);
+			return 0;
+		}
+		if (e->seq != seen) {
+			lck_spin_unlock(&g_eint_lock);
+			ml_set_interrupts_enabled(intr);
+			return 1;
+		}
+		clock_get_uptime(&now);
+		if (now >= deadline) {
+			lck_spin_unlock(&g_eint_lock);
+			ml_set_interrupts_enabled(intr);
+			return 0;
+		}
+		assert_wait_deadline(&e->seq, THREAD_UNINT, deadline);
+		lck_spin_unlock(&g_eint_lock);
+		ml_set_interrupts_enabled(intr);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+void
+ruby_eint_service_done(struct ruby_eint *e, int ok, int source_clear)
+{
+	uint32_t bit, doff, dval, moff;
+
+	if (!e || e->line >= RUBY_EINT_LINES)
+		return;
+	bit = ruby_eint_bit(e->line);
+	doff = ruby_eint_off(RUBY_EINT_DOM_EN, e->line);
+	moff = ruby_eint_off(RUBY_EINT_MASK, e->line);
+	RUBY_EINT_LOCK();
+	if (!e->used || e->state != RUBY_EINT_DEFERRED) {
+		RUBY_EINT_UNLOCK();
+		return;
+	}
+	if (ok && source_clear) {
+		/* No bottom-half ACK: an edge latched during service must
+		 * survive and re-trigger the parent after MASK_CLR. */
+		ruby_wr32(g_eint_base,
+		    ruby_eint_off(RUBY_EINT_MASK_CLR, e->line), bit);
+		(void)ruby_rd32(g_eint_base, moff);
+		e->state = RUBY_EINT_ACTIVE;
+		e->service_ok++;
+		e->fail_streak = 0;
+	} else {
+		/* Keep the parent gated but let polling observe new edges. */
+		dval = ruby_rd32(g_eint_base, doff);
+		ruby_wr32(g_eint_base, doff, dval & ~bit);
+		ruby_wr32(g_eint_base,
+		    ruby_eint_off(RUBY_EINT_MASK_CLR, e->line), bit);
+		(void)ruby_rd32(g_eint_base, moff);
+		e->service_fail++;
+		e->fail_streak++;
+		e->state = (e->fail_streak >= 8) ?
+		    RUBY_EINT_POLL_ONLY : RUBY_EINT_STUCK;
+		if (e->state == RUBY_EINT_POLL_ONLY)
+			e->poll_only = 1;
+	}
+	RUBY_EINT_UNLOCK();
+}
+
+int
+ruby_eint_active(struct ruby_eint *e)
+{
+	int r;
+
+	if (!e || e->line >= RUBY_EINT_LINES)
+		return 0;
+	RUBY_EINT_LOCK();
+	r = e->used && e->state == RUBY_EINT_ACTIVE;
+	RUBY_EINT_UNLOCK();
+	return r;
+}
+
+int
+ruby_eint_poll_only(struct ruby_eint *e)
+{
+	int r;
+
+	if (!e || e->line >= RUBY_EINT_LINES)
+		return 0;
+	RUBY_EINT_LOCK();
+	r = e->used && (e->poll_only || e->state == RUBY_EINT_STUCK ||
+	    e->state == RUBY_EINT_POLL_ONLY);
+	RUBY_EINT_UNLOCK();
+	return r;
+}
+
+void
+ruby_eint_force_poll(struct ruby_eint *e)
+{
+	uint32_t bit, doff, dval, moff;
+
+	if (!e || e->line >= RUBY_EINT_LINES)
+		return;
+	bit = ruby_eint_bit(e->line);
+	doff = ruby_eint_off(RUBY_EINT_DOM_EN, e->line);
+	moff = ruby_eint_off(RUBY_EINT_MASK, e->line);
+	RUBY_EINT_LOCK();
+	if (e->used && e->state != RUBY_EINT_FREE) {
+		dval = ruby_rd32(g_eint_base, doff);
+		ruby_wr32(g_eint_base, doff, dval & ~bit);
+		ruby_wr32(g_eint_base,
+		    ruby_eint_off(RUBY_EINT_MASK_CLR, e->line), bit);
+		(void)ruby_rd32(g_eint_base, moff);
+		e->state = RUBY_EINT_POLL_ONLY;
+		e->poll_only = 1;
+		e->service_fail++;
+		e->seq++;
+	}
+	RUBY_EINT_UNLOCK();
+	wakeup(&e->seq);
+}
+
+int
+ruby_eint_demux_isr(void)
+{
+	uint32_t port, sta, bit, line, wake[RUBY_EINT_LINE_PORTS] = { 0 };
+	uint64_t now;
+	struct ruby_eint *e;
+	int handled = 0, p;
+
+	if (__atomic_load_n(&g_eint_state, __ATOMIC_ACQUIRE) != 2 ||
+	    !g_eint_base)
+		return 0;
+	now = ruby_eint_now_ms();
+
+	lck_spin_lock(&g_eint_lock);
+	for (port = 0; port < RUBY_EINT_LINE_PORTS; port++) {
+		sta = ruby_rd32(g_eint_base, RUBY_EINT_STA + port * 4u);
+		while (sta != 0) {
+			bit = __builtin_ctz(sta);
+			sta &= ~(1u << bit);
+			line = port * 32u + bit;
+			e = &g_eint_slots[line];
+
+			/* Close the gate, clear the latch, flush APB before
+			 * the parent EOI can observe a still-high line. */
+			ruby_wr32(g_eint_base,
+			    RUBY_EINT_MASK_SET + port * 4u, 1u << bit);
+			ruby_wr32(g_eint_base,
+			    RUBY_EINT_ACK + port * 4u, 1u << bit);
+			(void)ruby_rd32(g_eint_base,
+			    RUBY_EINT_MASK + port * 4u);
+			handled++;
+
+			if (!e->used || e->state != RUBY_EINT_ACTIVE) {
+				e->stray++;
+				continue;
+			}
+
+			e->state = RUBY_EINT_DEFERRED;
+			e->isr_hits++;
+			if (ruby_rd32(g_eint_base,
+			    RUBY_EINT_STA + port * 4u) & (1u << bit))
+				e->edge_rearm++;
+			e->seq++;
+			wake[port] |= 1u << bit;
+
+			if (e->win_start_ms == 0 ||
+			    now - e->win_start_ms >= 20) {
+				e->win_start_ms = (uint32_t)now;
+				e->win_hits = 0;
+				e->win_service_base = e->service_ok;
+			}
+			e->win_hits++;
+			if (e->win_hits > 64 &&
+			    e->service_ok == e->win_service_base &&
+			    !e->poll_only) {
+				uint32_t doff = ruby_eint_off(
+				    RUBY_EINT_DOM_EN, line);
+				uint32_t dval = ruby_rd32(g_eint_base, doff);
+				ruby_wr32(g_eint_base, doff,
+				    dval & ~(1u << bit));
+				ruby_wr32(g_eint_base,
+				    RUBY_EINT_MASK_CLR + port * 4u,
+				    1u << bit);
+				(void)ruby_rd32(g_eint_base,
+				    RUBY_EINT_MASK + port * 4u);
+				e->state = RUBY_EINT_POLL_ONLY;
+				e->poll_only = 1;
+				e->service_fail++;
+			}
+		}
+	}
+	lck_spin_unlock(&g_eint_lock);
+
+	for (p = 0; p < (int)RUBY_EINT_LINE_PORTS; p++) {
+		uint32_t w = wake[p];
+		while (w != 0) {
+			uint32_t b = __builtin_ctz(w);
+			w &= ~(1u << b);
+			wakeup(&g_eint_slots[p * 32u + b].seq);
+		}
+	}
+	return handled;
+}
+
+void
+ruby_eint_all_poll_only(void)
+{
+	uint32_t i, bit, doff, dval;
+
+	if (__atomic_load_n(&g_eint_state, __ATOMIC_ACQUIRE) != 2 ||
+	    !g_eint_base)
+		return;
+	lck_spin_lock(&g_eint_lock);
+	for (i = 0; i < RUBY_EINT_LINES; i++) {
+		struct ruby_eint *e = &g_eint_slots[i];
+
+		if (!e->used)
+			continue;
+		bit = ruby_eint_bit(i);
+		doff = ruby_eint_off(RUBY_EINT_DOM_EN, i);
+		dval = ruby_rd32(g_eint_base, doff);
+		ruby_wr32(g_eint_base, doff, dval & ~bit);
+		ruby_wr32(g_eint_base,
+		    ruby_eint_off(RUBY_EINT_MASK_CLR, i), bit);
+		(void)ruby_rd32(g_eint_base, ruby_eint_off(RUBY_EINT_MASK, i));
+		e->state = RUBY_EINT_POLL_ONLY;
+		e->poll_only = 1;
+		e->seq++;
+	}
+	lck_spin_unlock(&g_eint_lock);
+	for (i = 0; i < RUBY_EINT_LINES; i++) {
+		if (g_eint_slots[i].used)
+			wakeup(&g_eint_slots[i].seq);
+	}
+}
