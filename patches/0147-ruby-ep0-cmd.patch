+/*
+ * 0147: vendor OUT 0x40/0x2E, one command line in the data stage.
+ *   wValue = sequence, wLength = 1..64.  The setup is ACKed without
+ *   DATAEND; ruby_ep0_service() copies the line and queues it.  The
+ *   command runs from the 1 ms tick, not from the EP0/RX context.
+ */
+static void
+ruby_ep0_vendor_cmd(vm_offset_t mac, uint32_t t, uint32_t value,
+    uint32_t index, uint32_t wlen)
+{
+    uint32_t csr;
+
+    (void)index;
+    if (wlen == 0 || wlen > RUBY_CMD_MAX) {
+        ruby_ep0_stall(mac, t, 0x402e, wlen);
+        return;
+    }
+    ruby_cmd_out_seq = value & 0xffffu;
+    ruby_cmd_out_len = wlen;
+    ruby_cmd_out_pending = 1;
