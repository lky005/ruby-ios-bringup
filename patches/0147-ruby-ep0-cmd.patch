+/*
+ * 0147: U3D_FIFO0 is a 32-bit port.  Reading it byte-by-byte returns the
+ * same lane repeatedly; vendor ep0_read_fifo() reads words and one final
+ * word for the 1..3 byte tail.  Use the same order for the 0x2E line.
+ */
+static void
+ruby_ep0_read_fifo_bytes(vm_offset_t mac, uint8_t *dst, uint32_t len)
+{
+    uint32_t i = 0;
+
+    while (i + 4 <= len) {
+        uint32_t w = ruby_rd32(mac, FIFO0_OFF);
+
+        dst[i++] = (uint8_t)(w & 0xffu);
+        dst[i++] = (uint8_t)((w >> 8) & 0xffu);
+        dst[i++] = (uint8_t)((w >> 16) & 0xffu);
+        dst[i++] = (uint8_t)((w >> 24) & 0xffu);
+    }
+    if (i < len) {
+        uint32_t w = ruby_rd32(mac, FIFO0_OFF);
+
+        while (i < len) {
+            dst[i++] = (uint8_t)(w & 0xffu);
+            w >>= 8;
+        }
+    }
+}
