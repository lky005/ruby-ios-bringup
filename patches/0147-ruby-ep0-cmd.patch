+static void
+ruby_cmd_submit(uint32_t seq, const char *line)
+{
+    uint32_t i;
+
+    if (ruby_cmd_busy || ruby_cmd_pending) {
+        ruby_cmd_busy_rejects++;
+        printf("RUBY CMD[%u]: busy\n", seq);
+        return;
+    }
+    for (i = 0; i < RUBY_CMD_MAX && line[i]; i++)
+        ruby_cmd_line[i] = line[i];
+    ruby_cmd_line[i] = '\0';
+    ruby_cmd_seq_pending = seq;
+    ruby_cmd_pending = 1;
+}
+
+static void
+ruby_cmd_tick(vm_offset_t mac)
+{
+    uint32_t seq;
+
+    if (!ruby_cmd_pending || ruby_cmd_busy)
+        return;
+    ruby_cmd_busy = 1;
+    ruby_cmd_pending = 0;
+    seq = ruby_cmd_seq_pending;
+    ruby_cmd_seq_active = seq;
+    ruby_cmd_count++;
+    ruby_cmd_dispatch(mac, ruby_cmd_line);
+    printf("RUBY CMD[%u]: done\n", seq);
+    ruby_cmd_seq_active = 0;
+    ruby_cmd_busy = 0;
+    ruby_cmd_done++;
+}
