  * readback still claims ACTIVE (console: act == kick, inf stuck), so a
  * pseudo-active queue has to be stopped and rebuilt.
  */
+/* 0253: vendor stop() flushes the TX FIFO and waits FIFOEMPTY; an
+ * aborted transfer leaves bytes in the FIFO and later GPDs are dropped. */
+static void
+ruby_ep2_tx_fifo_drain(vm_offset_t mac)
+{
+    uint32_t i;
+
+    ruby_wr32(mac, TX1CSR0_OFF,
+        ruby_rd32(mac, TX1CSR0_OFF) | TX_FLUSHFIFO);
+    for (i = 0; i < 100; i++) {
+        if (ruby_rd32(mac, TX1CSR0_OFF) & TX_FIFOEMPTY)
+            break;
+        delay(10);
+    }
+}
