 static void
+pr_eint_status(void)
+{
+	const uint32_t bit = PR_EINT_TOUCH_BIT;
+	uint32_t mask, sens, pol, sta;
+	uint32_t gic_ctl = 0, gic_isen = 0, gic_pnd = 0;
+
+	if (!pr.eint) {
+		printf("RUBY EINT: eint not mapped\n");
+		return;
+	}
+	mask = pr_rd32(pr.eint, PR_EINT_MASK);
+	sens = pr_rd32(pr.eint, PR_EINT_SENS);
+	pol = pr_rd32(pr.eint, PR_EINT_POL);
+	sta = pr_rd32(pr.eint, PR_EINT_STA);
+	if (pr.gicd) {
+		gic_ctl = pr_rd32(pr.gicd, PR_GICD_CTLR);
+		gic_isen = pr_rd32(pr.gicd, PR_GICD_ISENABLER_SPI256);
+		gic_pnd = pr_rd32(pr.gicd, PR_GICD_ISPENDR_SPI256);
+	}
+	printf("RUBY EINT: eint14 sta=%u mask=%u sens=%u pol=%u\n",
+	    (sta & bit) != 0, (mask & bit) != 0,
+	    (sens & bit) != 0, (pol & bit) != 0);
+	printf("RUBY EINT: raw sta=%08x mask=%08x sens=%08x pol=%08x\n",
+	    sta, mask, sens, pol);
+	if (pr.gicd)
+		printf("RUBY EINT: gic ctlr=%08x isen=%08x pnd=%08x spi256=%u\n",
+		    gic_ctl, gic_isen, gic_pnd,
+		    (gic_isen & PR_GIC_SPI256_BIT) != 0);
+	else
+		printf("RUBY EINT: gicd not mapped\n");
+}
+
+static int
+pr_eint_touch(uint32_t ms)
+{
+	const uint32_t bit = PR_EINT_TOUCH_BIT;
+	uint32_t saved_mask, saved_sens, saved_pol;
+	uint32_t mask, sens, pol, sta;
+	uint32_t gic_ctl, gic_isen, gic_pnd;
+	uint32_t i, events = 0;
+
+	if (!pr.eint_allowed) {
+		printf("RUBY EINT: disabled (rubyeint=0)\n");
+		return 1;
+	}
+	if (!pr.eint) {
+		printf("RUBY EINT: eint not mapped\n");
+		return 1;
+	}
+	if (!pr.gicd) {
+		printf("RUBY EINT: gicd not mapped; refusing to arm\n");
+		return 1;
+	}
+	if (ms < 100)
+		ms = 100;
+	if (ms > 3000)
+		ms = 3000;
+
+	gic_ctl = pr_rd32(pr.gicd, PR_GICD_CTLR);
+	gic_isen = pr_rd32(pr.gicd, PR_GICD_ISENABLER_SPI256);
+	gic_pnd = pr_rd32(pr.gicd, PR_GICD_ISPENDR_SPI256);
+	printf("RUBY EINT: gic ctlr=%08x isen=%08x pnd=%08x spi256=%u\n",
+	    gic_ctl, gic_isen, gic_pnd,
+	    (gic_isen & PR_GIC_SPI256_BIT) != 0);
+	if (gic_isen & PR_GIC_SPI256_BIT) {
+		printf("RUBY EINT: abort: GIC SPI256 enabled\n");
+		return 1;
+	}
+	if (gic_pnd & PR_GIC_SPI256_BIT)
+		printf("RUBY EINT: note: GIC SPI256 pending while disabled\n");
+
+	saved_mask = pr_rd32(pr.eint, PR_EINT_MASK);
+	saved_sens = pr_rd32(pr.eint, PR_EINT_SENS);
+	saved_pol = pr_rd32(pr.eint, PR_EINT_POL);
+	printf("RUBY EINT: saved mask=%08x sens=%08x pol=%08x\n",
+	    saved_mask, saved_sens, saved_pol);
+
+	pr_wr32(pr.eint, PR_EINT_SENS_CLR, bit);
+	pr_wr32(pr.eint, PR_EINT_POL_CLR, bit);
+	pr_wr32(pr.eint, PR_EINT_ACK, bit);
+	pr_wr32(pr.eint, PR_EINT_MASK_CLR, bit);
+	delay(1);
+
+	mask = pr_rd32(pr.eint, PR_EINT_MASK);
+	sens = pr_rd32(pr.eint, PR_EINT_SENS);
+	pol = pr_rd32(pr.eint, PR_EINT_POL);
+	sta = pr_rd32(pr.eint, PR_EINT_STA);
+	printf("RUBY EINT: arm mask=%08x sens=%08x pol=%08x sta=%08x\n",
+	    mask, sens, pol, sta);
+
+	for (i = 0; i < ms; i++) {
+		sta = pr_rd32(pr.eint, PR_EINT_STA);
+		if (sta & bit) {
+			printf("RUBY EINT: t=%ums sta=%08x ack=1\n", i, sta);
+			pr_wr32(pr.eint, PR_EINT_ACK, bit);
+			events++;
+			if (events >= 8)
+				break;
+		}
+		delay(1);
+	}
+
+	pr_wr32(pr.eint, PR_EINT_ACK, bit);
+	if (saved_mask & bit)
+		pr_wr32(pr.eint, PR_EINT_MASK_SET, bit);
+	else
+		pr_wr32(pr.eint, PR_EINT_MASK_CLR, bit);
+	if (saved_sens & bit)
+		pr_wr32(pr.eint, PR_EINT_SENS_SET, bit);
+	else
+		pr_wr32(pr.eint, PR_EINT_SENS_CLR, bit);
+	if (saved_pol & bit)
+		pr_wr32(pr.eint, PR_EINT_POL_SET, bit);
+	else
+		pr_wr32(pr.eint, PR_EINT_POL_CLR, bit);
+	pr_wr32(pr.eint, PR_EINT_ACK, bit);
+	delay(1);
+
+	mask = pr_rd32(pr.eint, PR_EINT_MASK);
+	sens = pr_rd32(pr.eint, PR_EINT_SENS);
+	pol = pr_rd32(pr.eint, PR_EINT_POL);
+	sta = pr_rd32(pr.eint, PR_EINT_STA);
+	printf("RUBY EINT: restore mask=%08x sens=%08x pol=%08x sta=%08x events=%u\n",
+	    mask, sens, pol, sta, events);
+	if ((mask & bit) != (saved_mask & bit) ||
+	    (sens & bit) != (saved_sens & bit) ||
+	    (pol & bit) != (saved_pol & bit))
+		printf("RUBY EINT: restore MISMATCH\n");
+	else
+		printf("RUBY EINT: restore ok\n");
+	return 1;
+}
