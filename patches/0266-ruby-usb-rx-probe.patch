+static void
+ruby_rx_mtr_add(uint16_t ev, uint16_t a, uint32_t b, uint32_t c)
+{
+    uint32_t i = __sync_fetch_and_add(&ruby_rx_mtr_idx, 1) &
+        (RUBY_RX_MTR_SLOTS - 1);
+    struct ruby_rx_mtr *e = &ruby_rx_mtr[i];
+
+    e->t = ruby_ms;
+    e->ev = ev;
+    e->a = a;
+    e->b = b;
+    e->c = c;
+}
+
+static void
+ruby_rx_mtr_dump(void)
+{
+    uint32_t i;
+
+    printf("RUBY USB RXMTR idx=%u desync=%u\n", ruby_rx_mtr_idx,
+        ruby_rx_desync_cnt);
+    for (i = 0; i < RUBY_RX_MTR_SLOTS; i++) {
+        struct ruby_rx_mtr *e = &ruby_rx_mtr[(ruby_rx_mtr_idx + i) &
+            (RUBY_RX_MTR_SLOTS - 1)];
+
+        if (!e->t)
+            continue;
+        printf("RUBY USB RXM[%02u] t=%u ev=%u a=%u b=%08x c=%08x\n",
+            i, e->t, e->ev, e->a, e->b, e->c);
+    }
+}
+
+static void
+ruby_ep2_rx_desync_dump(vm_offset_t mac)
+{
+    uint32_t cur = ruby_ep2_rx_cur_slot(mac);
+
+    ruby_rx_mtr_add(RUBY_RMR_DESYNC, (uint16_t)ruby_rx_deq,
+        cur, ruby_rd32(mac, RQCPR1_OFF));
+    printf("RUBY USB RXDESYNC n=%u deq=%02x cur=%02x pk=%u done=%u "
+        "err=%u rqcsr=%08x rqcpr=%08x rqhiar=%08x rqerr0=%08x "
+        "rqerr1=%08x\n", ruby_rx_desync_cnt, ruby_rx_deq, cur,
+        ruby_rx_packets, ruby_rx_done_events, ruby_rx_errors,
+        ruby_rd32(mac, RQCSR1_OFF), ruby_rd32(mac, RQCPR1_OFF),
+        ruby_rd32(mac, RQHIAR1_OFF), ruby_rd32(mac, RQERRIR0_OFF),
+        ruby_rd32(mac, RQERRIR1_OFF));
+    ruby_ep2_rx_stall_dump(mac);
+    ruby_rx_mtr_dump();
+}
