+extern "C" void
+ruby_ecm_ioeth_en0up(void)
+{
+	thread_t th;
+
+	if (kernel_thread_start((thread_continue_t)&ruby_ecm_en0up_thread,
+	    NULL, &th) == KERN_SUCCESS)
+		thread_deallocate(th);
+}
