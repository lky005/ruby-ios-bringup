+/*
+ * 0202: SOF-advancement watchdog.  A host port disable/enable cycle issues
+ * no bus reset the device can catch (measured: bus_resets frozen through the
+ * disable) and the MAC2 suspend interrupt never fires (suspend=0), so the
+ * device is left detached with its D+ enable bit still set and no event to
+ * recover on -- a physical replug was the only way back.  USB2 SOF is only
+ * delivered to enabled ports, so a frozen frame number while configured
+ * means the host port is gone; re-present the device with a full PHY
+ * re-attach so the host re-detects it when the port is re-enabled.
+ */
+#define RUBY_FRAME_WD_MS 500u           /* SOF frozen this long = port lost */
+
+static void
+ruby_usb_frame_watchdog(vm_offset_t mac)
+{
+    static uint32_t last_frame, last_change_ms, cooldown_until;
+    static int primed;
+    uint32_t frame;
+
+    if (!ruby_cfg_seen || mac == 0) {
+        primed = 0;
+        return;
+    }
+    frame = ruby_rd32(mac, FRAME_NUM_OFF) & 0x7ffu;
+    if (!primed) {
+        primed = 1;
+        last_frame = frame;
+        last_change_ms = ruby_ms;
+        return;
+    }
+    if (frame != last_frame) {
+        last_frame = frame;
+        last_change_ms = ruby_ms;
+        return;
+    }
+    if (ruby_ms < cooldown_until)
+        return;
+    if (ruby_ms - last_change_ms < RUBY_FRAME_WD_MS)
+        return;
+    cooldown_until = ruby_ms + 5000;
+    last_change_ms = ruby_ms;
+    printf("RUBY USB: t=%u SOF frozen %u ms (cfg=1 frame=%u), re-attach\n",
+        ruby_ms, RUBY_FRAME_WD_MS, frame);
+    ruby_usb_reattach_owned(mac, ruby_phy_base);
+    ruby_enum_assist_until = ruby_ms + 15000;
+}
