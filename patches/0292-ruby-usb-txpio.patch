+/*
+ * 0292: CPU PIO TX for EP1 IN.  The FIFO window auto-increments, so every
+ * access uses the same address; 4/2/1-byte stores cover any length.  When
+ * ruby_txpio=1 the TX QMU is never started.
+ */
+static void
+ruby_txpio_send(vm_offset_t mac, const uint8_t *buf, uint32_t len)
+{
+    uint32_t off = 0;
+
+    while (off < len) {
+        uint32_t chunk = len - off;
+        uint32_t i = 0;
+        uint32_t spins, v;
+
+        if (chunk > RUBY_TX_MPS)
+            chunk = RUBY_TX_MPS;
+        while (i + 4u <= chunk) {
+            v = (uint32_t)buf[off + i] |
+                ((uint32_t)buf[off + i + 1u] << 8) |
+                ((uint32_t)buf[off + i + 2u] << 16) |
+                ((uint32_t)buf[off + i + 3u] << 24);
+            *(volatile uint32_t *)(mac + RUBY_TX_FIFO_OFF) = v;
+            i += 4u;
+        }
+        if (chunk - i >= 2u) {
+            *(volatile uint16_t *)(mac + RUBY_TX_FIFO_OFF) =
+                (uint16_t)((uint32_t)buf[off + i] |
+                ((uint32_t)buf[off + i + 1u] << 8));
+            i += 2u;
+        }
+        if (i < chunk)
+            *(volatile uint8_t *)(mac + RUBY_TX_FIFO_OFF) = buf[off + i];
+        ruby_dma_mb();
+        v = ruby_rd32(mac, TX1CSR0_OFF);
+        v &= ~(TX_DMAREQEN | TX_MPSZ_MSK);
+        v |= RUBY_TX_MPS | TX_TXPKTRDY;
+        ruby_wr32(mac, TX1CSR0_OFF, v);
+        /*
+         * TXPKTRDY self-clears when the MAC accepts the packet; FIFOFULL
+         * clears when the packet is fetched.  Bounded wait, then move on.
+         */
+        spins = 0;
+        while (spins++ < 20000u) {
+            v = ruby_rd32(mac, TX1CSR0_OFF);
+            if (!(v & TX_TXPKTRDY) && !(v & TX_FIFOFULL))
+                break;
+        }
+        if (spins > 20000u) {
+            ruby_txpio_timeouts++;
+            if (ruby_txpio_timeouts <= 4 ||
+                (ruby_txpio_timeouts & 0x3fu) == 0)
+                printf("RUBY USB: 0292 txpio timeout n=%u tx0=%08x "
+                    "len=%u\n", ruby_txpio_timeouts,
+                    ruby_rd32(mac, TX1CSR0_OFF), chunk);
+        }
+        ruby_txpio_pkts++;
+        ruby_txpio_bytes += chunk;
+        off += chunk;
+    }
+}
+
+static void
+ruby_txpio_pump(vm_offset_t mac)
+{
+    uint32_t n;
+
+    if (!ruby_acm_cmd || !ruby_bulk_buf[0])
+        return;
+    n = ruby_acm_echo_dequeue(ruby_bulk_buf[0], RUBY_TX_MPS);
+    if (!n)
+        return;
+    ruby_txpio_send(mac, ruby_bulk_buf[0], n);
+}
