  * 0121: replace the bare EP_RST with the vendor/mainline stop/flush/restart
  * sequence.  The trigger conditions are deliberately unchanged.
  */
+/*
+ * 0269: layered TX recovery.  The base layer mirrors mainline
+ * mtu3_qmu_flush + mtu3_qmu_start (stop, flush, clear the ring, restart
+ * from its base).  EP_RST and the deq start stay opt-in because
+ * mainline/U-Boot/LK use neither for runtime recovery.  The trigger runs
+ * from the 1 ms tick -> workloop, so it does not depend on RX traffic.
+ */
+static void
+ruby_ep2_tx_rebuild(vm_offset_t mac)
+{
+    struct ruby_ep *txep;
+    uint64_t pa = ruby_gpd_pa[ruby_gpd_deq % RUBY_GPD_NUM];
+
+    if (ruby_ep2_qmu_stop(mac) != 0) {
+        printf("RUBY USB TXRESET stop timeout\n");
+        return;
+    }
+    if (ruby_txeprst_en) {
+        ruby_wr32(mac, EP_RST_OFF, EP_RST_TX1_BIT);
+        ruby_wr32(mac, EP_RST_OFF, 0);
+        (void)ruby_rd32(mac, EP_RST_OFF);
+    }
+    if (ruby_txdeq_en) {
+        /* Keep the ring; restart from the oldest pending GPD.  The stop
+         * above already flushed bytes the MAC had not sent. */
+        ruby_wr32(mac, TX1CSR0_OFF, 512u | (1u << 29));
+        ruby_wr32(mac, TX1CSR1_OFF, 2u << 8);
+        ruby_wr32(mac, TX1CSR2_OFF, 9u << 16);
+        ruby_wr32(mac, QCR0_OFF, 1u);
+        ruby_wr32(mac, QCR1_OFF,
+            ruby_rd32(mac, QCR1_OFF) | 0x0006000eu);
+        ruby_wr32(mac, TQERRIESR0_OFF,
+            ruby_rd32(mac, TQERRIESR0_OFF) | (1u << 17) | (1u << 1));
+        ruby_wr32(mac, TQSAR1_OFF, (uint32_t)pa);
+        ruby_wr32(mac, TQHIAR1_OFF, (uint32_t)((pa >> 32) & 0xfu));
+        ruby_wr32(mac, TQCSR1_OFF, QMU_Q_START);
+        ruby_ep_ready = 1;
+    } else {
+        /* Mainline-style: drop the ring contents, restart from the base. */
+        ruby_ep2_ring_reset(mac);
+        txep = ruby_ep_for_addr(0x81);
+        if (txep) {
+            lck_spin_lock(&txep->q_lock);
+            txep->q_head = NULL;
+            txep->q_tail = NULL;
+            txep->q_depth = 0;
+            lck_spin_unlock(&txep->q_lock);
+        }
+        (void)ruby_ep2_qmu_start(mac);
+    }
+    ruby_ep2_tx_restarts++;
+    ruby_tx_mtr_add(RUBY_MTR_TX_KICK, RUBY_TX_SRC_RECOVER,
+        ruby_rd32(mac, TQCSR1_OFF), ruby_inflight);
+}
+
+static void
+ruby_tx_reset_fire(vm_offset_t mac)
+{
+    ruby_tx_reset_tries++;
+    ruby_tx_reset_cnt++;
+    ruby_tx_reset_ms = ruby_ms;
+    ruby_tx_mtr_add(RUBY_MTR_TX_RESET, (uint16_t)ruby_gpd_deq,
+        ruby_inflight, ruby_rd32(mac, TX1CSR0_OFF));
+    printf("RUBY USB TXRESET n=%u deq=%u enq=%u inf=%u tx0=%08x "
+        "tqcsr=%08x mode=%u/%u/%u\n", ruby_tx_reset_cnt,
+        ruby_gpd_deq, ruby_gpd_enq, ruby_inflight,
+        ruby_rd32(mac, TX1CSR0_OFF), ruby_rd32(mac, TQCSR1_OFF),
+        ruby_txreset_en, ruby_txeprst_en, ruby_txdeq_en);
+    ruby_ep2_tx_rebuild(mac);
+}
+
+static void
+ruby_tx_recover_poll(vm_offset_t mac)
+{
+    if (!ruby_txreset_en || ruby_inflight == 0)
+        return;
+    if (!(ruby_rd32(mac, TX1CSR0_OFF) & (1u << 25)))
+        return;
+    if ((uint32_t)(ruby_ms - ruby_tx_progress_ms) < 200)
+        return;
+    if ((uint32_t)(ruby_ms - ruby_tx_reset_ms) < 1000)
+        return;
+    if (ruby_tx_reset_tries >= 5)
+        return;
+    if (ruby_qmu_irq_mode) {
+        ruby_qmu_txrecover_req = 1;
+        ruby_usb_irq_kick();
+    } else {
+        ruby_tx_reset_fire(mac);
+    }
+}
