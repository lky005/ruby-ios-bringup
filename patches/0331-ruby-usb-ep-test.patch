diff --git a/bsd/dev/ruby_usb_ep_test.c b/bsd/dev/ruby_usb_ep_test.c
new file mode 100644
index 0000000..b834efc
--- /dev/null
+++ b/bsd/dev/ruby_usb_ep_test.c
@@ -0,0 +1,326 @@
+/*
+ * 0331: EP0 0x2E test channel.
+ *
+ * Gate: rubyep_test=1 (default 0).  The host writes "t331 <cmd>" through
+ * the EP0 command runner and reads the 16-word mailbox through the
+ * vendor IN request 0xC0/0x31.  Commands only exercise the existing
+ * EP1 QMU data path and the configuration layer; no new data-plane
+ * behavior is added when the gate is off.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+
+#include "ruby_hal.h"
+#include "ruby_usb_mac.h"
+#include "ruby_usb_ep.h"
+#include "ruby_usb_io.h"
+#include "ruby_usb_qmu.h"
+#include "ruby_usb_config.h"
+#include "ruby_usb_gadget.h"
+#include "ruby_usb_ep_test.h"
+
+int ruby_ep_test_on;
+
+extern uint32_t ruby_inflight;
+extern uint32_t ruby_gpd_enq;
+extern uint32_t ruby_gpd_deq;
+extern volatile uint32_t ruby_ep_ready;
+extern volatile uint32_t ruby_rx_ready;
+extern uint32_t ruby_rx_packets;
+extern uint32_t ruby_rx_bytes;
+extern uint32_t ruby_rx_errors;
+extern uint32_t ruby_rx_crc;
+extern uint32_t ruby_rx_zlp;
+extern uint32_t ruby_rx_deq;
+extern int ruby_echo_en;
+extern int ruby_qmu_irq_mode;
+extern int ruby_usb_irq_kick(void);
+
+#define RUBY_EP_TEST_BUF 16384u
+static uint32_t ruby_ep_test_box[16];
+static uint32_t ruby_ep_test_seq;
+static uint8_t ruby_ep_test_buf[RUBY_EP_TEST_BUF];
+
+static uint32_t
+t331_fill(uint32_t code, uint32_t status)
+{
+    ruby_ep_test_seq++;
+    ruby_ep_test_box[0] = RUBY_EP_TEST_MAGIC;
+    ruby_ep_test_box[1] = ruby_ep_test_seq;
+    ruby_ep_test_box[2] = code;
+    ruby_ep_test_box[3] = status;
+    return ruby_ep_test_seq;
+}
+
+static void
+t331_put(uint32_t idx, uint32_t v)
+{
+    if (idx < 16)
+        ruby_ep_test_box[idx] = v;
+}
+
+static const char *
+t331_skip(const char *p)
+{
+    while (*p == ' ' || *p == '\t')
+        p++;
+    return p;
+}
+
+static int
+t331_u32(const char **pp, uint32_t *out)
+{
+    const char *p = t331_skip(*pp);
+    uint32_t v = 0;
+    int n = 0;
+
+    while (*p >= '0' && *p <= '9') {
+        v = v * 10u + (uint32_t)(*p - '0');
+        p++;
+        n++;
+        if (n > 9)
+            return -1;
+    }
+    if (!n)
+        return -1;
+    *out = v;
+    *pp = p;
+    return 0;
+}
+
+static int
+t331_pref(const char *p, const char *w)
+{
+    while (*w) {
+        if (*p != *w)
+            return 0;
+        p++;
+        w++;
+    }
+    return 1;
+}
+
+static int
+t331_word(const char *p, const char *w)
+{
+    while (*w) {
+        if (*p != *w)
+            return 0;
+        p++;
+        w++;
+    }
+    return *p == '\0' || *p == ' ' || *p == '\t';
+}
+
+void
+ruby_ep_test_init(void)
+{
+    int on = 0;
+
+    PE_parse_boot_argn("rubyep_test", &on, sizeof(on));
+    ruby_ep_test_on = (on == 1);
+    printf("RUBY EP TEST: 0331 channel %s (rubyep_test=%d)\n",
+        ruby_ep_test_on ? "on" : "off", on);
+}
+
+static void
+t331_caps(vm_offset_t mac)
+{
+    uint32_t n = 0, i, w = 4;
+
+    t331_fill(RUBY_EP_TEST_CAPS, 0);
+    t331_put(4, ruby_usb_cfg_cap[0]);
+    t331_put(5, ruby_usb_cfg_cap[1]);
+    t331_put(6, ruby_usb_cfg_cap[2]);
+    t331_put(7, ruby_usb_cfg_cap[3]);
+    for (i = 0; i < RUBY_EP_MAX && w + 1 < 16; i++) {
+        if (!ruby_eps[i].valid)
+            continue;
+        t331_put(w++, ((uint32_t)ruby_eps[i].addr << 16) | ruby_eps[i].mps);
+        n++;
+    }
+    t331_put(3, 0);
+    t331_put(8, n);
+    printf("RUBY EP TEST: 0331 caps ep=%u caps=%u/%u/%u/%u\n", n,
+        ruby_rd32(mac, CAP_EP0FFSZ_OFF), ruby_rd32(mac, CAP_EPNTXFFSZ_OFF),
+        ruby_rd32(mac, CAP_EPNRXFFSZ_OFF), ruby_rd32(mac, CAP_EPINFO_OFF));
+}
+
+static void
+t331_stat(vm_offset_t mac)
+{
+    t331_fill(RUBY_EP_TEST_STAT, 0);
+    t331_put(4, (uint32_t)ruby_ep_ready | ((uint32_t)ruby_rx_ready << 1) |
+        ((uint32_t)ruby_inflight << 8));
+    t331_put(5, ruby_rx_packets);
+    t331_put(6, ruby_rx_bytes);
+    t331_put(7, ruby_rx_errors | (ruby_rx_zlp << 16));
+    t331_put(8, ruby_gpd_enq | (ruby_gpd_deq << 16));
+    t331_put(9, ruby_rd32(mac, TQCSR1_OFF));
+    t331_put(10, ruby_rd32(mac, RQCSR1_OFF));
+    t331_put(11, ruby_ep2_cur_slot(mac) |
+        (ruby_ep2_rx_cur_slot(mac) << 8) | (ruby_rx_deq << 16));
+    t331_put(12, ruby_rx_crc);
+}
+
+static void
+t331_conf(vm_offset_t mac, const char *p)
+{
+    uint32_t ring, inf, gpd;
+    int status = 0;
+
+    if (t331_u32(&p, &ring) || t331_u32(&p, &inf) || t331_u32(&p, &gpd)) {
+        t331_fill(RUBY_EP_TEST_CONF, 22);
+        return;
+    }
+    if (ring < 8u || ring > RUBY_GPD_NUM || inf < 1u || inf >= ring ||
+        gpd < 64u || gpd > 16384u || (gpd % 512u) != 0) {
+        t331_fill(RUBY_EP_TEST_CONF, 22);
+        printf("RUBY EP TEST: 0331 conf reject %u/%u/%u\n", ring, inf, gpd);
+        return;
+    }
+    if (ruby_inflight != 0) {
+        t331_fill(RUBY_EP_TEST_CONF, 16);
+        printf("RUBY EP TEST: 0331 conf busy inf=%u\n", ruby_inflight);
+        return;
+    }
+    if (ruby_ep2_qmu_stop(mac) != 0) {
+        t331_fill(RUBY_EP_TEST_CONF, 5);
+        return;
+    }
+    ruby_tx_ring_n = ring;
+    ruby_inflight_max = inf;
+    ruby_tx_gpd_len = gpd;
+    ruby_ep2_ring_reset(mac);
+    if (ruby_ep2_qmu_prepare(mac) != 0)
+        status = 5;
+    t331_fill(RUBY_EP_TEST_CONF, (uint32_t)status);
+    printf("RUBY EP TEST: 0331 conf %u/%u/%u status=%d\n",
+        ring, inf, gpd, status);
+}
+
+static void
+t331_queue(vm_offset_t mac, const char *p)
+{
+    uint32_t len, i, n;
+
+    if (t331_u32(&p, &len) || len == 0 || len > RUBY_EP_TEST_BUF) {
+        t331_fill(RUBY_EP_TEST_QUEUE, 22);
+        return;
+    }
+    for (i = 0; i < len; i++)
+        ruby_ep_test_buf[i] = (uint8_t)(i & 0xffu);
+    n = ruby_ep2_data_enqueue(ruby_ep_test_buf, len);
+    if (ruby_qmu_irq_mode)
+        ruby_usb_irq_kick();
+    else
+        ruby_ep2_push_log(mac);
+    t331_fill(RUBY_EP_TEST_QUEUE, n);
+}
+
+static void
+t331_drain(vm_offset_t mac, const char *p)
+{
+    uint32_t ms = 2000u, t0, spins = 0;
+
+    (void)t331_u32(&p, &ms);
+    if (ms > 10000u)
+        ms = 10000u;
+    t0 = ruby_ms;
+    while (ruby_inflight != 0 && (uint32_t)(ruby_ms - t0) < ms) {
+        delay(1000);
+        spins++;
+    }
+    t331_fill(RUBY_EP_TEST_DRAIN,
+        (ruby_inflight == 0) ? 0u : 110u);
+    t331_put(4, ruby_inflight);
+    t331_put(5, spins);
+    (void)mac;
+}
+
+int
+ruby_ep_test_cmd(vm_offset_t mac, char *line)
+{
+    const char *p;
+
+    if (!ruby_ep_test_on)
+        return 0;
+    if (!(line[0] == 't' && line[1] == '3' && line[2] == '3' &&
+        line[3] == '1' && (line[4] == ' ' || line[4] == '\t' ||
+        line[4] == '\0')))
+        return 0;
+    p = t331_skip(line + 4);
+
+    if (t331_word(p, "caps")) {
+        t331_caps(mac);
+    } else if (t331_word(p, "stat")) {
+        t331_stat(mac);
+    } else if (t331_word(p, "resetcrc")) {
+        ruby_rx_crc = 2166136261u;
+        ruby_rx_packets = 0;
+        ruby_rx_bytes = 0;
+        ruby_rx_errors = 0;
+        ruby_rx_zlp = 0;
+        t331_fill(RUBY_EP_TEST_RESCRC, 0);
+    } else if (t331_word(p, "crc")) {
+        t331_fill(RUBY_EP_TEST_CRC, 0);
+        t331_put(4, ruby_rx_crc);
+        t331_put(5, ruby_rx_packets);
+        t331_put(6, ruby_rx_bytes);
+        t331_put(7, ruby_rx_errors);
+    } else if (t331_pref(p, "conf ")) {
+        t331_conf(mac, p + 5);
+    } else if (t331_pref(p, "queue ")) {
+        t331_queue(mac, p + 6);
+    } else if (t331_word(p, "drain")) {
+        t331_drain(mac, p + 5);
+    } else if (t331_word(p, "halt")) {
+        ruby_tx_halt_clear(mac);
+        t331_fill(RUBY_EP_TEST_HALT, 0);
+    } else if (t331_word(p, "clear")) {
+        ruby_tx_halt_clear(mac);
+        t331_fill(RUBY_EP_TEST_CLEAR, 0);
+    } else if (t331_word(p, "stop")) {
+        t331_fill(RUBY_EP_TEST_STOP,
+            (ruby_ep2_qmu_stop(mac) == 0) ? 0u : 5u);
+    } else if (t331_word(p, "start")) {
+        t331_fill(RUBY_EP_TEST_START,
+            (ruby_ep2_qmu_prepare(mac) == 0) ? 0u : 5u);
+    } else if (t331_word(p, "rxreset")) {
+        ruby_ep2_rx_reset(mac, 1);
+        t331_fill(RUBY_EP_TEST_RXRESET, 0);
+    } else if (t331_pref(p, "owner ")) {
+        const char *q = t331_skip(p + 6);
+        if (t331_word(q, "echo")) {
+            ruby_usb_io_force_echo();
+            t331_fill(RUBY_EP_TEST_OWNER, 0);
+        } else if (t331_word(q, "tty")) {
+            ruby_usb_io_force_owner(RUBY_USB_IO_TTY);
+            t331_fill(RUBY_EP_TEST_OWNER, 1);
+        } else if (t331_word(q, "raw")) {
+            ruby_usb_io_force_owner(RUBY_USB_IO_RAW);
+            t331_fill(RUBY_EP_TEST_OWNER, 2);
+        } else {
+            t331_fill(RUBY_EP_TEST_OWNER, 22);
+        }
+    } else {
+        t331_fill(0, 22);
+        printf("RUBY EP TEST: 0331 usage: t331 caps|stat|resetcrc|"
+            "crc|conf r i g|queue n|drain ms|halt|clear|stop|start|"
+            "rxreset|owner echo|tty|raw\n");
+    }
+    return 1;
+}
+
+void
+ruby_ep_test_vendor_read(vm_offset_t mac, uint32_t t, uint32_t wlen)
+{
+    ruby_ep0_send(mac, t, 0x31, (const uint8_t *)ruby_ep_test_box,
+        sizeof(ruby_ep_test_box), wlen);
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
