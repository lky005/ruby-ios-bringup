diff --git a/bsd/dev/ruby_usb_ep_test.h b/bsd/dev/ruby_usb_ep_test.h
new file mode 100644
index 0000000..c9adc5c
--- /dev/null
+++ b/bsd/dev/ruby_usb_ep_test.h
@@ -0,0 +1,37 @@
+#ifndef _RUBY_USB_EP_TEST_H_
+#define _RUBY_USB_EP_TEST_H_
+
+#include <mach/vm_types.h>
+#include <sys/types.h>
+
+/*
+ * 0331: EP0 0x2E test channel (rubyep_test=1, default off).
+ *
+ * The host sends "t331 <cmd> ..." over 0x40/0x2E and reads the 16-word
+ * mailbox over 0xC0/0x31.  The channel only drives breakout tests; with
+ * the 0328 cmdline it stays compiled in but inert.
+ */
+#define RUBY_EP_TEST_MAGIC 0x31333354u  /* "T331" little-endian */
+
+/* command codes echoed in mailbox word 2 */
+#define RUBY_EP_TEST_CAPS   1
+#define RUBY_EP_TEST_STAT   2
+#define RUBY_EP_TEST_CONF   3
+#define RUBY_EP_TEST_QUEUE  4
+#define RUBY_EP_TEST_HALT   5
+#define RUBY_EP_TEST_CLEAR  6
+#define RUBY_EP_TEST_STOP   7
+#define RUBY_EP_TEST_START  8
+#define RUBY_EP_TEST_CRC    9
+#define RUBY_EP_TEST_RESCRC 10
+#define RUBY_EP_TEST_DRAIN  11
+#define RUBY_EP_TEST_OWNER  12
+#define RUBY_EP_TEST_RXRESET 13
+
+extern int ruby_ep_test_on;
+
+void ruby_ep_test_init(void);
+int  ruby_ep_test_cmd(vm_offset_t mac, char *line);
+void ruby_ep_test_vendor_read(vm_offset_t mac, uint32_t t, uint32_t wlen);
+
+#endif /* _RUBY_USB_EP_TEST_H_ */
