+/* ==================== P3.2 user client device layer ==================== */
+
+#define RUBYGPU_UC_MAX_BO        32      /* legacy boot-arg floor */
+#define RUBYGPU_UC_MAX_BO_INIT   64
+#define RUBYGPU_UC_MAX_BO_CAP    4096
+#define RUBYGPU_UC_MAX_VM        8
+#define RUBYGPU_UC_VM_CHUNK_PAGES 64
+#define RUBYGPU_UC_VM_FIRST_PAGES 16
+#define RUBYGPU_UC_MAX_VM_CHUNKS 32
+#define RUBYGPU_UC_VM_PAGES_DEFAULT 1024
+#define RUBYGPU_UC_VM_PAGES_MIN  16
+#define RUBYGPU_UC_MAX_CLIENTS   8
+#define RUBYGPU_UC_BO_MAX        (64ULL << 20)
+#define RUBYGPU_UC_BO_TOTAL_MB_DEFAULT 1024
+#define RUBYGPU_UC_VA_MIN        0x10000000ULL
+#define RUBYGPU_UC_VA_LIMIT      (1ULL << 36)
+#define RUBYGPU_UC_BO_RETRIES    8
+
+#define RUBYGPU_PTE_TABLE        ((1ULL << 10) | 3ULL)
+#define RUBYGPU_ATE_PAGE         ((5ULL << 2) | (1ULL << 6) | (2ULL << 8) | \
+                                  (1ULL << 10) | 3ULL)
+#define RUBYGPU_PA_MASK          0xFFFFFFF000ULL
+
+struct ruby_gpu_bo_slot {
+	IOMemoryDescriptor     *md;
+	SweetSurface             *surface;       /* set for imported surfaces */
+	uint64_t                 size;
+	uint32_t                 flags;
+	uint32_t                 owner;
+	bool                     used;
+	bool                     prepared;
+};
+
+struct ruby_gpu_vm_chunk {
+	IOBufferMemoryDescriptor *md;
+	uint64_t                 phys;
+	uint8_t                 *va;
+	uint32_t                 page_base;
+	uint32_t                 pages;
+	uint32_t                 cap_pages;
+};
+
+struct ruby_gpu_vm_slot {
+	bool                     used;
+	uint32_t                 owner;
+	struct ruby_gpu_vm_chunk chunks[RUBYGPU_UC_MAX_VM_CHUNKS];
+	uint32_t                 nchunks;
+	uint32_t                 pool_pages;
+	uint64_t                 root_phys;
+	uint64_t                 va_start;
+	uint64_t                 va_size;
+};
+
+static ruby_gpu_bo_slot **s_uc_bo;
+static uint32_t s_uc_bo_cap;
+static uint32_t s_uc_bo_count;
+static uint64_t s_uc_bo_bytes;
+static ruby_gpu_vm_slot s_uc_vm[RUBYGPU_UC_MAX_VM];
+static IOLock *s_uc_lock;
+static RubyGPU *s_uc_service;
+static uint32_t s_uc_clients;
+static uint32_t s_uc_client_seq;
+static uint64_t s_uc_active_pgd;
+static int s_uc_cfg_multi = -1;
+static uint32_t s_uc_cfg_bo_max;
+static uint32_t s_uc_cfg_vm_pages;
+static uint64_t s_uc_cfg_bo_total;
+static int s_uc_cfg_vm_legacy;
+
+static IOLock *
+ruby_gpu_uc_lock(void)
+{
+	if (s_uc_lock == NULL) {
+		s_uc_lock = IOLockAlloc();
+	}
+	return s_uc_lock;
+}
+
+static bool
+ruby_gpu_drv_diag(void)
+{
+	static int state = -1;
+	static uint32_t lines;
+
+	if (state < 0) {
+		int on = 0;
+		PE_parse_boot_argn("rubygpudiag", &on, sizeof(on));
+		state = (on != 0) ? 1 : 0;
+	}
+	if (state == 0 || lines >= 200) {
+		return false;
+	}
+	lines++;
+	return true;
+}
+
+/* Caller holds s_uc_lock.  Defaults: 512 BO, 1024 PTE pages, multi-client on. */
+static void
+ruby_gpu_uc_config(void)
+{
+	int multi = 1;
+	int bo_max = 512;
+	int vm_pages = RUBYGPU_UC_VM_PAGES_DEFAULT;
+	int bo_total_mb = RUBYGPU_UC_BO_TOTAL_MB_DEFAULT;
+	int vm_legacy = 0;
+
+	if (s_uc_cfg_multi >= 0) {
+		return;
+	}
+	PE_parse_boot_argn("rubygpumulti", &multi, sizeof(multi));
+	PE_parse_boot_argn("rubygpubomax", &bo_max, sizeof(bo_max));
+	PE_parse_boot_argn("rubygpuvmpages", &vm_pages, sizeof(vm_pages));
+	PE_parse_boot_argn("rubygpubototalmb", &bo_total_mb, sizeof(bo_total_mb));
+	PE_parse_boot_argn("rubygpuvmlegacy", &vm_legacy, sizeof(vm_legacy));
+	if (bo_max < RUBYGPU_UC_MAX_BO) {
+		bo_max = RUBYGPU_UC_MAX_BO;
+	}
+	if (bo_max > RUBYGPU_UC_MAX_BO_CAP) {
+		bo_max = RUBYGPU_UC_MAX_BO_CAP;
+	}
+	if (vm_pages < RUBYGPU_UC_VM_PAGES_MIN) {
+		vm_pages = RUBYGPU_UC_VM_PAGES_MIN;
+	}
+	if (vm_pages > RUBYGPU_UC_MAX_VM_CHUNKS * RUBYGPU_UC_VM_CHUNK_PAGES) {
+		vm_pages = RUBYGPU_UC_MAX_VM_CHUNKS * RUBYGPU_UC_VM_CHUNK_PAGES;
+	}
+	if (bo_total_mb < 64) {
+		bo_total_mb = 64;
+	}
+	if (bo_total_mb > 4096) {
+		bo_total_mb = 4096;
+	}
+	s_uc_cfg_multi = (multi != 0) ? 1 : 0;
+	s_uc_cfg_vm_legacy = (vm_legacy != 0) ? 1 : 0;
+	s_uc_cfg_bo_max = (uint32_t)bo_max;
+	s_uc_cfg_vm_pages = (uint32_t)vm_pages;
+	s_uc_cfg_bo_total = (uint64_t)bo_total_mb << 20;
+}
