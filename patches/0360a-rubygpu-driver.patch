diff --git a/iokit/Kernel/arm/RubyGPUIRQ.cpp b/iokit/Kernel/arm/RubyGPUIRQ.cpp
new file mode 100644
index 0000000..1339d70
--- /dev/null
+++ b/iokit/Kernel/arm/RubyGPUIRQ.cpp
@@ -0,0 +1,199 @@
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOInterruptEventSource.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOWorkLoop.h>
+#include <kern/kern_types.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSSymbol.h>
+#include <kern/clock.h>
+#include <mach/mach_time.h>
+
+#include "../../../bsd/dev/ruby_gic.h"
+
+#include "RubyGPUIRQ.h"
+#include "RubyGPUInternal.h"
+
+
+OSDefineMetaClassAndStructors(RubyGPUIRQ, IOService);
+
+bool
+RubyGPUIRQ::init(OSDictionary *dictionary)
+{
+	fWorkLoop = NULL;
+	fIRQ = NULL;
+	fLock = IOLockAlloc();
+	fDone = false;
+	fStatus = fRaw = fJs = fAsf = fGirq = fMirq = 0;
+	fHits = fSpurious = 0;
+	fSlot = 0;
+	if (fLock == NULL) {
+		return false;
+	}
+	return IOService::init(dictionary);
+}
+
+bool
+RubyGPUIRQ::publishInterruptSource(void)
+{
+	OSArray *controllers;
+	OSArray *specifiers;
+	OSSymbol *name;
+	OSData *data;
+	struct ruby_gic_spec spec = {
+		.intid = SWEET_P2C_C2_JOB_INTID,
+		.flags = RUBY_GIC_LEVEL,
+	};
+	bool ok;
+
+	controllers = OSArray::withCapacity(1);
+	specifiers = OSArray::withCapacity(1);
+	name = (OSSymbol *)OSSymbol::withCStringNoCopy("RubyGIC");
+	data = OSData::withBytes(&spec, sizeof(spec));
+	ok = controllers != NULL && specifiers != NULL && name != NULL &&
+	    data != NULL &&
+	    controllers->setObject(name) && specifiers->setObject(data) &&
+	    setProperty("IOInterruptControllers", controllers) &&
+	    setProperty("IOInterruptSpecifiers", specifiers);
+	OSSafeReleaseNULL(controllers);
+	OSSafeReleaseNULL(specifiers);
+	OSSafeReleaseNULL(name);
+	OSSafeReleaseNULL(data);
+	return ok;
+}
+
+bool
+RubyGPUIRQ::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	fWorkLoop = getWorkLoop();
+	if (fWorkLoop == NULL) {
+		return false;
+	}
+	fWorkLoop->retain();
+	if (!publishInterruptSource()) {
+		return false;
+	}
+	fIRQ = IOInterruptEventSource::interruptEventSource(this,
+	    &RubyGPUIRQ::irqAction, this, 0);
+	if (fIRQ == NULL ||
+	    fWorkLoop->addEventSource(fIRQ) != kIOReturnSuccess) {
+		return false;
+	}
+	fIRQ->disable();
+	IOLog("SWEET GPU: C2 irq ready intid=%u (SPI455 JOB, level)\n",
+	    SWEET_P2C_C2_JOB_INTID);
+	return true;
+}
+
+void
+RubyGPUIRQ::free(void)
+{
+	if (fIRQ != NULL) {
+		fIRQ->disable();
+		if (fWorkLoop != NULL) {
+			fWorkLoop->removeEventSource(fIRQ);
+		}
+		OSSafeReleaseNULL(fIRQ);
+		fIRQ = NULL;
+	}
+	if (fWorkLoop != NULL) {
+		fWorkLoop->release();
+		fWorkLoop = NULL;
+	}
+	if (fLock != NULL) {
+		IOLockFree(fLock);
+		fLock = NULL;
+	}
+	IOService::free();
+}
+
+void
+RubyGPUIRQ::setSlot(uint32_t slot)
+{
+	if (slot < 3) {
+		fSlot = slot;
+	}
+}
+
+int
+RubyGPUIRQ::setEnabled(int on)
+{
+	if (fIRQ == NULL) {
+		return -1;
+	}
+	if (on) {
+		fIRQ->enable();
+	} else {
+		fIRQ->disable();
+	}
+	return 0;
+}
+
+int
+RubyGPUIRQ::waitDone(uint32_t ms)
+{
+	AbsoluteTime deadline;
+	int err = THREAD_TIMED_OUT;
+
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	IOLockLock(fLock);
+	while (!fDone) {
+		err = IOLockSleepDeadline(fLock, (void *)&fDone, deadline,
+		    THREAD_UNINT);
+		if (err != THREAD_AWAKENED) {
+			break;
+		}
+	}
+	IOLockUnlock(fLock);
+	return fDone ? 0 : 1;
+}
+
+void
+RubyGPUIRQ::irqAction(OSObject *owner, IOInterruptEventSource *sender,
+    int count)
+{
+	RubyGPUIRQ *self = (RubyGPUIRQ *)owner;
+	volatile uint32_t *gpu = sweet_gpu_regs;
+	uint32_t status, raw, js, asf, girq, mirq, slot, mask;
+
+	(void)sender;
+	(void)count;
+	self->fHits++;
+	if (gpu == NULL) {
+		return;
+	}
+	slot = self->fSlot;
+	mask = SWEET_P2C_JOB_SLOT_MASK(slot);
+	status = sweet_pwr_rd(gpu, SWEET_P2C_JOBIRQ_BASE +
+	    SWEET_P2C_JOBIRQ_STATUS);
+	if ((status & mask) == 0) {
+		self->fSpurious++;
+		return;
+	}
+	raw = sweet_pwr_rd(gpu, SWEET_P2C_JOBIRQ_BASE +
+	    SWEET_P2C_JOBIRQ_RAWSTAT);
+	js = sweet_pwr_rd(gpu, SWEET_P2C_JS_SLOT(slot) + 0x24);
+	asf = sweet_pwr_rd(gpu, SWEET_P2C_AS_BASE + 0x1c);
+	girq = sweet_pwr_rd(gpu, SWEET_P2C_GPUIRQ_RAWSTAT);
+	mirq = sweet_pwr_rd(gpu, SWEET_P2C_MMUIRQ_BASE +
+	    SWEET_P2C_MMUIRQ_RAWSTAT);
+	sweet_pwr_wr(gpu, SWEET_P2C_JOBIRQ_BASE + SWEET_P2C_JOBIRQ_CLEAR,
+	    status & mask);
+	IOLog("SWEET GPU: C2 irq slot=%u status=0x%08x raw=0x%08x "
+	    "js=0x%08x as=0x%08x girq=0x%08x mirq=0x%08x hits=%u\n",
+	    slot, status, raw, js, asf, girq, mirq, self->fHits);
+	IOLockLock(self->fLock);
+	self->fStatus = status;
+	self->fRaw = raw;
+	self->fJs = js;
+	self->fAsf = asf;
+	self->fGirq = girq;
+	self->fMirq = mirq;
+	self->fDone = true;
+	IOLockWakeup(self->fLock, (void *)&self->fDone, false);
+	IOLockUnlock(self->fLock);
+}
diff --git a/iokit/Kernel/arm/RubyGPUIRQ.h b/iokit/Kernel/arm/RubyGPUIRQ.h
new file mode 100644
index 0000000..8c5d226
--- /dev/null
+++ b/iokit/Kernel/arm/RubyGPUIRQ.h
@@ -0,0 +1,50 @@
+#ifndef _RUBYGPUIRQ_H
+#define _RUBYGPUIRQ_H
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOInterruptEventSource.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOWorkLoop.h>
+#include <libkern/c++/OSObject.h>
+
+/*
+ * C2 interrupt client: RubyGIC level source INTID487 (SPI455, Mali JOB).
+ * The "RubyGIC" interrupt-controller property is published on this service
+ * itself, so registerInterrupt(index 0) resolves to RubyGIC the same way as
+ * SweetKPD and RubyUSBIntService. The primary handler only masks the level
+ * line and signals the workloop; the action clears JOB_IRQ and wakes the
+ * waiter.
+ */
+class RubyGPUIRQ : public IOService {
+	OSDeclareDefaultStructors(RubyGPUIRQ);
+
+	IOWorkLoop             *fWorkLoop;
+	IOInterruptEventSource *fIRQ;
+	IOLock                 *fLock;
+
+	static void irqAction(OSObject *owner, IOInterruptEventSource *sender,
+	    int count);
+	bool publishInterruptSource(void);
+
+public:
+	volatile bool     fDone;
+	volatile uint32_t fStatus;
+	volatile uint32_t fSlot;
+	volatile uint32_t fRaw;
+	volatile uint32_t fJs;
+	volatile uint32_t fAsf;
+	volatile uint32_t fGirq;
+	volatile uint32_t fMirq;
+	volatile uint32_t fHits;
+	volatile uint32_t fSpurious;
+
+	bool init(OSDictionary *dictionary = NULL) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+	void setSlot(uint32_t slot);
+	int setEnabled(int on);
+	int waitDone(uint32_t ms);
+};
+
+#endif /* _RUBYGPUIRQ_H */
diff --git a/iokit/Kernel/arm/RubyGPUInternal.h b/iokit/Kernel/arm/RubyGPUInternal.h
new file mode 100644
index 0000000..a25901c
--- /dev/null
+++ b/iokit/Kernel/arm/RubyGPUInternal.h
@@ -0,0 +1,41 @@
+#ifndef _RUBYGPU_INTERNAL_H
+#define _RUBYGPU_INTERNAL_H
+
+#include <IOKit/IOTypes.h>
+
+extern volatile uint32_t *sweet_gpu_regs;
+
+uint32_t sweet_pwr_rd(volatile uint32_t *base, uint32_t off);
+void sweet_pwr_wr(volatile uint32_t *base, uint32_t off, uint32_t val);
+
+#define SWEET_P2C_VA           0x10000000ULL
+#define SWEET_P2C_TARGET_OFF   0x100u
+#define SWEET_P2C_MEM_SIZE     0x5000u
+#define SWEET_P2C_PAGE_SIZE    0x1000u
+#define SWEET_P2C_DATA_OFF     0x4000u
+#define SWEET_P2C_AS_BASE      0x2400u
+#define SWEET_P2C_JS_BASE      0x1800u
+#define SWEET_P2C_JOBIRQ_BASE      0x1000u
+#define SWEET_P2C_JOBIRQ_RAWSTAT   0x0000u
+#define SWEET_P2C_JOBIRQ_CLEAR     0x0004u
+#define SWEET_P2C_JOBIRQ_MASK      0x0008u
+#define SWEET_P2C_JOBIRQ_STATUS    0x000cu
+#define SWEET_P2C_GPUIRQ_RAWSTAT   0x0020u
+#define SWEET_P2C_GPUIRQ_CLEAR     0x0024u
+#define SWEET_P2C_GPUIRQ_MASK      0x0028u
+#define SWEET_P2C_MMUIRQ_BASE      0x2000u
+#define SWEET_P2C_MMUIRQ_RAWSTAT   0x0000u
+#define SWEET_P2C_MMUIRQ_CLEAR     0x0004u
+#define SWEET_P2C_MMUIRQ_MASK      0x0008u
+#define SWEET_P2C_JOB_DONE_MASK    ((1u << 0) | (1u << 16))
+#define SWEET_P2C_JS_SLOT(n)       (SWEET_P2C_JS_BASE + ((n) * 0x80u))
+#define SWEET_P2C_JOB_DONE_BIT(n)  (1u << (n))
+#define SWEET_P2C_JOB_FAIL_BIT(n)  (1u << (16u + (n)))
+#define SWEET_P2C_JOB_SLOT_MASK(n) (SWEET_P2C_JOB_DONE_BIT(n) | \
+    SWEET_P2C_JOB_FAIL_BIT(n))
+#define SWEET_P2C_C2_JOB_INTID     487u  /* DTS SPI455 + 32 */
+#define SWEET_P2C_C2_WAIT_MS       1000u
+#define SWEET_P2C_CFG_STD      0x00083300u
+#define SWEET_P2C_CFG_ALT      (SWEET_P2C_CFG_STD | (1u << 10) | (1u << 11))
+
+#endif /* _RUBYGPU_INTERNAL_H */
