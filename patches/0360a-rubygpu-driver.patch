+/*
+ * SweetGPUProbe: one-shot read-only Mali/mfgcfg/SPM/INFRA/TOPCKGEN/PLL dump
+ * plus MT6359P BUCK/LDO readback over pwrap (P2a, CL-0352 rev).
+ * Enabled by bootarg rubygpuprobe=1 for the read-only probe, and by
+ * rubygpupwr=1 (v1 minimal) or rubygpupwr=2 (v2 full JM wake) for the
+ * power path below.
+ * The probe path performs no writes; the power path writes only SPM PWR_CON
+ * for MFG2..5 and mfgcfg 0xB0/0x20/0xB4/0x170, no PMIC/PLL/mux writes.
+ * The pwrap command/clear registers are used only to issue PMIC reads.
+ */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOInterruptEventSource.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOWorkLoop.h>
+#include <kern/kern_types.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSString.h>
+#include <libkern/c++/OSSymbol.h>
+#include <pexpert/pexpert.h>
+#include <machine/machine_routines.h>
+#include <kern/clock.h>
+#include <kern/task.h>
+#include <mach/mach_time.h>
+#include "RubyGPU.h"
+#include "RubyGPUIRQ.h"
+#include "RubyGPUInternal.h"
+#include "RubyGPUUserClient.h"
+#include "SweetSurface.h"
+
+extern "C" vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern "C" void flush_dcache(vm_offset_t, unsigned int, boolean_t);
+
+#define SWEET_GPU_PA     0x13000000UL
+#define SWEET_GPU_SIZE   0x4000
+#define SWEET_MFG_PA     0x13fbf000UL
+#define SWEET_MFG_SIZE   0x1000
+#define SWEET_SPM_PA     0x10006000UL
+#define SWEET_SPM_SIZE   0x1000
+#define SWEET_TOP_PA     0x10000000UL
+#define SWEET_TOP_SIZE   0x1000
+#define SWEET_IFRAO_PA   0x10001000UL
+#define SWEET_IFRAO_SIZE 0x1000
+#define SWEET_MFGAO_PA   0x13fa0000UL
+#define SWEET_MFGAO_SIZE 0x1000
+#define SWEET_PWRAP_PA   0x10026000UL
+#define SWEET_PWRAP_SIZE 0x1000
+
+#define PR_PWRAP_INIT_DONE    0x000u
+#define PR_PWRAP_SWINF_ACC    0x880u
+#define PR_PWRAP_SWINF_WDATA  0x884u
+#define PR_PWRAP_SWINF_RDATA  0x894u
+#define PR_PWRAP_SWINF_VLDCLR 0x8a4u
+#define PR_PWRAP_SWINF_STA    0x8a8u
+#define PR_SWINF_FSM(v)       (((v) >> 1) & 7u)
+#define PR_SWINF_INIT_DONE    (1u << 15)
+
+volatile uint32_t *sweet_gpu_regs;
+static volatile uint32_t *sweet_mfg_regs;
+static volatile uint32_t *sweet_spm_regs;
+static volatile uint32_t *sweet_top_regs;
+static volatile uint32_t *sweet_ifrao_regs;
+static volatile uint32_t *sweet_mfgao_regs;
+static volatile uint32_t *sweet_pwrap_regs;
+static bool sweet_gpu_done;
+
+static void
+sweet_show(volatile uint32_t *base, const char *name, uint32_t off)
+{
+	uint32_t val = *(volatile uint32_t *)((uintptr_t)base + off);
+
+	IOLog("SWEET GPU: %s=0x%08x\n", name, val);
+}
+
+static int
+sweet_pwrap_wait(uint32_t fsm)
+{
+	uint32_t i, v = 0;
+
+	for (i = 0; i < 10000; i++) {
+		v = *(volatile uint32_t *)((uintptr_t)sweet_pwrap_regs +
+		    PR_PWRAP_SWINF_STA);
+		if (PR_SWINF_FSM(v) == fsm) {
+			return 0;
+		}
+	}
+	IOLog("SWEET GPU: pwrap wait fsm=%u timeout sta=%08x\n", fsm, v);
+	return 1;
+}
+
+static int
+sweet_pmic_read(uint16_t reg, const char *name)
+{
+	uint32_t rd, init, sta;
+	uint16_t val;
+
+	init = *(volatile uint32_t *)((uintptr_t)sweet_pwrap_regs +
+	    PR_PWRAP_INIT_DONE);
+	sta = *(volatile uint32_t *)((uintptr_t)sweet_pwrap_regs +
+	    PR_PWRAP_SWINF_STA);
+	if (!(sta & PR_SWINF_INIT_DONE)) {
+		IOLog("SWEET GPU: %s=pwrap not ready init=%08x sta=%08x\n",
+		    name, init, sta);
+		return 1;
+	}
+	if (sweet_pwrap_wait(0) != 0) {
+		return 1;
+	}
+	*(volatile uint32_t *)((uintptr_t)sweet_pwrap_regs +
+	    PR_PWRAP_SWINF_ACC) = reg;
+	if (sweet_pwrap_wait(6) != 0) {
+		return 1;
+	}
+	rd = *(volatile uint32_t *)((uintptr_t)sweet_pwrap_regs +
+	    PR_PWRAP_SWINF_RDATA);
+	val = (uint16_t)(rd & 0xffffu);
+	*(volatile uint32_t *)((uintptr_t)sweet_pwrap_regs +
+	    PR_PWRAP_SWINF_VLDCLR) = 1;
+	IOLog("SWEET GPU: %s=0x%04x\n", name, val);
+	return 0;
+}
+
+void
+sweet_gpu_probe_start(void)
+{
+	int on = 0;
+	vm_offset_t va;
+
+	if (sweet_gpu_done) {
+		return;
+	}
+	PE_parse_boot_argn("rubygpuprobe", &on, sizeof(on));
+	if (on != 1) {
+		return;
+	}
+	sweet_gpu_done = true;
+
+	va = ml_io_map(SWEET_GPU_PA, SWEET_GPU_SIZE);
+	if (va == 0) {
+		IOLog("SWEET GPU: map failed\n");
+		return;
+	}
+	sweet_gpu_regs = (volatile uint32_t *)va;
+	IOLog("SWEET GPU: mapped 0x%lx at 0x%llx read-only\n",
+	    SWEET_GPU_PA, (unsigned long long)va);
+	sweet_show(sweet_gpu_regs, "GPU_ID", 0x000);
+	sweet_show(sweet_gpu_regs, "AS_PRESENT", 0x018);
+	sweet_show(sweet_gpu_regs, "JS_PRESENT", 0x01c);
+	sweet_show(sweet_gpu_regs, "GPU_STATUS", 0x034);
+	sweet_show(sweet_gpu_regs, "SHADER_PRESENT_LO", 0x100);
+	sweet_show(sweet_gpu_regs, "SHADER_PRESENT_HI", 0x104);
+	sweet_show(sweet_gpu_regs, "SHADER_READY_LO", 0x140);
+	sweet_show(sweet_gpu_regs, "SHADER_READY_HI", 0x144);
+	sweet_show(sweet_gpu_regs, "TILER_READY_LO", 0x150);
+	sweet_show(sweet_gpu_regs, "L2_READY_LO", 0x160);
+
+	va = ml_io_map(SWEET_MFG_PA, SWEET_MFG_SIZE);
+	if (va == 0) {
+		IOLog("SWEET GPU: mfg map failed\n");
+	} else {
+		sweet_mfg_regs = (volatile uint32_t *)va;
+		IOLog("SWEET GPU: mapped 0x%lx at 0x%llx read-only\n",
+		    SWEET_MFG_PA, (unsigned long long)va);
+		sweet_show(sweet_mfg_regs, "MFG_CG_STA", 0x0);
+		sweet_show(sweet_mfg_regs, "MFG_DCM_CON", 0x10);
+		sweet_show(sweet_mfg_regs, "MFG_ASYNC_CON", 0x20);
+		sweet_show(sweet_mfg_regs, "MFG_QCHANNEL_00", 0x0b0);
+		sweet_show(sweet_mfg_regs, "MFG_QCHANNEL_CON", 0x0b4);
+		sweet_show(sweet_mfg_regs, "MFG_DEBUG_SEL", 0x170);
+		sweet_show(sweet_mfg_regs, "MFG_DEBUG_TOP", 0x178);
+		sweet_show(sweet_mfg_regs, "MFG_I2M_PROT_00", 0xf60);
+		sweet_show(sweet_mfg_regs, "MFG_I2M_PROT_01", 0xf64);
+		sweet_show(sweet_mfg_regs, "MFG_I2M_PROT_02", 0xf68);
+	}
+
+	va = ml_io_map(SWEET_SPM_PA, SWEET_SPM_SIZE);
+	if (va == 0) {
+		IOLog("SWEET GPU: spm map failed\n");
+	} else {
+		sweet_spm_regs = (volatile uint32_t *)va;
+		IOLog("SWEET GPU: mapped 0x%lx at 0x%llx read-only\n",
+		    SWEET_SPM_PA, (unsigned long long)va);
+		sweet_show(sweet_spm_regs, "SPM_PWR_STATUS", 0x0ef0);
+		sweet_show(sweet_spm_regs, "SPM_PWR_STATUS_2ND", 0x0ef4);
+		sweet_show(sweet_spm_regs, "SPM_XPU_PWR_STATUS", 0x0ef8);
+		sweet_show(sweet_spm_regs, "SPM_XPU_PWR_STATUS_2", 0x0efc);
+	}
+
+	va = ml_io_map(SWEET_TOP_PA, SWEET_TOP_SIZE);
+	if (va == 0) {
+		IOLog("SWEET GPU: top map failed\n");
+	} else {
+		sweet_top_regs = (volatile uint32_t *)va;
+		sweet_show(sweet_top_regs, "TOP_CLK_CFG_20", 0x0120);
+	}
+
+	va = ml_io_map(SWEET_IFRAO_PA, SWEET_IFRAO_SIZE);
+	if (va == 0) {
+		IOLog("SWEET GPU: infra map failed\n");
+	} else {
+		sweet_ifrao_regs = (volatile uint32_t *)va;
+		sweet_show(sweet_ifrao_regs, "INFRA_TOPAXI_PROTECTEN", 0x0220);
+		sweet_show(sweet_ifrao_regs, "INFRA_PROTECTEN_STA0", 0x0224);
+		sweet_show(sweet_ifrao_regs, "INFRA_PROTECTEN_STA1", 0x0228);
+	}
+
+	va = ml_io_map(SWEET_MFGAO_PA, SWEET_MFGAO_SIZE);
+	if (va == 0) {
+		IOLog("SWEET GPU: mfg_ao map failed\n");
+	} else {
+		sweet_mfgao_regs = (volatile uint32_t *)va;
+		sweet_show(sweet_mfgao_regs, "MFGPLL1_CON0", 0x008);
+		sweet_show(sweet_mfgao_regs, "MFGPLL1_CON1", 0x00c);
+		sweet_show(sweet_mfgao_regs, "MFGPLL4_CON0", 0x038);
+	}
+
+	va = ml_io_map(SWEET_PWRAP_PA, SWEET_PWRAP_SIZE);
+	if (va == 0) {
+		IOLog("SWEET GPU: pwrap map failed\n");
+	} else {
+		sweet_pwrap_regs = (volatile uint32_t *)va;
+		sweet_show(sweet_pwrap_regs, "PWRAP_INIT_DONE",
+		    PR_PWRAP_INIT_DONE);
+		sweet_show(sweet_pwrap_regs, "PWRAP_SWINF_STA",
+		    PR_PWRAP_SWINF_STA);
+		(void)sweet_pmic_read(0x1788, "PMIC_BUCK_VPROC2_CON0");
+		(void)sweet_pmic_read(0x17b2, "PMIC_BUCK_VPROC2_ELR0");
+		(void)sweet_pmic_read(0x1f2e, "PMIC_LDO_VSRAM_MD_CON0");
+		(void)sweet_pmic_read(0x1b4a, "PMIC_LDO_VSRAM_MD_ELR");
+	}
+	IOLog("SWEET GPU: probe done\n");
+}
+
+/*
+ * P2b - minimal MFG2..5 power-on, gated by rubygpupwr=1 (default off).
+ * Writes only SPM PWR_CON for MFG2..5 and mfgcfg 0xB0/0x20/0xB4/0x170.
+ * No PMIC writes (VPROC2/VSRAM_MD are already on at 0.75 V per docs/240),
+ * no PLL/mux writes. Single shot; any failure powers off what was
+ * enabled and restores the two mfgcfg registers.
+ */
+#define SWEET_PWR_CON(n)      (0x0e88u + 4u * (n))  /* n=0..3 -> MFG2..5 */
+#define SWEET_PWR_XPU_STA     0x0ef8u
+#define SWEET_PWR_XPU_STA2    0x0efcu
+#define SWEET_PWR_RST_B       (1u << 0)
+#define SWEET_PWR_ISO         (1u << 1)
+#define SWEET_PWR_ON          (1u << 2)
+#define SWEET_PWR_ON_2ND      (1u << 3)
+#define SWEET_PWR_CLK_DIS     (1u << 4)
+#define SWEET_PWR_SRAM_PDN    (1u << 8)
+#define SWEET_PWR_SRAM_ACK    (1u << 12)
+#define SWEET_PWR_MFG_BIT(n)  (1u << (n))           /* MFG0..5 -> bits 0..5 */
+
+static bool sweet_gpu_pwr_done;
+static bool sweet_pwr2_ready;
+
+uint32_t
+sweet_pwr_rd(volatile uint32_t *base, uint32_t off)
+{
+	return *(volatile uint32_t *)((uintptr_t)base + off);
+}
+
+void
+sweet_pwr_wr(volatile uint32_t *base, uint32_t off, uint32_t val)
+{
+	*(volatile uint32_t *)((uintptr_t)base + off) = val;
+}
+
+static bool
+sweet_pwr_wait(volatile uint32_t *base, uint32_t off, uint32_t mask,
+    uint32_t want, uint32_t iters)
+{
+	while (iters--) {
+		if ((sweet_pwr_rd(base, off) & mask) == want) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static volatile uint32_t *
+sweet_pwr_map(vm_offset_t pa, vm_size_t size)
+{
+	vm_offset_t va = ml_io_map(pa, size);
+
+	return va == 0 ? NULL : (volatile uint32_t *)va;
+}
+
+static int
+sweet_pwr_mfg_on(unsigned int n)
+{
+	uint32_t off = SWEET_PWR_CON(n);
+	uint32_t bit = SWEET_PWR_MFG_BIT(n + 2);
+	uint32_t v;
+
+	sweet_pwr_wr(sweet_spm_regs, off,
+	    sweet_pwr_rd(sweet_spm_regs, off) | SWEET_PWR_ON);
+	sweet_pwr_wr(sweet_spm_regs, off,
+	    sweet_pwr_rd(sweet_spm_regs, off) | SWEET_PWR_ON_2ND);
+	if (!sweet_pwr_wait(sweet_spm_regs, SWEET_PWR_XPU_STA, bit, bit,
+	    100000) ||
+	    !sweet_pwr_wait(sweet_spm_regs, SWEET_PWR_XPU_STA2, bit, bit,
+	    100000)) {
+		IOLog("SWEET GPU: PWR MFG%u no ack\n", n + 2);
+		return 1;
+	}
+	sweet_pwr_wr(sweet_spm_regs, off,
+	    sweet_pwr_rd(sweet_spm_regs, off) & ~SWEET_PWR_CLK_DIS);
+	sweet_pwr_wr(sweet_spm_regs, off,
+	    sweet_pwr_rd(sweet_spm_regs, off) & ~SWEET_PWR_ISO);
+	sweet_pwr_wr(sweet_spm_regs, off,
+	    sweet_pwr_rd(sweet_spm_regs, off) | SWEET_PWR_RST_B);
+	v = sweet_pwr_rd(sweet_spm_regs, off);
+	if (v & SWEET_PWR_SRAM_PDN) {
+		sweet_pwr_wr(sweet_spm_regs, off, v & ~SWEET_PWR_SRAM_PDN);
+		if (!sweet_pwr_wait(sweet_spm_regs, off, SWEET_PWR_SRAM_ACK,
+		    0, 100000)) {
+			IOLog("SWEET GPU: PWR MFG%u sram ack\n", n + 2);
+			return 1;
+		}
+	}
+	IOLog("SWEET GPU: PWR MFG%u on con=0x%08x xpu=0x%08x\n", n + 2,
+	    sweet_pwr_rd(sweet_spm_regs, off),
+	    sweet_pwr_rd(sweet_spm_regs, SWEET_PWR_XPU_STA));
+	return 0;
+}
+
+static void
+sweet_pwr_mfg_off(unsigned int n)
+{
+	uint32_t off = SWEET_PWR_CON(n);
+	uint32_t bit = SWEET_PWR_MFG_BIT(n + 2);
+
+	sweet_pwr_wr(sweet_spm_regs, off,
+	    sweet_pwr_rd(sweet_spm_regs, off) | SWEET_PWR_ISO);
+	sweet_pwr_wr(sweet_spm_regs, off,
+	    sweet_pwr_rd(sweet_spm_regs, off) | SWEET_PWR_CLK_DIS);
+	sweet_pwr_wr(sweet_spm_regs, off,
+	    sweet_pwr_rd(sweet_spm_regs, off) & ~SWEET_PWR_RST_B);
+	sweet_pwr_wr(sweet_spm_regs, off,
+	    sweet_pwr_rd(sweet_spm_regs, off) & ~SWEET_PWR_ON);
+	sweet_pwr_wr(sweet_spm_regs, off,
+	    sweet_pwr_rd(sweet_spm_regs, off) & ~SWEET_PWR_ON_2ND);
+	(void)sweet_pwr_wait(sweet_spm_regs, SWEET_PWR_XPU_STA, bit, 0,
+	    100000);
+}
+
+static void
+sweet_pwr_v1_run(void)
+{
+	uint32_t old_b0, old_20, xpu;
+	int e;
+
+	if (sweet_spm_regs == NULL) {
+		sweet_spm_regs = sweet_pwr_map(SWEET_SPM_PA, SWEET_SPM_SIZE);
+	}
+	if (sweet_spm_regs == NULL) {
+		IOLog("SWEET GPU: PWR spm map failed\n");
+		return;
+	}
+	xpu = sweet_pwr_rd(sweet_spm_regs, SWEET_PWR_XPU_STA);
+	if ((xpu & 0x3u) != 0x3u) {
+		IOLog("SWEET GPU: PWR MFG0/1 not on, abort xpu=0x%08x\n",
+		    xpu);
+		return;
+	}
+	if (sweet_mfg_regs == NULL) {
+		sweet_mfg_regs = sweet_pwr_map(SWEET_MFG_PA, SWEET_MFG_SIZE);
+	}
+	if (sweet_mfg_regs == NULL) {
+		IOLog("SWEET GPU: PWR mfg map failed\n");
+		return;
+	}
+
+	old_b0 = sweet_pwr_rd(sweet_mfg_regs, 0x0b0);
+	old_20 = sweet_pwr_rd(sweet_mfg_regs, 0x020);
+	sweet_pwr_wr(sweet_mfg_regs, 0x0b0,
+	    old_b0 & ~((1u << 21) | (1u << 10)));
+	sweet_pwr_wr(sweet_mfg_regs, 0x020, old_20 | (0xfu << 22));
+
+	for (e = 0; e < 4; e++) {
+		if (sweet_pwr_mfg_on((unsigned int)e) != 0) {
+			break;
+		}
+	}
+	if (e < 4) {
+		int failed = e;
+
+		sweet_pwr_mfg_off((unsigned int)failed);
+		while (e > 0) {
+			e--;
+			sweet_pwr_mfg_off((unsigned int)e);
+		}
+		sweet_pwr_wr(sweet_mfg_regs, 0x0b0, old_b0);
+		sweet_pwr_wr(sweet_mfg_regs, 0x020, old_20);
+		IOLog("SWEET GPU: PWR failed at MFG%u, rolled back\n",
+		    failed + 2);
+		return;
+	}
+
+	sweet_pwr_wr(sweet_mfg_regs, 0x0b4, 1);
+	sweet_pwr_wr(sweet_mfg_regs, 0x170, 3);
+	if (!sweet_pwr_wait(sweet_mfg_regs, 0x178, (1u << 2), (1u << 2),
+	    100000)) {
+		IOLog("SWEET GPU: PWR bus idle timeout\n");
+	}
+
+	if (sweet_gpu_regs == NULL) {
+		sweet_gpu_regs = sweet_pwr_map(SWEET_GPU_PA, SWEET_GPU_SIZE);
+	}
+	if (sweet_gpu_regs != NULL) {
+		IOLog("SWEET GPU: PWR READY sh=0x%08x/0x%08x ti=0x%08x/0x%08x "
+		    "l2=0x%08x/0x%08x\n",
+		    sweet_pwr_rd(sweet_gpu_regs, 0x140),
+		    sweet_pwr_rd(sweet_gpu_regs, 0x144),
+		    sweet_pwr_rd(sweet_gpu_regs, 0x150),
+		    sweet_pwr_rd(sweet_gpu_regs, 0x154),
+		    sweet_pwr_rd(sweet_gpu_regs, 0x160),
+		    sweet_pwr_rd(sweet_gpu_regs, 0x164));
+	}
+	xpu = sweet_pwr_rd(sweet_spm_regs, SWEET_PWR_XPU_STA);
+	IOLog("SWEET GPU: PWR done xpu=0x%08x\n", xpu);
+}
+
+/*
+ * P2b-v2: full JM-style wake, gated by rubygpupwr=2 (default off, single
+ * shot). Order follows kbase: platform power -> PLL/CG -> SOFT_RESET ->
+ * TILER PWRON -> L2 PWRON -> SHADER PWRON, waiting PWRTRANS==0 and
+ * READY==PRESENT. No PMIC writes, TOPCKGEN is read-only, no HARD_RESET,
+ * no 26 MHz parking WA. Any failure powers off and restores mfgcfg.
+ */
+#define SWEET_PWR2_TOP_MUX          0x120u
+#define SWEET_PWR2_PLL1_CON0        0x008u
+#define SWEET_PWR2_PLL1_CON3        0x014u
+#define SWEET_PWR2_GPU_IRQ_RAWSTAT  0x020u
+#define SWEET_PWR2_GPU_IRQ_CLEAR    0x024u
+#define SWEET_PWR2_GPU_COMMAND      0x030u
+#define SWEET_PWR2_SHADER_PRESENT   0x100u
+#define SWEET_PWR2_TILER_PRESENT    0x110u
+#define SWEET_PWR2_L2_PRESENT       0x120u
+#define SWEET_PWR2_SHADER_READY     0x140u
+#define SWEET_PWR2_TILER_READY      0x150u
+#define SWEET_PWR2_L2_READY         0x160u
+#define SWEET_PWR2_SHADER_PWRON     0x180u
+#define SWEET_PWR2_TILER_PWRON      0x190u
+#define SWEET_PWR2_L2_PWRON         0x1a0u
+#define SWEET_PWR2_SHADER_PWROFF    0x1c0u
+#define SWEET_PWR2_TILER_PWROFF     0x1d0u
+#define SWEET_PWR2_L2_PWROFF        0x1e0u
+#define SWEET_PWR2_SHADER_PWRTRANS  0x200u
+#define SWEET_PWR2_TILER_PWRTRANS   0x210u
+#define SWEET_PWR2_L2_PWRTRANS      0x220u
+#define SWEET_PWR2_RESET_DONE       (1u << 8)
+#define SWEET_PWR2_SOFT_RESET       0x01u
+#define SWEET_PWR2_RESET_MS         500u
+#define SWEET_PWR2_PM_MS            5000u
+#define SWEET_PWR2_CG_MS            10u
+#define SWEET_PWR2_ROLLBACK_MS      1000u
+
+static uint64_t
+sweet_pwr2_rd64(volatile uint32_t *base, uint32_t off)
+{
+	return (uint64_t)sweet_pwr_rd(base, off) |
+	    ((uint64_t)sweet_pwr_rd(base, off + 4) << 32);
+}
+
+static void
+sweet_pwr2_wr64(volatile uint32_t *base, uint32_t off, uint64_t mask)
+{
+	if ((mask & 0xffffffffULL) != 0) {
+		sweet_pwr_wr(base, off, (uint32_t)mask);
+	}
+	if ((mask >> 32) != 0) {
+		sweet_pwr_wr(base, off + 4, (uint32_t)(mask >> 32));
+	}
+}
+
+static bool
+sweet_pwr2_wait_bits(volatile uint32_t *base, uint32_t off, uint32_t mask,
+    uint32_t want, uint32_t ms)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	for (;;) {
+		if ((sweet_pwr_rd(base, off) & mask) == want) {
+			return true;
+		}
+		if (mach_absolute_time() >= deadline) {
+			return false;
+		}
+		IOSleep(1);
+	}
+}
+
+static bool
+sweet_pwr2_wait_core(volatile uint32_t *gpu, uint32_t trans_off,
+    uint32_t ready_off, uint64_t mask, uint32_t ms)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	for (;;) {
+		uint64_t trans = sweet_pwr2_rd64(gpu, trans_off);
+		uint64_t ready = sweet_pwr2_rd64(gpu, ready_off);
+
+		if ((trans & mask) == 0 && (ready & mask) == mask) {
+			return true;
+		}
+		if (mach_absolute_time() >= deadline) {
+			return false;
+		}
+		IOSleep(1);
+	}
+}
+
+static bool
+sweet_pwr2_wait_tiler_l2(volatile uint32_t *gpu, uint64_t tiler_mask,
+    uint64_t l2_mask, uint32_t ms)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	for (;;) {
+		uint64_t tt = sweet_pwr2_rd64(gpu, SWEET_PWR2_TILER_PWRTRANS);
+		uint64_t tr = sweet_pwr2_rd64(gpu, SWEET_PWR2_TILER_READY);
+		uint64_t lt = sweet_pwr2_rd64(gpu, SWEET_PWR2_L2_PWRTRANS);
+		uint64_t lr = sweet_pwr2_rd64(gpu, SWEET_PWR2_L2_READY);
+
+		if ((tt & tiler_mask) == 0 && (tr & tiler_mask) == tiler_mask &&
+		    (lt & l2_mask) == 0 && (lr & l2_mask) == l2_mask) {
+			return true;
+		}
+		if (mach_absolute_time() >= deadline) {
+			return false;
+		}
+		IOSleep(1);
+	}
+}
+
+static void
+sweet_pwr2_wait_off(volatile uint32_t *gpu, uint32_t trans_off,
+    uint64_t mask, uint32_t ms)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	while ((sweet_pwr2_rd64(gpu, trans_off) & mask) != 0) {
+		if (mach_absolute_time() >= deadline) {
+			return;
+		}
+		IOSleep(1);
+	}
+}
+
+static bool
+sweet_pwr2_map(void)
+{
+	if (sweet_spm_regs == NULL) {
+		sweet_spm_regs = sweet_pwr_map(SWEET_SPM_PA, SWEET_SPM_SIZE);
+	}
+	if (sweet_mfg_regs == NULL) {
+		sweet_mfg_regs = sweet_pwr_map(SWEET_MFG_PA, SWEET_MFG_SIZE);
+	}
+	if (sweet_gpu_regs == NULL) {
+		sweet_gpu_regs = sweet_pwr_map(SWEET_GPU_PA, SWEET_GPU_SIZE);
+	}
+	if (sweet_top_regs == NULL) {
+		sweet_top_regs = sweet_pwr_map(SWEET_TOP_PA, SWEET_TOP_SIZE);
+	}
+	if (sweet_mfgao_regs == NULL) {
+		sweet_mfgao_regs = sweet_pwr_map(SWEET_MFGAO_PA,
+		    SWEET_MFGAO_SIZE);
+	}
+	return sweet_spm_regs != NULL && sweet_mfg_regs != NULL &&
+	    sweet_gpu_regs != NULL && sweet_top_regs != NULL &&
+	    sweet_mfgao_regs != NULL;
+}
+
+static void
+sweet_pwr2_run(void)
+{
+	const char *stage = "pre";
+	uint64_t shader_present = 0, tiler_present = 0, l2_present = 0;
+	uint32_t pll3, cg_sta, top_mux, xpu;
+	uint32_t old_10 = 0, old_20 = 0, old_b0 = 0;
+	int mtcmos = 0;
+	bool cg_written = false, cg_opened = false;
+	bool tiler_on = false, l2_on = false, shader_on = false;
+	int e;
+
+	if (!sweet_pwr2_map()) {
+		IOLog("SWEET GPU: PWR2 map failed\n");
+		return;
+	}
+	xpu = sweet_pwr_rd(sweet_spm_regs, SWEET_PWR_XPU_STA);
+	if ((xpu & 0x3u) != 0x3u) {
+		IOLog("SWEET GPU: PWR2 MFG0/1 not on, abort xpu=0x%08x\n",
+		    xpu);
+		return;
+	}
+	pll3 = sweet_pwr_rd(sweet_mfgao_regs, SWEET_PWR2_PLL1_CON3);
+	cg_sta = sweet_pwr_rd(sweet_mfg_regs, 0x0);
+	top_mux = sweet_pwr_rd(sweet_top_regs, SWEET_PWR2_TOP_MUX);
+	IOLog("SWEET GPU: PWR2 pre cg=0x%08x pll0=0x%08x pll3=0x%08x "
+	    "top=0x%08x\n", cg_sta,
+	    sweet_pwr_rd(sweet_mfgao_regs, SWEET_PWR2_PLL1_CON0),
+	    pll3, top_mux);
+
+	stage = "mtcmos";
+	for (e = 0; e < 4; e++) {
+		if (sweet_pwr_mfg_on((unsigned int)e) != 0) {
+			goto fail;
+		}
+		mtcmos++;
+	}
+
+	stage = "pll";
+	if ((pll3 & 0x1u) == 0 || (pll3 & 0x2u) != 0) {
+		sweet_pwr_wr(sweet_mfgao_regs, SWEET_PWR2_PLL1_CON3,
+		    (pll3 | 0x1u) & ~0x2u);
+		IOSleep(1);
+		pll3 = sweet_pwr_rd(sweet_mfgao_regs, SWEET_PWR2_PLL1_CON3);
+	}
+	if (((pll3 & 0x1u) == 0) || ((pll3 & 0x2u) != 0)) {
+		goto fail;
+	}
+	if ((sweet_pwr_rd(sweet_mfgao_regs, SWEET_PWR2_PLL1_CON0) &
+	    0x1u) == 0) {
+		goto fail;
+	}
+
+	stage = "cg";
+	/* setclr gate: enable is a write to CLR (+0x8), STA bit0=0 means on */
+	sweet_pwr_wr(sweet_mfg_regs, 0x8, 0x1u);
+	if (!sweet_pwr2_wait_bits(sweet_mfg_regs, 0x0, 0x1u, 0,
+	    SWEET_PWR2_CG_MS)) {
+		goto fail;
+	}
+	cg_opened = (cg_sta & 0x1u) != 0;
+	old_20 = sweet_pwr_rd(sweet_mfg_regs, 0x20);
+	old_b0 = sweet_pwr_rd(sweet_mfg_regs, 0xb0);
+	old_10 = sweet_pwr_rd(sweet_mfg_regs, 0x10);
+	sweet_pwr_wr(sweet_mfg_regs, 0x20, old_20 | (0xfu << 22));
+	sweet_pwr_wr(sweet_mfg_regs, 0xb0,
+	    old_b0 & ~((1u << 8) | (1u << 20) | (1u << 21) | (1u << 10)));
+	sweet_pwr_wr(sweet_mfg_regs, 0x10,
+	    (old_10 | (1u << 15) | 0x3fu) & ~(1u << 6));
+	cg_written = true;
+	IOLog("SWEET GPU: PWR2 cg set=0x%08x async=0x%08x global=0x%08x "
+	    "dcm=0x%08x\n", sweet_pwr_rd(sweet_mfg_regs, 0x0),
+	    sweet_pwr_rd(sweet_mfg_regs, 0x20),
+	    sweet_pwr_rd(sweet_mfg_regs, 0xb0),
+	    sweet_pwr_rd(sweet_mfg_regs, 0x10));
+
+	stage = "mux";
+	if ((sweet_pwr_rd(sweet_top_regs, SWEET_PWR2_TOP_MUX) &
+	    (1u << 18)) == 0) {
+		goto fail;
+	}
+
+	stage = "present";
+	shader_present = sweet_pwr2_rd64(sweet_gpu_regs,
+	    SWEET_PWR2_SHADER_PRESENT);
+	tiler_present = sweet_pwr2_rd64(sweet_gpu_regs,
+	    SWEET_PWR2_TILER_PRESENT);
+	l2_present = sweet_pwr2_rd64(sweet_gpu_regs, SWEET_PWR2_L2_PRESENT);
+	IOLog("SWEET GPU: PWR2 present sh=0x%llx ti=0x%llx l2=0x%llx\n",
+	    (unsigned long long)shader_present,
+	    (unsigned long long)tiler_present,
+	    (unsigned long long)l2_present);
+	if (shader_present == 0 || tiler_present == 0 || l2_present == 0) {
+		goto fail;
+	}
+
+	stage = "reset";
+	sweet_pwr_wr(sweet_gpu_regs, SWEET_PWR2_GPU_COMMAND,
+	    SWEET_PWR2_SOFT_RESET);
+	if (!sweet_pwr2_wait_bits(sweet_gpu_regs,
+	    SWEET_PWR2_GPU_IRQ_RAWSTAT, SWEET_PWR2_RESET_DONE,
+	    SWEET_PWR2_RESET_DONE, SWEET_PWR2_RESET_MS)) {
+		goto fail;
+	}
+	sweet_pwr_wr(sweet_gpu_regs, SWEET_PWR2_GPU_IRQ_CLEAR,
+	    SWEET_PWR2_RESET_DONE);
+
+	stage = "tiler";
+	sweet_pwr2_wr64(sweet_gpu_regs, SWEET_PWR2_TILER_PWRON,
+	    tiler_present);
+	tiler_on = true;
+	if (l2_present != 1) {
+		sweet_pwr2_wr64(sweet_gpu_regs, SWEET_PWR2_L2_PWRON,
+		    l2_present & ~1ULL);
+		l2_on = true;
+	}
+	if (!sweet_pwr2_wait_tiler_l2(sweet_gpu_regs, tiler_present,
+	    l2_present, SWEET_PWR2_PM_MS)) {
+		goto fail;
+	}
+
+	stage = "shader";
+	sweet_pwr2_wr64(sweet_gpu_regs, SWEET_PWR2_SHADER_PWRON,
+	    shader_present);
+	shader_on = true;
+	if (!sweet_pwr2_wait_core(sweet_gpu_regs,
+	    SWEET_PWR2_SHADER_PWRTRANS, SWEET_PWR2_SHADER_READY,
+	    shader_present, SWEET_PWR2_PM_MS)) {
+		goto fail;
+	}
+
+	xpu = sweet_pwr_rd(sweet_spm_regs, SWEET_PWR_XPU_STA);
+	IOLog("SWEET GPU: PWR2 done ready sh=0x%llx ti=0x%llx l2=0x%llx "
+	    "xpu=0x%08x\n",
+	    (unsigned long long)sweet_pwr2_rd64(sweet_gpu_regs,
+	    SWEET_PWR2_SHADER_READY),
+	    (unsigned long long)sweet_pwr2_rd64(sweet_gpu_regs,
+	    SWEET_PWR2_TILER_READY),
+	    (unsigned long long)sweet_pwr2_rd64(sweet_gpu_regs,
+	    SWEET_PWR2_L2_READY), xpu);
+	sweet_pwr2_ready = true;
+	return;
+
+fail:
+	xpu = sweet_pwr_rd(sweet_spm_regs, SWEET_PWR_XPU_STA);
+	IOLog("SWEET GPU: PWR2 FAIL stage=%s cg=0x%08x xpu=0x%08x\n", stage,
+	    sweet_pwr_rd(sweet_mfg_regs, 0x0), xpu);
+	if (shader_on) {
+		sweet_pwr2_wr64(sweet_gpu_regs, SWEET_PWR2_SHADER_PWROFF,
+		    shader_present);
+	}
+	if (l2_on) {
+		sweet_pwr2_wr64(sweet_gpu_regs, SWEET_PWR2_L2_PWROFF,
+		    l2_present & ~1ULL);
+	}
+	if (tiler_on) {
+		sweet_pwr2_wr64(sweet_gpu_regs, SWEET_PWR2_TILER_PWROFF,
+		    tiler_present);
+	}
+	if (shader_on) {
+		sweet_pwr2_wait_off(sweet_gpu_regs,
+		    SWEET_PWR2_SHADER_PWRTRANS, shader_present,
+		    SWEET_PWR2_ROLLBACK_MS);
+	}
+	if (tiler_on) {
+		sweet_pwr2_wait_off(sweet_gpu_regs,
+		    SWEET_PWR2_TILER_PWRTRANS, tiler_present,
+		    SWEET_PWR2_ROLLBACK_MS);
+	}
+	if (l2_on) {
+		sweet_pwr2_wait_off(sweet_gpu_regs,
+		    SWEET_PWR2_L2_PWRTRANS, l2_present & ~1ULL,
+		    SWEET_PWR2_ROLLBACK_MS);
+	}
+	if (cg_written) {
+		sweet_pwr_wr(sweet_mfg_regs, 0x20, old_20);
+		sweet_pwr_wr(sweet_mfg_regs, 0xb0, old_b0);
+		sweet_pwr_wr(sweet_mfg_regs, 0x10, old_10);
+	}
+	if (cg_opened) {
+		/* restore the closed state we opened (setclr: SET = disable) */
+		sweet_pwr_wr(sweet_mfg_regs, 0x4, 0x1u);
+	}
+	while (mtcmos > 0) {
+		mtcmos--;
+		sweet_pwr_mfg_off((unsigned int)mtcmos);
+	}
+	IOLog("SWEET GPU: PWR2 rolled back\n");
+}
+
+void
+sweet_gpu_power_start(void)
+{
+	int on = 0;
+
+	if (sweet_gpu_pwr_done) {
+		return;
+	}
+	PE_parse_boot_argn("rubygpupwr", &on, sizeof(on));
+	if (on != 1 && on != 2) {
+		return;
+	}
+	sweet_gpu_pwr_done = true;
+	if (on == 1) {
+		sweet_pwr_v1_run();
+	} else {
+		sweet_pwr2_run();
+	}
+	ruby_gpu_service_publish();
+}
+
+/*
+ * P2c: first-pixel loop, gated by rubygpucommit=1/2/3 (default off, single
+ * shot, requires a successful rubygpupwr=2 pass). Variant 1 uses the kbase
+ * standard JS_CONFIG; variant 2 adds START_MMU | JOB_CHAIN_FLAG. 1/2 are
+ * C1 (GPU-side JOB_IRQ_RAWSTAT poll); 3 is C2: the line is delivered as
+ * GIC SPI455 / INTID487 level through RubyGIC and the workloop action of
+ * RubyGPUIRQ clears it and wakes the waiter.
+ */
+
+static bool sweet_gpu_commit_done;
+static IOBufferMemoryDescriptor *sweet_p2c_md;
+
+static void
+sweet_p2c_tables(uint8_t *mem, uint64_t phys)
+{
+	uint64_t *l0 = (uint64_t *)(void *)mem;
+	uint64_t *l1 = (uint64_t *)(void *)(mem + 0x1000);
+	uint64_t *l2 = (uint64_t *)(void *)(mem + 0x2000);
+	uint64_t *l3 = (uint64_t *)(void *)(mem + 0x3000);
+	uint64_t pte = (1ULL << 10) | 3ULL;
+	uint64_t ate = (5ULL << 2) | (1ULL << 6) | (2ULL << 8) |
+	    (1ULL << 10) | 3ULL;
+
+	l0[0] = (phys + 0x1000) | pte;
+	l1[0] = (phys + 0x2000) | pte;
+	l2[0x80] = (phys + 0x3000) | pte;
+	l3[0] = (phys + 0x4000) | ate;
+}
+
+static void
+sweet_p2c_job(uint8_t *mem)
+{
+	uint32_t *job = (uint32_t *)(void *)(mem + SWEET_P2C_DATA_OFF);
+	uint64_t target = SWEET_P2C_VA + SWEET_P2C_TARGET_OFF;
+
+	job[4] = 2u << 1;                       /* Write value */
+	job[8] = (uint32_t)target;              /* payload: address lo */
+	job[9] = (uint32_t)(target >> 32);
+	job[10] = 6u;                           /* Immediate 32 */
+	job[12] = 0xff00ff00u;                  /* payload: value lo */
+	job[13] = 0;
+}
+
+static RubyGPUIRQ *sweet_c2_irq;
+
+RubyGPUIRQ *
+sweet_c2_irq_create(void)
+{
+	IOService *platform;
+	RubyGPUIRQ *irq;
+
+	if (sweet_c2_irq != NULL) {
+		return sweet_c2_irq;
+	}
+	platform = (IOService *)IOService::getPlatform();
+	irq = new RubyGPUIRQ;
+	if (platform == NULL || irq == NULL || !irq->init()) {
+		IOLog("SWEET GPU: C2 irq service failed\n");
+		OSSafeReleaseNULL(irq);
+		return NULL;
+	}
+	if (!irq->attach(platform)) {
+		IOLog("SWEET GPU: C2 irq service failed\n");
+		irq->release();
+		return NULL;
+	}
+	if (!irq->start(platform)) {
+		IOLog("SWEET GPU: C2 irq service failed\n");
+		irq->detach(platform);
+		irq->release();
+		return NULL;
+	}
+	irq->registerService();
+	sweet_c2_irq = irq;
+	return irq;
+}
+
+static void
+sweet_gpu_commit_run(int variant, RubyGPUIRQ *irq)
+{
+	const char *path = (irq != NULL) ? "c2" : "c1";
+	const char *stage = "pre";
+	volatile uint32_t *gpu = sweet_gpu_regs;
+	uint64_t phys = 0;
+	IOByteCount seglen = 0;
+	void *mem;
+	uint8_t *base;
+	uint64_t pgd, deadline;
+	uint32_t cfg, raw = 0, js = 0, asf = 0, girq = 0, mirq = 0;
+	uint32_t irq_status = 0, irq_hits = 0, irq_spurious = 0;
+	uint32_t jstat = 0, jmask = 0;
+	uint32_t val = 0;
+	vm_offset_t map;
+	bool done = false;
+
+	if (!sweet_pwr2_ready) {
+		IOLog("SWEET GPU: P2C skip pwr2 not ready\n");
+		return;
+	}
+	if (sweet_p2c_md == NULL) {
+		sweet_p2c_md = IOBufferMemoryDescriptor::withOptions(
+		    kIODirectionInOut | kIOMemoryPhysicallyContiguous,
+		    SWEET_P2C_MEM_SIZE, SWEET_P2C_PAGE_SIZE);
+	}
+	if (sweet_p2c_md == NULL ||
+	    sweet_p2c_md->prepare(kIODirectionInOut) != kIOReturnSuccess) {
+		IOLog("SWEET GPU: P2C alloc failed\n");
+		return;
+	}
+	mem = sweet_p2c_md->getBytesNoCopy();
+	phys = sweet_p2c_md->getPhysicalSegment(0, &seglen, 0);
+	if (mem == NULL || phys == 0 || seglen < SWEET_P2C_MEM_SIZE ||
+	    (phys & 0xfffull) != 0 ||
+	    phys + SWEET_P2C_MEM_SIZE >= (1ULL << 40)) {
+		IOLog("SWEET GPU: P2C map failed phys=0x%llx seg=0x%llx\n",
+		    (unsigned long long)phys, (unsigned long long)seglen);
+		return;
+	}
+	base = (uint8_t *)mem;
+	bzero(base, SWEET_P2C_MEM_SIZE);
+	sweet_p2c_tables(base, (uint64_t)phys);
+	sweet_p2c_job(base);
+	pgd = (uint64_t)phys & 0xfffffffffff0ULL;
+
+	/*
+	 * Mali MASK bits are enable bits: 1 unmasks, 0 masks (kbase writes
+	 * JOB_IRQ_MASK=0xFFFFFFFF to unmask). C1 polls RAWSTAT with
+	 * everything masked; C2 unmasks only the JOB done/fail bits.
+	 */
+	sweet_pwr_wr(gpu, SWEET_P2C_GPUIRQ_CLEAR, 0xffffffffu);
+	sweet_pwr_wr(gpu, SWEET_P2C_JOBIRQ_BASE + SWEET_P2C_JOBIRQ_CLEAR,
+	    0xffffffffu);
+	sweet_pwr_wr(gpu, SWEET_P2C_MMUIRQ_BASE + SWEET_P2C_MMUIRQ_CLEAR,
+	    0xffffffffu);
+
+	sweet_pwr_wr(gpu, SWEET_P2C_GPUIRQ_MASK, 0);
+	sweet_pwr_wr(gpu, SWEET_P2C_MMUIRQ_BASE + SWEET_P2C_MMUIRQ_MASK, 0);
+	sweet_pwr_wr(gpu, SWEET_P2C_JOBIRQ_BASE + SWEET_P2C_JOBIRQ_MASK,
+	    (irq != NULL) ? SWEET_P2C_JOB_DONE_MASK : 0);
+	if (irq != NULL) {
+		irq->fDone = false;
+	}
+
+	flush_dcache((vm_offset_t)mem, SWEET_P2C_MEM_SIZE, FALSE);
+
+	stage = "as";
+	if (!sweet_pwr2_wait_bits(gpu, SWEET_P2C_AS_BASE + 0x28, 0x1u, 0,
+	    10)) {
+		goto fail;
+	}
+	sweet_pwr_wr(gpu, SWEET_P2C_AS_BASE + 0x30, 0x42000006u);
+	sweet_pwr_wr(gpu, SWEET_P2C_AS_BASE + 0x34, 0);
+	sweet_pwr_wr(gpu, SWEET_P2C_AS_BASE + 0x00, (uint32_t)pgd);
+	sweet_pwr_wr(gpu, SWEET_P2C_AS_BASE + 0x04, (uint32_t)(pgd >> 32));
+	sweet_pwr_wr(gpu, SWEET_P2C_AS_BASE + 0x08, 0x888d8f88u);
+	sweet_pwr_wr(gpu, SWEET_P2C_AS_BASE + 0x0c, 0x4c8du);
+	sweet_pwr_wr(gpu, SWEET_P2C_AS_BASE + 0x18, 1);   /* UPDATE */
+	if (!sweet_pwr2_wait_bits(gpu, SWEET_P2C_AS_BASE + 0x28, 0x1u, 0,
+	    10)) {
+		goto fail;
+	}
+
+	stage = "submit";
+	cfg = (variant == 2) ? SWEET_P2C_CFG_ALT : SWEET_P2C_CFG_STD;
+	flush_dcache((vm_offset_t)mem, SWEET_P2C_MEM_SIZE, FALSE);
+	sweet_pwr_wr(gpu, SWEET_P2C_JS_BASE + 0x40, (uint32_t)SWEET_P2C_VA);
+	sweet_pwr_wr(gpu, SWEET_P2C_JS_BASE + 0x44,
+	    (uint32_t)(SWEET_P2C_VA >> 32));
+	sweet_pwr_wr(gpu, SWEET_P2C_JS_BASE + 0x58, cfg);
+	sweet_pwr_wr(gpu, SWEET_P2C_JS_BASE + 0x60, 1);   /* START */
+	IOLog("SWEET GPU: P2C submit path=%s variant=%d cfg=0x%08x va=0x%llx\n",
+	    path, variant, cfg, (unsigned long long)SWEET_P2C_VA);
+
+	stage = "job";
+	if (irq != NULL) {
+		irq->setSlot(0);
+		if (irq->setEnabled(1) != 0) {
+			goto fail;
+		}
+		done = irq->waitDone(SWEET_P2C_C2_WAIT_MS) == 0;
+		irq->setEnabled(0);
+		irq_status = irq->fStatus;
+		irq_hits = irq->fHits;
+		irq_spurious = irq->fSpurious;
+		raw = irq->fRaw;
+		js = irq->fJs;
+		asf = irq->fAsf;
+		girq = irq->fGirq;
+		mirq = irq->fMirq;
+		if (!done) {
+			raw = sweet_pwr_rd(gpu, SWEET_P2C_JOBIRQ_BASE +
+			    SWEET_P2C_JOBIRQ_RAWSTAT);
+			js = sweet_pwr_rd(gpu, SWEET_P2C_JS_BASE + 0x24);
+			asf = sweet_pwr_rd(gpu, SWEET_P2C_AS_BASE + 0x1c);
+			girq = sweet_pwr_rd(gpu, SWEET_P2C_GPUIRQ_RAWSTAT);
+			mirq = sweet_pwr_rd(gpu, SWEET_P2C_MMUIRQ_BASE +
+			    SWEET_P2C_MMUIRQ_RAWSTAT);
+		}
+	} else {
+		clock_interval_to_deadline(1000, NSEC_PER_MSEC, &deadline);
+		for (;;) {
+			raw = sweet_pwr_rd(gpu, SWEET_P2C_JOBIRQ_BASE +
+			    SWEET_P2C_JOBIRQ_RAWSTAT);
+			if (raw & SWEET_P2C_JOB_DONE_MASK) {
+				done = true;
+				break;
+			}
+			if (mach_absolute_time() >= deadline) {
+				break;
+			}
+			IOSleep(1);
+		}
+		js = sweet_pwr_rd(gpu, SWEET_P2C_JS_BASE + 0x24);
+		asf = sweet_pwr_rd(gpu, SWEET_P2C_AS_BASE + 0x1c);
+		girq = sweet_pwr_rd(gpu, SWEET_P2C_GPUIRQ_RAWSTAT);
+		mirq = sweet_pwr_rd(gpu, SWEET_P2C_MMUIRQ_BASE +
+		    SWEET_P2C_MMUIRQ_RAWSTAT);
+		sweet_pwr_wr(gpu, SWEET_P2C_JOBIRQ_BASE + SWEET_P2C_JOBIRQ_CLEAR,
+		    SWEET_P2C_JOB_DONE_MASK);
+	}
+
+	jstat = sweet_pwr_rd(gpu, SWEET_P2C_JOBIRQ_BASE +
+	    SWEET_P2C_JOBIRQ_STATUS);
+	jmask = sweet_pwr_rd(gpu, SWEET_P2C_JOBIRQ_BASE +
+	    SWEET_P2C_JOBIRQ_MASK);
+
+	map = ml_io_map((vm_offset_t)((uint64_t)phys + SWEET_P2C_DATA_OFF),
+	    SWEET_P2C_PAGE_SIZE);
+	if (map != 0) {
+		val = *(volatile uint32_t *)(map + SWEET_P2C_TARGET_OFF);
+	}
+
+	if (done && (raw & SWEET_P2C_JOB_DONE_MASK) == (1u << 0) && js == 0 &&
+	    val == 0xff00ff00u) {
+		IOLog("SWEET GPU: P2C done path=%s variant=%d value=0x%08x "
+		    "irq=0x%08x raw=0x%08x js=0x%08x as=0x%08x girq=0x%08x "
+		    "mirq=0x%08x stat=0x%08x mask=0x%08x hits=%u spur=%u\n",
+		    path, variant, val, irq_status, raw, js, asf, girq, mirq,
+		    jstat, jmask, irq_hits, irq_spurious);
+		return;
+	}
+
+	stage = "verify";
+fail:
+	if (irq != NULL) {
+		irq->setEnabled(0);
+	}
+	IOLog("SWEET GPU: P2C FAIL path=%s variant=%d stage=%s "
+	    "irq=0x%08x raw=0x%08x js=0x%08x as=0x%08x girq=0x%08x "
+	    "mirq=0x%08x stat=0x%08x mask=0x%08x value=0x%08x "
+	    "hits=%u spur=%u\n", path, variant, stage, irq_status, raw, js,
+	    asf, girq, mirq, jstat, jmask, val, irq_hits, irq_spurious);
+	sweet_pwr_wr(gpu, SWEET_P2C_JS_BASE + 0x60, 3);   /* HARD_STOP */
+	IOSleep(10);
+	sweet_pwr_wr(gpu, SWEET_P2C_AS_BASE + 0x00, 0);
+	sweet_pwr_wr(gpu, SWEET_P2C_AS_BASE + 0x04, 0);
+	sweet_pwr_wr(gpu, SWEET_P2C_AS_BASE + 0x30, 1);   /* UNMAPPED */
+	sweet_pwr_wr(gpu, SWEET_P2C_AS_BASE + 0x34, 0);
+	if (sweet_pwr2_wait_bits(gpu, SWEET_P2C_AS_BASE + 0x28, 0x1u, 0,
+	    10)) {
+		sweet_pwr_wr(gpu, SWEET_P2C_AS_BASE + 0x18, 1);
+	}
+	sweet_pwr_wr(gpu, SWEET_P2C_JOBIRQ_BASE + SWEET_P2C_JOBIRQ_CLEAR,
+	    0xffffffffu);
+	sweet_pwr_wr(gpu, SWEET_P2C_GPUIRQ_CLEAR, 0xffffffffu);
+	sweet_pwr_wr(gpu, SWEET_P2C_MMUIRQ_BASE + SWEET_P2C_MMUIRQ_CLEAR,
+	    0xffffffffu);
+	IOLog("SWEET GPU: P2C rolled back\n");
+}
+
+void
+sweet_gpu_commit_start(void)
+{
+	int on = 0;
+	RubyGPUIRQ *irq = NULL;
+
+	if (sweet_gpu_commit_done) {
+		return;
+	}
+	PE_parse_boot_argn("rubygpucommit", &on, sizeof(on));
+	if (on != 1 && on != 2 && on != 3) {
+		return;
+	}
+	sweet_gpu_commit_done = true;
+	if (on == 3) {
+		if (!sweet_pwr2_ready) {
+			IOLog("SWEET GPU: P2C skip pwr2 not ready\n");
+			return;
+		}
+		irq = sweet_c2_irq_create();
+		if (irq == NULL) {
+			IOLog("SWEET GPU: C2 irq unavailable, fallback C1 poll\n");
+		}
+		sweet_gpu_commit_run(1, irq);
+		return;
+	}
+	sweet_gpu_commit_run(on, NULL);
+}
