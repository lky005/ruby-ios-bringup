+int
+ruby_gpu_param(uint32_t param, uint64_t *value)
+{
+	switch (param) {
+	case kRubyGPUParamVAStart:
+		*value = RUBYGPU_UC_VA_MIN;
+		return RUBYGPU_OK;
+	case kRubyGPUParamVARange:
+		*value = RUBYGPU_UC_VA_LIMIT - RUBYGPU_UC_VA_MIN;
+		return RUBYGPU_OK;
+	case kRubyGPUParamPowered:
+		*value = sweet_pwr2_ready ? 1 : 0;
+		return RUBYGPU_OK;
+	case kRubyGPUParamIRQIntID:
+		*value = SWEET_P2C_C2_JOB_INTID;
+		return RUBYGPU_OK;
+	case kRubyGPUParamVersion:
+		*value = RUBYGPU_UC_VERSION;
+		return RUBYGPU_OK;
+	default:
+		return RUBYGPU_E_ARG;
+	}
+}
+
+static IOBufferMemoryDescriptor *
+ruby_gpu_uc_alloc_contig(uint64_t size, bool low4g, uint64_t *phys)
+{
+	int i;
+
+	for (i = 0; i < RUBYGPU_UC_BO_RETRIES; i++) {
+		IOBufferMemoryDescriptor *md;
+		IOByteCount seg = 0;
+		uint64_t pa;
+
+		md = IOBufferMemoryDescriptor::withOptions(
+		    kIODirectionInOut | kIOMemoryPhysicallyContiguous,
+		    (vm_size_t)size, PAGE_SIZE);
+		if (md == NULL) {
+			return NULL;
+		}
+		if (md->prepare(kIODirectionInOut) != kIOReturnSuccess) {
+			md->release();
+			return NULL;
+		}
+		pa = (uint64_t)md->getPhysicalSegment(0, &seg, 0);
+		if (pa != 0 && (uint64_t)seg >= size &&
+		    pa + size <= (1ULL << 40) &&
+		    (!low4g || pa + size <= (1ULL << 32))) {
+			*phys = pa;
+			return md;
+		}
+		md->complete(kIODirectionInOut);
+		md->release();
+	}
+	return NULL;
+}
+
+/*
+ * BO memory: ordinary wired pages (no kIOMemoryPhysicallyContiguous).  The
+ * GPU maps them page by page in ruby_gpu_vm_bind(); the low-4G flag is still
+ * honoured by rejecting any page above 4 GiB.
+ */
+static IOBufferMemoryDescriptor *
+ruby_gpu_uc_alloc_pages(uint64_t size, bool low4g, uint64_t *phys)
+{
+	IOBufferMemoryDescriptor *md;
+	uint64_t off, first = 0, first_seg = 0;
+
+	md = IOBufferMemoryDescriptor::withOptions(kIODirectionInOut,
+	    (vm_size_t)size, PAGE_SIZE);
+	if (md == NULL) {
+		return NULL;
+	}
+	if (md->prepare(kIODirectionInOut) != kIOReturnSuccess) {
+		md->release();
+		return NULL;
+	}
+	for (off = 0; off < size; off += 0x1000ULL) {
+		IOByteCount seg = 0;
+		uint64_t pa = (uint64_t)md->getPhysicalSegment(
+		    (IOByteCount)off, &seg, 0);
+
+		if (pa == 0 || seg < 0x1000ULL || (pa & 0xfffULL) != 0 ||
+		    pa + 0x1000ULL > (1ULL << 40) ||
+		    (low4g && pa + 0x1000ULL > (1ULL << 32))) {
+			md->complete(kIODirectionInOut);
+			md->release();
+			return NULL;
+		}
+		if (off == 0) {
+			first = pa;
+			first_seg = (uint64_t)seg;
+		}
+	}
+	if (first_seg < size) {
+		IOLog("RGDIAG sg bo size=%llu first=0x%llx seg0=0x%llx\n",
+		    (unsigned long long)size, (unsigned long long)first,
+		    (unsigned long long)first_seg);
+	}
+	if (phys != NULL) {
+		*phys = first;
+	}
+	return md;
+}
+
+static ruby_gpu_bo_slot *
+ruby_gpu_uc_bo_at(uint32_t slot)
+{
+	if (s_uc_bo == NULL || slot >= s_uc_bo_cap) {
+		return NULL;
+	}
+	return s_uc_bo[slot];
+}
+
+static ruby_gpu_bo_slot *
+ruby_gpu_uc_bo_lookup(uint32_t handle, uint32_t *slot_out)
+{
+	uint32_t slot = handle - 1;
+	ruby_gpu_bo_slot *bo;
+
+	if (handle == 0) {
+		return NULL;
+	}
+	bo = ruby_gpu_uc_bo_at(slot);
+	if (bo == NULL || !bo->used) {
+		return NULL;
+	}
+	if (slot_out != NULL) {
+		*slot_out = slot;
+	}
+	return bo;
+}
+
+/* Caller holds s_uc_lock.  Returns the new capacity or 0 on failure. */
+static uint32_t
+ruby_gpu_uc_bo_table_grow(void)
+{
+	uint32_t cap = (s_uc_bo_cap == 0) ? RUBYGPU_UC_MAX_BO_INIT : s_uc_bo_cap * 2;
+	ruby_gpu_bo_slot **tbl;
+
+	if (cap > s_uc_cfg_bo_max) {
+		cap = s_uc_cfg_bo_max;
+	}
+	if (cap <= s_uc_bo_cap) {
+		return 0;
+	}
+	tbl = (ruby_gpu_bo_slot **)IOMallocData(cap * sizeof(*tbl));
+	if (tbl == NULL) {
+		IOLog("RGDIAG bo table grow cap=%u failed\n", cap);
+		return 0;
+	}
+	bzero(tbl, cap * sizeof(*tbl));
+	if (s_uc_bo != NULL) {
+		memcpy(tbl, s_uc_bo, s_uc_bo_cap * sizeof(*tbl));
+		IOFreeData(s_uc_bo, s_uc_bo_cap * sizeof(*s_uc_bo));
+	}
+	s_uc_bo = tbl;
+	s_uc_bo_cap = cap;
+	IOLog("RGDIAG bo table cap=%u\n", cap);
+	return cap;
+}
+
+int
+ruby_gpu_bo_create(uint32_t client, uint64_t size, uint32_t flags,
+    uint32_t *handle, uint64_t *phys)
+{
+	IOBufferMemoryDescriptor *md;
+	ruby_gpu_bo_slot *bo;
+	uint64_t pa = 0;
+	uint32_t i, slot = 0;
+	bool have_slot = false;
+
+	if (size == 0 || size > RUBYGPU_UC_BO_MAX || (size & 0xfffull) != 0 ||
+	    handle == NULL) {
+		return RUBYGPU_E_ARG;
+	}
+	IOLockLock(ruby_gpu_uc_lock());
+	ruby_gpu_uc_config();
+	if (s_uc_bo_cap == 0 && ruby_gpu_uc_bo_table_grow() == 0) {
+		IOLockUnlock(ruby_gpu_uc_lock());
+		return RUBYGPU_E_NORES;
+	}
+	for (i = 0; i < s_uc_bo_cap; i++) {
+		if (s_uc_bo[i] == NULL) {
+			slot = i;
+			have_slot = true;
+			break;
+		}
+	}
+	if (!have_slot && s_uc_bo_cap < s_uc_cfg_bo_max &&
+	    ruby_gpu_uc_bo_table_grow() != 0) {
+		for (i = 0; i < s_uc_bo_cap; i++) {
+			if (s_uc_bo[i] == NULL) {
+				slot = i;
+				have_slot = true;
+				break;
+			}
+		}
+	}
+	if (!have_slot) {
+		IOLockUnlock(ruby_gpu_uc_lock());
+		IOLog("RGDIAG bo exhausted cap=%u used=%u\n", s_uc_bo_cap,
+		    s_uc_bo_count);
+		return RUBYGPU_E_NORES;
+	}
+	if (s_uc_bo_bytes + size > s_uc_cfg_bo_total) {
+		IOLockUnlock(ruby_gpu_uc_lock());
+		IOLog("RGDIAG bo quota size=%llu used=%llu max=%llu\n",
+		    (unsigned long long)size, (unsigned long long)s_uc_bo_bytes,
+		    (unsigned long long)s_uc_cfg_bo_total);
+		return RUBYGPU_E_NORES;
+	}
+	md = ruby_gpu_uc_alloc_pages(size, (flags & kRubyGPUBOFlagLow4G) != 0, &pa);
+	if (md == NULL) {
+		IOLockUnlock(ruby_gpu_uc_lock());
+		return RUBYGPU_E_NORES;
+	}
+	bo = (ruby_gpu_bo_slot *)IOMallocData(sizeof(*bo));
+	if (bo == NULL) {
+		md->complete(kIODirectionInOut);
+		md->release();
+		IOLockUnlock(ruby_gpu_uc_lock());
+		return RUBYGPU_E_NORES;
+	}
+	bzero(bo, sizeof(*bo));
+	bo->md = md;
+	bo->size = size;
+	bo->flags = flags;
+	bo->owner = client;
+	bo->used = true;
+	bo->prepared = true;
+	s_uc_bo[slot] = bo;
+	s_uc_bo_count++;
+	s_uc_bo_bytes += size;
+	*handle = slot + 1;
+	if (phys != NULL) {
+		*phys = pa;
+	}
+	IOLockUnlock(ruby_gpu_uc_lock());
+	return RUBYGPU_OK;
+}
+
+int
+ruby_gpu_bo_create_from_surface(uint32_t client, uint32_t surface_id,
+    uint32_t flags, uint64_t size, uint32_t *handle, uint64_t *out_size,
+    uint64_t *phys)
+{
+	SweetSurface *surface;
+	ruby_gpu_bo_slot *bo;
+	uint64_t pa = 0, alloc_size;
+	uint32_t i, slot = 0;
+	bool have_slot = false;
+
+	(void)flags;
+	if (handle == NULL || surface_id == 0) {
+		return RUBYGPU_E_ARG;
+	}
+	surface = sweet_surface_copy(surface_id);
+	if (surface == NULL || surface->memory == NULL) {
+		if (surface != NULL) {
+			surface->release();
+		}
+		return RUBYGPU_E_NOENT;
+	}
+	/* Only the task that created the surface may expose it to the GPU; a
+	 * surface id alone must not let another process map its memory. */
+	if (!sweet_surface_owned_by(surface, current_task())) {
+		surface->release();
+		IOLog("RGDIAG bo import surface=%u denied (owner mismatch)\n",
+		    surface_id);
+		return RUBYGPU_E_PERM;
+	}
+	alloc_size = surface->allocSize;
+	if (size == 0) {
+		size = alloc_size;
+	}
+	if (size == 0 || size > RUBYGPU_UC_BO_MAX || (size & 0xfffull) != 0 ||
+	    size > alloc_size) {
+		surface->release();
+		return RUBYGPU_E_ARG;
+	}
+	IOLockLock(ruby_gpu_uc_lock());
+	ruby_gpu_uc_config();
+	if (s_uc_bo_cap == 0 && ruby_gpu_uc_bo_table_grow() == 0) {
+		IOLockUnlock(ruby_gpu_uc_lock());
+		surface->release();
+		return RUBYGPU_E_NORES;
+	}
+	for (i = 0; i < s_uc_bo_cap; i++) {
+		if (s_uc_bo[i] == NULL) {
+			slot = i;
+			have_slot = true;
+			break;
+		}
+	}
+	if (!have_slot && s_uc_bo_cap < s_uc_cfg_bo_max &&
+	    ruby_gpu_uc_bo_table_grow() != 0) {
+		for (i = 0; i < s_uc_bo_cap; i++) {
+			if (s_uc_bo[i] == NULL) {
+				slot = i;
+				have_slot = true;
+				break;
+			}
+		}
+	}
+	if (!have_slot || s_uc_bo_bytes + size > s_uc_cfg_bo_total) {
+		IOLockUnlock(ruby_gpu_uc_lock());
+		surface->release();
+		return RUBYGPU_E_NORES;
+	}
+	bo = (ruby_gpu_bo_slot *)IOMallocData(sizeof(*bo));
+	if (bo == NULL) {
+		IOLockUnlock(ruby_gpu_uc_lock());
+		surface->release();
+		return RUBYGPU_E_NORES;
+	}
+	surface->memory->retain();
+	bzero(bo, sizeof(*bo));
+	bo->md = surface->memory;
+	bo->surface = surface;
+	bo->size = size;
+	bo->owner = client;
+	bo->used = true;
+	bo->prepared = false;
+	s_uc_bo[slot] = bo;
+	s_uc_bo_count++;
+	s_uc_bo_bytes += size;
+	*handle = slot + 1;
+	if (out_size != NULL) {
+		*out_size = size;
+	}
+	IOLog("RGDIAG bo import surface=%u handle=%u size=%llu\n", surface_id,
+	    slot + 1, (unsigned long long)size);
+	if (phys != NULL) {
+		IOByteCount seg = 0;
+		uint64_t p = (uint64_t)bo->md->getPhysicalSegment(0, &seg, 0);
+
+		if (p != 0) {
+			pa = p;
+		}
+		*phys = pa;
+	}
+	IOLockUnlock(ruby_gpu_uc_lock());
+	return RUBYGPU_OK;
+}
+
+int
+ruby_gpu_bo_release(uint32_t client, uint32_t handle)
+{
+	ruby_gpu_bo_slot *bo;
+	uint32_t slot = 0;
+	int ret = RUBYGPU_OK;
+
+	IOLockLock(ruby_gpu_uc_lock());
+	bo = ruby_gpu_uc_bo_lookup(handle, &slot);
+	if (bo == NULL || bo->owner != client) {
+		ret = RUBYGPU_E_NOENT;
+	} else {
+		if (bo->prepared) {
+			bo->md->complete(kIODirectionInOut);
+		}
+		bo->md->release();
+		if (bo->surface != NULL) {
+			bo->surface->release();
+		}
+		s_uc_bo_bytes -= bo->size;
+		s_uc_bo_count--;
+		IOFreeData(bo, sizeof(*bo));
+		s_uc_bo[slot] = NULL;
+	}
+	IOLockUnlock(ruby_gpu_uc_lock());
+	return ret;
+}
+
+IOMemoryDescriptor *
+ruby_gpu_bo_descriptor(uint32_t client, uint32_t handle)
+{
+	IOMemoryDescriptor *md = NULL;
+	ruby_gpu_bo_slot *bo;
+
+	IOLockLock(ruby_gpu_uc_lock());
+	bo = ruby_gpu_uc_bo_lookup(handle, NULL);
+	if (bo != NULL && bo->owner == client) {
+		md = bo->md;
+		md->retain();
+	}
+	IOLockUnlock(ruby_gpu_uc_lock());
+	return md;
+}
+
+static uint8_t *
+ruby_gpu_uc_bo_kva(ruby_gpu_bo_slot *bo)
+{
+	IOBufferMemoryDescriptor *buffer;
+
+	if (bo == NULL || bo->md == NULL) {
+		return NULL;
+	}
+	if (bo->surface != NULL) {
+		return (uint8_t *)bo->surface->kernelAddress();
+	}
+	buffer = OSDynamicCast(IOBufferMemoryDescriptor, bo->md);
+	return (buffer != NULL) ? (uint8_t *)buffer->getBytesNoCopy() : NULL;
+}
+
+int
+ruby_gpu_bo_sync(uint32_t client, uint32_t handle, uint64_t offset,
+    uint64_t size, uint32_t dir)
+{
+	ruby_gpu_bo_slot *bo;
+	uint8_t *base;
+
+	if (dir > kRubyGPUSyncInOut) {
+		return RUBYGPU_E_ARG;
+	}
+	IOLockLock(ruby_gpu_uc_lock());
+	bo = ruby_gpu_uc_bo_lookup(handle, NULL);
+	if (bo == NULL || bo->owner != client || size == 0 ||
+	    offset > bo->size || offset + size > bo->size) {
+		IOLockUnlock(ruby_gpu_uc_lock());
+		return RUBYGPU_E_ARG;
+	}
+	base = ruby_gpu_uc_bo_kva(bo);
+	if (base == NULL) {
+		IOLockUnlock(ruby_gpu_uc_lock());
+		return RUBYGPU_E_IO;
+	}
+	(void)bo->md->performOperation(kIOMemoryIncoherentIOFlush,
+	    (IOByteCount)offset, (IOByteCount)size);
+	flush_dcache((vm_offset_t)(base + offset), (unsigned int)size, FALSE);
+	IOLockUnlock(ruby_gpu_uc_lock());
+	return RUBYGPU_OK;
+}
+
+static ruby_gpu_vm_slot *
+ruby_gpu_uc_vm_lookup(uint32_t handle)
+{
+	uint32_t slot = handle - 1;
+
+	if (handle == 0 || slot >= RUBYGPU_UC_MAX_VM || !s_uc_vm[slot].used) {
+		return NULL;
+	}
+	return &s_uc_vm[slot];
+}
+
+static uint8_t *
+ruby_gpu_uc_vm_page_va(ruby_gpu_vm_slot *vm, uint32_t idx)
+{
+	uint32_t i;
+
+	for (i = 0; i < vm->nchunks; i++) {
+		struct ruby_gpu_vm_chunk *c = &vm->chunks[i];
+
+		if (idx >= c->page_base && idx < c->page_base + c->pages) {
+			return c->va + (uint64_t)(idx - c->page_base) * 0x1000ULL;
+		}
+	}
+	return NULL;
+}
+
+static uint64_t
+ruby_gpu_uc_vm_page_phys(ruby_gpu_vm_slot *vm, uint32_t idx)
+{
+	uint32_t i;
+
+	for (i = 0; i < vm->nchunks; i++) {
+		struct ruby_gpu_vm_chunk *c = &vm->chunks[i];
+
+		if (idx >= c->page_base && idx < c->page_base + c->pages) {
+			return c->phys + (uint64_t)(idx - c->page_base) * 0x1000ULL;
+		}
+	}
+	return 0;
+}
+
+static uint8_t *
+ruby_gpu_uc_vm_phys_va(ruby_gpu_vm_slot *vm, uint64_t phys)
+{
+	uint32_t i;
+
+	for (i = 0; i < vm->nchunks; i++) {
+		struct ruby_gpu_vm_chunk *c = &vm->chunks[i];
+
+		if (phys >= c->phys &&
+		    phys < c->phys + (uint64_t)c->pages * 0x1000ULL) {
+			return c->va + (phys - c->phys);
+		}
+	}
+	return NULL;
+}
+
+static void
+ruby_gpu_uc_vm_free_chunks(ruby_gpu_vm_slot *vm)
+{
+	uint32_t i;
+
+	for (i = 0; i < vm->nchunks; i++) {
+		if (vm->chunks[i].md != NULL) {
+			vm->chunks[i].md->complete(kIODirectionInOut);
+			vm->chunks[i].md->release();
+		}
+	}
+	vm->nchunks = 0;
+}
+
+static void
+ruby_gpu_uc_vm_flush(ruby_gpu_vm_slot *vm)
+{
+	uint32_t i;
+
+	for (i = 0; i < vm->nchunks; i++) {
+		struct ruby_gpu_vm_chunk *c = &vm->chunks[i];
+
+		if (c->pages != 0) {
+			flush_dcache((vm_offset_t)c->va,
+			    (unsigned int)(c->pages * 0x1000ULL), FALSE);
+		}
+	}
+}
+
+/* Caller holds s_uc_lock. */
+static bool
+ruby_gpu_uc_vm_add_chunk(ruby_gpu_vm_slot *vm, uint32_t cap_pages)
+{
+	IOBufferMemoryDescriptor *md;
+	struct ruby_gpu_vm_chunk *c;
+	uint64_t phys = 0;
+	uint32_t idx = vm->nchunks;
+
+	if (idx >= RUBYGPU_UC_MAX_VM_CHUNKS || cap_pages == 0) {
+		return false;
+	}
+	md = ruby_gpu_uc_alloc_contig((uint64_t)cap_pages * 0x1000ULL, false,
+	    &phys);
+	if (md == NULL) {
+		IOLog("RGDIAG vm chunk alloc %u pages failed\n", cap_pages);
+		return false;
+	}
+	c = &vm->chunks[idx];
+	c->md = md;
+	c->phys = phys;
+	c->va = (uint8_t *)md->getBytesNoCopy();
+	if (c->va == NULL) {
+		md->complete(kIODirectionInOut);
+		md->release();
+		bzero(c, sizeof(*c));
+		return false;
+	}
+	c->page_base = vm->pool_pages;
+	c->pages = 0;
+	c->cap_pages = cap_pages;
+	vm->nchunks = idx + 1;
+	return true;
+}
+
+/* Caller holds s_uc_lock.  Returns 0xffffffff on exhaustion. */
+static uint32_t
+ruby_gpu_uc_vm_alloc_page(ruby_gpu_vm_slot *vm)
+{
+	struct ruby_gpu_vm_chunk *c;
+	uint32_t idx = vm->pool_pages;
+	uint32_t cap;
+	uint32_t limit = s_uc_cfg_vm_legacy ? RUBYGPU_UC_VM_CHUNK_PAGES :
+	    s_uc_cfg_vm_pages;
+
+	if (idx >= limit) {
+		IOLog("RGDIAG vm pool exhausted (%u pages, next %u)\n",
+		    limit, idx);
+		return 0xffffffffu;
+	}
+	if (vm->nchunks == 0) {
+		cap = s_uc_cfg_vm_pages - idx;
+		if (cap > RUBYGPU_UC_VM_FIRST_PAGES) {
+			cap = RUBYGPU_UC_VM_FIRST_PAGES;
+		}
+		if (!ruby_gpu_uc_vm_add_chunk(vm, cap)) {
+			return 0xffffffffu;
+		}
+	} else {
+		c = &vm->chunks[vm->nchunks - 1];
+		if (c->pages == c->cap_pages) {
+			cap = s_uc_cfg_vm_pages - idx;
+			if (cap > RUBYGPU_UC_VM_CHUNK_PAGES) {
+				cap = RUBYGPU_UC_VM_CHUNK_PAGES;
+			}
+			if (!ruby_gpu_uc_vm_add_chunk(vm, cap)) {
+				return 0xffffffffu;
+			}
+		}
+	}
+	c = &vm->chunks[vm->nchunks - 1];
+	bzero(c->va + (uint64_t)c->pages * 0x1000ULL, 0x1000);
+	c->pages++;
+	vm->pool_pages++;
+	return idx;
+}
+
+static uint64_t *
+ruby_gpu_uc_vm_l3(ruby_gpu_vm_slot *vm, uint64_t va, bool create)
+{
+	uint64_t *tbl = (uint64_t *)(void *)ruby_gpu_uc_vm_page_va(vm, 0);
+	int level;
+
+	if (tbl == NULL) {
+		return NULL;
+	}
+	for (level = 0; level < 3; level++) {
+		uint32_t idx = (uint32_t)((va >> (39 - 9 * level)) & 0x1ff);
+		uint64_t entry = tbl[idx];
+
+		if ((entry & 1ULL) == 0) {
+			uint32_t child;
+			uint64_t child_phys;
+			uint8_t *child_va;
+
+			if (!create) {
+				return NULL;
+			}
+			child = ruby_gpu_uc_vm_alloc_page(vm);
+			if (child == 0xffffffffu) {
+				return NULL;
+			}
+			child_phys = ruby_gpu_uc_vm_page_phys(vm, child);
+			child_va = ruby_gpu_uc_vm_page_va(vm, child);
+			if (child_phys == 0 || child_va == NULL) {
+				return NULL;
+			}
+			tbl[idx] = child_phys | RUBYGPU_PTE_TABLE;
+			tbl = (uint64_t *)(void *)child_va;
+		} else {
+			uint64_t child_phys = entry & RUBYGPU_PA_MASK;
+			uint8_t *child_va = ruby_gpu_uc_vm_phys_va(vm, child_phys);
+
+			if (child_va == NULL) {
+				return NULL;
+			}
+			tbl = (uint64_t *)(void *)child_va;
+		}
+	}
+	return tbl;
+}
+
+static int
+ruby_gpu_uc_as_flush(void)
+{
+	volatile uint32_t *gpu = sweet_gpu_regs;
+
+	if (gpu == NULL) {
+		return RUBYGPU_E_IO;
+	}
+	if (!sweet_pwr2_wait_bits(gpu, SWEET_P2C_AS_BASE + 0x28, 0x1u, 0, 10)) {
+		return RUBYGPU_E_IO;
+	}
+	/* Whole-space 2^44 flush, then FLUSH_MEM which releases the lock. */
+	sweet_pwr_wr(gpu, SWEET_P2C_AS_BASE + 0x10, 43);
+	sweet_pwr_wr(gpu, SWEET_P2C_AS_BASE + 0x14, 0);
+	sweet_pwr_wr(gpu, SWEET_P2C_AS_BASE + 0x18, 2);   /* LOCK */
+	if (!sweet_pwr2_wait_bits(gpu, SWEET_P2C_AS_BASE + 0x28, 0x1u, 0, 10)) {
+		return RUBYGPU_E_IO;
+	}
+	sweet_pwr_wr(gpu, SWEET_P2C_AS_BASE + 0x18, 5);   /* FLUSH_MEM */
+	if (!sweet_pwr2_wait_bits(gpu, SWEET_P2C_AS_BASE + 0x28, 0x1u, 0, 10)) {
+		return RUBYGPU_E_IO;
+	}
+	return RUBYGPU_OK;
+}
+
+static int
+ruby_gpu_uc_as_program(uint64_t pgd, bool flush_mmu)
+{
+	volatile uint32_t *gpu = sweet_gpu_regs;
+	uint64_t prev = s_uc_active_pgd;
+
+	if (gpu == NULL) {
+		return RUBYGPU_E_IO;
+	}
+	/*
+	 * Always re-issue AS_COMMAND_UPDATE, even for the active root: the
+	 * MMU caches translations, and PanVK binds BOs lazily between submits.
+	 * Without the broadcast, a VA first walked as unmapped keeps faulting
+	 * after it is bound (P0.2 issued UPDATE on every bind).
+	 */
+	if (!sweet_pwr2_wait_bits(gpu, SWEET_P2C_AS_BASE + 0x28, 0x1u, 0, 10)) {
+		return RUBYGPU_E_IO;
+	}
+	sweet_pwr_wr(gpu, SWEET_P2C_AS_BASE + 0x30, 0x42000006u);
+	sweet_pwr_wr(gpu, SWEET_P2C_AS_BASE + 0x34, 0);
+	sweet_pwr_wr(gpu, SWEET_P2C_AS_BASE + 0x00, (uint32_t)pgd);
+	sweet_pwr_wr(gpu, SWEET_P2C_AS_BASE + 0x04, (uint32_t)(pgd >> 32));
+	sweet_pwr_wr(gpu, SWEET_P2C_AS_BASE + 0x08, 0x888d8f88u);
+	sweet_pwr_wr(gpu, SWEET_P2C_AS_BASE + 0x0c, 0x4c8du);
+	sweet_pwr_wr(gpu, SWEET_P2C_AS_BASE + 0x18, 1);
+	if (!sweet_pwr2_wait_bits(gpu, SWEET_P2C_AS_BASE + 0x28, 0x1u, 0, 10)) {
+		return RUBYGPU_E_IO;
+	}
+	/*
+	 * A new TRANSTAB alone leaves stale translations from the previous
+	 * VM in the MMU caches (DATA_INVALID faults on the second client).
+	 */
+	if (flush_mmu) {
+		int ret = ruby_gpu_uc_as_flush();
+
+		if (ret != RUBYGPU_OK) {
+			return ret;
+		}
+	}
+	if (ruby_gpu_drv_diag()) {
+		IOLog("RGDIAG as pgd=0x%llx prev=0x%llx flush=%d\n",
+		    (unsigned long long)pgd, (unsigned long long)prev,
+		    flush_mmu ? 1 : 0);
+	}
+	s_uc_active_pgd = pgd;
+	return RUBYGPU_OK;
+}
+
+static void
+ruby_gpu_uc_as_unmap(void)
+{
+	volatile uint32_t *gpu = sweet_gpu_regs;
+
+	if (gpu == NULL) {
+		return;
+	}
+	(void)sweet_pwr2_wait_bits(gpu, SWEET_P2C_AS_BASE + 0x28, 0x1u, 0, 10);
+	sweet_pwr_wr(gpu, SWEET_P2C_AS_BASE + 0x00, 0);
+	sweet_pwr_wr(gpu, SWEET_P2C_AS_BASE + 0x04, 0);
+	sweet_pwr_wr(gpu, SWEET_P2C_AS_BASE + 0x30, 1);
+	sweet_pwr_wr(gpu, SWEET_P2C_AS_BASE + 0x34, 0);
+	(void)sweet_pwr2_wait_bits(gpu, SWEET_P2C_AS_BASE + 0x28, 0x1u, 0, 10);
+	sweet_pwr_wr(gpu, SWEET_P2C_AS_BASE + 0x18, 1);
+	s_uc_active_pgd = 0;
+}
+
+int
+ruby_gpu_vm_create(uint32_t client, uint64_t va_start, uint64_t va_size,
+    uint32_t *handle)
+{
+	ruby_gpu_vm_slot *vm;
+	int i, slot = -1;
+
+	if (handle == NULL || va_size == 0 || (va_start & 0xfffull) != 0 ||
+	    (va_size & 0xfffull) != 0 || va_start < RUBYGPU_UC_VA_MIN ||
+	    va_start + va_size > RUBYGPU_UC_VA_LIMIT) {
+		return RUBYGPU_E_ARG;
+	}
+	if (!sweet_pwr2_ready) {
+		return RUBYGPU_E_NOPWR;
+	}
+	IOLockLock(ruby_gpu_uc_lock());
+	ruby_gpu_uc_config();
+	for (i = 0; i < RUBYGPU_UC_MAX_VM; i++) {
+		if (!s_uc_vm[i].used) {
+			slot = i;
+			break;
+		}
+	}
+	if (slot < 0) {
+		IOLockUnlock(ruby_gpu_uc_lock());
+		return RUBYGPU_E_NORES;
+	}
+	vm = &s_uc_vm[slot];
+	bzero(vm, sizeof(*vm));
+	if (!ruby_gpu_uc_vm_add_chunk(vm, s_uc_cfg_vm_legacy ?
+	    RUBYGPU_UC_VM_CHUNK_PAGES : RUBYGPU_UC_VM_FIRST_PAGES) ||
+	    ruby_gpu_uc_vm_alloc_page(vm) == 0xffffffffu) {
+		ruby_gpu_uc_vm_free_chunks(vm);
+		bzero(vm, sizeof(*vm));
+		IOLockUnlock(ruby_gpu_uc_lock());
+		return RUBYGPU_E_NORES;
+	}
+	vm->root_phys = ruby_gpu_uc_vm_page_phys(vm, 0);
+	vm->owner = client;
+	vm->va_start = va_start;
+	vm->va_size = va_size;
+	vm->used = true;
+	*handle = (uint32_t)(slot + 1);
+	IOLockUnlock(ruby_gpu_uc_lock());
+	return RUBYGPU_OK;
+}
+
+int
+ruby_gpu_vm_destroy(uint32_t client, uint32_t handle)
+{
+	ruby_gpu_vm_slot *vm;
+
+	IOLockLock(ruby_gpu_uc_lock());
+	vm = ruby_gpu_uc_vm_lookup(handle);
+	if (vm == NULL || vm->owner != client) {
+		IOLockUnlock(ruby_gpu_uc_lock());
+		return RUBYGPU_E_NOENT;
+	}
+	if (s_uc_active_pgd == vm->root_phys) {
+		ruby_gpu_uc_as_unmap();
+	}
+	ruby_gpu_uc_vm_free_chunks(vm);
+	bzero(vm, sizeof(*vm));
+	IOLockUnlock(ruby_gpu_uc_lock());
+	return RUBYGPU_OK;
+}
+
+int
+ruby_gpu_vm_bind(uint32_t client, uint32_t vmh, uint32_t boh, uint64_t va,
+    uint64_t bo_offset, uint64_t size)
+{
+	ruby_gpu_vm_slot *vm;
+	ruby_gpu_bo_slot *bo;
+	uint64_t i;
+	int ret;
+
+	if (size == 0 || (va & 0xfffull) != 0 || (bo_offset & 0xfffull) != 0 ||
+	    (size & 0xfffull) != 0) {
+		return RUBYGPU_E_ARG;
+	}
+	IOLockLock(ruby_gpu_uc_lock());
+	vm = ruby_gpu_uc_vm_lookup(vmh);
+	bo = ruby_gpu_uc_bo_lookup(boh, NULL);
+	if (vm == NULL || bo == NULL || vm->owner != client ||
+	    bo->owner != client || bo_offset + size > bo->size ||
+	    va < vm->va_start || va + size > vm->va_start + vm->va_size) {
+		IOLockUnlock(ruby_gpu_uc_lock());
+		return RUBYGPU_E_ARG;
+	}
+	for (i = 0; i < size; i += 0x1000ULL) {
+		IOByteCount seg = 0;
+		uint64_t pa = (uint64_t)bo->md->getPhysicalSegment(
+		    (IOByteCount)(bo_offset + i), &seg, 0);
+		uint64_t *l3;
+		uint32_t idx;
+
+		if (pa == 0 || seg < 0x1000ULL || (pa & 0xfffULL) != 0 ||
+		    pa + 0x1000ULL > (1ULL << 40)) {
+			ret = RUBYGPU_E_IO;
+			goto fail;
+		}
+		l3 = ruby_gpu_uc_vm_l3(vm, va + i, true);
+		if (l3 == NULL) {
+			ret = RUBYGPU_E_NORES;
+			goto fail;
+		}
+		idx = (uint32_t)(((va + i) >> 12) & 0x1ff);
+		l3[idx] = pa | RUBYGPU_ATE_PAGE;
+	}
+	if (ruby_gpu_drv_diag()) {
+		IOLog("RGDIAG bind vm=%u va=0x%llx size=0x%llx pages=%u "
+		    "chunks=%u legacy=%d\n", vmh, (unsigned long long)va,
+		    (unsigned long long)size, vm->pool_pages, vm->nchunks,
+		    s_uc_cfg_vm_legacy);
+	}
+	ruby_gpu_uc_vm_flush(vm);
+	ret = ruby_gpu_uc_as_program(vm->root_phys, false);
+	IOLockUnlock(ruby_gpu_uc_lock());
+	return ret;
+
+fail:
+	for (uint64_t j = 0; j < i; j += 0x1000ULL) {
+		uint64_t *l3 = ruby_gpu_uc_vm_l3(vm, va + j, false);
+		uint32_t idx = (uint32_t)(((va + j) >> 12) & 0x1ff);
+
+		if (l3 != NULL) {
+			l3[idx] = 0;
+		}
+	}
+	ruby_gpu_uc_vm_flush(vm);
+	(void)ruby_gpu_uc_as_program(vm->root_phys, false);
+	IOLockUnlock(ruby_gpu_uc_lock());
+	return ret;
+}
+
+int
+ruby_gpu_vm_unbind(uint32_t client, uint32_t vmh, uint64_t va, uint64_t size)
+{
+	ruby_gpu_vm_slot *vm;
+	uint64_t i;
+	int ret;
+
+	if (size == 0 || (va & 0xfffull) != 0 || (size & 0xfffull) != 0) {
+		return RUBYGPU_E_ARG;
+	}
+	IOLockLock(ruby_gpu_uc_lock());
+	vm = ruby_gpu_uc_vm_lookup(vmh);
+	if (vm == NULL || vm->owner != client) {
+		IOLockUnlock(ruby_gpu_uc_lock());
+		return RUBYGPU_E_NOENT;
+	}
+	for (i = 0; i < size; i += 0x1000ULL) {
+		uint64_t *l3 = ruby_gpu_uc_vm_l3(vm, va + i, false);
+		uint32_t idx = (uint32_t)(((va + i) >> 12) & 0x1ff);
+
+		if (l3 != NULL) {
+			l3[idx] = 0;
+		}
+	}
+	ruby_gpu_uc_vm_flush(vm);
+	if (s_uc_active_pgd == vm->root_phys) {
+		ret = ruby_gpu_uc_as_flush();
+	} else {
+		ret = RUBYGPU_OK;
+	}
+	IOLockUnlock(ruby_gpu_uc_lock());
+	return ret;
+}
+
+static int
+ruby_gpu_bo_find_offset(ruby_gpu_bo_slot *bo, uint64_t pa, uint64_t *bo_off,
+    uint64_t *seg_base)
+{
+	uint64_t off = 0;
+
+	if (bo == NULL || bo->md == NULL) {
+		return 0;
+	}
+	while (off < bo->size) {
+		IOByteCount seg = 0;
+		uint64_t p = (uint64_t)bo->md->getPhysicalSegment(
+		    (IOByteCount)off, &seg, 0);
+
+		if (p == 0 || seg == 0) {
+			return 0;
+		}
+		if (off + seg > bo->size) {
+			seg = (IOByteCount)(bo->size - off);
+		}
+		if (pa >= p && pa < p + seg) {
+			if (bo_off != NULL) {
+				*bo_off = off + (pa - p);
+			}
+			if (seg_base != NULL) {
+				*seg_base = p;
+			}
+			return 1;
+		}
+		off += seg;
+	}
+	return 0;
+}
+
+static void
+ruby_gpu_uc_vm_walk_dump(ruby_gpu_vm_slot *vm, uint64_t va)
+{
+	uint64_t *tbl = (uint64_t *)(void *)ruby_gpu_uc_vm_page_va(vm, 0);
+	uint64_t e0 = 0, e1 = 0, e2 = 0, e3 = 0;
+	int level;
+
+	if (tbl == NULL) {
+		return;
+	}
+	for (level = 0; level < 3; level++) {
+		uint32_t idx = (uint32_t)((va >> (39 - 9 * level)) & 0x1ff);
+		uint64_t e = tbl[idx];
+		uint8_t *child;
+
+		if (level == 0) {
+			e0 = e;
+		} else if (level == 1) {
+			e1 = e;
+		} else {
+			e2 = e;
+		}
+		if ((e & 1ULL) == 0) {
+			break;
+		}
+		child = ruby_gpu_uc_vm_phys_va(vm, e & RUBYGPU_PA_MASK);
+		if (child == NULL) {
+			break;
+		}
+		tbl = (uint64_t *)(void *)child;
+	}
+	if (level >= 3) {
+		e3 = tbl[(uint32_t)((va >> 12) & 0x1ff)];
+	}
+	IOLog("RGDIAG walk va=0x%llx e0=0x%llx e1=0x%llx e2=0x%llx "
+	    "e3=0x%llx levels=%d\n", (unsigned long long)va,
+	    (unsigned long long)e0, (unsigned long long)e1,
+	    (unsigned long long)e2, (unsigned long long)e3, level);
+}
+
+static void
+ruby_gpu_uc_dump_failed_submit(ruby_gpu_vm_slot *vm, uint64_t job_va)
+{
+	uint64_t *l3;
+	uint64_t pte = 0, pa = 0, bp = 0, off = 0;
+	uint32_t idx = (uint32_t)((job_va >> 12) & 0x1ff);
+	ruby_gpu_bo_slot *bo = NULL;
+	uint32_t i;
+
+	if (vm == NULL || sweet_gpu_regs == NULL) {
+		return;
+	}
+	l3 = ruby_gpu_uc_vm_l3(vm, job_va, false);
+	if (l3 != NULL) {
+		pte = l3[idx];
+		pa = pte & RUBYGPU_PA_MASK;
+		for (i = 0; i < s_uc_bo_cap; i++) {
+			ruby_gpu_bo_slot *cand = ruby_gpu_uc_bo_at(i);
+			uint64_t bo_off;
+
+			if (cand == NULL || !cand->used || cand->md == NULL) {
+				continue;
+			}
+			if (ruby_gpu_bo_find_offset(cand, pa, &bo_off, &bp)) {
+				bo = cand;
+				off = bo_off + (job_va & 0xfff);
+				break;
+			}
+		}
+	}
+	IOLog("RGDIAG chain pte=0x%llx pa=0x%llx bo_phys=0x%llx size=0x%llx\n",
+	    pte, pa, bp, (bo != NULL) ? bo->size : 0);
+	IOLog("RGDIAG jsfeat js0=0x%x js1=0x%x js2=0x%x\n",
+	    sweet_pwr_rd(sweet_gpu_regs, 0x0c0),
+	    sweet_pwr_rd(sweet_gpu_regs, 0x0c4),
+	    sweet_pwr_rd(sweet_gpu_regs, 0x0c8));
+	{
+		uint32_t asf = sweet_pwr_rd(sweet_gpu_regs,
+		    SWEET_P2C_AS_BASE + 0x1c);
+		uint64_t fa = ((uint64_t)sweet_pwr_rd(sweet_gpu_regs,
+		    SWEET_P2C_AS_BASE + 0x24) << 32) |
+		    sweet_pwr_rd(sweet_gpu_regs, SWEET_P2C_AS_BASE + 0x20);
+
+		IOLog("RGDIAG mmu asf=0x%x fa=0x%llx girq=0x%x mirq=0x%x\n", asf,
+		    (unsigned long long)fa,
+		    sweet_pwr_rd(sweet_gpu_regs, SWEET_P2C_GPUIRQ_RAWSTAT),
+		    sweet_pwr_rd(sweet_gpu_regs, SWEET_P2C_MMUIRQ_BASE +
+		    SWEET_P2C_MMUIRQ_RAWSTAT));
+		if (fa != 0 && fa < RUBYGPU_UC_VA_LIMIT) {
+			ruby_gpu_uc_vm_walk_dump(vm, fa);
+		}
+	}
+	if (bo != NULL) {
+		uint8_t *base = ruby_gpu_uc_bo_kva(bo);
+
+		if (base != NULL && off + 64 <= bo->size) {
+			const uint32_t *w = (const uint32_t *)(void *)(base + off);
+
+			IOLog("RGDIAG chain w0: %08x %08x %08x %08x %08x %08x %08x %08x\n",
+			    w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7]);
+			IOLog("RGDIAG chain w1: %08x %08x %08x %08x %08x %08x %08x %08x\n",
+			    w[8], w[9], w[10], w[11], w[12], w[13], w[14], w[15]);
+		}
+	}
+}
+
+static int
+ruby_gpu_uc_chain_type(ruby_gpu_vm_slot *vm, uint64_t job_va, uint32_t *type)
+{
+	uint64_t *l3;
+	uint64_t pa;
+	uint32_t idx = (uint32_t)((job_va >> 12) & 0x1ff);
+	uint32_t i;
+
+	if (vm == NULL || type == NULL) {
+		return RUBYGPU_E_ARG;
+	}
+	l3 = ruby_gpu_uc_vm_l3(vm, job_va, false);
+	if (l3 == NULL) {
+		return RUBYGPU_E_ARG;
+	}
+	pa = l3[idx] & RUBYGPU_PA_MASK;
+	for (i = 0; i < s_uc_bo_cap; i++) {
+		ruby_gpu_bo_slot *bo = ruby_gpu_uc_bo_at(i);
+		uint64_t bo_off, off;
+		uint8_t *base;
+
+		if (bo == NULL || !bo->used || bo->md == NULL) {
+			continue;
+		}
+		if (!ruby_gpu_bo_find_offset(bo, pa, &bo_off, NULL)) {
+			continue;
+		}
+		off = bo_off + (job_va & 0xfff);
+		base = ruby_gpu_uc_bo_kva(bo);
+		if (base == NULL || off + 20 > bo->size) {
+			return RUBYGPU_E_IO;
+		}
+		/* genxml Job Header: word 4 bit 0 Is64b, type at 4:1..7. */
+		*type = (*(uint32_t *)(void *)(base + off + 16) >> 1) & 0x7f;
+		return RUBYGPU_OK;
+	}
+	return RUBYGPU_E_IO;
+}
+
+static uint32_t
+ruby_gpu_uc_slot_for_type(uint32_t type)
+{
+	switch (type) {
+	case 4:  /* compute */
+	case 5:  /* vertex */
+	case 6:  /* geometry */
+	case 7:  /* tiler */
+	case 10: /* indexed vertex (v9) */
+	case 11: /* malloc vertex (v9) */
+	case 12: /* fullscreen (v9) */
+		return 1;
+	default: /* fragment, write value, cache flush, null */
+		return 0;
+	}
+}
+
+static int
+ruby_gpu_uc_submit_cfg(void)
+{
+	static int alt = -1;
+
+	if (alt < 0) {
+		int on = 0;
+		PE_parse_boot_argn("rubygpujc", &on, sizeof(on));
+		alt = (on != 0) ? 1 : 0;
+	}
+	return alt;
+}
+
+int
+ruby_gpu_submit(uint32_t client, uint32_t vmh, uint64_t job_va,
+    uint32_t flags, uint32_t timeout_ms, struct ruby_gpu_submit_rep *rep)
+{
+	ruby_gpu_vm_slot *vm;
+	RubyGPUIRQ *irq;
+	volatile uint32_t *gpu = sweet_gpu_regs;
+	uint32_t status, raw, js, asf, girq, mirq, jstat;
+	uint32_t slot = 0, js_base, chain_type = 0xffffffffu;
+	bool done;
+
+	(void)flags;
+	if (rep == NULL) {
+		return RUBYGPU_E_ARG;
+	}
+	bzero(rep, sizeof(*rep));
+	if (!sweet_pwr2_ready) {
+		return RUBYGPU_E_NOPWR;
+	}
+	if (timeout_ms == 0 || timeout_ms > 10000) {
+		timeout_ms = RUBYGPU_JOB_TIMEOUT_MS;
+	}
+	IOLockLock(ruby_gpu_uc_lock());
+	vm = ruby_gpu_uc_vm_lookup(vmh);
+	if (vm == NULL || vm->owner != client || gpu == NULL ||
+	    (job_va & 0x3fULL) != 0 || job_va < vm->va_start ||
+	    job_va >= vm->va_start + vm->va_size) {
+		IOLockUnlock(ruby_gpu_uc_lock());
+		return RUBYGPU_E_ARG;
+	}
+	{
+		uint64_t *l3 = ruby_gpu_uc_vm_l3(vm, job_va, false);
+		uint32_t idx = (uint32_t)((job_va >> 12) & 0x1ff);
+
+		if (l3 == NULL || (l3[idx] & 1ULL) == 0) {
+			IOLockUnlock(ruby_gpu_uc_lock());
+			return RUBYGPU_E_ARG;
+		}
+	}
+	if (s_uc_active_pgd != vm->root_phys) {
+		int as_ret = ruby_gpu_uc_as_program(vm->root_phys, true);
+
+		if (as_ret != RUBYGPU_OK) {
+			IOLockUnlock(ruby_gpu_uc_lock());
+			return as_ret;
+		}
+	}
+	if (ruby_gpu_uc_chain_type(vm, job_va, &chain_type) == RUBYGPU_OK) {
+		slot = ruby_gpu_uc_slot_for_type(chain_type);
+	}
+	js_base = SWEET_P2C_JS_SLOT(slot);
+	IOLog("RGDIAG jsroute type=%u slot=%u job=0x%llx\n",
+	    chain_type, slot, job_va);
+	irq = sweet_c2_irq_create();
+	if (irq == NULL) {
+		IOLockUnlock(ruby_gpu_uc_lock());
+		return RUBYGPU_E_IO;
+	}
+	irq->setSlot(slot);
+
+	sweet_pwr_wr(gpu, SWEET_P2C_GPUIRQ_CLEAR, 0xffffffffu);
+	sweet_pwr_wr(gpu, SWEET_P2C_JOBIRQ_BASE + SWEET_P2C_JOBIRQ_CLEAR,
+	    0xffffffffu);
+	sweet_pwr_wr(gpu, SWEET_P2C_MMUIRQ_BASE + SWEET_P2C_MMUIRQ_CLEAR,
+	    0xffffffffu);
+	sweet_pwr_wr(gpu, SWEET_P2C_GPUIRQ_MASK, 0);
+	sweet_pwr_wr(gpu, SWEET_P2C_MMUIRQ_BASE + SWEET_P2C_MMUIRQ_MASK, 0);
+	sweet_pwr_wr(gpu, SWEET_P2C_JOBIRQ_BASE + SWEET_P2C_JOBIRQ_MASK,
+	    SWEET_P2C_JOB_SLOT_MASK(slot));
+	irq->fDone = false;
+
+	sweet_pwr_wr(gpu, js_base + 0x50,
+	    sweet_pwr_rd(gpu, SWEET_PWR2_SHADER_PRESENT));
+	sweet_pwr_wr(gpu, js_base + 0x54,
+	    sweet_pwr_rd(gpu, SWEET_PWR2_SHADER_PRESENT + 4));
+	sweet_pwr_wr(gpu, js_base + 0x40, (uint32_t)job_va);
+	sweet_pwr_wr(gpu, js_base + 0x44, (uint32_t)(job_va >> 32));
+	sweet_pwr_wr(gpu, js_base + 0x58,
+	    ruby_gpu_uc_submit_cfg() ? SWEET_P2C_CFG_ALT : SWEET_P2C_CFG_STD);
+	sweet_pwr_wr(gpu, js_base + 0x60, 1);
+	if (irq->setEnabled(1) != 0) {
+		IOLockUnlock(ruby_gpu_uc_lock());
+		return RUBYGPU_E_IO;
+	}
+	done = irq->waitDone(timeout_ms) == 0;
+	irq->setEnabled(0);
+	status = irq->fStatus;
+	raw = irq->fRaw;
+	js = irq->fJs;
+	asf = irq->fAsf;
+	girq = irq->fGirq;
+	mirq = irq->fMirq;
+	if (!done) {
+		raw = sweet_pwr_rd(gpu, SWEET_P2C_JOBIRQ_BASE +
+		    SWEET_P2C_JOBIRQ_RAWSTAT);
+		js = sweet_pwr_rd(gpu, js_base + 0x24);
+		asf = sweet_pwr_rd(gpu, SWEET_P2C_AS_BASE + 0x1c);
+		girq = sweet_pwr_rd(gpu, SWEET_P2C_GPUIRQ_RAWSTAT);
+		mirq = sweet_pwr_rd(gpu, SWEET_P2C_MMUIRQ_BASE +
+		    SWEET_P2C_MMUIRQ_RAWSTAT);
+	}
+	if (!done || (raw & SWEET_P2C_JOB_DONE_BIT(slot)) == 0 ||
+	    (raw & SWEET_P2C_JOB_FAIL_BIT(slot)) != 0) {
+		ruby_gpu_uc_dump_failed_submit(vm, job_va);
+	}
+	jstat = sweet_pwr_rd(gpu, SWEET_P2C_JOBIRQ_BASE +
+	    SWEET_P2C_JOBIRQ_STATUS);
+	rep->status = (done && (raw & SWEET_P2C_JOB_DONE_BIT(slot)) != 0 &&
+	    (raw & SWEET_P2C_JOB_FAIL_BIT(slot)) == 0) ?
+	    RUBYGPU_OK : RUBYGPU_E_TIMEOUT;
+	rep->hits = irq->fHits;
+	rep->spur = irq->fSpurious;
+	rep->raw = raw;
+	rep->jstat = jstat;
+	rep->js = js;
+	rep->girq = girq;
+	rep->mirq = mirq;
+	(void)status;
+	(void)asf;
+	if (rep->status != RUBYGPU_OK) {
+		sweet_pwr_wr(gpu, js_base + 0x60, 3);
+		IOSleep(10);
+		sweet_pwr_wr(gpu, SWEET_P2C_JOBIRQ_BASE + SWEET_P2C_JOBIRQ_CLEAR,
+		    0xffffffffu);
+		sweet_pwr_wr(gpu, SWEET_P2C_GPUIRQ_CLEAR, 0xffffffffu);
+		sweet_pwr_wr(gpu, SWEET_P2C_MMUIRQ_BASE + SWEET_P2C_MMUIRQ_CLEAR,
+		    0xffffffffu);
+	}
+	IOLockUnlock(ruby_gpu_uc_lock());
+	return rep->status;
+}
+
+void
+ruby_gpu_reset_resources(uint32_t client)
+{
+	ruby_gpu_vm_slot *vm;
+	ruby_gpu_bo_slot *bo;
+	uint32_t i;
+
+	IOLockLock(ruby_gpu_uc_lock());
+	for (i = 0; i < RUBYGPU_UC_MAX_VM; i++) {
+		vm = &s_uc_vm[i];
+		if (!vm->used || vm->owner != client) {
+			continue;
+		}
+		if (s_uc_active_pgd == vm->root_phys) {
+			ruby_gpu_uc_as_unmap();
+		}
+		ruby_gpu_uc_vm_free_chunks(vm);
+		bzero(vm, sizeof(*vm));
+	}
+	for (i = 0; i < s_uc_bo_cap; i++) {
+		bo = ruby_gpu_uc_bo_at(i);
+		if (bo == NULL || !bo->used || bo->owner != client) {
+			continue;
+		}
+		if (bo->prepared) {
+			bo->md->complete(kIODirectionInOut);
+		}
+		bo->md->release();
+		if (bo->surface != NULL) {
+			bo->surface->release();
+		}
+		s_uc_bo_bytes -= bo->size;
+		s_uc_bo_count--;
+		IOFreeData(bo, sizeof(*bo));
+		s_uc_bo[i] = NULL;
+	}
+	IOLockUnlock(ruby_gpu_uc_lock());
+}
+
+bool
+ruby_gpu_client_open(uint32_t *client_id)
+{
+	bool ok = false;
+	uint32_t id = 0;
+
+	if (client_id == NULL) {
+		return false;
+	}
+	IOLockLock(ruby_gpu_uc_lock());
+	ruby_gpu_uc_config();
+	if (!(s_uc_cfg_multi == 0 && s_uc_clients != 0) &&
+	    s_uc_clients < RUBYGPU_UC_MAX_CLIENTS) {
+		id = ++s_uc_client_seq;
+		if (id == 0) {
+			id = ++s_uc_client_seq;
+		}
+		s_uc_clients++;
+		*client_id = id;
+		ok = true;
+	}
+	IOLockUnlock(ruby_gpu_uc_lock());
+	return ok;
+}
+
+void
+ruby_gpu_client_close(uint32_t client_id)
+{
+	(void)client_id;
+	IOLockLock(ruby_gpu_uc_lock());
+	if (s_uc_clients != 0) {
+		s_uc_clients--;
+	}
+	IOLockUnlock(ruby_gpu_uc_lock());
+}
+
+#define kAccelPluginNameKey      "MetalPluginName"
+#define kAccelPluginClassNameKey "MetalPluginClassName"
+#define kAccelPluginName         "RubyMetal"
+#define kAccelPluginClassName    "RubyMetalDevice"
+
+static bool s_accel_props_allowed;
+
+/*
+ * Empty IOAcceleratorES service: Metal/QuartzCore enumerate this class for a
+ * GPU. With no MetalPluginName property it is passed over; rubymetalu=1 lets a
+ * user process install/remove MetalPluginName and MetalPluginClassName here.
+ */
+class IOAcceleratorES : public IOService {
+	OSDeclareDefaultStructors(IOAcceleratorES);
+
+public:
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
+IOReturn
+IOAcceleratorES::setProperties(OSObject *properties)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	OSString *name;
+	OSString *cls;
+
+	if (!s_accel_props_allowed) {
+		IOLog("SWEET GPU: IOAcceleratorES setProperties refused (rubymetalu=0)\n");
+		return kIOReturnUnsupported;
+	}
+	if (dict == NULL) {
+		return kIOReturnBadArgument;
+	}
+	name = OSDynamicCast(OSString, dict->getObject(kAccelPluginNameKey));
+	cls = OSDynamicCast(OSString, dict->getObject(kAccelPluginClassNameKey));
+	if (name == NULL && cls == NULL) {
+		return kIOReturnBadArgument;
+	}
+	if (name != NULL && name->getLength() != 0 &&
+	    !name->isEqualTo(kAccelPluginName)) {
+		IOLog("SWEET GPU: IOAcceleratorES refusing MetalPluginName\n");
+		return kIOReturnBadArgument;
+	}
+	if (cls != NULL && cls->getLength() != 0 &&
+	    !cls->isEqualTo(kAccelPluginClassName)) {
+		IOLog("SWEET GPU: IOAcceleratorES refusing MetalPluginClassName\n");
+		return kIOReturnBadArgument;
+	}
+	if (name != NULL) {
+		if (name->getLength() == 0) {
+			removeProperty(kAccelPluginNameKey);
+			IOLog("SWEET GPU: IOAcceleratorES MetalPluginName removed\n");
+		} else {
+			setProperty(kAccelPluginNameKey, name);
+			IOLog("SWEET GPU: IOAcceleratorES MetalPluginName=%s\n",
+			    kAccelPluginName);
+		}
+	}
+	if (cls != NULL) {
+		if (cls->getLength() == 0) {
+			removeProperty(kAccelPluginClassNameKey);
+			IOLog("SWEET GPU: IOAcceleratorES MetalPluginClassName removed\n");
+		} else {
+			setProperty(kAccelPluginClassNameKey, cls);
+			IOLog("SWEET GPU: IOAcceleratorES MetalPluginClassName=%s\n",
+			    kAccelPluginClassName);
+		}
+	}
+	return kIOReturnSuccess;
+}
+
+OSDefineMetaClassAndStructors(RubyGPU, IOService);
+
+bool
+RubyGPU::start(IOService *provider)
+{
+	return IOService::start(provider);
+}
+
+IOReturn
+RubyGPU::newUserClient(task_t owningTask, void *securityID, UInt32 type,
+    OSDictionary *properties, IOUserClient **handler)
+{
+	RubyGPUUserClient *uc;
+	uint32_t client_id = 0;
+
+	if (handler == NULL) {
+		return kIOReturnBadArgument;
+	}
+	if (!ruby_gpu_client_open(&client_id)) {
+		return kIOReturnExclusiveAccess;
+	}
+	uc = new RubyGPUUserClient;
+	if (uc == NULL) {
+		ruby_gpu_client_close(client_id);
+		return kIOReturnNoMemory;
+	}
+	if (!uc->initWithTask(owningTask, securityID, type, properties)) {
+		uc->release();
+		ruby_gpu_client_close(client_id);
+		return kIOReturnError;
+	}
+	uc->setClientID(client_id);
+	if (!uc->attach(this) || !uc->start(this)) {
+		uc->detach(this);
+		uc->release();
+		ruby_gpu_client_close(client_id);
+		return kIOReturnError;
+	}
+	*handler = uc;
+	return kIOReturnSuccess;
+}
+
+void
+ruby_gpu_service_publish(void)
+{
+	int on = 0;
+	IOService *platform;
+	RubyGPU *svc;
+	bool ok;
+
+	if (s_uc_service != NULL || !sweet_pwr2_ready) {
+		return;
+	}
+	PE_parse_boot_argn("rubygpuuc", &on, sizeof(on));
+	if (on != 1) {
+		return;
+	}
+	(void)ruby_gpu_uc_lock();
+	platform = (IOService *)IOService::getPlatform();
+	svc = new RubyGPU;
+	if (platform == NULL || svc == NULL) {
+		OSSafeReleaseNULL(svc);
+		return;
+	}
+	ok = svc->init() && svc->attach(platform) && svc->start(platform);
+	if (!ok) {
+		IOLog("SWEET GPU: RubyGPU service failed\n");
+		if (svc->getProvider() != NULL) {
+			svc->detach(platform);
+		}
+		svc->release();
+		return;
+	}
+	svc->registerService();
+	s_uc_service = svc;
+	IOLog("SWEET GPU: RubyGPU service up intid=%u gate=rubygpuuc\n",
+	    SWEET_P2C_C2_JOB_INTID);
+
+	PE_parse_boot_argn("rubymetalu", &on, sizeof(on));
+	s_accel_props_allowed = (on != 0);
+	IOAcceleratorES *accel = OSTypeAlloc(IOAcceleratorES);
+	if (accel != NULL && accel->init()) {
+		accel->setName("sgx");
+		if (accel->attach(platform)) {
+			accel->registerService();
+			IOLog("SWEET GPU: empty IOAcceleratorES published "
+			    "(rubymetalu=%d)\n", on);
+		}
+	}
+	OSSafeReleaseNULL(accel);
+}
