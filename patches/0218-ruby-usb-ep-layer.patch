+/*
+ * 0218: EP array + composite descriptor (Linux usb_function analogue).
+ * RUBY_EP_MAX = 16 (MTU3 hardware limit). Each EP owns its queue under
+ * lck_spin_t: enqueue/release runs under lock; the descriptor blob is
+ * assembled from the EP table instead of a hand-kept static array, so
+ * wTotalLength / bNumEndpoints can no longer desync.
+ */
+#define RUBY_EP_MAX         16u
+#define RUBY_EP_DIR_IN      0u
+#define RUBY_EP_DIR_OUT     1u
+#define RUBY_EP_TYPE_CTRL   0u
+#define RUBY_EP_TYPE_BULK   2u
+#define RUBY_EP_TYPE_INTR   3u
+#define RUBY_DESC_MAX       (9 + 9 * 8 + 7 * RUBY_EP_MAX)  /* cfg+ifs+eps */
+
+struct ruby_ep {
+    int8_t        valid;
+    uint8_t       addr;        /* full bEndpointAddress, 0x81 etc. */
+    uint8_t       dir;         /* RUBY_EP_DIR_* */
+    uint8_t       type;        /* RUBY_EP_TYPE_* */
+    uint8_t       iface;       /* owning interface number */
+    uint16_t      mps;         /* wMaxPacketSize */
+    uint8_t       interval;    /* bInterval (0 for bulk) */
+    lck_spin_t    q_lock;
+    struct ruby_req *q_head;
+    struct ruby_req *q_tail;
+    uint32_t      q_depth;
+};
+
+struct ruby_req {
+    const uint8_t *buf;
+    uint32_t       len;
+    void (*done)(void *ctx, int status);
+    void          *ctx;
+    struct ruby_req *next;
+};
+
+/* Function descriptor fragment: one function may own several interfaces
+ * (e.g. CDC-ACM: Iface0 Comm/IFace1 Data). Desc pointers are to const
+ * bytes inside a single function blob; bNumEndpoints is derived. */
+struct ruby_func_desc {
+    const uint8_t *desc;
+    uint32_t       len;
+    uint8_t        n_iface;
+    uint8_t        n_eps;
+};
+struct ruby_composite {
+    struct ruby_func_desc funcs[4];
+    uint8_t              n_funcs;
+};
+
+static struct ruby_ep ruby_eps[RUBY_EP_MAX];
+static lck_grp_t ruby_usb_lck_grp;
+static volatile uint32_t ruby_usb_lck_init;
+
+static void
+ruby_usb_lck_ensure(void)
+{
+    if (ruby_usb_lck_init == 0) {
+        lck_grp_init(&ruby_usb_lck_grp, "ruby_usb", LCK_GRP_ATTR_NULL);
+        for (uint32_t i = 0; i < RUBY_EP_MAX; i++)
+            lck_spin_init(&ruby_eps[i].q_lock, &ruby_usb_lck_grp, LCK_ATTR_NULL);
+        __atomic_store_n(&ruby_usb_lck_init, 1, __ATOMIC_RELEASE);
+    }
+}
+
+static void
+ruby_ep_init(void)
+{
+    ruby_usb_lck_ensure();
+    for (uint32_t i = 0; i < RUBY_EP_MAX; i++)
+        ruby_eps[i].valid = 0;
+    /* EP0 */
+    ruby_eps[0].valid = 1; ruby_eps[0].addr = 0x00;
+    ruby_eps[0].dir = RUBY_EP_DIR_OUT; ruby_eps[0].type = RUBY_EP_TYPE_CTRL;
+    ruby_eps[0].mps = 64;
+    /* 0216 live wire: EP1 OUT 0x01 MPS 64, EP2 OUT 0x02 MPS 64, EP1 IN 0x81 MPS 512 */
+    ruby_eps[1].valid = 1; ruby_eps[1].addr = 0x01; ruby_eps[1].iface = 0;
+    ruby_eps[1].dir = RUBY_EP_DIR_OUT; ruby_eps[1].type = RUBY_EP_TYPE_BULK; ruby_eps[1].mps = 64;
+    ruby_eps[2].valid = 1; ruby_eps[2].addr = 0x02; ruby_eps[2].iface = 0;
+    ruby_eps[2].dir = RUBY_EP_DIR_OUT; ruby_eps[2].type = RUBY_EP_TYPE_BULK; ruby_eps[2].mps = 64;
+    ruby_eps[3].valid = 1; ruby_eps[3].addr = 0x81; ruby_eps[3].iface = 0;
+    ruby_eps[3].dir = RUBY_EP_DIR_IN;  ruby_eps[3].type = RUBY_EP_TYPE_BULK; ruby_eps[3].mps = 512;
+}
+
+static struct ruby_ep *
+ruby_ep_by_addr(uint8_t addr)
+{
+    for (uint32_t i = 0; i < RUBY_EP_MAX; i++)
+        if (ruby_eps[i].valid && ruby_eps[i].addr == addr)
+            return &ruby_eps[i];
+    return NULL;
+}
+
+/* Lock-held queue ops (q_head/q_tail write must go through these). */
+static int
+ruby_ep_queue(struct ruby_ep *ep, struct ruby_req *req)
+{
+    if (!ep->valid || req->len == 0 || req->len > 16 * 1024)
+        return -1;  /* CL-0219 guard: contiguous PA, 1 req = 1 GPD */
+    lck_spin_lock(&ep->q_lock);
+    req->next = NULL;
+    if (ep->q_tail)
+        ep->q_tail->next = req;
+    else
+        ep->q_head = req;
+    ep->q_tail = req;
+    ep->q_depth++;
+    lck_spin_unlock(&ep->q_lock);
+    return 0;
+}
+
+static void
+ruby_ep_complete(struct ruby_ep *ep, int status)
+{
+    struct ruby_req *req;
+    lck_spin_lock(&ep->q_lock);
+    req = ep->q_head;
+    if (req) {
+        ep->q_head = req->next;
+        if (!ep->q_head)
+            ep->q_tail = NULL;
+        ep->q_depth--;
+    }
+    lck_spin_unlock(&ep->q_lock);
+    if (req && req->done)
+        req->done(req->ctx, status);
+}
+
+/* Build the composite configuration descriptor from the EP table.
+ * Returns total length; caller passes a RUBY_DESC_MAX buffer. */
+static uint32_t
+ruby_build_cfg_desc(uint8_t *out)
+{
+    uint32_t off = 0;
+    uint8_t n_eps_total = 0;
+    /* Config header (length filled at end) */
+    out[off++] = 9; out[off++] = 2; out[off++] = 0; out[off++] = 0;
+    out[off++] = 1; out[off++] = 1; out[off++] = 0; out[off++] = 0x80; out[off++] = 50;
+    for (uint32_t i = 0; i < RUBY_EP_MAX; i++) {
+        if (!ruby_eps[i].valid || ruby_eps[i].addr == 0x00)
+            continue;
+        n_eps_total++;
+        out[off++] = 7; out[off++] = 5; out[off++] = ruby_eps[i].addr;
+        out[off++] = ruby_eps[i].type;
+        out[off++] = (uint8_t)(ruby_eps[i].mps & 0xffu);
+        out[off++] = (uint8_t)((ruby_eps[i].mps >> 8) & 0xffu);
+        out[off++] = ruby_eps[i].interval;
+    }
+    out[2] = (uint8_t)(off & 0xffu);
+    out[3] = (uint8_t)((off >> 8) & 0xffu);
+    /* Interface descriptor (softer: 1 iface for now, bNumEndpoints auto) */
+    out[off++] = 9; out[off++] = 4; out[off++] = 0; out[off++] = 0;
+    out[off++] = n_eps_total; out[off++] = 0xFF; out[off++] = 0; out[off++] = 0; out[off++] = 0;
+    return off;
+}
