+ * the EP0 control channel never takes a consumer lock. */
+#define RUBY_USB_IO_ECHO 0u
+#define RUBY_USB_IO_TTY  1u
+#define RUBY_USB_IO_RAW  2u
+
+void ruby_usb_io_init(void);
