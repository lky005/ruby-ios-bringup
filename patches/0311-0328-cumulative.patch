diff --git a/bsd/dev/ruby_raw.c b/bsd/dev/ruby_raw.c
new file mode 100644
index 0000000..b9042fa
--- /dev/null
+++ b/bsd/dev/ruby_raw.c
@@ -0,0 +1,260 @@
+/*
+ * CL-0320: /dev/ruby_raw — raw EP1 stream for userland muxers (adbusbmux).
+ *
+ * RX: EP1 drain -> ruby_raw_input() -> 32 KB SPSC ring -> read().
+ * TX: write() -> EP1 TX ring -> QMU workloop.
+ * No line discipline; one open at a time; ownership via ruby_usb_io.
+ */
+#include <sys/param.h>
+#include <libkern/libkern.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/uio.h>
+#include <sys/fcntl.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/time.h>
+#include <sys/kernel.h>
+#include <sys/vnode.h>
+#include <miscfs/devfs/devfs.h>
+
+#include "ruby_usb_io.h"
+
+#define RUBY_RAW_RX_SIZE 32768u
+
+static uint8_t ruby_raw_rx[RUBY_RAW_RX_SIZE];
+static volatile uint32_t ruby_raw_head;
+static volatile uint32_t ruby_raw_tail;
+static volatile uint32_t ruby_raw_drops;
+static int ruby_raw_major = -1;
+static void *ruby_raw_node;
+
+static void *
+ruby_raw_rx_wait = &ruby_raw_rx;
+static void *
+ruby_raw_tx_wait = &ruby_raw_tail;
+
+static uint32_t
+ruby_raw_avail(void)
+{
+	return __atomic_load_n(&ruby_raw_head, __ATOMIC_ACQUIRE) -
+	    __atomic_load_n(&ruby_raw_tail, __ATOMIC_ACQUIRE);
+}
+
+uint32_t
+ruby_raw_space(void)
+{
+	uint32_t head = __atomic_load_n(&ruby_raw_head, __ATOMIC_ACQUIRE);
+	uint32_t tail = __atomic_load_n(&ruby_raw_tail, __ATOMIC_ACQUIRE);
+
+	return RUBY_RAW_RX_SIZE - (head - tail);
+}
+
+void
+ruby_raw_input(const uint8_t *data, uint32_t len)
+{
+	uint32_t head = __atomic_load_n(&ruby_raw_head, __ATOMIC_RELAXED);
+	uint32_t tail = __atomic_load_n(&ruby_raw_tail, __ATOMIC_ACQUIRE);
+	uint32_t space = RUBY_RAW_RX_SIZE - (head - tail);
+	uint32_t off, first, n;
+
+	if (space < len) {
+		__atomic_add_fetch(&ruby_raw_drops, len - space, __ATOMIC_RELAXED);
+		len = space;
+	}
+	if (len == 0)
+		return;
+	off = head % RUBY_RAW_RX_SIZE;
+	first = RUBY_RAW_RX_SIZE - off;
+	if (first > len)
+		first = len;
+	n = first;
+	memcpy(&ruby_raw_rx[off], data, first);
+	if (len > first)
+		memcpy(&ruby_raw_rx[0], data + first, len - first);
+	__atomic_store_n(&ruby_raw_head, head + len, __ATOMIC_RELEASE);
+	wakeup(ruby_raw_rx_wait);
+}
+
+/* EP0 force-detach path: no locks, just wake blocked I/O. */
+void
+ruby_raw_detach(void)
+{
+	wakeup(ruby_raw_rx_wait);
+	wakeup(ruby_raw_tx_wait);
+}
+
+static int
+ruby_raw_open(dev_t dev, int flag, int devtype, proc_t p)
+{
+	(void)dev;
+	(void)flag;
+	(void)devtype;
+	(void)p;
+	ruby_usb_io_set_open(RUBY_USB_IO_RAW, 1);
+	printf("RUBY RAW: open owner=%s\n",
+	    ruby_usb_io_owner_name(ruby_usb_io_owner()));
+	return 0;
+}
+
+static int
+ruby_raw_close(dev_t dev, int flag, int devtype, proc_t p)
+{
+	(void)dev;
+	(void)flag;
+	(void)devtype;
+	(void)p;
+	if (ruby_usb_io_owner() == RUBY_USB_IO_RAW)
+		ruby_usb_io_force_owner(ruby_usb_io_tty_open() ?
+		    RUBY_USB_IO_TTY : RUBY_USB_IO_ECHO);
+	ruby_usb_io_set_open(RUBY_USB_IO_RAW, 0);
+	printf("RUBY RAW: close owner=%s drops=%u\n",
+	    ruby_usb_io_owner_name(ruby_usb_io_owner()),
+	    __atomic_load_n(&ruby_raw_drops, __ATOMIC_ACQUIRE));
+	return 0;
+}
+
+static int
+ruby_raw_io_valid(void)
+{
+	return ruby_usb_io_owner() == RUBY_USB_IO_RAW;
+}
+
+static int
+ruby_raw_read(dev_t dev, struct uio *uio, int ioflag)
+{
+	uint8_t buf[256];
+	int moved = 0;
+	int err;
+
+	(void)dev;
+	while (uio_resid(uio) > 0) {
+		uint32_t avail = ruby_raw_avail();
+		uint32_t off, first, n;
+
+		if (avail == 0) {
+			if (!ruby_raw_io_valid())
+				return EIO;
+			if (ioflag & IO_NDELAY)
+				return moved ? 0 : EWOULDBLOCK;
+			err = tsleep(ruby_raw_rx_wait, PRIBIO, "rubyraw", hz / 10);
+			if (err)
+				return err;
+			continue;
+		}
+		off = __atomic_load_n(&ruby_raw_tail, __ATOMIC_RELAXED) %
+		    RUBY_RAW_RX_SIZE;
+		first = RUBY_RAW_RX_SIZE - off;
+		if (first > avail)
+			first = avail;
+		n = first;
+		if ((user_ssize_t)n > uio_resid(uio))
+			n = (uint32_t)uio_resid(uio);
+		if (n > sizeof(buf))
+			n = sizeof(buf);
+		memcpy(buf, &ruby_raw_rx[off], n);
+		err = uiomove((const char *)buf, (int)n, uio);
+		if (err)
+			return err;
+		__atomic_store_n(&ruby_raw_tail,
+		    __atomic_load_n(&ruby_raw_tail, __ATOMIC_RELAXED) + n,
+		    __ATOMIC_RELEASE);
+		ruby_usb_rx_kick();
+		moved += (int)n;
+	}
+	return 0;
+}
+
+static int
+ruby_raw_write(dev_t dev, struct uio *uio, int ioflag)
+{
+	uint8_t buf[256];
+	int moved = 0;
+	int err;
+
+	(void)dev;
+	while (uio_resid(uio) > 0) {
+		uint32_t space = ruby_ep2_data_space();
+		uint32_t n;
+
+		if (space == 0) {
+			if (!ruby_raw_io_valid())
+				return EIO;
+			if (ioflag & IO_NDELAY)
+				return moved ? 0 : EWOULDBLOCK;
+			err = tsleep(ruby_raw_tx_wait, PRIBIO, "rubyraw", hz / 10);
+			if (err)
+				return err;
+			continue;
+		}
+		n = space;
+		if ((user_ssize_t)n > uio_resid(uio))
+			n = (uint32_t)uio_resid(uio);
+		if (n > sizeof(buf))
+			n = sizeof(buf);
+		err = uiomove((char *)buf, (int)n, uio);
+		if (err)
+			return err;
+		if (ruby_usb_io_write(buf, n) != (int)n)
+			return EIO;
+		moved += (int)n;
+	}
+	return 0;
+}
+
+#define RUBY_RAW_TAKE 0x5201UL
+#define RUBY_RAW_GIVE 0x5202UL
+
+static int
+ruby_raw_ioctl(dev_t dev, u_long cmd, caddr_t data, int flag, proc_t p)
+{
+	(void)dev;
+	(void)data;
+	(void)flag;
+	(void)p;
+	switch (cmd) {
+	case RUBY_RAW_TAKE:
+		ruby_usb_io_force_owner(RUBY_USB_IO_RAW);
+		return 0;
+	case RUBY_RAW_GIVE:
+		ruby_usb_io_force_owner(ruby_usb_io_tty_open() ?
+		    RUBY_USB_IO_TTY : RUBY_USB_IO_ECHO);
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static const struct cdevsw ruby_raw_cdev = {
+	.d_open       = ruby_raw_open,
+	.d_close      = ruby_raw_close,
+	.d_read       = ruby_raw_read,
+	.d_write      = ruby_raw_write,
+	.d_ioctl      = ruby_raw_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+};
+
+int
+ruby_raw_init(void)
+{
+	ruby_raw_major = cdevsw_add(-15, &ruby_raw_cdev);
+	if (ruby_raw_major < 0) {
+		printf("RUBY RAW: cdevsw_add failed\n");
+		return ENXIO;
+	}
+	ruby_raw_node = devfs_make_node(makedev(ruby_raw_major, 0), DEVFS_CHAR,
+	    UID_ROOT, GID_WHEEL, 0666, "ruby_raw");
+	if (!ruby_raw_node) {
+		printf("RUBY RAW: devfs node failed\n");
+		return ENXIO;
+	}
+	printf("RUBY RAW: /dev/ruby_raw major=%d\n", ruby_raw_major);
+	return 0;
+}
\ No newline at end of file
diff --git a/bsd/dev/ruby_tty.c b/bsd/dev/ruby_tty.c
new file mode 100644
index 0000000..c6b58ec
--- /dev/null
+++ b/bsd/dev/ruby_tty.c
@@ -0,0 +1,361 @@
+/*
+ * CL-0320: /dev/tty.ruby — BSD tty front-end over the EP1 bulk pair.
+ *
+ * RX: EP1 drain -> ruby_tty_input() -> line discipline (l_rint).
+ * TX: line discipline -> ruby_tty_start() -> EP1 TX ring (ruby_usb.c).
+ * One tty instance; ownership is claimed through ruby_usb_io.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/tty.h>
+#include <sys/conf.h>
+#include <sys/uio.h>
+#include <sys/fcntl.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/vnode.h>
+#include <pexpert/pexpert.h>
+#include <miscfs/devfs/devfs.h>
+
+#include "ruby_usb_io.h"
+#include "rubysh_blob.h"
+
+#define RUBY_TTY_JOB_PATH "/System/Library/LaunchDaemons/com.ruby.tty.plist"
+#define RUBY_SH_PATH "/usr/libexec/rubysh-0322"
+
+static struct tty *ruby_tty_tp;
+static struct tty *ruby_tty_ttys[1] = { NULL };
+static int ruby_tty_major = -1;
+static int ruby_tty_opens;
+
+static const char ruby_tty_job_plist[] =
+	"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+	"<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
+	"\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+	"<plist version=\"1.0\">\n"
+	"<dict>\n"
+	"\t<key>Label</key>\n"
+	"\t<string>com.ruby.tty</string>\n"
+	"\t<key>ProgramArguments</key>\n"
+	"\t<array>\n"
+	"\t\t<string>/usr/libexec/rubysh-0322</string>\n"
+	"\t</array>\n"
+	"\t<key>StandardInPath</key>\n"
+	"\t<string>/dev/tty.ruby</string>\n"
+	"\t<key>StandardOutPath</key>\n"
+	"\t<string>/dev/tty.ruby</string>\n"
+	"\t<key>StandardErrorPath</key>\n"
+	"\t<string>/dev/tty.ruby</string>\n"
+	"\t<key>RunAtLoad</key>\n"
+	"\t<true/>\n"
+	"\t<key>KeepAlive</key>\n"
+	"\t<false/>\n"
+	"\t<key>ThrottleInterval</key>\n"
+	"\t<integer>10</integer>\n"
+	"\t<key>Umask</key>\n"
+	"\t<integer>22</integer>\n"
+	"</dict>\n"
+	"</plist>\n";
+
+static void ruby_tty_start(struct tty *tp);
+
+/*
+ * CL-0322: write the ad-hoc signed arm64 rubysh; this root has no
+ * BaseSystem (/bin/sh is absent).  The versioned path keeps the install
+ * idempotent across CLs.
+ */
+static void
+ruby_tty_install_sh_bin(struct vfs_context *ctx)
+{
+	struct vnode *vp = NULLVP;
+	uio_t uio;
+	int err;
+
+	err = vnode_open(RUBY_SH_PATH,
+	    (O_CREAT | FWRITE | O_TRUNC | O_NOFOLLOW),
+	    0755, VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+	if (err) {
+		printf("RUBY TTY: rubysh open err=%d\n", err);
+		return;
+	}
+	uio = uio_create(1, 0, UIO_SYSSPACE, UIO_WRITE);
+	uio_addiov(uio, CAST_USER_ADDR_T(rubysh_blob), RUBYSH_BLOB_LEN);
+	err = VNOP_WRITE(vp, uio, 0, ctx);
+	printf("RUBY TTY: rubysh write err=%d len=%lu resid=%ld\n", err,
+	    (unsigned long)RUBYSH_BLOB_LEN, (long)uio_resid(uio));
+	uio_free(uio);
+	(void)vnode_close(vp, FWRITE, ctx);
+}
+
+/*
+ * CL-0321: install the launchd job before launchd starts, so the same
+ * boot opens /dev/tty.ruby and runs /bin/sh on it.  Idempotent: an
+ * existing file is left untouched.  rubyttyjob=0 disables the install.
+ */
+void
+ruby_tty_install_sh_job(void)
+{
+	struct vfs_context *ctx = vfs_context_kernel();
+	struct vnode *vp = NULLVP;
+	uio_t uio;
+	int enable = 1;
+	int err;
+
+	if (PE_parse_boot_argn("rubyttyjob", &enable, sizeof(enable)) && !enable)
+		return;
+	ruby_tty_install_sh_bin(ctx);
+	err = vnode_lookup("/", 0, &vp, ctx);
+	if (err == 0)
+		vnode_put(vp);
+	printf("RUBY TTY: sh job root lookup=%d\n", err);
+	err = vnode_lookup(RUBY_TTY_JOB_PATH, 0, &vp, ctx);
+	if (err == 0) {
+		vnode_put(vp);
+		printf("RUBY TTY: sh job present\n");
+		return;
+	}
+	err = vnode_open(RUBY_TTY_JOB_PATH, (O_CREAT | FWRITE | O_NOFOLLOW),
+	    0644, VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+	if (err) {
+		printf("RUBY TTY: sh job open err=%d\n", err);
+		return;
+	}
+	uio = uio_create(1, 0, UIO_SYSSPACE, UIO_WRITE);
+	uio_addiov(uio, CAST_USER_ADDR_T(ruby_tty_job_plist),
+	    sizeof(ruby_tty_job_plist) - 1);
+	err = VNOP_WRITE(vp, uio, 0, ctx);
+	printf("RUBY TTY: sh job write err=%d len=%u\n", err,
+	    (unsigned)(sizeof(ruby_tty_job_plist) - 1));
+	uio_free(uio);
+	(void)vnode_close(vp, FWRITE, ctx);
+}
+
+static int
+ruby_tty_open(dev_t dev, int flag, int devtype, proc_t p)
+{
+	int err;
+	struct tty *tp = ruby_tty_tp;
+
+	(void)flag;
+	(void)devtype;
+	(void)p;
+	if (!tp)
+		return ENXIO;
+	tty_lock(tp);
+	if (ruby_tty_opens == 0) {
+		err = ruby_usb_io_claim(RUBY_USB_IO_TTY);
+		if (err) {
+			tty_unlock(tp);
+			return err;
+		}
+		tp->t_oproc = ruby_tty_start;
+		tp->t_param = NULL;
+		tp->t_dev = dev;
+		tp->t_iflag = TTYDEF_IFLAG;
+		tp->t_oflag = TTYDEF_OFLAG;
+		tp->t_cflag = (CREAD | CS8 | CLOCAL);
+		tp->t_lflag = TTYDEF_LFLAG;
+		tp->t_ispeed = tp->t_ospeed = TTYDEF_SPEED;
+		termioschars(&tp->t_termios);
+		ttsetwater(tp);
+	}
+	ruby_tty_opens++;
+	tp->t_state |= TS_CARR_ON;
+	err = (*linesw[tp->t_line].l_open)(dev, tp);
+	tty_unlock(tp);
+	if (err) {
+		tty_lock(tp);
+		if (--ruby_tty_opens == 0) {
+			tty_unlock(tp);
+			ruby_usb_io_release(RUBY_USB_IO_TTY);
+		} else {
+			tty_unlock(tp);
+		}
+		return err;
+	}
+	ruby_usb_io_set_open(RUBY_USB_IO_TTY, 1);
+	printf("RUBY TTY: open (%d)\n", ruby_tty_opens);
+	return 0;
+}
+
+static int
+ruby_tty_close(dev_t dev, int flag, int devtype, proc_t p)
+{
+	int err;
+	struct tty *tp = ruby_tty_tp;
+
+	(void)devtype;
+	(void)p;
+	if (!tp)
+		return ENXIO;
+	tty_lock(tp);
+	ruby_tty_opens--;
+	if (ruby_tty_opens <= 0)
+		ruby_tty_opens = 0;
+	if (ruby_tty_opens == 0) {
+		err = (*linesw[tp->t_line].l_close)(tp, flag);
+		ttyclose(tp);
+	} else {
+		err = 0;
+	}
+	tty_unlock(tp);
+	if (ruby_tty_opens == 0) {
+		ruby_usb_io_set_open(RUBY_USB_IO_TTY, 0);
+		ruby_usb_io_release(RUBY_USB_IO_TTY);
+		printf("RUBY TTY: close\n");
+	}
+	return err;
+}
+
+static int
+ruby_tty_read(dev_t dev, struct uio *uio, int ioflag)
+{
+	struct tty *tp = ruby_tty_tp;
+	int err;
+
+	(void)dev;
+	if (!tp)
+		return ENXIO;
+	tty_lock(tp);
+	err = (*linesw[tp->t_line].l_read)(tp, uio, ioflag);
+	tty_unlock(tp);
+	return err;
+}
+
+static int
+ruby_tty_write(dev_t dev, struct uio *uio, int ioflag)
+{
+	struct tty *tp = ruby_tty_tp;
+	int err;
+
+	(void)dev;
+	if (!tp)
+		return ENXIO;
+	tty_lock(tp);
+	err = (*linesw[tp->t_line].l_write)(tp, uio, ioflag);
+	tty_unlock(tp);
+	return err;
+}
+
+static int
+ruby_tty_ioctl(dev_t dev, u_long cmd, caddr_t data, int flag, proc_t p)
+{
+	struct tty *tp = ruby_tty_tp;
+	int err;
+
+	(void)dev;
+	if (!tp)
+		return ENXIO;
+	tty_lock(tp);
+	err = (*linesw[tp->t_line].l_ioctl)(tp, cmd, data, flag, p);
+	if (err == ENOTTY)
+		err = ttioctl_locked(tp, cmd, data, flag, p);
+	tty_unlock(tp);
+	return err;
+}
+
+/*
+ * t_oproc: called with the tty lock held.  Move the line-discipline
+ * output queue into the EP1 TX ring.  The ring (32 KB) is larger than
+ * the tty high-water mark, so a full ring only happens when the host
+ * stops reading; leave the remainder queued in the tty, no drop.
+ */
+static void
+ruby_tty_start(struct tty *tp)
+{
+	u_char buf[128];
+	uint32_t space;
+	int cc;
+
+	if (tp->t_state & (TS_TIMEOUT | TS_BUSY | TS_TTSTOP)) {
+		(*linesw[tp->t_line].l_start)(tp);
+		return;
+	}
+	tp->t_state |= TS_BUSY;
+	while (tp->t_outq.c_cc > 0) {
+		space = ruby_ep2_data_space();
+		if (space == 0)
+			break;
+		cc = ndqb(&tp->t_outq, 0);
+		if (cc <= 0)
+			break;
+		if ((uint32_t)cc > space)
+			cc = (int)space;
+		if (cc > (int)sizeof(buf))
+			cc = (int)sizeof(buf);
+		cc = q_to_b(&tp->t_outq, buf, cc);
+		if (cc <= 0)
+			break;
+		if (ruby_ep2_data_enqueue(buf, (uint32_t)cc) != (uint32_t)cc) {
+			/* Space only grows; a short accept means a race we do
+			 * not expect.  Leave the rest queued. */
+			break;
+		}
+	}
+	tp->t_state &= ~TS_BUSY;
+	if (tp->t_outq.c_cc == 0)
+		(*linesw[tp->t_line].l_start)(tp);
+}
+
+void
+ruby_tty_input(const uint8_t *data, uint32_t len)
+{
+	struct tty *tp = ruby_tty_tp;
+	uint32_t i;
+
+	if (!tp)
+		return;
+	tty_lock(tp);
+	for (i = 0; i < len; i++)
+		(*linesw[tp->t_line].l_rint)((u_char)data[i], tp);
+	tty_unlock(tp);
+}
+
+/* Force-detach runs from the EP0 thread: no tty lock, no blocking. */
+void
+ruby_tty_detach(void)
+{
+}
+
+static const struct cdevsw ruby_tty_cdev = {
+	.d_open       = ruby_tty_open,
+	.d_close      = ruby_tty_close,
+	.d_read       = ruby_tty_read,
+	.d_write      = ruby_tty_write,
+	.d_ioctl      = ruby_tty_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = ruby_tty_ttys,
+	.d_select     = ttselect,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_TTY
+};
+
+int
+ruby_tty_init(void)
+{
+	void *node;
+
+	ruby_tty_tp = ttymalloc();
