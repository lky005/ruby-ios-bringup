+void ruby_usb_io_release(uint32_t owner);
+void ruby_usb_io_force_echo(void);
+void ruby_usb_io_force_owner(uint32_t owner);
+uint32_t ruby_usb_io_tty_open(void);
+void ruby_usb_io_set_open(uint32_t owner, int open);
+int ruby_usb_io_rx(const uint8_t *data, uint32_t len);
+int ruby_usb_io_write(const uint8_t *data, uint32_t len);
+void ruby_usb_io_status(void);
+
+int ruby_tty_init(void);
+int ruby_raw_init(void);
+void ruby_tty_input(const uint8_t *data, uint32_t len);
+void ruby_tty_detach(void);
+void ruby_raw_input(const uint8_t *data, uint32_t len);
+void ruby_raw_detach(void);
+
+/* Implemented in ruby_usb.c. */
+int ruby_ep2_data_ready(void);
+uint32_t ruby_ep2_data_space(void);
+uint32_t ruby_raw_space(void);
+void ruby_usb_rx_kick(void);
+uint32_t ruby_ep2_data_enqueue(const uint8_t *data, uint32_t len);
+
+#endif /* _RUBY_USB_IO_H_ */
