diff --git a/bsd/dev/ruby_usb_io.c b/bsd/dev/ruby_usb_io.c
new file mode 100644
index 0000000..7543de8
--- /dev/null
+++ b/bsd/dev/ruby_usb_io.c
@@ -0,0 +1,146 @@
+/*
+ * CL-0320: EP1 consumer ownership (echo / tty / raw).
+ *
+ * The owner is a single atomic word.  EP0 status and force-detach touch
+ * only this word and the generation counter; they never take a tty or
+ * raw lock, so a stuck userland consumer cannot stall 0x2A/0x2B/0x2E.
+ */
+#include <sys/param.h>
+#include <libkern/libkern.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/types.h>
+
+#include "ruby_usb_io.h"
+
+static volatile uint32_t ruby_io_owner = RUBY_USB_IO_ECHO;
+static volatile uint32_t ruby_io_gen;
+static volatile uint32_t ruby_io_tty_open;
+static volatile uint32_t ruby_io_raw_open;
+
+uint32_t
+ruby_usb_io_owner(void)
+{
+	return __atomic_load_n(&ruby_io_owner, __ATOMIC_ACQUIRE);
+}
+
+uint32_t
+ruby_usb_io_generation(void)
+{
+	return __atomic_load_n(&ruby_io_gen, __ATOMIC_ACQUIRE);
+}
+
+const char *
+ruby_usb_io_owner_name(uint32_t owner)
+{
+	switch (owner) {
+	case RUBY_USB_IO_TTY:
+		return "tty";
+	case RUBY_USB_IO_RAW:
+		return "raw";
+	default:
+		return "echo";
+	}
+}
+
+void
+ruby_usb_io_init(void)
+{
+	printf("RUBY EP1: owner=echo ready=%d gen=%u\n",
+	    ruby_ep2_data_ready(), ruby_usb_io_generation());
+}
+
+int
+ruby_usb_io_claim(uint32_t owner)
+{
+	uint32_t expect = RUBY_USB_IO_ECHO;
+
+	if (owner != RUBY_USB_IO_TTY && owner != RUBY_USB_IO_RAW)
+		return EINVAL;
+	if (!ruby_ep2_data_ready())
+		return ENODEV;
+	if (!__atomic_compare_exchange_n(&ruby_io_owner, &expect, owner, 0,
+	    __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE))
+		return EBUSY;
+	return 0;
+}
+
+void
+ruby_usb_io_release(uint32_t owner)
+{
+	uint32_t expect = owner;
+
+	__atomic_compare_exchange_n(&ruby_io_owner, &expect, RUBY_USB_IO_ECHO, 0,
+	    __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+}
+
+/* EP0-safe: no locks, no sleep.  Consumers see the generation change on
+ * their next I/O and return EIO until close/open. */
+uint32_t
+ruby_usb_io_tty_open(void)
+{
+	return __atomic_load_n(&ruby_io_tty_open, __ATOMIC_ACQUIRE);
+}
+
+/* EP0-safe owner switch (atomics + wakeups only). */
+void
+ruby_usb_io_force_owner(uint32_t owner)
+{
+	__atomic_store_n(&ruby_io_owner, owner, __ATOMIC_RELEASE);
+	__atomic_add_fetch(&ruby_io_gen, 1, __ATOMIC_RELAXED);
+	ruby_raw_detach();
+	if (owner == RUBY_USB_IO_ECHO)
+		ruby_tty_detach();
+}
+
+void
+ruby_usb_io_force_echo(void)
+{
+	ruby_usb_io_force_owner(RUBY_USB_IO_ECHO);
+}
+
+void
+ruby_usb_io_set_open(uint32_t owner, int open)
+{
+	volatile uint32_t *p = NULL;
+
+	if (owner == RUBY_USB_IO_TTY)
+		p = &ruby_io_tty_open;
+	else if (owner == RUBY_USB_IO_RAW)
+		p = &ruby_io_raw_open;
+	if (p)
+		__atomic_store_n(p, open ? 1u : 0u, __ATOMIC_RELEASE);
+}
+
+/* Called from the EP1 RX drain (workloop) with no lock held. */
+int
+ruby_usb_io_rx(const uint8_t *data, uint32_t len)
+{
+	uint32_t owner = __atomic_load_n(&ruby_io_owner, __ATOMIC_ACQUIRE);
+
+	if (owner == RUBY_USB_IO_TTY) {
+		ruby_tty_input(data, len);
+		return 1;
+	}
+	if (owner == RUBY_USB_IO_RAW) {
+		ruby_raw_input(data, len);
+		return 1;
+	}
+	return 0;
+}
+
+int
+ruby_usb_io_write(const uint8_t *data, uint32_t len)
+{
+	return (int)ruby_ep2_data_enqueue(data, len);
+}
+
+void
+ruby_usb_io_status(void)
+{
+	printf("RUBY CMD: ep1 owner=%s gen=%u tty_open=%u raw_open=%u\n",
+	    ruby_usb_io_owner_name(ruby_usb_io_owner()),
+	    ruby_usb_io_generation(),
+	    __atomic_load_n(&ruby_io_tty_open, __ATOMIC_ACQUIRE),
+	    __atomic_load_n(&ruby_io_raw_open, __ATOMIC_ACQUIRE));
+}
