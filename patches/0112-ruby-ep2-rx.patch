+/* Vendor IN request 0xC0/0x23: read-only EP2 RX diagnostics. */
+static void
+ruby_ep0_vendor_rx(vm_offset_t mac, uint32_t t, uint32_t wlen)
+{
+    uint32_t v[16];
+    uint32_t hwo = 0, i;
+
+    ruby_dc_civac(ruby_rx_gpd_ring, sizeof(ruby_rx_gpd_ring));
+    for (i = 0; i < RUBY_RX_GPD_NUM; i++)
+        if (ruby_rx_gpd_ring[i * 16] & 1u)
+            hwo |= 1u << i;
+
+    v[0] = 0x45503252u;         /* "EP2R" */
+    v[1] = ruby_rx_packets;
+    v[2] = ruby_rx_bytes;
+    v[3] = ruby_rx_zlp;
+    v[4] = ruby_rx_last_len;
+    v[5] = ruby_rx_crc;
+    v[6] = ruby_rd32(mac, RQCPR2_OFF);
+    v[7] = ruby_rd32(mac, RQHIAR2_OFF);
+    v[8] = ruby_rd32(mac, RQCSR2_OFF);
+    v[9] = ruby_rd32(mac, QISAR0_OFF);
+    v[10] = ruby_rd32(mac, QISAR1_OFF);
+    v[11] = ruby_rd32(mac, RQERRIR0_OFF);
+    v[12] = ruby_rd32(mac, RQERRIR1_OFF);
+    v[13] = ruby_rx_errors;
+    v[14] = (ruby_rx_empty & 0xffffu) | ((ruby_rx_ext_bad & 0xffffu) << 16);
+    v[15] = (ruby_rx_deq & 0xfu) | ((hwo & 0xfu) << 4) |
+        ((ruby_rx_bypasses & 0xffu) << 8) |
+        ((ruby_rx_done_events & 0xffffu) << 16);
+    ruby_ep0_send(mac, t, 0xc023, (const uint8_t *)v, sizeof(v), wlen);
+}
