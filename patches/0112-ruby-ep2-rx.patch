+/* ---- EP2 bulk OUT (RX), 0112 Stage A ---- */
+
+static uint32_t
+ruby_fnv1a(uint32_t h, const uint8_t *p, uint32_t n)
+{
+    while (n--) {
+        h ^= *p++;
+        h *= 16777619u;
+    }
+    return h;
+}
+
+static void
+ruby_ep2_rx_arm(uint32_t i)
+{
+    uint8_t *g = ruby_rx_gpd_ring + i * 16;
+    uint64_t next = ruby_rx_gpd_pa[(i + 1u) % RUBY_RX_GPD_NUM];
+    uint64_t buf = ruby_rx_buf_pa[i];
+    uint32_t k;
+
+    for (k = 0; k < 16; k++)
+        g[k] = 0;
+    g[0] = 1u << 7;             /* IOC; HWO is added after the checksum */
+    g[2] = (uint8_t)RUBY_RX_BUF;
+    g[3] = 0;
+    *(volatile uint32_t *)(g + 4) = (uint32_t)next;
+    *(volatile uint32_t *)(g + 8) = (uint32_t)buf;
+    g[14] = (uint8_t)(((buf >> 32) & 0xfu) |
+        (((next >> 32) & 0xfu) << 4));
+    g[1] = ruby_gpd_chksum(g);
+    g[0] = (1u << 0) | (1u << 7);
+
+    ruby_dc_civac(ruby_rx_buf[i], RUBY_RX_BUF);
+    ruby_dc_civac(g, 16);
+}
+
+static void
+ruby_ep2_rx_config(vm_offset_t mac)
+{
+    uint32_t i;
+
+    if (ruby_rx_ready)
+        return;
+    ruby_rx_ring_pa = ruby_dma_pa(ruby_rx_gpd_ring);
+    for (i = 0; i < RUBY_RX_GPD_NUM; i++) {
+        ruby_rx_buf_pa[i] = ruby_dma_pa(ruby_rx_buf[i]);
+        ruby_rx_gpd_pa[i] = ruby_dma_pa(ruby_rx_gpd_ring + i * 16);
+    }
+    if (!ruby_rx_ring_pa) {
+        printf("RUBY USB: EP2 RX ring not mapped\n");
+        return;
+    }
+    for (i = 0; i < RUBY_RX_GPD_NUM; i++) {
+        if (!ruby_rx_buf_pa[i] || !ruby_rx_gpd_pa[i]) {
+            printf("RUBY USB: EP2 RX buffers not mapped\n");
+            ruby_rx_ring_pa = 0;
+            return;
+        }
+    }
+
+    ruby_rx_packets = 0;
+    ruby_rx_bytes = 0;
+    ruby_rx_zlp = 0;
+    ruby_rx_last_len = 0;
+    ruby_rx_crc = RUBY_FNV_OFFSET;
+    ruby_rx_errors = 0;
+    ruby_rx_empty = 0;
+    ruby_rx_done_events = 0;
+    ruby_rx_bypasses = 0;
+    ruby_rx_ext_bad = 0;
+    ruby_rx_deq = 0;
+
+    ruby_wr32(mac, RX2CSR0_OFF, 64u | RX_DMAREQEN);
+    ruby_wr32(mac, RX2CSR1_OFF, RX_SLOT(2) | RX_TYPE(0));
+    ruby_wr32(mac, RX2CSR2_OFF, RX_FIFOADDR(0) | RX_FIFOSEGSIZE(9));
+    ruby_wr32(mac, QCR0_OFF,
+        ruby_rd32(mac, QCR0_OFF) | QMU_RX_CS_EN_BIT);
+    ruby_wr32(mac, QCR3_OFF,
+        (ruby_rd32(mac, QCR3_OFF) & ~QMU_RX_ZLP_BIT) | QMU_RX_COZ_BIT);
+    ruby_wr32(mac, RQERRIESR0_OFF, ruby_rd32(mac, RQERRIESR0_OFF) |
+        QMU_RX_LEN_ERR_BIT | QMU_RX_CS_ERR_BIT);
+    ruby_wr32(mac, RQERRIESR1_OFF, ruby_rd32(mac, RQERRIESR1_OFF) |
+        QMU_RX_ZLP_ERR_BIT);
+    ruby_wr32(mac, RQSAR2_OFF, (uint32_t)ruby_rx_ring_pa);
+    ruby_wr32(mac, RQHIAR2_OFF, (uint32_t)((ruby_rx_ring_pa >> 32) & 0xfu));
+    for (i = 0; i < RUBY_RX_GPD_NUM; i++)
+        ruby_ep2_rx_arm(i);
+    ruby_wr32(mac, RQCSR2_OFF, QMU_Q_START);
+    ruby_rx_ready = 1;
+    printf("RUBY USB: EP2 RX ring pa=0x%llx buf=0x%llx/0x%llx/0x%llx/0x%llx\n",
+        ruby_rx_ring_pa, ruby_rx_buf_pa[0], ruby_rx_buf_pa[1],
+        ruby_rx_buf_pa[2], ruby_rx_buf_pa[3]);
+}
+
+static uint32_t
+ruby_ep2_rx_cur_slot(vm_offset_t mac)
+{
+    uint64_t cur_pa;
+    uint32_t rqcpr, rqhiar;
+
+    rqcpr = ruby_rd32(mac, RQCPR2_OFF);
+    rqhiar = ruby_rd32(mac, RQHIAR2_OFF);
+    cur_pa = ((uint64_t)((rqhiar >> 8) & 0xfu) << 32) | rqcpr;
+    if (cur_pa < ruby_rx_ring_pa ||
+        cur_pa >= ruby_rx_ring_pa + (RUBY_RX_GPD_NUM * 16u))
+        return 0xffu;
+    return (uint32_t)((cur_pa - ruby_rx_ring_pa) / 16u);
+}
+
+static void
+ruby_ep2_rx_resume(vm_offset_t mac)
+{
+    ruby_wr32(mac, RQCSR2_OFF, QMU_Q_RESUME);
+    if (!(ruby_rd32(mac, RQCSR2_OFF) & QMU_Q_ACTIVE))
+        ruby_wr32(mac, RQCSR2_OFF, QMU_Q_RESUME);
+}
+
+static void
+ruby_ep2_rx_drain(vm_offset_t mac)
+{
+    uint32_t cur, hwo = 0, i, n, len, done = 0;
+    uint8_t *g;
+
+    if (!ruby_rx_ready)
+        return;
+
+    ruby_dc_civac(ruby_rx_gpd_ring, sizeof(ruby_rx_gpd_ring));
+    for (i = 0; i < RUBY_RX_GPD_NUM; i++)
+        if (ruby_rx_gpd_ring[i * 16] & 1u)
+            hwo |= 1u << i;
+
+    cur = ruby_ep2_rx_cur_slot(mac);
+    if (cur == 0xffu)
+        return;
+
+    for (n = 0; n < RUBY_RX_GPD_NUM && ruby_rx_deq != cur; n++) {
+        i = ruby_rx_deq;
+        g = ruby_rx_gpd_ring + i * 16;
+        if (hwo & (1u << i))
+            break;
+
+        ruby_dc_civac(ruby_rx_buf[i], RUBY_RX_BUF);
+        len = *(volatile uint16_t *)(g + 12) & 0xffffu;
+        if (len > RUBY_RX_BUF)
+            len = RUBY_RX_BUF;
+
+        ruby_rx_packets++;
+        ruby_rx_bytes += len;
+        if (len == 0)
+            ruby_rx_zlp++;
+        ruby_rx_last_len = len;
+        ruby_rx_crc = ruby_fnv1a(ruby_rx_crc, ruby_rx_buf[i], len);
+
+        /* The 36-bit ext bits live in dw3 for RX; the length write must not
+         * clobber them.  Count a mismatch before re-arming the slot. */
+        if ((g[14] & 0xfu) != ((ruby_rx_buf_pa[i] >> 32) & 0xfu) ||
+            ((g[14] >> 4) & 0xfu) !=
+            ((ruby_rx_gpd_pa[(i + 1u) % RUBY_RX_GPD_NUM] >> 32) & 0xfu))
+            ruby_rx_ext_bad++;
+
+        ruby_ep2_rx_arm(i);
+        ruby_rx_deq = (i + 1u) % RUBY_RX_GPD_NUM;
+        hwo |= 1u << i;
+        done++;
+    }
+
+    if (done)
+        ruby_ep2_rx_resume(mac);
+}
+
+static void
+ruby_ep2_rx_bypass(vm_offset_t mac)
+{
+    uint32_t cur;
+    uint8_t *g;
+
+    cur = ruby_ep2_rx_cur_slot(mac);
+    if (cur == 0xffu)
+        return;
+    g = ruby_rx_gpd_ring + cur * 16;
+    ruby_dc_civac(g, 16);
+    g[0] |= (1u << 0) | (1u << 2);      /* HWO | BPS: bypass this GPD */
+    ruby_dc_civac(g, 16);
+    ruby_rx_bypasses++;
+    ruby_ep2_rx_resume(mac);
+}
+
+static void
+ruby_ep2_rx_poll(vm_offset_t mac)
+{
+    uint32_t q0, q1, rxq, err;
+
+    if (!ruby_rx_ready)
+        return;
+
+    q1 = ruby_rd32(mac, QISAR1_OFF);
+    rxq = q1 & (QISAR1_RXQ_EMPTY | QISAR1_RXQ_CSERR |
+        QISAR1_RXQ_LENERR | QISAR1_RXQ_ZLPERR);
+    if (rxq) {
+        ruby_wr32(mac, QISAR1_OFF, rxq);
+        if (rxq & QISAR1_RXQ_EMPTY)
+            ruby_rx_empty++;
+        if (rxq & (QISAR1_RXQ_CSERR | QISAR1_RXQ_LENERR)) {
+            err = ruby_rd32(mac, RQERRIR0_OFF);
+            if (err)
+                ruby_wr32(mac, RQERRIR0_OFF, err);
+            ruby_rx_errors++;
+            ruby_ep2_rx_bypass(mac);
+        }
+        if (rxq & QISAR1_RXQ_ZLPERR) {
+            err = ruby_rd32(mac, RQERRIR1_OFF);
+            if (err)
+                ruby_wr32(mac, RQERRIR1_OFF, err);
+            /* A ZLP is a valid RX event; it is counted by length 0. */
+        }
+    }
+
+    q0 = ruby_rd32(mac, QISAR0_OFF);
+    if (q0 & QMU_RX_DONE_BIT) {
+        ruby_wr32(mac, QISAR0_OFF, QMU_RX_DONE_BIT);
+        ruby_rx_done_events++;
+    }
+
+    ruby_ep2_rx_drain(mac);
+}
