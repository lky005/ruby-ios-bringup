+/*
+ * Bring the device back to the state it must have at the start of an
+ * enumeration: address 0, EP0 armed, no configured endpoints.
+ */
+static void
+ruby_usb_rearm(vm_offset_t mac, uint32_t reason)
+{
+    uint32_t csr, dc, v;
+
+    csr = ruby_rd32(mac, EP0CSR_OFF) & EP0_W1C_BITS;
+    csr |= EP0_RXPKTRDY | EP0_SETUPPKTRDY | EP0_SENTSTALL;
+    csr &= ~EP0_MAXPKTSZ_MSK;
+    csr |= 64;
+    ruby_wr32(mac, EP0CSR_OFF, csr);
+
+    dc = ruby_rd32(mac, DEVICE_CONF - MTU3_PA);
+    dc &= ~0x7f000000u;         /* device address back to 0 */
+    ruby_wr32(mac, DEVICE_CONF - MTU3_PA, dc);
+
+    ruby_config = 0;
+    ruby_cfg_seen = 0;
+    ruby_ep_ready = 0;
+    ruby_tx_busy = 0;
+    ruby_busy_ticks = 0;
+    ruby_gpd_enq = 0;
+    ruby_wr32(mac, TQCSR2_OFF, 1u << 2);   /* stop the TX QMU */
+
+    if (reason == RUBY_REARM_ATTACH) {
+        /* The PHY lost its session with the unplug; re-assert the port. */
+        v = ruby_rd32(mac, MISC_CTRL - MTU3_PA);
+        ruby_wr32(mac, MISC_CTRL - MTU3_PA, v | 0x3u);
+        v = ruby_rd32(mac, PM_CTRL - MTU3_PA);
+        ruby_wr32(mac, PM_CTRL - MTU3_PA, v | (1u << 6) | (1u << 0));
+    }
+}
+
+/*
+ * The host resets the bus whenever an enumeration attempt fails.  The
+ * MAC2 common-USB status latches that event; without handling it the
+ * device keeps its old address and a stale EP0 state, so the host's next
+ * attempt is answered by garbage and the device looks dead until reboot.
+ */
+static void
+ruby_usb_reset_check(vm_offset_t mac)
+{
+    static uint32_t seen, resets, armed;
+    uint32_t st = ruby_rd32(mac, MAC2_INTR_STATUS_OFF);
+
+    if (!(st & MAC2_INTR_RESET)) {
+        seen = 0;
+        armed = 1;         /* the bit reads back clear at least once */
+        return;
+    }
+    if (!armed)
+        return;             /* stuck high: not a usable reset source */
+    if (!seen) {
+        /* Confirm on the next poll: a single sample may be a glitch. */
+        seen = 1;
+        return;
+    }
+    seen = 0;
+    ruby_wr32(mac, MAC2_INTR_STATUS_OFF, st & MAC2_INTR_RESET);
+
+    resets++;
+    ruby_usb_rearm(mac, RUBY_REARM_RESET);
+    ruby_trace(0, RUBY_TR_STATE, 7, st, resets, 0);
+    if (resets <= 4)
+        printf("RUBY USB: host bus reset #%u, address cleared\n", resets);
+}
+
+/*
+ * Physical unplug.  A detach drops the PHY session and leaves the device
+ * with a stale address, so the next attach has to re-arm it or the host
+ * enumerates a device that answers at the wrong address.  The VBUS sense
+ * is debounced and only a real detach -> attach sequence re-arms, so the
+ * normal enumeration path is untouched.
+ */
+static void
+ruby_usb_attach_poll(vm_offset_t mac, vm_offset_t ippc)
+{
+    static uint32_t stable, cand, count, seen_detach, attaches;
+    uint32_t v = ruby_rd32(ippc, IPPC_OTG_STS_OFF);
+    uint32_t present = (v & OTG_VBUS_VALID) ? 1 : 0;
+
+    if (present != cand) {
+        cand = present;
+        count = 0;
+        return;
+    }
+    if (++count < RUBY_VBUS_DEBOUNCE)
+        return;
+    count = 0;
+    if (present == stable)
+        return;
+    stable = present;
+
+    if (!present) {
+        seen_detach = 1;
+        ruby_trace(0, RUBY_TR_STATE, 8, v, 0, 0);
+        printf("RUBY USB: VBUS detached\n");
+        return;
+    }
+    if (!seen_detach)
+        return;             /* attached at boot: nothing to redo */
+    seen_detach = 0;
+    attaches++;
+    ruby_usb_rearm(mac, RUBY_REARM_ATTACH);
+    ruby_trace(0, RUBY_TR_STATE, 9, v, attaches, 0);
+    printf("RUBY USB: VBUS attached, device re-armed\n");
+}
