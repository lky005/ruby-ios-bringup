+/*
+ * CL-0338: this root's launchd cache has no _RubyPad, so the com.ruby.tty
+ * job cannot be injected at a fixed extent size.  Rewrite the cache by path
+ * each boot instead; launchd parses it after we return.  rubyttycache=0
+ * disables the rewrite.
+ */
+static void
+ruby_tty_install_launchd_cache(struct vfs_context *ctx)
+{
+	struct vnode *vp = NULLVP;
+	uio_t uio;
+	int err;
+
+	err = vnode_open(RUBY_LAUNCHD_CACHE_PATH,
+	    (FWRITE | O_TRUNC | O_NOFOLLOW), 0644, VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+	if (err) {
+		printf("RUBY TTY: cache open err=%d\n", err);
+		return;
+	}
+	uio = uio_create(1, 0, UIO_SYSSPACE, UIO_WRITE);
+	uio_addiov(uio, CAST_USER_ADDR_T(launchd_cache_blob),
+	    RUBYSH_CACHE_BLOB_LEN);
+	err = VNOP_WRITE(vp, uio, 0, ctx);
+	printf("RUBY TTY: cache write err=%d len=%lu resid=%ld\n", err,
+	    (unsigned long)RUBYSH_CACHE_BLOB_LEN, (long)uio_resid(uio));
+	uio_free(uio);
+	(void)vnode_close(vp, FWRITE, ctx);
+}
