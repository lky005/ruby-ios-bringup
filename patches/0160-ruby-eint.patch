+#ifndef RUBY_EINT_H
+#define RUBY_EINT_H
+
+#include <stdint.h>
+
+enum ruby_eint_trigger {
+	RUBY_EINT_EDGE_FALLING = 0,
+	RUBY_EINT_EDGE_RISING,
+	RUBY_EINT_LEVEL_LOW,
+	RUBY_EINT_LEVEL_HIGH,
+};
+
+struct ruby_eint;
+
+struct ruby_eint_port {
+	uint32_t sta;
+	uint32_t mask;
+	uint32_t sens;
+	uint32_t pol;
+};
+
+void ruby_eint_init(void);
+struct ruby_eint *ruby_eint_acquire(uint32_t line,
+    enum ruby_eint_trigger trig);
+void ruby_eint_release(struct ruby_eint *e);
+int ruby_eint_pending(struct ruby_eint *e);
+void ruby_eint_ack(struct ruby_eint *e);
+int ruby_eint_safe(void);
+int ruby_eint_read_port(uint32_t port, struct ruby_eint_port *out);
+void ruby_eint_status(void);
+int ruby_eint_selftest(uint32_t line, uint32_t ms);
+
+#endif /* RUBY_EINT_H */
