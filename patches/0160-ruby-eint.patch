@@ -0,0 +1,376 @@
+/*
+ * Shared EINT0 controller for the Ruby (MT6877) board.
+ *
+ * The register offsets and trigger semantics come from the vendor
+ * mtk-eint.c.  The HAL only writes the EINT0 MASK/SENS/POL/ACK
+ * registers; it never writes GICD, PMIC, rails, clocks or the WDT.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+
+#include "ruby_eint.h"
+#include "ruby_hal.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define RUBY_EINT0_PA        0x1000b000u
+#define RUBY_EINT_GICD_PA    0x0c000000u
+#define RUBY_EINT_REG_SIZE   0x1000u
+#define RUBY_EINT_LINES      32u
+#define RUBY_EINT_PORTS      7u
+
+#define RUBY_EINT_STA        0x000u
+#define RUBY_EINT_ACK        0x040u
+#define RUBY_EINT_MASK       0x080u
+#define RUBY_EINT_MASK_SET   0x0c0u
+#define RUBY_EINT_MASK_CLR   0x100u
+#define RUBY_EINT_SENS       0x140u
+#define RUBY_EINT_SENS_SET   0x180u
+#define RUBY_EINT_SENS_CLR   0x1c0u
+#define RUBY_EINT_POL        0x300u
+#define RUBY_EINT_POL_SET    0x340u
+#define RUBY_EINT_POL_CLR    0x380u
+
+#define RUBY_EINT_GICD_CTLR  0x000u
+/* GIC_SPI 256 is SPI 256 -> INTID 288 -> ISENABLER[9] bit 0. */
+#define RUBY_EINT_GIC_SPI256_INTID 288u
+#define RUBY_EINT_GICD_ISENABLER_SPI256 0x124u
+#define RUBY_EINT_GICD_ISPENDR_SPI256 0x224u
+#define RUBY_EINT_GIC_SPI256_BIT \
+	(1u << (RUBY_EINT_GIC_SPI256_INTID % 32u))
+
+struct ruby_eint {
+	uint32_t line;
+	uint32_t trigger;
+	uint32_t saved_mask;
+	uint32_t saved_sens;
+	uint32_t saved_pol;
+	uint32_t pending_count;
+	uint32_t ack_count;
+	bool used;
+};
+
+static struct ruby_eint g_eint_slots[RUBY_EINT_LINES];
+static vm_offset_t g_eint_base, g_gicd_base;
+static lck_grp_t g_eint_lck_grp;
+static lck_spin_t g_eint_lock;
+static volatile int g_eint_state; /* 0 uninit, 1 init, 2 ready, 3 failed */
+static bool g_eint_enabled;
+
+static void
+ruby_eint_gic_read(uint32_t *ctl, uint32_t *isen, uint32_t *pnd)
+{
+	*ctl = 0;
+	*isen = 0;
+	*pnd = 0;
+	if (!g_gicd_base)
+		return;
+	*ctl = ruby_rd32(g_gicd_base, RUBY_EINT_GICD_CTLR);
+	*isen = ruby_rd32(g_gicd_base, RUBY_EINT_GICD_ISENABLER_SPI256);
+	*pnd = ruby_rd32(g_gicd_base, RUBY_EINT_GICD_ISPENDR_SPI256);
+}
+
+void
+ruby_eint_init(void)
+{
+	vm_offset_t eint, gicd;
+	int expected = 0;
+	int v = 0;
+
+	if (__atomic_load_n(&g_eint_state, __ATOMIC_ACQUIRE) == 2)
+		return;
+	if (__atomic_load_n(&g_eint_state, __ATOMIC_ACQUIRE) == 3)
+		return;
+	if (!__atomic_compare_exchange_n(&g_eint_state, &expected, 1, false,
+	    __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+		while (__atomic_load_n(&g_eint_state, __ATOMIC_ACQUIRE) == 1)
+			delay(100);
+		return;
+	}
+
+	lck_grp_init(&g_eint_lck_grp, "ruby_eint", LCK_GRP_ATTR_NULL);
+	lck_spin_init(&g_eint_lock, &g_eint_lck_grp, LCK_ATTR_NULL);
+
+	eint = ml_io_map(RUBY_EINT0_PA, RUBY_EINT_REG_SIZE);
+	gicd = ml_io_map(RUBY_EINT_GICD_PA, RUBY_EINT_REG_SIZE);
+	g_eint_base = eint;
+	g_gicd_base = gicd;
+	if (PE_parse_boot_argn("rubyeint", &v, sizeof(v)) && v == 1)
+		g_eint_enabled = true;
+
+	printf("RUBY EINT: init eint=%d gicd=%d enabled=%d\n",
+	    g_eint_base != 0, g_gicd_base != 0, g_eint_enabled);
+	__atomic_store_n(&g_eint_state,
+	    (g_eint_base != 0 && g_gicd_base != 0) ? 2 : 3, __ATOMIC_RELEASE);
+}
+
+static void
+ruby_eint_apply_trigger(struct ruby_eint *e, uint32_t bit)
+{
+	switch (e->trigger) {
+	case RUBY_EINT_EDGE_FALLING:
+		ruby_wr32(g_eint_base, RUBY_EINT_SENS_CLR, bit);
+		ruby_wr32(g_eint_base, RUBY_EINT_POL_CLR, bit);
+		break;
+	case RUBY_EINT_EDGE_RISING:
+		ruby_wr32(g_eint_base, RUBY_EINT_SENS_CLR, bit);
+		ruby_wr32(g_eint_base, RUBY_EINT_POL_SET, bit);
+		break;
+	case RUBY_EINT_LEVEL_LOW:
+		ruby_wr32(g_eint_base, RUBY_EINT_SENS_SET, bit);
+		ruby_wr32(g_eint_base, RUBY_EINT_POL_CLR, bit);
+		break;
+	case RUBY_EINT_LEVEL_HIGH:
+		ruby_wr32(g_eint_base, RUBY_EINT_SENS_SET, bit);
+		ruby_wr32(g_eint_base, RUBY_EINT_POL_SET, bit);
+		break;
+	default:
+		break;
+	}
+}
+
+struct ruby_eint *
+ruby_eint_acquire(uint32_t line, enum ruby_eint_trigger trig)
+{
+	struct ruby_eint *e;
+	uint32_t bit, mask, ctl, isen, pnd;
+	uint32_t saved_mask, saved_sens, saved_pol;
+
+	ruby_eint_init();
+	if (__atomic_load_n(&g_eint_state, __ATOMIC_ACQUIRE) != 2 ||
+	    !g_eint_enabled || !g_eint_base || !g_gicd_base)
+		return NULL;
+	if (line >= RUBY_EINT_LINES ||
+	    trig > RUBY_EINT_LEVEL_HIGH)
+		return NULL;
+
+	bit = 1u << line;
+	ruby_eint_gic_read(&ctl, &isen, &pnd);
+	if (ctl == 0 || ctl == 0xffffffffu || isen == 0xffffffffu ||
+	    (isen & RUBY_EINT_GIC_SPI256_BIT)) {
+		printf("RUBY EINT: line=%u refused gic ctlr=%08x isen=%08x pnd=%08x\n",
+		    line, ctl, isen, pnd);
+		return NULL;
+	}
+
+	lck_spin_lock(&g_eint_lock);
+	e = &g_eint_slots[line];
+	if (e->used) {
+		lck_spin_unlock(&g_eint_lock);
+		return NULL;
+	}
+	e->line = line;
+	e->trigger = (uint32_t)trig;
+	saved_mask = (ruby_rd32(g_eint_base, RUBY_EINT_MASK) & bit) ? 1 : 0;
+	saved_sens = (ruby_rd32(g_eint_base, RUBY_EINT_SENS) & bit) ? 1 : 0;
+	saved_pol = (ruby_rd32(g_eint_base, RUBY_EINT_POL) & bit) ? 1 : 0;
+	e->saved_mask = saved_mask;
+	e->saved_sens = saved_sens;
+	e->saved_pol = saved_pol;
+	e->pending_count = 0;
+	e->ack_count = 0;
+
+	ruby_eint_apply_trigger(e, bit);
+	ruby_wr32(g_eint_base, RUBY_EINT_ACK, bit);
+	ruby_wr32(g_eint_base, RUBY_EINT_MASK_CLR, bit);
+	e->used = true;
+	mask = ruby_rd32(g_eint_base, RUBY_EINT_MASK);
+	lck_spin_unlock(&g_eint_lock);
+
+	printf("RUBY EINT: line=%u armed trigger=%u saved=%u/%u/%u mask=%08x\n",
+	    line, (unsigned)trig, saved_mask, saved_sens, saved_pol, mask);
+	return e;
+}
+
+void
+ruby_eint_release(struct ruby_eint *e)
+{
+	uint32_t bit;
+
+	if (!e)
+		return;
+	ruby_eint_init();
+	if (__atomic_load_n(&g_eint_state, __ATOMIC_ACQUIRE) != 2 ||
+	    !g_eint_base || e->line >= RUBY_EINT_LINES)
+		return;
+	bit = 1u << e->line;
+
+	lck_spin_lock(&g_eint_lock);
+	if (!e->used) {
+		lck_spin_unlock(&g_eint_lock);
+		return;
+	}
+	if (e->saved_mask & 1u)
+		ruby_wr32(g_eint_base, RUBY_EINT_MASK_SET, bit);
+	else
+		ruby_wr32(g_eint_base, RUBY_EINT_MASK_CLR, bit);
+	if (e->saved_sens & 1u)
+		ruby_wr32(g_eint_base, RUBY_EINT_SENS_SET, bit);
+	else
+		ruby_wr32(g_eint_base, RUBY_EINT_SENS_CLR, bit);
+	if (e->saved_pol & 1u)
+		ruby_wr32(g_eint_base, RUBY_EINT_POL_SET, bit);
+	else
+		ruby_wr32(g_eint_base, RUBY_EINT_POL_CLR, bit);
+	ruby_wr32(g_eint_base, RUBY_EINT_ACK, bit);
+	e->used = false;
+	lck_spin_unlock(&g_eint_lock);
+	printf("RUBY EINT: line=%u released\n", e->line);
+}
+
+int
+ruby_eint_pending(struct ruby_eint *e)
+{
+	uint32_t bit, sta;
+	int hit = 0;
+
+	if (!e || e->line >= RUBY_EINT_LINES)
+		return 0;
+	bit = 1u << e->line;
+	lck_spin_lock(&g_eint_lock);
+	if (e->used) {
+		sta = ruby_rd32(g_eint_base, RUBY_EINT_STA);
+		if (sta & bit) {
+			e->pending_count++;
+			hit = 1;
+		}
+	}
+	lck_spin_unlock(&g_eint_lock);
+	return hit;
+}
+
+void
+ruby_eint_ack(struct ruby_eint *e)
+{
+	uint32_t bit;
+
+	if (!e || e->line >= RUBY_EINT_LINES)
+		return;
+	bit = 1u << e->line;
+	lck_spin_lock(&g_eint_lock);
+	if (e->used) {
+		ruby_wr32(g_eint_base, RUBY_EINT_ACK, bit);
+		e->ack_count++;
+	}
+	lck_spin_unlock(&g_eint_lock);
+}
+
+int
+ruby_eint_safe(void)
+{
+	uint32_t ctl, isen, pnd;
+
+	ruby_eint_init();
+	if (__atomic_load_n(&g_eint_state, __ATOMIC_ACQUIRE) != 2 ||
+	    !g_gicd_base)
+		return 0;
+	ruby_eint_gic_read(&ctl, &isen, &pnd);
+	if (ctl == 0 || ctl == 0xffffffffu || isen == 0xffffffffu)
+		return 0;
+	return (isen & RUBY_EINT_GIC_SPI256_BIT) == 0;
+}
+
+int
+ruby_eint_read_port(uint32_t port, struct ruby_eint_port *out)
+{
+	if (!out || port >= RUBY_EINT_PORTS)
+		return EINVAL;
+	ruby_eint_init();
+	if (__atomic_load_n(&g_eint_state, __ATOMIC_ACQUIRE) != 2 ||
+	    !g_eint_base)
+		return ENODEV;
+	lck_spin_lock(&g_eint_lock);
+	out->sta = ruby_rd32(g_eint_base, RUBY_EINT_STA + port * 4u);
+	out->mask = ruby_rd32(g_eint_base, RUBY_EINT_MASK + port * 4u);
+	out->sens = ruby_rd32(g_eint_base, RUBY_EINT_SENS + port * 4u);
+	out->pol = ruby_rd32(g_eint_base, RUBY_EINT_POL + port * 4u);
+	lck_spin_unlock(&g_eint_lock);
+	return 0;
+}
+
+void
+ruby_eint_status(void)
+{
+	struct {
+		uint32_t line, trigger, pending, ack;
+	} snap[RUBY_EINT_LINES];
+	uint32_t ctl, isen, pnd;
+	uint32_t sta, mask, sens, pol;
+	uint32_t i, n = 0;
+
+	ruby_eint_init();
+	if (__atomic_load_n(&g_eint_state, __ATOMIC_ACQUIRE) != 2 ||
+	    !g_eint_base) {
+		printf("RUBY EINT: unavailable\n");
+		return;
+	}
+	lck_spin_lock(&g_eint_lock);
+	sta = ruby_rd32(g_eint_base, RUBY_EINT_STA);
+	mask = ruby_rd32(g_eint_base, RUBY_EINT_MASK);
+	sens = ruby_rd32(g_eint_base, RUBY_EINT_SENS);
+	pol = ruby_rd32(g_eint_base, RUBY_EINT_POL);
+	for (i = 0; i < RUBY_EINT_LINES; i++) {
+		if (!g_eint_slots[i].used)
+			continue;
+		snap[n].line = g_eint_slots[i].line;
+		snap[n].trigger = g_eint_slots[i].trigger;
+		snap[n].pending = g_eint_slots[i].pending_count;
+		snap[n].ack = g_eint_slots[i].ack_count;
+		n++;
+	}
+	lck_spin_unlock(&g_eint_lock);
+	ruby_eint_gic_read(&ctl, &isen, &pnd);
+
+	printf("RUBY EINT: enabled=%d safe=%d raw sta=%08x mask=%08x sens=%08x pol=%08x\n",
+	    g_eint_enabled, ruby_eint_safe(), sta, mask, sens, pol);
+	printf("RUBY EINT: gic ctlr=%08x isen=%08x pnd=%08x spi256=%u\n",
+	    ctl, isen, pnd,
+	    (isen & RUBY_EINT_GIC_SPI256_BIT) != 0);
+	if (n == 0) {
+		printf("RUBY EINT: used=none\n");
+		return;
+	}
+	for (i = 0; i < n; i++)
+		printf("RUBY EINT: used line=%u trigger=%u pending=%u ack=%u\n",
+		    snap[i].line, snap[i].trigger, snap[i].pending, snap[i].ack);
+}
+
+int
+ruby_eint_selftest(uint32_t line, uint32_t ms)
+{
+	struct ruby_eint *e;
+	uint32_t i, events = 0;
+
+	if (ms < 100)
+		ms = 100;
+	if (ms > 3000)
+		ms = 3000;
+	e = ruby_eint_acquire(line, RUBY_EINT_EDGE_FALLING);
+	if (!e) {
+		printf("RUBY EINT: selftest line=%u unavailable (busy/disabled/unsafe)\n",
+		    line);
+		return 1;
+	}
+	printf("RUBY EINT: selftest line=%u start\n", line);
+	for (i = 0; i < ms; i++) {
+		if (ruby_eint_pending(e)) {
+			printf("RUBY EINT: selftest t=%ums ack=1\n", i);
+			ruby_eint_ack(e);
+			events++;
+			if (events >= 8)
+				break;
+		}
+		delay(1);
+	}
+	ruby_eint_release(e);
+	printf("RUBY EINT: selftest line=%u events=%u\n", line, events);
+	return 1;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
