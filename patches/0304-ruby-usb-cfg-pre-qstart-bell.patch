+/*
+ * 0304: fast Q_START doorbell for the post-drain / FIFO-data window.
+ * Only the TQCSR command bit is written; CSR0, EP_RST, the ring and
+ * TQSAR are untouched.  The conditions are deliberately read-only and
+ * conservative: a healthy active queue, an empty FIFO, or a pending
+ * TXPKTRDY never triggers.
+ */
+static void
+ruby_txbell_poll(vm_offset_t mac)
+{
+    uint32_t tx0, tq, now;
+
+    if (!ruby_txbell_en || !ruby_ep_ready)
+        return;
+    if (ruby_inflight == 0)
+        return;
+    now = ruby_ms;
+    if (ruby_txbell_last_ms != 0 &&
+        (uint32_t)(now - ruby_txbell_last_ms) < ruby_txbell_ms)
+        return;
+    tx0 = ruby_rd32(mac, TX1CSR0_OFF);
+    if (tx0 & TX_TXPKTRDY)
+        return;
+    if (tx0 & TX_FIFOEMPTY)
+        return;
+    tq = ruby_rd32(mac, TQCSR1_OFF);
+    if (tq & QMU_Q_ACTIVE)
+        return;
+    ruby_wr32(mac, TQCSR1_OFF, QMU_Q_START);
+    ruby_tx_queue_started = 1;
+    ruby_txbell_cnt++;
+    ruby_txbell_last_ms = now;
+    if (ruby_txbell_cnt <= 8 || (ruby_txbell_cnt & 0x3fu) == 0)
+        printf("RUBY USB: 0304 txbell n=%u tx0=%08x tq=%08x inf=%u\n",
+            ruby_txbell_cnt, tx0, tq, ruby_inflight);
+}
