+/*
+ * 0290: vendor parity for CLEAR_FEATURE.  The vendor clears the stall bits
+ * and pulses EP_RST (data toggle reset) without flushing the ring or
+ * restarting QMU.
+ */
+static void
+ruby_ep1in_halt_clear_light(vm_offset_t mac)
+{
+    uint32_t tx0 = ruby_rd32(mac, TX1CSR0_OFF);
+
+    ruby_wr32(mac, TX1CSR0_OFF,
+        (tx0 & ~(TX_SENDSTALL | TX_SENTSTALL)) | TX_SENTSTALL);
+    ruby_ep2_eprst_tx(mac);
+    ruby_clr81_cnt++;
+    if (ruby_clr81_cnt <= 8 || (ruby_clr81_cnt & 0xffu) == 0)
+        ruby_seq("CLR81", tx0, ruby_rd32(mac, TX1CSR0_OFF));
+}
