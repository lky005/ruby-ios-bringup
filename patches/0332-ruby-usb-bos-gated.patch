+
+/* ---- 0332: BOS + MS OS 2.0 (Vendor debug interface only, gated) ---- */
+#define RUBY_BOS_LEN 40u
+#define RUBY_MSOS_MAX 192u
+static uint8_t ruby_bos_desc[RUBY_BOS_LEN];
+static uint8_t ruby_msos_desc[RUBY_MSOS_MAX];
+static uint32_t ruby_msos_len;
+static int ruby_0332_iface = -2;   /* -2 unbuilt, -1 none, >=0 vendor iface */
+
+extern int ruby_winusb_mode;
+
+static int
+ruby_0332_vendor_iface(void)
+{
+    if (ruby_winusb_mode == 0)
+        return -1;
+    if (ruby_enum_profile == 0)
+        return 0;
+    if (ruby_enum_profile == 2)
+        return 2;
+    return -1;
+}
+
+static int
+ruby_0332_bos_on(void)
+{
+    /* mode 3 serves BOS for host-side inspection without advertising
+     * bcdUSB 2.01, so Windows ignores it and enumeration stays safe. */
+    return ruby_winusb_mode == 1 || ruby_winusb_mode == 2 ||
+        ruby_winusb_mode == 3;
+}
+
+static int
+ruby_0332_msos_on(void)
+{
+    return ruby_winusb_mode == 1 || ruby_winusb_mode == 3;
+}
+
+static void
+ruby_0332_build(void)
+{
+    uint32_t o = 0, total, subset, func, iface, reglen;
+    volatile uint8_t *v;
+    uint16_t w;
+    const char *name = "DeviceInterfaceGUIDs";
+    const char *guid = "{2C4FFB48-B39B-4E6E-9D4B-6B0E7C9C0E35}";
+    uint32_t nlen = 0, glen = 0, i;
+
+    if (ruby_0332_iface != -2)
+        return;
+    iface = (uint32_t)ruby_0332_vendor_iface();
+    ruby_0332_iface = (int)iface;
+    if ((int)iface < 0)
+        return;
+
+    /* BOS: header(5) + USB2 extension(7) + platform capability(28) */
+    v = ruby_bos_desc;
+    v[0] = 5; v[1] = 0x0F; v[2] = RUBY_BOS_LEN; v[3] = 0; v[4] = 2;
+    v[5] = 7; v[6] = 0x10; v[7] = 0x02; v[8] = 0; v[9] = 0; v[10] = 0; v[11] = 0;
+    v[12] = 28; v[13] = 0x10; v[14] = 0x05; v[15] = 0;
+    {
+        static const uint8_t uuid[16] = {
+            0xB0, 0x60, 0xDD, 0xD8, 0x4F, 0x0E, 0x5B, 0x4E,
+            0x98, 0xA2, 0x1C, 0xE7, 0x62, 0x73, 0xE2, 0xCE
+        };
+
+        for (i = 0; i < 16; i++)
+            v[16 + i] = uuid[i];
+    }
+    v[32] = 0x00; v[33] = 0x00; v[34] = 0x03; v[35] = 0x06;
+    for (i = 36; i < RUBY_BOS_LEN; i++)
+        v[i] = 0;
+
+    while (name[nlen])
+        nlen++;
+    while (guid[glen])
+        glen++;
+    reglen = 6u + 2u * (nlen + 1u) + 2u + 2u * (glen + 2u);
+    func = 8u + 20u + reglen;
+    subset = 8u + func;
+    total = 10u + subset;
+    if (total > RUBY_MSOS_MAX) {
+        printf("RUBY 0332: msos overflow %u ", total);
+        ruby_0332_iface = -1;
+        return;
+    }
+    v = ruby_msos_desc;
+    v[o++] = 10; v[o++] = 0x00;
+    v[o++] = 0x00; v[o++] = 0x00; v[o++] = 0x03; v[o++] = 0x06;
+    v[o++] = (uint8_t)(total & 0xffu); v[o++] = (uint8_t)(total >> 8);
+    v[o++] = 0; v[o++] = 0;
+    v[o++] = 8; v[o++] = 0x01; v[o++] = 1; v[o++] = 0;
+    v[o++] = (uint8_t)(subset & 0xffu); v[o++] = (uint8_t)(subset >> 8);
+    v[o++] = 0; v[o++] = 0;
+    v[o++] = 8; v[o++] = 0x02; v[o++] = (uint8_t)iface; v[o++] = 0;
+    v[o++] = (uint8_t)(func & 0xffu); v[o++] = (uint8_t)(func >> 8);
+    v[o++] = 0; v[o++] = 0;
+    v[o++] = 20; v[o++] = 0x03;
+    v[o++] = 0x57; v[o++] = 0x49; v[o++] = 0x4E; v[o++] = 0x55;
+    v[o++] = 0x53; v[o++] = 0x42; v[o++] = 0; v[o++] = 0;
+    for (i = 0; i < 8; i++)
+        v[o++] = 0;
+    /* MS OS 2.0 CompatibleID declares bLength=20: two Reserved bytes. */
+    v[o++] = 0; v[o++] = 0;
+    v[o++] = (uint8_t)reglen; v[o++] = 0x04;
+    v[o++] = 0x01; v[o++] = 0x00;
+    w = (uint16_t)(2u * (nlen + 1u));
+    v[o++] = (uint8_t)(w & 0xffu); v[o++] = (uint8_t)(w >> 8);
+    for (i = 0; i < nlen; i++) {
+        v[o++] = (uint8_t)name[i];
+        v[o++] = 0;
+    }
+    v[o++] = 0; v[o++] = 0;
+    w = (uint16_t)(2u * (glen + 2u));
+    v[o++] = (uint8_t)(w & 0xffu); v[o++] = (uint8_t)(w >> 8);
+    for (i = 0; i < glen; i++) {
+        v[o++] = (uint8_t)guid[i];
+        v[o++] = 0;
+    }
+    v[o++] = 0; v[o++] = 0;
+    v[o++] = 0; v[o++] = 0;
+    ruby_msos_len = o;
+    printf("RUBY 0332: bos=%u msos=%u iface=%u reglen=%u rescue ep=01/81 kept ",
+        RUBY_BOS_LEN, ruby_msos_len, iface, reglen);
+}
