+
+/* 0332: USB 2.01 hosts ask for the device qualifier and the other-speed
+ * configuration; stall at 2.00 was tolerated, at 2.01 it aborts the
+ * enumeration with "invalid configuration descriptor".  Serve a HS-only
+ * qualifier (one other-speed configuration) and an FS-clamped copy. */
+static uint8_t ruby_qual_desc[10];
+static uint8_t ruby_other_cfg[96];
+static uint32_t ruby_other_len;
+static int ruby_0332_qual_ready;
+
+static void
+ruby_0332_build_qual(void)
+{
+    if (ruby_0332_qual_ready)
+        return;
+    ruby_0332_qual_ready = 1;
+    ruby_qual_desc[0] = 10;
+    ruby_qual_desc[1] = 0x06;
+    ruby_qual_desc[2] = 0x00;
+    ruby_qual_desc[3] = 0x02;
+    ruby_qual_desc[4] = ruby_dev_desc[4];
+    ruby_qual_desc[5] = ruby_dev_desc[5];
+    ruby_qual_desc[6] = ruby_dev_desc[6];
+    ruby_qual_desc[7] = 64;
+    ruby_qual_desc[8] = 1;
+    ruby_qual_desc[9] = 0;
+
+    ruby_other_len = ruby_build_cfg_desc(ruby_other_cfg);
+    if (ruby_other_len >= 2)
+        ruby_other_cfg[1] = 0x07;
+    {
+        uint32_t off = 9;
+
+        while (off + 2 <= ruby_other_len) {
+            uint8_t len = ruby_other_cfg[off];
+
+            if (len < 2)
+                break;
+            if (ruby_other_cfg[off + 1] == 0x05 && off + 6 <= ruby_other_len) {
+                uint16_t mps = (uint16_t)(ruby_other_cfg[off + 4] |
+                    (ruby_other_cfg[off + 5] << 8));
+
+                if (mps > 64) {
+                    ruby_other_cfg[off + 4] = 64;
+                    ruby_other_cfg[off + 5] = 0;
+                }
+            }
+            off += len;
+        }
+    }
+    printf("RUBY 0332: qual=10 other_cfg=%u ", ruby_other_len);
+}
+
+static void
+ruby_ep0_0332_msos(vm_offset_t mac, uint32_t t, uint32_t wlen)
+{
+    static uint32_t msos_reqs;
+
+    if (!ruby_0332_msos_on()) {
+        ruby_ep0_stall(mac, t, 0xc001, wlen);
+        return;
+    }
+    if (msos_reqs < 8) {
+        msos_reqs++;
+        printf("RUBY 0332: msos req wlen=%u ", wlen);
+    }
+    ruby_0332_build();
+    if (ruby_0332_iface < 0) {
+        ruby_ep0_stall(mac, t, 0xc001, wlen);
+        return;
+    }
+    ruby_ep0_send(mac, t, 0xc001, ruby_msos_desc, ruby_msos_len, wlen);
+}
