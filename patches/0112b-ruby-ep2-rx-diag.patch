+/* Vendor IN request 0xC0/0x24: raw current/prev/next RX GPD + RX CSRs. */
+static void
+ruby_ep0_vendor_rx_gpd(vm_offset_t mac, uint32_t t, uint32_t wlen)
+{
+    uint32_t v[16];
+    uint32_t rqcpr, rqhiar, rqcsr, rx0, rx1, rx2, hwo = 0, cur, i;
+    uint32_t *g;
+
+    ruby_dc_civac(ruby_rx_gpd_ring, sizeof(ruby_rx_gpd_ring));
+    for (i = 0; i < RUBY_RX_GPD_NUM; i++)
+        if (ruby_rx_gpd_ring[i * 16] & 1u)
+            hwo |= 1u << i;
+
+    rqcpr = ruby_rd32(mac, RQCPR2_OFF);
+    rqhiar = ruby_rd32(mac, RQHIAR2_OFF);
+    rqcsr = ruby_rd32(mac, RQCSR2_OFF);
+    rx0 = ruby_rd32(mac, RX2CSR0_OFF);
+    rx1 = ruby_rd32(mac, RX2CSR1_OFF);
+    rx2 = ruby_rd32(mac, RX2CSR2_OFF);
+    cur = ruby_ep2_rx_cur_slot(mac);
+
+    v[0] = 0x47325045u;         /* "EP2G" */
+    v[1] = rqcpr;
+    v[2] = rqhiar;
+    v[3] = rqcsr;
+    v[4] = rx0;
+    v[5] = rx1;
+    v[6] = rx2;
+    v[7] = hwo;
+    v[8] = cur;
+    v[9] = v[10] = v[11] = v[12] = v[13] = v[14] = 0;
+    if (cur != 0xffu) {
+        uint32_t prev = (cur + RUBY_RX_GPD_NUM - 1u) % RUBY_RX_GPD_NUM;
+        uint32_t next = (cur + 1u) % RUBY_RX_GPD_NUM;
+
+        g = (uint32_t *)(ruby_rx_gpd_ring + cur * 16);
+        v[9] = g[0];
+        v[10] = g[1];
+        v[11] = g[2];
+        v[12] = g[3];
+        v[13] = *(uint32_t *)(ruby_rx_gpd_ring + prev * 16 + 12);
+        v[14] = *(uint32_t *)(ruby_rx_gpd_ring + next * 16 + 12);
+    }
+    v[15] = (ruby_rx_zlp_err & 0xffffu) |
+        ((ruby_rx_stall_seen & 1u) << 16) |
+        ((ruby_rx_ready & 1u) << 31);
+    ruby_ep0_send(mac, t, 0xc024, (const uint8_t *)v, sizeof(v), wlen);
+}
+
+/* Vendor IN request 0xC0/0x26: reset the RX ring/counters for a clean test. */
+static void
+ruby_ep0_vendor_rx_reset(vm_offset_t mac, uint32_t t, uint32_t wlen)
+{
+    uint32_t v[1];
+
+    ruby_ep2_rx_reset(mac, 1);
+    v[0] = 0x4b4f5852u;         /* "RXOK" */
+    ruby_ep0_send(mac, t, 0xc026, (const uint8_t *)v, sizeof(v), wlen);
+}
