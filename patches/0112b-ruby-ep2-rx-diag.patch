+static void
+ruby_ep2_rx_reset(vm_offset_t mac, uint32_t reset_counters)
+{
+    uint32_t csr, i;
+
+    if (!ruby_rx_ring_pa)
+        return;
+
+    ruby_wr32(mac, RQCSR2_OFF, QMU_Q_STOP);
+    csr = ruby_rd32(mac, RX2CSR0_OFF) &
+        ~(RX_SENTSTALL_BIT | RX_RXPKTRDY_BIT);
+    csr = (csr & ~RX_SENDSTALL_BIT) | RX_SENTSTALL_BIT | RX_RXPKTRDY_BIT;
+    ruby_wr32(mac, RX2CSR0_OFF, csr);
+    ruby_wr32(mac, EP_RST_OFF, EP_RST_RX2_BIT);
+    ruby_wr32(mac, EP_RST_OFF, 0);
+
+    /* EP_RST may reset the per-endpoint configuration; restore it before
+     * re-arming the ring so every clean test starts from the same state. */
+    ruby_wr32(mac, RX2CSR0_OFF, 64u | RX_DMAREQEN);
+    ruby_wr32(mac, RX2CSR1_OFF, RX_SLOT(2) | RX_TYPE(0));
+    ruby_wr32(mac, RX2CSR2_OFF, RX_FIFOADDR(0) | RX_FIFOSEGSIZE(9));
+    ruby_wr32(mac, QCR0_OFF,
+        ruby_rd32(mac, QCR0_OFF) | QMU_RX_CS_EN_BIT);
+    ruby_wr32(mac, QCR3_OFF,
+        (ruby_rd32(mac, QCR3_OFF) & ~QMU_RX_ZLP_BIT) | QMU_RX_COZ_BIT);
+    ruby_wr32(mac, RQERRIESR0_OFF, ruby_rd32(mac, RQERRIESR0_OFF) |
+        QMU_RX_LEN_ERR_BIT | QMU_RX_CS_ERR_BIT);
+    ruby_wr32(mac, RQERRIESR1_OFF, ruby_rd32(mac, RQERRIESR1_OFF) |
+        QMU_RX_ZLP_ERR_BIT);
+    ruby_wr32(mac, RQSAR2_OFF, (uint32_t)ruby_rx_ring_pa);
+    ruby_wr32(mac, RQHIAR2_OFF, (uint32_t)((ruby_rx_ring_pa >> 32) & 0xfu));
+
+    ruby_rx_ready = 0;
+    ruby_rx_deq = 0;
+    ruby_rx_stall_seen = 0;
+    if (reset_counters) {
+        ruby_rx_packets = 0;
+        ruby_rx_bytes = 0;
+        ruby_rx_zlp = 0;
+        ruby_rx_last_len = 0;
+        ruby_rx_crc = RUBY_FNV_OFFSET;
+        ruby_rx_errors = 0;
+        ruby_rx_empty = 0;
+        ruby_rx_done_events = 0;
+        ruby_rx_bypasses = 0;
+        ruby_rx_ext_bad = 0;
+        ruby_rx_zlp_err = 0;
+    }
+    for (i = 0; i < RUBY_RX_GPD_NUM; i++)
+        ruby_ep2_rx_arm(i);
+    ruby_wr32(mac, RQCSR2_OFF, QMU_Q_START);
+    ruby_rx_ready = 1;
+}
+
+static void
+ruby_ep2_rx_halt_clear(vm_offset_t mac)
+{
+    ruby_ep2_rx_reset(mac, 0);
+}
