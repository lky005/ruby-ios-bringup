+ * host answered every GET_DESCRIPTOR with a port reset even though the
+ * driver had loaded the full response and written DATAEND.
  *
  * strict=0 is the 1 ms service tick, kept at the 0113b rule that TXPKTRDY
  * clear alone is enough.  So the strict test can only ever cost a tick, it
@@ -522,6 +528,9 @@ ruby_ep0_tx_step(vm_offset_t mac, uint32_t t, int strict)
         ruby_ep0_txpkts++;
         return 1;
     }
+    /* Last packet is out; leave DATAEND to the service tick (0113b timing). */
+    if (strict)
+        return 0;
     /*
      * On this IP EP0_FIFOFULL remains set until DATAEND is written
      * (0105/0107 finding).  Gating DATAEND on it deadlocks short and
@@ -623,12 +632,14 @@ ruby_ep0_send(vm_offset_t mac, uint32_t t, uint16_t key, const uint8_t *data,
     ruby_trace(t, RUBY_TR_SEND, key, total, wlen, n);
 
     /*
