+		if (!err)
+			err = pr_i2c_write_reg(b, 0x34, 0xD8, 0x9E);
+		if (!err)
+			err = pr_i2c_read_regs(b, 0x34, 0xD0, irq2, 16);
+		(void)pr_i2c_release(b);
+		if (err) {
+			printf("RUBY MT6360: ack err=%d\n", err);
+			return 1;
