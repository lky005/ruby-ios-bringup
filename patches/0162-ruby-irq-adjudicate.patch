+{
+	uint32_t i;
+
+	printf("RUBY MT6360: %s irq d0..df:", tag);
+	for (i = 0; i < 16; i++)
+		printf(" %02x", irq[i]);
+	printf("\n");
+	printf("RUBY MT6360: %s mask f0..ff:", tag);
+	for (i = 0; i < 16; i++)
+		printf(" %02x", mask[i]);
+	printf("\n");
+	printf("RUBY MT6360: %s base irq=d8:%02x mask=f8:%02x\n", tag,
+	    irq[8], mask[8]);
+}
+
+static void
+pr_mt6360_chg(const uint8_t *chg)
+{
+	uint32_t i;
+
+	printf("RUBY MT6360: chg e0..ef:");
+	for (i = 0; i < 16; i++)
+		printf(" %02x", chg[i]);
+	printf("\n");
+}
