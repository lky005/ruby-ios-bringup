+static int
+pr_i2c_write_reg(struct ruby_i2c_bus *b, uint8_t addr, uint8_t reg,
+    uint8_t val)
+{
+	int ack;
+
+	if (!ruby_i2c_start(b))
+		return ETIMEDOUT;
+	ack = ruby_i2c_write_byte(b, (uint8_t)(addr << 1));
+	if (ack != 1)
+		goto fail;
+	ack = ruby_i2c_write_byte(b, reg);
+	if (ack != 1)
+		goto fail;
+	ack = ruby_i2c_write_byte(b, val);
+	if (ack != 1)
+		goto fail;
+	ruby_i2c_stop(b);
+	return 0;
+
+fail:
+	ruby_i2c_stop(b);
+	return ack < 0 ? ETIMEDOUT : ENXIO;
 }
 
