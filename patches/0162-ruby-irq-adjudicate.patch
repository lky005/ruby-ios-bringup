+		if (!err)
+			err = pr_i2c_read_regs(b, 0x34, 0xF0, mask, 16);
+		if (!err)
+			err = pr_i2c_read_regs(b, 0x34, 0xE0, chg, 16);
+		(void)pr_i2c_release(b);
+		if (err) {
+			printf("RUBY MT6360: status err=%d\n", err);
+			return 1;
+		}
+		pr_mt6360_dump("now", irq, mask);
+		pr_mt6360_chg(chg);
+		pr_gpio_read(4);
+		return 1;
+	}
+	if (!strcmp(p, "ack")) {
