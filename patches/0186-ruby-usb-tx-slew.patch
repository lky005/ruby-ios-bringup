--- a/bsd/dev/ruby_usb.c
+++ b/bsd/dev/ruby_usb.c
@@ -122,6 +122,20 @@
 #define ACR3_PUPD_BIST_EN   (1u << 12)
 #define ACR3_EN_PU_DP       (1u << 9)
 
+/* 0186: vendor hs_slew_rate_calibrate (tphy v2, U2FREQ bank at +0x100). */
+#define PHY_U2_FMCR0    0x0100
+#define PHY_U2_FMVAL    0x010c
+#define PHY_U2_FMMONR1  0x0110
+#define ACR5_SRCAL_EN   (1u << 15)
+#define ACR5_SRCTRL     (0x7u << 12)
+#define FMCR0_FREQDET_EN (1u << 24)
+#define FMCR0_CYCLECNT  0x00ffffffu
+#define FMMONR1_FRCK_EN  (1u << 8)
+#define FMMONR1_FM_VALID (1u << 0)
+#define RUBY_SLEW_REF_MHZ  26u
+#define RUBY_SLEW_COEF     28u
+#define RUBY_SLEW_CYCLE    1024u
+
 /* 0185: ruby u2port0 HS eye tuning (mt6877.dts device values). */
 #define PHY_U2_ACR1     0x0304
 #define ACR1_VRT_SEL    (0x7u << 12)    /* PA1_RG_VRT_SEL  [14:12] */
@@ -432,7 +446,7 @@
 static void
 ruby_usb_u2_phy_on(vm_offset_t phy)
 {
-    uint32_t v;
+    uint32_t v, fm_out, calib, i;
 
     /* u2_phy_instance_init (tphy v2, generic-tphy-v2). */
     v = ruby_rd32(phy, PHY_U2_DTM0);
@@ -521,6 +535,45 @@
     v |= DTM1_RG_VBUSVALID | DTM1_RG_AVALID;
     v &= ~DTM1_RG_SESSEND;
     ruby_wr32(phy, PHY_U2_DTM1, v);
+
+    /*
+     * 0186: vendor hs_slew_rate_calibrate (ruby u2port0 has no eye-src).
+     * Runs after instance power-on and before the D+ pull-up, matching
+     * mtk_phy_power_on() -> u2_phy_instance_power_on() -> this.
+     */
+    v = ruby_rd32(phy, PHY_U2_ACR5);
+    ruby_wr32(phy, PHY_U2_ACR5, v | ACR5_SRCAL_EN);
+    delay(1);
+    v = ruby_rd32(phy, PHY_U2_FMMONR1);
+    ruby_wr32(phy, PHY_U2_FMMONR1, v | FMMONR1_FRCK_EN);
+    v = ruby_rd32(phy, PHY_U2_FMCR0);
+    v &= ~FMCR0_CYCLECNT;
+    v |= RUBY_SLEW_CYCLE & FMCR0_CYCLECNT;
+    ruby_wr32(phy, PHY_U2_FMCR0, v);
+    ruby_wr32(phy, PHY_U2_FMCR0, v | FMCR0_FREQDET_EN);
+    fm_out = 0;
+    for (i = 0; i < 200; i++) {
+        if (ruby_rd32(phy, PHY_U2_FMMONR1) & FMMONR1_FM_VALID) {
+            fm_out = ruby_rd32(phy, PHY_U2_FMVAL);
+            break;
+        }
+        delay(10);
+    }
+    v = ruby_rd32(phy, PHY_U2_FMCR0);
+    ruby_wr32(phy, PHY_U2_FMCR0, v & ~FMCR0_FREQDET_EN);
+    v = ruby_rd32(phy, PHY_U2_FMMONR1);
+    ruby_wr32(phy, PHY_U2_FMMONR1, v & ~FMMONR1_FRCK_EN);
+    calib = fm_out ?
+        (RUBY_SLEW_REF_MHZ * RUBY_SLEW_COEF * RUBY_SLEW_CYCLE / fm_out +
+            500u) / 1000u : 4u;
+    if (calib > 7u)
+        calib = 7u;
+    v = ruby_rd32(phy, PHY_U2_ACR5);
+    v &= ~(ACR5_SRCAL_EN | ACR5_SRCTRL);
+    v |= (calib & 7u) << 12;
+    ruby_wr32(phy, PHY_U2_ACR5, v);
+    printf("RUBY USB: slew fm_out=%u calib=%u acr5=0x%08x\n",
+        fm_out, calib, ruby_rd32(phy, PHY_U2_ACR5));
 }
 
 static void
