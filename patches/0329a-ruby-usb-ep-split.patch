new file mode 100644
index 0000000..cb16c2e
--- /dev/null
+++ b/bsd/dev/ruby_usb_ep.h
@@ -0,0 +1,59 @@
+#ifndef _RUBY_USB_EP_H_
+#define _RUBY_USB_EP_H_
+
+#include <mach/vm_types.h>
+#include <kern/locks.h>
+#include <sys/types.h>
+
+/*
+ * 0329a: L2 endpoint core.  The EP table, request queue and lock group
+ * move here unchanged from ruby_usb.c; the surrounding layers still call
+ * the same functions, so this slice is a pure relocation.
+ */
+#define RUBY_EP_MAX         16u
+#define RUBY_EP_DIR_IN      0u
+#define RUBY_EP_DIR_OUT     1u
+#define RUBY_EP_TYPE_CTRL   0u
+#define RUBY_EP_TYPE_BULK   2u
+#define RUBY_EP_TYPE_INTR   3u
+
+struct ruby_req {
+    const uint8_t *buf;
+    uint32_t       len;
+    void (*done)(void *ctx, int status);
+    void          *ctx;
+    struct ruby_req *next;
+};
+
+struct ruby_ep {
+    int8_t        valid;
+    uint8_t       addr;        /* full bEndpointAddress, 0x81 etc. */
+    uint8_t       dir;         /* RUBY_EP_DIR_* */
+    uint8_t       type;        /* RUBY_EP_TYPE_* */
+    uint8_t       iface;       /* owning interface number */
+    uint16_t      mps;         /* wMaxPacketSize */
+    uint8_t       interval;    /* bInterval (0 for bulk) */
+    lck_spin_t    q_lock;
+    struct ruby_req *q_head;
+    struct ruby_req *q_tail;
+    uint32_t      q_depth;
+};
+
+extern struct ruby_ep ruby_eps[RUBY_EP_MAX];
+
+/*
+ * Transitional: the function registry still lives in ruby_usb.c (L6).
+ * 0329b moves it behind the composite builder; until then ruby_ep_init()
+ * uses this declaration to register the built-in functions unchanged.
+ */
+void ruby_func_register(const char *name,
+    int (*setup)(vm_offset_t, uint32_t, uint8_t, uint8_t, uint32_t, uint32_t,
+                 uint32_t),
+    void (*configure)(vm_offset_t));
+
+void ruby_ep_init(void);
+struct ruby_ep *ruby_ep_by_addr(uint8_t addr);
+int ruby_ep_queue(struct ruby_ep *ep, struct ruby_req *req);
+void ruby_ep_complete(struct ruby_ep *ep, int status);
+
+#endif /* _RUBY_USB_EP_H_ */
