diff --git a/bsd/dev/ruby_usb_ep.c b/bsd/dev/ruby_usb_ep.c
new file mode 100644
index 0000000..1daab3b
--- /dev/null
+++ b/bsd/dev/ruby_usb_ep.c
@@ -0,0 +1,99 @@
+/*
+ * 0329a: L2 endpoint core moved verbatim from ruby_usb.c.
+ *
+ * The EP table, lock group and queue helpers are unchanged; the function
+ * registry call in ruby_ep_init() is the only cross-layer reference and
+ * stays a transitional declaration until 0329b moves the registry.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/locks.h>
+
+#include "ruby_usb_ep.h"
+
+struct ruby_ep ruby_eps[RUBY_EP_MAX];
+static lck_grp_t ruby_usb_lck_grp;
+static volatile uint32_t ruby_usb_lck_init;
+
+static void
+ruby_usb_lck_ensure(void)
+{
+    if (ruby_usb_lck_init == 0) {
+        lck_grp_init(&ruby_usb_lck_grp, "ruby_usb", LCK_GRP_ATTR_NULL);
+        for (uint32_t i = 0; i < RUBY_EP_MAX; i++)
+            lck_spin_init(&ruby_eps[i].q_lock, &ruby_usb_lck_grp, LCK_ATTR_NULL);
+        __atomic_store_n(&ruby_usb_lck_init, 1, __ATOMIC_RELEASE);
+    }
+}
+
+void
+ruby_ep_init(void)
+{
+    ruby_usb_lck_ensure();
+    for (uint32_t i = 0; i < RUBY_EP_MAX; i++)
+        ruby_eps[i].valid = 0;
+    /* EP0 */
+    ruby_eps[0].valid = 1; ruby_eps[0].addr = 0x00;
+    ruby_eps[0].dir = RUBY_EP_DIR_OUT; ruby_eps[0].type = RUBY_EP_TYPE_CTRL;
+    ruby_eps[0].mps = 64;
+    /* 0216 live wire: EP1 OUT 0x01 MPS 512, EP2 OUT 0x02 MPS 64, EP1 IN 0x81 MPS 512 */
+    /*
+     * 0262: vendor EP1 OUT is maxp 512.  With maxp 64 a 256-byte write is
+     * four full packets with no short packet/ZLP to terminate the transfer,
+     * so the QMU waits forever and the endpoint NAKs (ADB ZLP doc "stall").
+     * 512 turns 256 B into one short packet and 1000 B into 512 + 488.
+     */
+    ruby_eps[1].valid = 1; ruby_eps[1].addr = 0x01; ruby_eps[1].iface = 0;
+    ruby_eps[1].dir = RUBY_EP_DIR_OUT; ruby_eps[1].type = RUBY_EP_TYPE_BULK; ruby_eps[1].mps = 512;
+    ruby_eps[2].valid = 1; ruby_eps[2].addr = 0x02; ruby_eps[2].iface = 0;
+    ruby_eps[2].dir = RUBY_EP_DIR_OUT; ruby_eps[2].type = RUBY_EP_TYPE_BULK; ruby_eps[2].mps = 64;
+    ruby_eps[3].valid = 1; ruby_eps[3].addr = 0x81; ruby_eps[3].iface = 0;
+    ruby_eps[3].dir = RUBY_EP_DIR_IN;  ruby_eps[3].type = RUBY_EP_TYPE_BULK; ruby_eps[3].mps = 512;
+    /* 0223: probe function (commands) + log function (stream) */
+    ruby_func_register("probe", NULL, NULL);
+    ruby_func_register("log", NULL, NULL);
+}
+
+struct ruby_ep *
+ruby_ep_by_addr(uint8_t addr)
+{
+    for (uint32_t i = 0; i < RUBY_EP_MAX; i++)
+        if (ruby_eps[i].valid && ruby_eps[i].addr == addr)
+            return &ruby_eps[i];
+    return NULL;
+}
+
+/* Lock-held queue ops (q_head/q_tail write must go through these). */
+int
+ruby_ep_queue(struct ruby_ep *ep, struct ruby_req *req)
+{
+    if (!ep->valid || req->len == 0 || req->len > 16 * 1024)
+        return -1;  /* CL-0219 guard: contiguous PA, 1 req = 1 GPD */
+    lck_spin_lock(&ep->q_lock);
+    req->next = NULL;
+    if (ep->q_tail)
+        ep->q_tail->next = req;
+    else
+        ep->q_head = req;
+    ep->q_tail = req;
+    ep->q_depth++;
+    lck_spin_unlock(&ep->q_lock);
+    return 0;
+}
+
+void
+ruby_ep_complete(struct ruby_ep *ep, int status)
+{
+    struct ruby_req *req;
+    lck_spin_lock(&ep->q_lock);
+    req = ep->q_head;
+    if (req) {
+        ep->q_head = req->next;
+        if (!ep->q_head)
+            ep->q_tail = NULL;
+        ep->q_depth--;
+    }
+    lck_spin_unlock(&ep->q_lock);
+    if (req && req->done)
+        req->done(req->ctx, status);
+}
