+/*
+ * Walk completed GPDs up to the QMU's current pointer, like the vendor
+ * qmu_done_tx.  HWO clears when the QMU takes a GPD, so the current-GPD
+ * address is what tells us how far the ring actually advanced.  A valid
+ * cur is required: a guessed pointer can release a GPD still in flight.
+ */
+uint32_t
+ruby_ep2_drain(vm_offset_t mac, uint32_t q0)
+{
+    uint32_t cur, freed = 0, i;
+    uint64_t hwo;
+
+    ruby_ep2_drain_calls++;
+    if (ruby_inflight == 0)
+        return 0;
+
+    cur = ruby_ep2_cur_slot(mac);
+    if (cur == 0xffu) {
+        ruby_ep2_cur_bad++;
+        return 0;
+    }
+    if (ruby_ep2_ring_dist(ruby_gpd_deq, cur) > ruby_inflight) {
+        ruby_ep2_cur_bad++;
+        return 0;
+    }
+
+    ruby_dma_mb();          /* TQCPR read complete before HWO snapshot */
+    hwo = ruby_ep2_hwo_bits();
+    while (ruby_inflight > 0 && ruby_gpd_deq != cur) {
+        i = ruby_gpd_deq;
+        if (hwo & (1ull << i)) {
+            ruby_ep2_hwo_gap++;
+            break;
+        }
+        ruby_gpd_deq = (i + 1u) % ruby_tx_ring_n;
+        ruby_inflight--;
+        freed++;
+    }
+
+    if (freed) {
+        struct ruby_ep *txep = ruby_ep_for_addr(ruby_tx_ep_addr);
+        if (txep) {
+            /* 0222: dequeue the burst under one lock hold, run the
+             * completes AFTER the lock drops (they are currently
+             * NULL, but the discipline generalizes to consumers). */
+            struct ruby_req *done_reqs[64];
+            uint32_t done_n = 0;
+            lck_spin_lock(&txep->q_lock);
+            while (txep->q_head && done_n < 64) {
+                struct ruby_req *r = txep->q_head;
+                txep->q_head = r->next;
+                if (!txep->q_head)
+                    txep->q_tail = NULL;
+                txep->q_depth--;
+                done_reqs[done_n++] = r;
+            }
+            lck_spin_unlock(&txep->q_lock);
+            for (uint32_t ci = 0; ci < done_n; ci++) {
+                struct ruby_req *r = done_reqs[ci];
+                if (r->done)
+                    r->done(r->ctx, 0);
+            }
+        }
+        ruby_txdone_count += freed;
+        ruby_ep2_drain_freed_total += freed;
+        ruby_tx_progress_deq = ruby_gpd_deq;
+        ruby_tx_progress_ms = ruby_ms;
+        ruby_tx_reset_tries = 0;
+        /*
+         * 0300: once the ring drains, the QMU has no GPD left to fetch and
+         * this MAC parks the queue (0272/0273: RESUME on the parked queue
+         * is a no-op).  Mark the software state unstarted so the next
+         * prepared GPD issues Q_START instead of a dead RESUME.
+         * 0304: qstart_keep retains vendor's never-clear-started model;
+         * the doorbell axis covers the parked-RESUME case.
+         */
+        if (ruby_inflight == 0 && !ruby_qstart_keep)
+            ruby_tx_queue_started = 0;
+        ruby_tx_mtr_add(RUBY_MTR_TX_DONE, (uint16_t)freed,
+            cur, ruby_rd32(mac, TQCSR1_OFF));
+        if (freed > ruby_ep2_drain_max)
+            ruby_ep2_drain_max = freed;
+        if (!(q0 & RUBY_QMU_TX_DONE))
+            ruby_ep2_drain_noq0++;
+    }
+
+    if (cur == ruby_gpd_enq && ruby_inflight != 0)
+        ruby_ep2_drain_invariant++;
+    return freed;
+}
