+    /*
+     * 0142: EP2 IN MPS 64 -> 512.  The FIFO segment already covers it:
+     * TX1CSR2 SEGSIZE 9 = ilog2(512) in vendor ep_fifo_alloc semantics,
+     * and a 512 B segment serves both 64 and 512 maxpacket.
+     */
