+        printf("RUBY USB: GPD[%02u] flag=%02x chk=%02x len=%u "
+            "next=%08x buf=%08x\n", i, g[0], g[1],
+            (uint32_t)(*(volatile uint16_t *)(g + 12)),
+            *(volatile uint32_t *)(g + 4),
+            *(volatile uint32_t *)(g + 8));
+    }
+}
