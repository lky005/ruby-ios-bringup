+     * bits clear is the only untested vendor-aligned combination). */
+    ruby_wr32(mac, QCR0_OFF, 1u);
+    ruby_wr32(mac, QCR1_OFF, ruby_rd32(mac, QCR1_OFF) | 0x0006000eu);
+    ruby_wr32(mac, TQERRIESR0_OFF,
+        ruby_rd32(mac, TQERRIESR0_OFF) | (1u << 17) | (1u << 1));
