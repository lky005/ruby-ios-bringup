+static void
+gt_soft_reset(void)
+{
+	int ok;
+
+	/*
+	 * Drop stale SPI controller/FIFO state, then re-handshake the chip.
+	 * No reset pin, no rail change, no backoff.
+	 */
+	(void)ruby_spi3_set_speed(gt.hw_speed_khz);
+	ok = gt_dev_confirm() && gt_version_ok();
+	gt.fail_streak = 0;
+	if (ok) {
+		gt.hw_fail = 0;
+	}
+	GT_LOG("SWEET GT: soft reset %s\n", ok ? "ok" : "no-ack");
+}
+
 void
 sweet_gt_service_done(int ok)
 {
-	if (gt.eint) {
-		ruby_eint_service_done(gt.eint, ok, ok);
+	if (!gt.eint) {
+		return;
+	}
+	if (ruby_eint_service_done(gt.eint, ok, ok)) {
+		gt_soft_reset();
 	}
 }
 
