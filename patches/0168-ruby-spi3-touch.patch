+			return 1;
+		}
+		__atomic_store_n(&gt.bb_barrier, v, __ATOMIC_RELEASE);
+		printf("SWEET GT: bb bar=%u\n", v);
+		return 1;
+	}
+	if (!strncmp(p, "hwfail ", 7)) {
+		if (gt_parse_uint(p + 7, &v) != 0 || v < 1 || v > 100) {
+			printf("SWEET GT: hwfail 1..100\n");
+			return 1;
+		}
+		gt.hw_fail_max = v;
+		printf("SWEET GT: hwfail=%u\n", v);
+		return 1;
+	}
+	if (!strncmp(p, "spi speed ", 10)) {
+		if (gt_parse_uint(p + 10, &v) != 0 || v < 100 || v > 5000) {
+			printf("SWEET GT: spi speed 100..5000 kHz\n");
+			return 1;
+		}
+		__atomic_store_n(&gt.hw_speed_khz, v, __ATOMIC_RELEASE);
+		__atomic_store_n(&gt.speed_request, v, __ATOMIC_RELEASE);
+		printf("SWEET GT: spi speed request=%u kHz\n", v);
+		return 1;
+	}
+	if (!strncmp(p, "spi failtest ", 13)) {
+		if (!gt.dbg) {
+			printf("SWEET GT: failtest needs sweetgtdbg=1\n");
+			return 1;
+		}
+		p += 13;
+		while (*p == ' ') {
+			p++;
