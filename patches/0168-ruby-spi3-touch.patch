+		if (!strcmp(p, "bb")) {
+			__atomic_store_n(&gt.mode_request, GT_REQ_BB_FAST,
+			    __ATOMIC_RELEASE);
+		} else if (!strcmp(p, "legacy")) {
+			__atomic_store_n(&gt.mode_request, GT_REQ_BB_LEGACY,
+			    __ATOMIC_RELEASE);
+		} else if (!strcmp(p, "hw")) {
+			__atomic_store_n(&gt.mode_request, GT_REQ_HW,
+			    __ATOMIC_RELEASE);
+		} else if (!strcmp(p, "auto")) {
+			__atomic_store_n(&gt.mode_request, GT_REQ_AUTO,
+			    __ATOMIC_RELEASE);
+		} else if (!strcmp(p, "off")) {
+			__atomic_store_n(&gt.mode_request, GT_REQ_OFF,
+			    __ATOMIC_RELEASE);
+		} else {
+			printf("SWEET GT: bus bb|legacy|hw|auto|off\n");
+			return 1;
