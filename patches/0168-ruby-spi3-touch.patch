+static const char *
+gt_bus_name(enum gt_bus_mode bus)
+{
+	switch (bus) {
+	case GT_BUS_BB_LEGACY:
+		return "bb-legacy";
+	case GT_BUS_BB_FAST:
+		return "bb-fast";
+	case GT_BUS_SPI3:
+		return "spi3";
+	default:
+		return "off";
+	}
+}
+
+static int
+gt_parse_uint(const char *s, uint32_t *out)
+{
+	uint32_t v = 0;
+	int any = 0;
+
+	while (*s == ' ' || *s == '\t') {
+		s++;
+	}
+	while (*s >= '0' && *s <= '9') {
+		v = v * 10 + (uint32_t)(*s - '0');
+		s++;
+		any = 1;
+	}
+	if (!any) {
+		return EINVAL;
+	}
+	*out = v;
+	return 0;
+}
+
+int
+sweet_goodix_cmd(char *cmd)
+{
+	char *p = cmd;
+	char *q;
+	uint32_t v;
