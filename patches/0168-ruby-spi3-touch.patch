+		if (!strcmp(p, "self")) {
+			__atomic_store_n(&gt.fail_selftest, 1, __ATOMIC_RELEASE);
+		} else if (!strcmp(p, "runtime")) {
+			__atomic_store_n(&gt.fail_next, 3, __ATOMIC_RELEASE);
+		} else if (!strcmp(p, "off")) {
+			__atomic_store_n(&gt.fail_selftest, 0, __ATOMIC_RELEASE);
+			__atomic_store_n(&gt.fail_next, 0, __ATOMIC_RELEASE);
+		} else {
+			printf("SWEET GT: spi failtest self|runtime|off\n");
+			return 1;
+		}
+		printf("SWEET GT: failtest=%s\n", p);
+		return 1;
+	}
+	printf("SWEET GT: gt diag | bus [bb|legacy|hw|auto|off] | recover | log 0|1 | hwfail <1..100> | bb delay <us> | bb bar <0..15> | spi speed <khz>\n");
+	return 1;
+}
