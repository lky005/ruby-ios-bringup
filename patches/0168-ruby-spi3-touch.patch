+	    mode == GT_BUS_BB_LEGACY ? "bb-legacy" : "bb-fast");
+}
+
+static void
+gt_apply_mode(int req)
+{
+	switch (req) {
+	case GT_REQ_BB_FAST:
+		gt_switch_bb(GT_BUS_BB_FAST);
+		break;
+	case GT_REQ_BB_LEGACY:
+		gt_switch_bb(GT_BUS_BB_LEGACY);
+		break;
+	case GT_REQ_HW:
+		if (gt_try_hw() != 0) {
+			gt_switch_bb(GT_BUS_BB_LEGACY);
+		}
+		break;
+	case GT_REQ_AUTO:
+		if (gt_try_hw() != 0) {
+			gt_switch_bb(GT_BUS_BB_LEGACY);
+		}
+		break;
+	case GT_REQ_OFF:
+		gt.stop_requested = 1;
+		break;
+	default:
+		break;
+	}
+}
+
+static void
+gt_fallback_bb(void)
+{
+	GT_LOG("SWEET GT: spi3 runtime fail %u; switch bb-legacy\n",
+	    gt.hw_fail);
+	gt_diag.path_switch++;
+	gt_release_all();
+	gt_switch_bb(GT_BUS_BB_LEGACY);
+	gt.fail_streak = 0;
+}
+
+static void
+gt_stop(void)
+{
+	if (gt.hw_ready || gt.bus == GT_BUS_SPI3) {
+		ruby_spi3_shutdown();
+	}
+	gt.hw_ready = 0;
+	if (gt.gpio) {
+		gt_pins_gpio_init();
+	}
+	gt_release_all();
+	if (gt.eint) {
+		ruby_eint_detach(gt.eint);
+		gt.eint = NULL;
+	}
+	gt.bus = GT_BUS_OFF;
+	GT_LOG("SWEET GT: touch disabled\n");
+}
+
+static void
+gt_recover(void)
+{
+	enum gt_bus_mode old = gt.bus;
+	int was_hw = (old == GT_BUS_SPI3);
+
+	gt_release_all();
+	if (gt.hw_ready || was_hw) {
+		ruby_spi3_shutdown();
+	}
+	gt.hw_ready = 0;
+	gt.bus = GT_BUS_BB_LEGACY;
+	gt_pins_gpio_init();
+
+	gt_wr(GT_RESET_DIR, gt_rd(GT_RESET_DIR) | GT_RESET);
+	gt_wr(GT_RESET_DO, gt_rd(GT_RESET_DO) & ~GT_RESET);
+	gt_wait(10);
+	gt_wr(GT_RESET_DO, gt_rd(GT_RESET_DO) | GT_RESET);
+	gt_wait(100);
+
+	if (!gt_dev_confirm() || !gt_version_ok()) {
+		GT_LOG("SWEET GT: recover failed; stay bb-legacy\n");
+		return;
+	}
+	gt.recover_count++;
+	gt_diag.recover++;
+	GT_LOG("SWEET GT: recover ok (%u)\n", gt.recover_count);
+
+	if (was_hw && gt_try_hw() == 0) {
+		return;
+	}
+	/* Fast BB is experimental and has proven destructive on this
+	 * panel; never make it the implicit recovery target. */
+	gt_switch_bb(GT_BUS_BB_LEGACY);
+}
+
+static int
+gt_service_frame(void)
+{
+	int rc = gt_frame();
+
+	if (rc == GT_FRAME_OK || rc == GT_FRAME_NONE) {
+		gt.hw_fail = 0;
+		gt.fail_streak = 0;
+		return 1;
+	}
+
+	if (rc == GT_FRAME_BUS_ERROR) {
+		gt.hw_fail++;
+		gt_diag.hw_fail = gt.hw_fail;
+		if (gt.bus == GT_BUS_SPI3 && gt.hw_fail >= gt.hw_fail_max) {
+			gt_fallback_bb();
+		} else if (gt.hw_fail == 1) {
+			GT_LOG("SWEET GT: frame bus error\n");
+		}
+	} else if (gt.bus == GT_BUS_SPI3) {
+		gt.hw_fail++;
+		gt_diag.hw_fail = gt.hw_fail;
+		if (gt.hw_fail >= gt.hw_fail_max) {
+			gt_fallback_bb();
+		}
+	}
+
+	if (++gt.fail_streak >= 10) {
+		uint32_t n = gt.fail_streak;
+
+		gt.fail_streak = 0;
+		GT_LOG("SWEET GT: %u frame errors; recover\n", n);
+		gt_recover();
+	}
+	return 0;
 }
 
