--- /dev/null
+++ b/bsd/dev/ruby_spi3.c
@@ -0,0 +1,443 @@
+/*
+ * Minimal polled MTK SPI3 controller for the ruby (MT6877) touch panel.
+ *
+ * The controller is used in single-shot FIFO mode only: every transfer is
+ * at most 32 bytes, which is the TX/RX FIFO depth.  The Goodix frame reader
+ * splits larger reads into random-access sub-reads, so no DMA and no
+ * pause/resume choreography is needed.
+ *
+ * Read-only preconditions (no clock or power writes):
+ *   - IFRAO2 STA bit10 must be 0 (SPI3 gate already enabled by LK).
+ *   - TOPCKGEN spi_sel pdn bit must be 0 (mux gate already enabled).
+ * Any precondition failure returns ENODEV before touching a pin or a
+ * controller register.
+ */
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <mach/mach_time.h>
+#include <machine/machine_routines.h>
+#include "ruby_spi3.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define S3_SPI_PA	0x11013000u
+#define S3_GPIO_PA	0x10005000u
+#define S3_IFRAO_PA	0x10001000u
+#define S3_TOP_PA	0x10000000u
+#define S3_MAP_SIZE	0x1000u
+
+/* GPIO bank 5: pins 160-163; mode group 20 = pins 160-167. */
+#define S3_GPIO_DIR5	0x050u
+#define S3_GPIO_DO5	0x150u
+#define S3_GPIO_MODE20	0x440u
+#define S3_SPI_FUNC	0x2222u		/* pins 160-163 = function 2 */
+
+/* MTK SPI registers (vendor spi-mt65xx.c). */
+#define S3_CFG0		0x00u
+#define S3_CFG1		0x04u
+#define S3_TX_DATA	0x10u
+#define S3_RX_DATA	0x14u
+#define S3_CMD		0x18u
+#define S3_STATUS0	0x1cu
+#define S3_STATUS1	0x20u
+#define S3_PAD_SEL	0x24u
+#define S3_CFG2		0x28u
+
+#define S3_CMD_ACT	(1u << 0)
+#define S3_CMD_RST	(1u << 2)
+#define S3_CMD_PAUSE_EN	(1u << 4)
+#define S3_CMD_TXMSBF	(1u << 12)
+#define S3_CMD_RXMSBF	(1u << 13)
+
+#define S3_ST0_FINISH	(1u << 0)
+#define S3_ST1_IDLE	(1u << 0)
+
+#define S3_IFRAO_CG2_STA	0xacu
+#define S3_SPI3_GATE_BIT	10u
+#define S3_TOP_CFG6		0x70u
+#define S3_TOP_SPI_MUX_SHIFT	8u
+#define S3_TOP_SPI_PDN_SHIFT	15u
+
+static struct {
+	vm_offset_t spi;
+	vm_offset_t gpio;
+	vm_offset_t ifrao;
+	vm_offset_t top;
+	uint32_t cfg0, cfg1, cfg2, cmd, pad;
+	uint32_t mode_orig, dir_orig, do_orig;
+	uint32_t mux, pdn, div, target_khz, sck_khz;
+	uint32_t last_st0, last_st1;
+	uint32_t xfers, errors;
+	int gate_on;
+	int saved;
+	int ready;
+} s3;
+
+static inline uint32_t
+s3_rd(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static inline void
+s3_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+}
+
+static inline void
+s3_barrier(void)
+{
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+s3_reset(void)
+{
+	if (!s3.spi) {
+		return;
+	}
+	s3_wr(s3.spi, S3_CMD, S3_CMD_RST);
+	s3_barrier();
+	s3_wr(s3.spi, S3_CMD, 0);
+	s3_barrier();
+}
+
+/* PAUSE_EN=1 is the deasserted/idle CS state in the vendor driver. */
+static void
+s3_idle(void)
+{
+	if (!s3.spi) {
+		return;
+	}
+	s3_wr(s3.spi, S3_CMD,
+	    S3_CMD_TXMSBF | S3_CMD_RXMSBF | S3_CMD_PAUSE_EN);
+	s3_barrier();
+}
+
+static void
+s3_calc_div(uint32_t target_khz)
+{
+	uint32_t parent, div;
+
+	if (target_khz == 0) {
+		target_khz = 2000;
+	}
+	/* mux 0 = 26 MHz; mux 1 = mainpll/20 (~55 MHz); others conservative. */
+	if (s3.mux == 0) {
+		parent = 26000u;
+	} else if (s3.mux == 1) {
+		parent = 55000u;
+	} else {
+		parent = 60000u;
+	}
+	div = (parent + target_khz - 1) / target_khz;
+	if (div == 0) {
+		div = 1;
+	}
+	if (div > 255) {
+		div = 255;
+	}
+	s3.target_khz = target_khz;
+	s3.div = div;
+	s3.sck_khz = parent / div;
+}
+
+static void
+s3_apply_timing(void)
+{
+	uint32_t sck, cs, v;
+
+	sck = (s3.div + 1) / 2;
+	if (sck == 0) {
+		sck = 1;
+	}
+	if (sck > 0xffffu) {
+		sck = 0xffffu;
+	}
+	cs = sck * 2;
+	if (cs > 0xffffu) {
+		cs = 0xffffu;
+	}
+
+	v = ((sck - 1) & 0xffffu) | (((sck - 1) & 0xffffu) << 16);
+	s3_wr(s3.spi, S3_CFG2, v);
+	v = ((cs - 1) & 0xffffu) | (((cs - 1) & 0xffffu) << 16);
+	s3_wr(s3.spi, S3_CFG0, v);
+	v = s3_rd(s3.spi, S3_CFG1);
+	v &= ~0xffu;
+	if (cs != 0) {
+		v |= (cs - 1) & 0xffu;
+	}
+	s3_wr(s3.spi, S3_CFG1, v);
+}
+
+static void
+s3_set_packet(uint32_t len)
+{
+	uint32_t v;
+
+	v = s3_rd(s3.spi, S3_CFG1);
+	v &= ~(0xff00u | 0x3ff0000u);
+	v |= ((len - 1) & 0x3ffu) << 16;
+	s3_wr(s3.spi, S3_CFG1, v);
+}
+
+static void
+s3_write_fifo(const uint8_t *tx, uint32_t len)
+{
+	uint32_t i = 0, j, w;
+
+	while (i + 4 <= len) {
+		w = (uint32_t)tx[i] | ((uint32_t)tx[i + 1] << 8) |
+		    ((uint32_t)tx[i + 2] << 16) | ((uint32_t)tx[i + 3] << 24);
+		s3_wr(s3.spi, S3_TX_DATA, w);
+		i += 4;
+	}
+	if (i < len) {
+		w = 0;
+		for (j = 0; i + j < len; j++) {
+			w |= (uint32_t)tx[i + j] << (8 * j);
+		}
+		s3_wr(s3.spi, S3_TX_DATA, w);
+	}
+}
+
+static void
+s3_read_fifo(uint8_t *rx, uint32_t len)
+{
+	uint32_t i = 0, j, w;
+
+	while (i + 4 <= len) {
+		w = s3_rd(s3.spi, S3_RX_DATA);
+		rx[i] = (uint8_t)w;
+		rx[i + 1] = (uint8_t)(w >> 8);
+		rx[i + 2] = (uint8_t)(w >> 16);
+		rx[i + 3] = (uint8_t)(w >> 24);
+		i += 4;
+	}
+	if (i < len) {
+		w = s3_rd(s3.spi, S3_RX_DATA);
+		for (j = 0; i + j < len; j++) {
+			rx[i + j] = (uint8_t)(w >> (8 * j));
+		}
+	}
+}
+
+int
+ruby_spi3_init(uint32_t target_khz)
+{
+	uint32_t v;
+
+	if (s3.ready) {
+		return 0;
+	}
+	if (!s3.spi) {
+		s3.spi = ml_io_map(S3_SPI_PA, S3_MAP_SIZE);
+		s3.gpio = ml_io_map(S3_GPIO_PA, S3_MAP_SIZE);
+		s3.ifrao = ml_io_map(S3_IFRAO_PA, S3_MAP_SIZE);
+		s3.top = ml_io_map(S3_TOP_PA, S3_MAP_SIZE);
+	}
+	if (!s3.spi || !s3.gpio || !s3.ifrao || !s3.top) {
+		return ENODEV;
+	}
+
+	v = s3_rd(s3.ifrao, S3_IFRAO_CG2_STA);
+	s3.gate_on = ((v & (1u << S3_SPI3_GATE_BIT)) == 0);
+	if (!s3.gate_on) {
+		return ENODEV;
+	}
+	v = s3_rd(s3.top, S3_TOP_CFG6);
+	s3.mux = (v >> S3_TOP_SPI_MUX_SHIFT) & 3u;
+	s3.pdn = (v >> S3_TOP_SPI_PDN_SHIFT) & 1u;
+	if (s3.pdn) {
+		return ENODEV;
+	}
+	s3_calc_div(target_khz);
+
+	s3.cfg0 = s3_rd(s3.spi, S3_CFG0);
+	s3.cfg1 = s3_rd(s3.spi, S3_CFG1);
+	s3.cfg2 = s3_rd(s3.spi, S3_CFG2);
+	s3.cmd = s3_rd(s3.spi, S3_CMD);
+	s3.pad = s3_rd(s3.spi, S3_PAD_SEL);
+	s3.mode_orig = s3_rd(s3.gpio, S3_GPIO_MODE20);
+	s3.dir_orig = s3_rd(s3.gpio, S3_GPIO_DIR5);
+	s3.do_orig = s3_rd(s3.gpio, S3_GPIO_DO5);
+	s3.saved = 1;
+
+	s3_reset();
+	s3_wr(s3.spi, S3_PAD_SEL, 0);
+	s3_wr(s3.spi, S3_CMD, S3_CMD_TXMSBF | S3_CMD_RXMSBF);
+	s3_apply_timing();
+	s3_idle();
+	s3_barrier();
+
+	/* Configure the controller before handing the pins to it. */
+	v = (s3.mode_orig & ~0xffffu) | S3_SPI_FUNC;
+	s3_wr(s3.gpio, S3_GPIO_MODE20, v);
+	s3_barrier();
+	if ((s3_rd(s3.gpio, S3_GPIO_MODE20) & 0xffffu) != S3_SPI_FUNC) {
+		ruby_spi3_shutdown();
+		return EIO;
+	}
+
+	s3.ready = 1;
+	return 0;
+}
+
+int
+ruby_spi3_set_speed(uint32_t target_khz)
+{
+	if (target_khz == 0) {
+		return EINVAL;
+	}
+	s3_calc_div(target_khz);
+	if (s3.ready) {
+		s3_apply_timing();
+		s3_barrier();
+	}
+	return 0;
+}
+
+int
+ruby_spi3_xfer(const uint8_t *tx, uint8_t *rx, uint32_t len)
+{
+	uint64_t deadline;
+	uint32_t cmd, st;
+
+	if (!s3.ready) {
+		return ENODEV;
+	}
+	if (!tx || len == 0 || len > RUBY_SPI3_MAX_XFER) {
+		return EINVAL;
+	}
+
+	s3.xfers++;
+	s3_reset();
+	cmd = S3_CMD_TXMSBF | S3_CMD_RXMSBF;
+	s3_wr(s3.spi, S3_CMD, cmd);
+	s3_wr(s3.spi, S3_PAD_SEL, 0);
+	s3_set_packet(len);
+	s3_write_fifo(tx, len);
+	s3_barrier();
+	s3_wr(s3.spi, S3_CMD, cmd | S3_CMD_ACT);
+
+	clock_interval_to_deadline(10, NSEC_PER_MSEC, &deadline);
+	for (;;) {
+		st = s3_rd(s3.spi, S3_STATUS0);
+		s3.last_st0 = st;
+		if (st & S3_ST0_FINISH) {
+			break;
+		}
+		if (mach_absolute_time() >= deadline) {
+			s3.errors++;
+			s3_reset();
+			s3_idle();
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+
+	s3.last_st1 = s3_rd(s3.spi, S3_STATUS1);
+	if (rx) {
+		s3_read_fifo(rx, len);
+	}
+	s3_idle();
+	return 0;
+}
+
+void
+ruby_spi3_cs_high(void)
+{
+	if (!s3.ready) {
+		return;
+	}
+	s3_reset();
+	s3_idle();
+}
+
+void
+ruby_spi3_shutdown(void)
+{
+	s3.ready = 0;
+	if (!s3.saved) {
+		return;
+	}
+	if (s3.spi) {
+		s3_idle();
+	}
+	if (s3.gpio) {
+		s3_wr(s3.gpio, S3_GPIO_MODE20, s3.mode_orig);
+		s3_wr(s3.gpio, S3_GPIO_DIR5, s3.dir_orig);
+		s3_wr(s3.gpio, S3_GPIO_DO5, s3.do_orig);
+		s3_barrier();
+	}
+	if (s3.spi) {
+		s3_reset();
+		s3_wr(s3.spi, S3_CFG0, s3.cfg0);
+		s3_wr(s3.spi, S3_CFG1, s3.cfg1);
+		s3_wr(s3.spi, S3_CFG2, s3.cfg2);
+		s3_wr(s3.spi, S3_CMD, s3.cmd);
+		s3_wr(s3.spi, S3_PAD_SEL, s3.pad);
+		s3_barrier();
+	}
+	s3.saved = 0;
+}
+
+int
+ruby_spi3_ready(void)
+{
+	return s3.ready;
+}
+
+int
+ruby_spi3_gate_on(void)
+{
+	return s3.gate_on;
+}
+
+uint32_t
+ruby_spi3_mux(void)
+{
+	return s3.mux;
+}
+
+uint32_t
+ruby_spi3_div(void)
+{
+	return s3.div;
+}
+
+uint32_t
+ruby_spi3_sck_khz(void)
+{
+	return s3.sck_khz;
+}
+
+uint32_t
+ruby_spi3_last_status0(void)
+{
+	return s3.last_st0;
+}
+
+uint32_t
+ruby_spi3_last_status1(void)
+{
+	return s3.last_st1;
+}
+
+uint32_t
+ruby_spi3_xfers(void)
+{
+	return s3.xfers;
+}
+
+uint32_t
+ruby_spi3_errors(void)
+{
+	return s3.errors;
+}
