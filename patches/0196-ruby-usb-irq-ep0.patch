+#include <pexpert/arm64/board_config.h>
+#if defined(SWEET)
+/*
+ * SWEET: MTU3 USB device MAC (INTID160, SPI128 level-high) on RubyGIC.
+ *
+ * The level IOInterruptEventSource hard-masks INTID160 through the
+ * controller in the occurrence path and schedules this dedicated workloop;
+ * the action runs the C service pass (MAC2 first, then BMU/EP0, vendor
+ * order) and the class re-enables the line afterwards.  Primary never
+ * touches MTU3 MMIO and never clears device state -- all sub-status is
+ * consumed by the action per the register semantics.
+ *
+ * The 100 us timer requeue advances deferred EP0 work (DATAEND written on
+ * a later pass, reset two-beat) the way the old 1 ms polling tick did, and
+ * runs the EP0-owning reattach sequence on the same single-owner loop.
+ * Deferred-work requeues are bounded: past the cap the service waits for
+ * the next real interrupt instead of spinning.
+ */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOInterruptEventSource.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOTimerEventSource.h>
+#include <IOKit/IOWorkLoop.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSSymbol.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+
+#include "../../../bsd/dev/ruby_gic.h"
+#include "RubyUSBIntService.h"
+
+#define super IOService
+OSDefineMetaClassAndStructors(RubyUSBIntService, IOService);
+
+#define RUBY_USB_INTID          160u
+#define RUBY_USB_REQUEUE_US     100u
+#define RUBY_USB_REQUEUE_CAP    20000u
+
+static RubyUSBIntService *gRubyUSBIntService;
+
+extern "C" {
+int ruby_usb_irq_pass(void);        /* 1 = deferred EP0 work remains */
+void ruby_usb_irq_service_work(void);
+}
+
+bool
+RubyUSBIntService::init(OSDictionary *dictionary)
+{
+	fWorkLoop = NULL;
+	fIRQ = NULL;
+	fTimer = NULL;
+	fActive = false;
+	fRequeues = 0;
+	return super::init(dictionary);
+}
+
+bool
+RubyUSBIntService::publishInterruptSource(void)
+{
+	OSArray *controllers = NULL;
+	OSArray *specifiers = NULL;
+	OSSymbol *name = NULL;
+	OSData *data = NULL;
+	struct ruby_gic_spec spec = {
+		.intid = RUBY_USB_INTID,
+		.flags = RUBY_GIC_LEVEL,
+	};
+	bool ok = false;
+
+	controllers = OSArray::withCapacity(1);
+	specifiers = OSArray::withCapacity(1);
+	name = (OSSymbol *)OSSymbol::withCStringNoCopy("RubyGIC");
+	data = OSData::withBytes(&spec, sizeof(spec));
+	if (!controllers || !specifiers || !name || !data) {
+		goto out;
+	}
+	if (!controllers->setObject(name) || !specifiers->setObject(data)) {
+		goto out;
+	}
+	ok = setProperty("IOInterruptControllers", controllers) &&
+	    setProperty("IOInterruptSpecifiers", specifiers);
+out:
+	OSSafeRelease(controllers);
+	OSSafeRelease(specifiers);
+	OSSafeRelease(name);
+	OSSafeRelease(data);
+	return ok;
+}
+
+bool
+RubyUSBIntService::start(IOService *provider)
+{
+	int usbirq = 0;
+
+	if (!super::start(provider)) {
+		return false;
+	}
+	(void)PE_parse_boot_argn("rubyusbirq", &usbirq, sizeof(usbirq));
+	if (usbirq != 1) {
+		return false;
+	}
+	fWorkLoop = getWorkLoop();
+	if (!fWorkLoop) {
+		return false;
+	}
+	fWorkLoop->retain();
+	fTimer = IOTimerEventSource::timerEventSource(this,
+	    &RubyUSBIntService::timerAction);
+	if (!fTimer ||
+	    fWorkLoop->addEventSource(fTimer) != kIOReturnSuccess) {
+		return false;
+	}
+	if (!publishInterruptSource()) {
+		return false;
+	}
+	gRubyUSBIntService = this;
+	IOLog("RUBY USB INT: service ready (INTID160, activation pending)\n");
+	return true;
+}
+
+void
+RubyUSBIntService::free(void)
+{
+	if (gRubyUSBIntService == this) {
+		gRubyUSBIntService = NULL;
+	}
+	if (fIRQ) {
+		fIRQ->disable();
+		if (fWorkLoop) {
+			fWorkLoop->removeEventSource(fIRQ);
+		}
+		OSSafeRelease(fIRQ);
+		fIRQ = NULL;
+	}
+	if (fTimer) {
+		fTimer->cancelTimeout();
+		if (fWorkLoop) {
+			fWorkLoop->removeEventSource(fTimer);
+		}
+		OSSafeRelease(fTimer);
+		fTimer = NULL;
+	}
+	if (fWorkLoop) {
+		fWorkLoop->release();
+		fWorkLoop = NULL;
+	}
+	super::free();
+}
+
