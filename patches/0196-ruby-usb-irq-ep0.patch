+	}
+	fIRQ = IOInterruptEventSource::interruptEventSource(this,
+	    &RubyUSBIntService::irqAction, this, 0);
+	if (!fIRQ ||
+	    fWorkLoop->addEventSource(fIRQ) != kIOReturnSuccess) {
+		return false;
+	}
+	/* Starts masked; ruby_usb activates it after the MTU3 enables. */
+	fIRQ->disable();
+	return true;
+}
+
+int
+RubyUSBIntService::prepare(void)
+{
+	if (!fWorkLoop || !createIrqSource()) {
+		return ENODEV;
+	}
+	return 0;
+}
+
+int
+RubyUSBIntService::activate(void)
+{
+	if (!fIRQ) {
+		return ENODEV;
+	}
+	fIRQ->enable();
+	fActive = true;
+	IOLog("RUBY USB INT: INTID160 unmasked\n");
+	return 0;
+}
+
+int
+RubyUSBIntService::kick(void)
+{
+	if (!fTimer) {
+		return ENODEV;
+	}
+	fTimer->setTimeoutUS(1);
+	return 0;
+}
+
+void
+RubyUSBIntService::serviceWork(void)
+{
+	int more;
+
+	/*
+	 * Reattach requests come from the probe/boot window and the 1 ms
+	 * thread (single requester at a time); run the EP0-owning sequence
+	 * here so only the workloop ever touches EP0 ownership state.
+	 */
+	ruby_usb_irq_service_work();
+	more = ruby_usb_irq_pass();
+	if (more) {
+		if (++fRequeues <= RUBY_USB_REQUEUE_CAP) {
+			fTimer->setTimeoutUS(RUBY_USB_REQUEUE_US);
+		}
+		/* Past the cap: wait for the next real interrupt. */
+	} else {
+		fRequeues = 0;
+	}
+}
+
+void
+RubyUSBIntService::irqAction(OSObject *owner,
+    IOInterruptEventSource *sender, int count)
+{
+	RubyUSBIntService *self = (RubyUSBIntService *)owner;
+
+	(void)sender;
+	(void)count;
+	if (!self->fActive) {
+		return;
+	}
+	self->fRequeues = 0;
+	self->serviceWork();
+}
+
+void
+RubyUSBIntService::timerAction(OSObject *owner, IOTimerEventSource *sender)
+{
+	RubyUSBIntService *self = (RubyUSBIntService *)owner;
+
+	(void)sender;
+	if (!self->fActive) {
+		return;
+	}
+	self->serviceWork();
+}
+
+extern "C" int
+ruby_usb_irq_prepare(void)
+{
+	return gRubyUSBIntService ? gRubyUSBIntService->prepare() : ENODEV;
+}
+
+extern "C" int
+ruby_usb_irq_activate(void)
+{
+	return gRubyUSBIntService ? gRubyUSBIntService->activate() : ENODEV;
+}
+
+extern "C" int
+ruby_usb_irq_kick(void)
+{
+	return gRubyUSBIntService ? gRubyUSBIntService->kick() : ENODEV;
+}
