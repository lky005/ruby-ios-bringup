+#ifndef _IOKIT_RUBY_USB_INT_SERVICE_H
+#define _IOKIT_RUBY_USB_INT_SERVICE_H
+
+#include <IOKit/IOService.h>
+#include <mach/vm_types.h>
+#include <stdint.h>
+
+class OSDictionary;
+class IOWorkLoop;
+class IOInterruptEventSource;
+class IOTimerEventSource;
+
+/*
+ * SWEET: MTU3 USB device MAC (INTID160) as a RubyGIC vector.
+ *
+ * The level interrupt event source hard-masks the GIC line in the
+ * occurrence path and signals this dedicated workloop; the action consumes
+ * the MAC level-1 groups (BMU/EP0 + MAC2/reset) through the C service pass
+ * and the class re-enables the line afterwards.  A 100 us timer requeue
+ * advances deferred EP0 work (DATAEND next pass, reset second beat) and
+ * runs the EP0-owning reattach sequence on the same single-owner loop.
+ */
+class RubyUSBIntService : public IOService
+{
+	OSDeclareDefaultStructors(RubyUSBIntService);
+
+public:
+	bool init(OSDictionary *dictionary = NULL) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void free() APPLE_KEXT_OVERRIDE;
+
+	int prepare(void);
+	int activate(void);
+	int kick(void);
+
+private:
+	IOWorkLoop *fWorkLoop;
+	IOInterruptEventSource *fIRQ;
+	IOTimerEventSource *fTimer;
+	bool fActive;
+	uint32_t fRequeues;
+
+	bool publishInterruptSource(void);
+	bool createIrqSource(void);
+	void serviceWork(void);
+	static void irqAction(OSObject *owner,
+	    IOInterruptEventSource *sender, int count);
+	static void timerAction(OSObject *owner, IOTimerEventSource *sender);
+};
+
+#endif /* _IOKIT_RUBY_USB_INT_SERVICE_H */
