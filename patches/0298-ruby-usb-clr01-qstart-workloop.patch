+static void
+ruby_txpio_qstart_tick(vm_offset_t mac)
+{
+    if (!ruby_txpio_qstart_pending)
+        return;
+    if ((int32_t)(ruby_ms - ruby_txpio_qstart_due_ms) < 0)
+        return;
+    /*
+     * 0298: the deferred starter must share the producer's owner.  In IRQ
+     * mode the PIO send runs on the QMU workloop, so only queue a request
+     * here; the 1 ms EP0 thread must not touch TQCSR1 concurrently (the
+     * 0297 service did and produced the pseudo-active 0x18100 readback).
+     */
+    if (ruby_qmu_irq_mode) {
+        ruby_txpio_qstart_req = 1;
+        ruby_usb_irq_kick();
+    } else {
+        ruby_txpio_qstart_service(mac);
+    }
+}
