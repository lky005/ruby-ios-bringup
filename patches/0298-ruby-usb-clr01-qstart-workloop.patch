+static void
+ruby_ep2_rx_halt_clear_light(vm_offset_t mac)
+{
+    uint32_t rx0 = ruby_rd32(mac, RX1CSR0_OFF);
+
+    /*
+     * 0298: CLEAR_FEATURE(ENDPOINT_HALT) on the bulk OUT (0x01).  Vendor
+     * parity: W1C SENTSTALL, clear SENDSTALL, pulse EP_RST(RX1) so the
+     * data toggle re-syncs.  The ring and FIFO are left untouched.
+     */
+    ruby_wr32(mac, RX1CSR0_OFF,
+        (rx0 & ~(RX_SENDSTALL_BIT | RX_SENTSTALL_BIT)) | RX_SENTSTALL_BIT);
+    ruby_wr32(mac, EP_RST_OFF, EP_RST_RX1_BIT);
+    ruby_wr32(mac, EP_RST_OFF, 0);
+    (void)ruby_rd32(mac, EP_RST_OFF);
+    ruby_clr01_hits++;
+    if (ruby_clr01_hits <= 8 || (ruby_clr01_hits & 0xffu) == 0)
+        printf("RUBY USB: 0298 clr01 n=%u reqs=%u rx0=%08x rx0_now=%08x "
+            "rqcsr=%08x\n", ruby_clr01_hits, ruby_clr01_reqs, rx0,
+            ruby_rd32(mac, RX1CSR0_OFF), ruby_rd32(mac, RQCSR1_OFF));
+}
