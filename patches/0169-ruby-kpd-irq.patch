 static vm_offset_t rk_kpd, rk_pwrap;
+static vm_offset_t rk_gicd;
 static bool rk_started;
+static bool rk_kpd_irq_ready;
+static volatile int rk_kpd_irq_masked;
+static unsigned rk_kpd_irq_hits;
 static int rk_sleep_chan;
 static unsigned rk_errors;
 
+static inline uint32_t
+rk_gic_rd32(uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(rk_gicd + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+rk_gic_wr32(uint32_t off, uint32_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(rk_gicd + off) = v;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static inline void
+rk_gic_wr64(uint32_t off, uint64_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint64_t *)(rk_gicd + off) = v;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static int
+rk_gic_rwp(void)
+{
+	uint32_t i;
+
+	for (i = 0; i < 1000; i++) {
+		if ((rk_gic_rd32(RK_GICD_CTLR) & RK_GICD_CTLR_RWP) == 0)
+			return 0;
+		delay(1);
+	}
+	return 1;
+}
+
+static uint64_t
+rk_gic_route(uint64_t mpidr)
+{
+	uint64_t aff0 = mpidr & 0xffu;
+	uint64_t aff1 = (mpidr >> 8) & 0xffu;
+	uint64_t aff2 = (mpidr >> 16) & 0xffu;
+	uint64_t aff3 = (mpidr >> 32) & 0xffu;
+
+	return (aff3 << 32) | (aff2 << 24) | (aff1 << 16) | aff0;
+}
+
+static long
+rk_smc_gic_dump(uint32_t intid, uint64_t *raw)
+{
+	register uint64_t x0 __asm__("x0") = RK_SMC_GIC_DUMP;
+	register uint64_t x1 __asm__("x1") = intid;
+
+	__asm__ volatile(
+	    "mov x2, xzr\n\t"
+	    "mov x3, xzr\n\t"
+	    "mov x4, xzr\n\t"
+	    "mov x5, xzr\n\t"
+	    "mov x6, xzr\n\t"
+	    "mov x7, xzr\n\t"
+	    "smc #0\n\t"
+	    : "+r"(x0), "+r"(x1)
+	    :
+	    : "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10",
+	      "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	*raw = x0;
+	return (long)x0;
+}
+
+static void
+rk_kpd_irq_mask(void)
+{
+	rk_gic_wr32(RK_GICD_ICENABLER4, 1u << RK_GIC_BIT);
+}
+
+static void
+rk_kpd_irq_unmask(void)
+{
+	rk_gic_wr32(RK_GICD_ISENABLER4, 1u << RK_GIC_BIT);
+	(void)rk_gic_rwp();
+}
+
+static void
+rk_kpd_isr(void *target, void *refCon, void *nub, int source)
+{
+	(void)target;
+	(void)refCon;
+	(void)nub;
+
+	if (source != (int)RK_KPD_IRQ_INTID)
+		return;
+	/* Mirror the vendor handler: gate the line until the thread samples. */
+	rk_kpd_irq_mask();
+	__atomic_add_fetch(&rk_kpd_irq_hits, 1, __ATOMIC_RELAXED);
+	__atomic_store_n(&rk_kpd_irq_masked, 1, __ATOMIC_RELEASE);
+	wakeup(&rk_sleep_chan);
+}
+
+static void
+rk_kpd_irq_init(void)
+{
+	uint64_t smc = 0, mpidr, route;
+	uint32_t ctlr, prio, cfg;
+	long smc_rc;
+
+	if (!rk_kpd)
+		return;
+	rk_gicd = ml_io_map(RK_GICD_PA, RK_GICD_SIZE);
+	if (!rk_gicd) {
+		printf("RUBY KEYS: kpd irq no gicd\n");
+		return;
+	}
+	smc_rc = rk_smc_gic_dump(RK_KPD_IRQ_INTID, &smc);
+	if (smc_rc < 0 || ((smc >> 1) & 1u) != 1u) {
+		printf("RUBY KEYS: kpd irq group not NS (rc=%ld smc=%llx)\n",
+		    smc_rc, (unsigned long long)smc);
+		return;
+	}
+	ctlr = rk_gic_rd32(RK_GICD_CTLR);
+	if ((ctlr & (RK_GICD_CTLR_ARE_NS | RK_GICD_CTLR_GRP1NS)) !=
+	    (RK_GICD_CTLR_ARE_NS | RK_GICD_CTLR_GRP1NS)) {
+		printf("RUBY KEYS: kpd irq gic ctlr=%08x\n", ctlr);
+		return;
+	}
+
+	/* Drop a stale edge left by the bootloader or a previous boot. */
+	rk_gic_wr32(RK_GICD_ICPENDR4, 1u << RK_GIC_BIT);
+	rk_gic_wr32(RK_GICD_ICENABLER4, 1u << RK_GIC_BIT);
+	(void)rk_gic_rwp();
+	prio = rk_gic_rd32(RK_GICD_IPRIORITY_138);
+	cfg = rk_gic_rd32(RK_GICD_ICFGR_138);
+
+	disable_preemption();
+	ml_install_interrupt_handler(NULL, RK_KPD_IRQ_INTID, NULL,
+	    rk_kpd_isr, NULL);
+	mpidr = __builtin_arm_rsr64("MPIDR_EL1");
+	enable_preemption();
+	route = rk_gic_route(mpidr);
+
+	rk_gic_wr32(RK_GICD_IPRIORITY_138,
+	    (prio & ~(0xffu << RK_GIC_PRIO_SHIFT)) |
+	    (RK_GIC_PRIO << RK_GIC_PRIO_SHIFT));
+	rk_gic_wr32(RK_GICD_ICFGR_138,
+	    (cfg & ~(3u << RK_GIC_CFG_SHIFT)) |
+	    (2u << RK_GIC_CFG_SHIFT));
+	rk_gic_wr64(RK_GICD_IROUTER_138, route);
+	rk_kpd_irq_unmask();
+	if (rk_gic_rwp() != 0 ||
+	    (rk_gic_rd32(RK_GICD_ISENABLER4) & (1u << RK_GIC_BIT)) == 0) {
+		rk_kpd_irq_mask();
+		printf("RUBY KEYS: kpd irq enable failed\n");
+		return;
+	}
+	__atomic_store_n(&rk_kpd_irq_masked, 0, __ATOMIC_RELEASE);
+	rk_kpd_irq_ready = true;
+	printf("RUBY KEYS: kpd irq intid=%u route=%016llx\n",
+	    RK_KPD_IRQ_INTID, (unsigned long long)route);
+}
