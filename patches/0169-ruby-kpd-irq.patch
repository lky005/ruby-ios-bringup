+#define RK_GICD_PA       0x0c000000u
+#define RK_GICD_SIZE     0x10000u
+#define RK_GICD_CTLR     0x0000u
+#define RK_GICD_ISENABLER4 0x0110u
+#define RK_GICD_ICENABLER4 0x0190u
+#define RK_GICD_ICPENDR4 0x0290u
+#define RK_GICD_IPRIORITY_138 0x0488u
+#define RK_GICD_ICFGR_138 0x0c20u
+#define RK_GICD_IROUTER_138 0x6450u
+#define RK_GICD_CTLR_RWP 0x80000000u
+#define RK_GICD_CTLR_ARE_NS 0x10u
+#define RK_GICD_CTLR_GRP1NS 0x2u
+#define RK_GIC_BIT       10u
+#define RK_GIC_PRIO      0xb0u
+#define RK_GIC_PRIO_SHIFT 16u
+#define RK_GIC_CFG_SHIFT 20u
+#define RK_SMC_GIC_DUMP  0xc2000201u
