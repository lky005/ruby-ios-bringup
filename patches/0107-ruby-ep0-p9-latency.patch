-            ruby_rd32(mac, EP0CSR_OFF), waited);
-
     csr = ruby_rd32(mac, EP0CSR_OFF) & EP0_W1C_BITS;
     csr |= EP0_SETUPPKTRDY | EP0_DATAEND;
     ruby_wr32(mac, EP0CSR_OFF, csr);
-    ruby_trace(t, RUBY_TR_ACK, key, csr, wlen, waited);
