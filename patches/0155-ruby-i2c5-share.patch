 ruby_battery_init(void)
 {
+	if (rb_ready)
+		return 0;
 	if (rb_init_attempted)
-		return rb_ready ? 0 : -1;
+		return -1;
 	rb_init_attempted = true;
-	rb_lock = IOLockAlloc();
-	if (!rb_lock) {
+	if (ruby_i2c5_lock_init() != 0) {
 		printf("RUBY BATTERY: no IOLock\n");
 		return -1;
 	}
+	if (ruby_i2c5_acquire() != 0) {
+		/* Probe holds I2C5; retry on the next poll. */
+		rb_init_attempted = false;
+		return -1;
+	}
 	rb_gpio = ml_io_map(RB_GPIO_PA, RB_REG_SIZE);
 	rb_cfg = ml_io_map(RB_IOCFG_PA, RB_REG_SIZE);
 	if (!rb_gpio || !rb_cfg) {
 		printf("RUBY BATTERY: I2C5 mapping failed\n");
+		ruby_i2c5_release();
 		return -1;
 	}
 	rb_bus_init();
+	ruby_i2c5_release();
 	rb_ready = true;
 	printf("RUBY BATTERY: MT6360 I2C5 read-only ready\n");
 	return 0;
@@ -460,7 +492,7 @@ void
 ruby_battery_lock(void)
 {
 	/* IOLock: sleeping mutex, never called from interrupt context. */
-	if (rb_lock)
+	if (ruby_i2c5_lock_init() == 0)
 		IOLockLock(rb_lock);
