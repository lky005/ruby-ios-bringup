@@ -477,6 +509,26 @@ ruby_battery_taken(int taken)
 	rb_probe_taken = taken != 0;
 }
 
+int
+ruby_i2c5_acquire(void)
+{
+	if (ruby_i2c5_lock_init() != 0)
+		return -1;
+	IOLockLock(rb_lock);
+	if (rb_probe_taken) {
+		IOLockUnlock(rb_lock);
+		return -1;
+	}
+	return 0;
+}
