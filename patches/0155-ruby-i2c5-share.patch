  * The I2C5 lock is an IOLock (a sleeping mutex, not an interrupt-disabled
  * spinlock).  ruby_probe takes it around its I2C5 take/release, so the
  * probe and the 30 s battery poll cannot interleave on the bus.  The
- * probe's manual "i2c 5 take" sets ruby_battery_taken(1); a poll during
- * that hold fails and SweetBattery keeps its last valid sample.
+ * Goodix touch driver also holds it across its whole boot-time LDO
+ * sequence.  The probe's manual "i2c 5 take" sets ruby_battery_taken(1);
+ * a poll during that hold fails and SweetBattery keeps its last valid
+ * sample.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
@@ -59,6 +61,7 @@ struct rb_i2c_bus {
 static vm_offset_t rb_gpio, rb_cfg;
 static struct rb_i2c_bus rb_bus;
 static IOLock *rb_lock;
+static volatile int rb_lock_state; /* 0 uninit, 1 allocating, 2 ready, 3 failed */
 static bool rb_ready, rb_init_attempted, rb_probe_taken;
 static uint32_t rb_budget;
 
@@ -433,24 +436,53 @@ rb_bus_init(void)
 	b->drv_sda_shift = 3;
 }
 
+int
+ruby_i2c5_lock_init(void)
+{
+	int expected = 0;
+
+	if (__atomic_load_n(&rb_lock_state, __ATOMIC_ACQUIRE) == 2)
+		return 0;
+	if (__atomic_load_n(&rb_lock_state, __ATOMIC_ACQUIRE) == 3)
+		return -1;
+	if (!__atomic_compare_exchange_n(&rb_lock_state, &expected, 1, false,
+	    __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+		while (__atomic_load_n(&rb_lock_state, __ATOMIC_ACQUIRE) == 1)
+			delay(100);
+		return __atomic_load_n(&rb_lock_state, __ATOMIC_ACQUIRE) == 2 ?
+		    0 : -1;
+	}
+	rb_lock = IOLockAlloc();
+	__atomic_store_n(&rb_lock_state, rb_lock ? 2 : 3, __ATOMIC_RELEASE);
+	return rb_lock ? 0 : -1;
+}
+
