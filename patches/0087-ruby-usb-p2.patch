--- a/bsd/dev/ruby_usb.c
+++ b/bsd/dev/ruby_usb.c
@@ -1,10 +1,10 @@
 /*
- * Ruby (MT6877) USB P0.
+ * Ruby (MT6877) USB P2b.
  *
  * IP power/reset + U2/U3 PHY + IDDIG/D+ pull-up + PS5169 + device
- * soft-connect.  This is intentionally not a USB stack: no EP0, no IRQ,
- * no DMA.  It leaves the controller soft-connected so the host can see the
- * port attach; descriptor requests will fail until a gadget layer exists.
+ * soft-connect, followed by a polling EP0 enumeration path with minimal
+ * device/config/string descriptors.  No IRQ, no DMA, no non-control
+ * endpoints; it is a bring-up step, not a USB function driver.
  *
  * Boot arg: rubyusb=1 enables.  Default 0 keeps topaz/sweet builds safe;
  * the Qualcomm DWC3/ECM driver in sweet_usb.c is not used by ruby.
@@ -114,6 +114,75 @@
 #define GPIO_DO3        0x0130
 #define GPIO121_BIT     (1u << 25)
 
+/* EP0 registers (MTU3 MAC offsets) */
+#define EP0CSR_OFF      0x0100
+#define RXCOUNT0_OFF    0x0108
+#define FIFO0_OFF       0x0300
+
+#define EP0_SENDSTALL   (1u << 25)
+#define EP0_SENTSTALL   (1u << 22)
+#define EP0_DPHTX       (1u << 20)
+#define EP0_DATAEND     (1u << 19)
+#define EP0_TXPKTRDY    (1u << 18)
+#define EP0_SETUPPKTRDY (1u << 17)
+#define EP0_RXPKTRDY    (1u << 16)
+#define EP0_MAXPKTSZ_MSK 0x3ffu
+#define EP0_W1C_BITS    (~(EP0_RXPKTRDY | EP0_SETUPPKTRDY | EP0_SENTSTALL))
+
+/* P2a trace ring: snapshots and EP0 setup attempts, dumped once. */
+#define RUBY_TRACE_MAX  512
+#define RUBY_TR_SNAP    1
+#define RUBY_TR_SETUP   2
+#define RUBY_TR_STALL   3
+#define RUBY_TR_STATE   4
+#define RUBY_TR_NOTE    5
+#define RUBY_TR_RAW     6
+#define RUBY_TR_ACK     7
+#define RUBY_TR_SEND    8
+#define RUBY_TR_ADDR    9
+#define RUBY_TR_CFG     10
+#define RUBY_TR_TX      11
+#define RUBY_TR_STATUS  12
+
+struct ruby_evt {
+    uint32_t t;
+    uint16_t type;
+    uint16_t a;
+    uint32_t b;
+    uint32_t c;
+    uint32_t d;
+};
+
+static struct ruby_evt ruby_events[RUBY_TRACE_MAX];
+static uint32_t ruby_event_count;
+static uint32_t ruby_event_overflow;
+
+/* Minimal USB2 device: no interfaces other than the default one. */
+static const uint8_t ruby_dev_desc[18] = {
+    18, 1, 0x00, 0x02, 0x00, 0x00, 0x00, 64,
+    0x09, 0x12, 0x01, 0x00, 0x00, 0x01,
+    1, 2, 3, 1
+};
+
+static const uint8_t ruby_cfg_desc[18] = {
+    9, 2, 18, 0, 1, 1, 0, 0x80, 50,
+    9, 4, 0, 0, 0, 0, 0, 0, 0
+};
+
+static const uint8_t ruby_str_lang[4] = { 4, 3, 0x09, 0x04 };
+static const uint8_t ruby_str_mfg[10] = {
+    10, 3, 'r', 0, 'u', 0, 'b', 0, 'y', 0
+};
+static const uint8_t ruby_str_prod[24] = {
+    24, 3, 'r', 0, 'u', 0, 'b', 0, 'y', 0, ' ', 0,
+    'U', 0, 'S', 0, 'B', 0, ' ', 0, 'P', 0, '2', 0
+};
+static const uint8_t ruby_str_ser[10] = {
+    10, 3, '0', 0, '0', 0, '0', 0, '1', 0
+};
+
+static uint8_t ruby_config;
+
 static inline uint32_t
 ruby_rd32(vm_offset_t base, uint32_t off)
 {
@@ -122,10 +191,23 @@
     return v;
 }
 
+static inline uint8_t
+ruby_rd8(vm_offset_t base, uint32_t off)
+{
+    return *(volatile uint8_t *)(base + off);
+}
+
 static inline void
 ruby_wr32(vm_offset_t base, uint32_t off, uint32_t v)
 {
     *(volatile uint32_t *)(base + off) = v;
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+
+static inline void
+ruby_wr16(vm_offset_t base, uint32_t off, uint16_t v)
+{
+    *(volatile uint16_t *)(base + off) = v;
     __asm__ volatile("dsb sy" ::: "memory");
 }
 
@@ -250,6 +332,372 @@
     ruby_wr32(phy, PHY_U2_DTM1, v);
 }
 
+static void
+ruby_trace(uint32_t t, uint16_t type, uint16_t a, uint32_t b, uint32_t c,
+    uint32_t d)
+{
+    if (ruby_event_count < RUBY_TRACE_MAX) {
+        struct ruby_evt *e = &ruby_events[ruby_event_count++];
+
+        e->t = t;
+        e->type = type;
+        e->a = a;
+        e->b = b;
+        e->c = c;
+        e->d = d;
+    } else {
+        ruby_event_overflow++;
+    }
+}
+
+static void
+ruby_snapshot(vm_offset_t mac, vm_offset_t ippc, vm_offset_t gpio, uint32_t t)
+{
+    ruby_trace(t, RUBY_TR_SNAP, 1, ruby_rd32(ippc, 0x18), 0, 0);
+    ruby_trace(t, RUBY_TR_SNAP, 2, ruby_rd32(mac, PM_CTRL - MTU3_PA), 0, 0);
+    ruby_trace(t, RUBY_TR_SNAP, 3, ruby_rd32(mac, MISC_CTRL - MTU3_PA), 0, 0);
+    ruby_trace(t, RUBY_TR_SNAP, 4, ruby_rd32(mac, USB20_OP - MTU3_PA), 0, 0);
+    ruby_trace(t, RUBY_TR_SNAP, 5, ruby_rd32(mac, DEVICE_CONF - MTU3_PA), 0, 0);
+    ruby_trace(t, RUBY_TR_SNAP, 6, ruby_rd32(mac, EP0CSR_OFF), 0, 0);
+    ruby_trace(t, RUBY_TR_SNAP, 7, ruby_rd32(mac, RXCOUNT0_OFF), 0, 0);
+    ruby_trace(t, RUBY_TR_SNAP, 8, ruby_rd32(gpio, GPIO_DIR3), 0, 0);
+    ruby_trace(t, RUBY_TR_SNAP, 9, ruby_rd32(gpio, GPIO_DO3), 0, 0);
+}
+
+static void
+ruby_ep0_set_maxpacket(vm_offset_t mac)
+{
+    uint32_t v = ruby_rd32(mac, EP0CSR_OFF);
+
+    v &= ~EP0_MAXPKTSZ_MSK;
+    v |= 64;
+    v &= EP0_W1C_BITS;
+    ruby_wr32(mac, EP0CSR_OFF, v);
+}
+
+static void
+ruby_ep0_write_fifo(vm_offset_t mac, const uint8_t *src, uint32_t len)
+{
+    uint32_t i = 0;
+
+    while (i + 4 <= len) {
+        uint32_t w = (uint32_t)src[i] |
+            ((uint32_t)src[i + 1] << 8) |
+            ((uint32_t)src[i + 2] << 16) |
+            ((uint32_t)src[i + 3] << 24);
+        ruby_wr32(mac, FIFO0_OFF, w);
+        i += 4;
+    }
+    if (i + 2 <= len) {
+        uint16_t w = (uint16_t)src[i] | ((uint16_t)src[i + 1] << 8);
+
+        ruby_wr16(mac, FIFO0_OFF, w);
+        i += 2;
+    }
+    if (i < len)
+        *(volatile uint8_t *)(mac + FIFO0_OFF) = src[i];
+}
+
+static void
+ruby_ep0_ack(vm_offset_t mac, uint32_t t, uint16_t key, uint32_t wlen)
+{
+    uint32_t csr = ruby_rd32(mac, EP0CSR_OFF) & EP0_W1C_BITS;
+
+    csr |= EP0_SETUPPKTRDY | EP0_DATAEND;
+    ruby_wr32(mac, EP0CSR_OFF, csr);
+    ruby_trace(t, RUBY_TR_ACK, key, csr, wlen, 0);
+}
+
+static void
+ruby_ep0_stall(vm_offset_t mac, uint32_t t, uint16_t key, uint32_t wlen)
+{
+    uint32_t csr = ruby_rd32(mac, EP0CSR_OFF) & EP0_W1C_BITS;
+
+    csr |= EP0_SENDSTALL;
+    if (wlen == 0)
+        csr |= EP0_SETUPPKTRDY;
+    ruby_wr32(mac, EP0CSR_OFF, csr);
+    ruby_trace(t, RUBY_TR_STALL, key, csr, wlen, 0);
+}
+
+static void
+ruby_ep0_send(vm_offset_t mac, uint32_t t, uint16_t key, const uint8_t *data,
+    uint32_t len, uint32_t wlen)
+{
+    uint32_t total = len < wlen ? len : wlen;
+    uint32_t sent = 0;
+    uint32_t csr;
+    uint32_t spin = 0;
+
+    if (wlen == 0) {
+        ruby_ep0_ack(mac, t, key, wlen);
+        return;
+    }
+
+    csr = ruby_rd32(mac, EP0CSR_OFF) & EP0_W1C_BITS;
+    csr |= EP0_SETUPPKTRDY | EP0_DPHTX;
+    ruby_wr32(mac, EP0CSR_OFF, csr);
+
+    while (sent < total) {
+        uint32_t n = total - sent;
+
+        if (n > 64)
+            n = 64;
+        ruby_ep0_write_fifo(mac, data + sent, n);
+        csr = ruby_rd32(mac, EP0CSR_OFF) & EP0_W1C_BITS;
+        ruby_wr32(mac, EP0CSR_OFF, csr | EP0_TXPKTRDY);
+        for (spin = 0; spin < 1000; spin++) {
+            if (!(ruby_rd32(mac, EP0CSR_OFF) & EP0_TXPKTRDY))
+                break;
+            delay(10);
+        }
+        sent += n;
+    }
+
+    csr = ruby_rd32(mac, EP0CSR_OFF) & EP0_W1C_BITS;
+    ruby_wr32(mac, EP0CSR_OFF, csr | EP0_DATAEND);
+    ruby_trace(t, RUBY_TR_SEND, key, total, wlen, sent);
+    ruby_trace(t, RUBY_TR_TX, key, csr,
+        spin >= 1000 ? 1 : 0, ruby_rd32(mac, EP0CSR_OFF));
+}
+
+static const uint8_t *
+ruby_descriptor(uint32_t value, uint32_t *len)
+{
+    switch (value) {
+    case 0x0100:
+        *len = sizeof(ruby_dev_desc);
+        return ruby_dev_desc;
+    case 0x0200:
+        *len = sizeof(ruby_cfg_desc);
+        return ruby_cfg_desc;
+    case 0x0300:
+        *len = sizeof(ruby_str_lang);
+        return ruby_str_lang;
+    case 0x0301:
+        *len = sizeof(ruby_str_mfg);
+        return ruby_str_mfg;
+    case 0x0302:
+        *len = sizeof(ruby_str_prod);
+        return ruby_str_prod;
+    case 0x0303:
+        *len = sizeof(ruby_str_ser);
+        return ruby_str_ser;
+    default:
+        return NULL;
+    }
+}
+
+static void
+ruby_ep0_standard(vm_offset_t mac, uint32_t t, uint8_t type, uint8_t req,
+    uint32_t value, uint32_t index, uint32_t wlen)
+{
+    uint16_t key = ((uint16_t)type << 8) | req;
+    const uint8_t *desc;
+    uint32_t desc_len;
+    uint8_t byte;
+    uint8_t status[2] = { 0, 0 };
+
+    (void)index;
+
+    switch (req) {
+    case 6: /* GET_DESCRIPTOR */
+        desc = ruby_descriptor(value, &desc_len);
+        if (desc == NULL)
+            ruby_ep0_stall(mac, t, key, wlen);
+        else if (wlen == 0)
+            ruby_ep0_ack(mac, t, key, wlen);
+        else
+            ruby_ep0_send(mac, t, key, desc, desc_len, wlen);
+        return;
+    case 5: /* SET_ADDRESS */
+        if (wlen != 0) {
+            ruby_ep0_stall(mac, t, key, wlen);
+            return;
+        }
+        {
+            uint32_t v = ruby_rd32(mac, DEVICE_CONF - MTU3_PA);
+
+            v &= ~0x7f000000u;
+            v |= (value & 0x7fu) << 24;
+            ruby_wr32(mac, DEVICE_CONF - MTU3_PA, v);
+            ruby_trace(t, RUBY_TR_ADDR, value & 0x7f, v, 0, 0);
+        }
+        ruby_ep0_ack(mac, t, key, wlen);
+        return;
+    case 9: /* SET_CONFIGURATION */
+        ruby_config = value & 0xff;
+        ruby_trace(t, RUBY_TR_CFG, ruby_config, 0, 0, 0);
+        ruby_ep0_ack(mac, t, key, wlen);
+        return;
+    case 8: /* GET_CONFIGURATION */
+        byte = ruby_config;
+        ruby_ep0_send(mac, t, key, &byte, 1, wlen);
+        return;
+    case 0: /* GET_STATUS */
+        ruby_ep0_send(mac, t, key, status, 2, wlen);
+        return;
+    case 10: /* GET_INTERFACE */
+        byte = 0;
+        ruby_ep0_send(mac, t, key, &byte, 1, wlen);
+        return;
+    case 11: /* SET_INTERFACE */
+        ruby_ep0_ack(mac, t, key, wlen);
+        return;
+    case 1: /* CLEAR_FEATURE */
+    case 3: /* SET_FEATURE */
+        if (wlen == 0)
+            ruby_ep0_ack(mac, t, key, wlen);
+        else
+            ruby_ep0_stall(mac, t, key, wlen);
+        return;
+    default:
+        ruby_ep0_stall(mac, t, key, wlen);
+        return;
+    }
+}
+
+static void
+ruby_ep0_capture(vm_offset_t mac, uint32_t t)
+{
+    static uint32_t last_key, last_value, last_len, retry;
+    uint32_t count = ruby_rd32(mac, RXCOUNT0_OFF);
+    uint32_t csr = ruby_rd32(mac, EP0CSR_OFF);
+    uint32_t w0, w1, key;
+    uint32_t value, index, len;
+    uint8_t st[8];
+
+    if (count != 8) {
+        ruby_trace(t, RUBY_TR_NOTE, 1, count, csr, 0);
+        ruby_ep0_stall(mac, t, 0, 0);
+        return;
+    }
+
+    /*
+     * U3D_FIFO0 is a 32-bit data port.  Read both setup words from the
+     * same address; reading FIFO0+4 left RXCOUNT0=4 in the P2a trace.
+     */
+    w0 = ruby_rd32(mac, FIFO0_OFF);
+    w1 = ruby_rd32(mac, FIFO0_OFF);
+    ruby_trace(t, RUBY_TR_RAW, 0, w0, w1, ruby_rd32(mac, RXCOUNT0_OFF));
+    st[0] = w0;
+    st[1] = w0 >> 8;
+    st[2] = w0 >> 16;
+    st[3] = w0 >> 24;
+    st[4] = w1;
+    st[5] = w1 >> 8;
+    st[6] = w1 >> 16;
+    st[7] = w1 >> 24;
+
+    value = st[2] | (st[3] << 8);
+    index = st[4] | (st[5] << 8);
+    len = st[6] | (st[7] << 8);
+    key = ((uint32_t)st[0] << 8) | st[1];
+
+    if (key == last_key && value == last_value && len == last_len) {
+        retry++;
+    } else {
+        retry = 1;
+        last_key = key;
+        last_value = value;
+        last_len = len;
+    }
+    if (retry == 1 || (retry & 0xf) == 0)
+        ruby_trace(t, RUBY_TR_SETUP, key, (value << 16) | index, len, retry);
+
+    if ((st[0] & 0x60) == 0)
+        ruby_ep0_standard(mac, t, st[0], st[1], value, index, len);
+    else
+        ruby_ep0_stall(mac, t, key, len);
+}
+
+static void
+ruby_usb_ep0_window(vm_offset_t mac, vm_offset_t ippc, vm_offset_t gpio)
+{
+    static const uint32_t snaps[] = {
+        0, 100, 500, 1000, 2000, 5000, 10000, 20000, 30000
+    };
+    uint32_t window_ms = 30000;
+    uint32_t t = 0, si = 0;
+    uint32_t last_otg = 0, last_op = 0;
+    uint32_t v;
+
+    PE_parse_boot_argn("rubyusb_window_ms", &window_ms, sizeof(window_ms));
+    if (window_ms < 1000 || window_ms > 120000)
+        window_ms = 30000;
+
+    if (!(ruby_rd32(mac, EP0CSR_OFF) & EP0_SETUPPKTRDY))
+        ruby_ep0_set_maxpacket(mac);
+    printf("RUBY USB: P2b window %u ms; EP0 polling, trace ring %u\n",
+        window_ms, RUBY_TRACE_MAX);
+
+    while (t <= window_ms) {
+        while (si < sizeof(snaps) / sizeof(snaps[0]) && t >= snaps[si]) {
+            ruby_snapshot(mac, ippc, gpio, t);
+            si++;
+        }
+
+        v = ruby_rd32(mac, EP0CSR_OFF);
+        if (!(v & EP0_SETUPPKTRDY) && (v & EP0_MAXPKTSZ_MSK) != 64) {
+            ruby_ep0_set_maxpacket(mac);
+            ruby_trace(t, RUBY_TR_NOTE, 2, v,
+                ruby_rd32(mac, EP0CSR_OFF), 0);
+            v = ruby_rd32(mac, EP0CSR_OFF);
+        }
+        if (v & EP0_SENTSTALL) {
+            static uint32_t stall_notes;
+
+            /* EP0_SENTSTALL is W1C; write it back to clear the stall. */
+            ruby_wr32(mac, EP0CSR_OFF,
+                (ruby_rd32(mac, EP0CSR_OFF) & EP0_W1C_BITS) |
+                EP0_SENTSTALL);
+            if (stall_notes++ == 0 || (stall_notes & 0xf) == 0)
+                ruby_trace(t, RUBY_TR_NOTE, 3, v, 0, 0);
+        }
+        if (v & EP0_SETUPPKTRDY)
+            ruby_ep0_capture(mac, t);
+
+        v = ruby_rd32(mac, EP0CSR_OFF);
+        if (v & EP0_RXPKTRDY) {
+            uint32_t count = ruby_rd32(mac, RXCOUNT0_OFF);
+            uint32_t csr;
+
+            for (uint32_t i = 0; i < count; i++)
+                (void)ruby_rd8(mac, FIFO0_OFF);
+            csr = ruby_rd32(mac, EP0CSR_OFF) & EP0_W1C_BITS;
+            csr |= EP0_RXPKTRDY | EP0_DATAEND;
+            ruby_wr32(mac, EP0CSR_OFF, csr);
+            ruby_trace(t, RUBY_TR_STATUS, 0, v, count,
+                ruby_rd32(mac, EP0CSR_OFF));
+            v = ruby_rd32(mac, EP0CSR_OFF);
+        }
+
+        v = ruby_rd32(ippc, 0x18);
+        if (v != last_otg) {
+            ruby_trace(t, RUBY_TR_STATE, 1, v, 0, 0);
+            last_otg = v;
+        }
+        v = ruby_rd32(mac, USB20_OP - MTU3_PA);
+        if (v != last_op) {
+            ruby_trace(t, RUBY_TR_STATE, 2, v, 0, 0);
+            last_op = v;
+        }
+
+        delay(1000);
+        t++;
+    }
+
+    ruby_snapshot(mac, ippc, gpio, window_ms);
+    printf("RUBY USB: trace n=%u overflow=%u\n",
+        ruby_event_count, ruby_event_overflow);
+    for (uint32_t i = 0; i < ruby_event_count; i++)
+        printf("RUBY USB TRACE t=%u type=%u a=%u b=%08x c=%08x d=%08x\n",
+            ruby_events[i].t, ruby_events[i].type, ruby_events[i].a,
+            ruby_events[i].b, ruby_events[i].c, ruby_events[i].d);
+    printf("RUBY USB: trace dumped; settle 3s\n");
+    delay(3000);
+}
