+static void
+ruby_ep0_service(vm_offset_t mac, uint32_t t)
+{
+    uint32_t v = ruby_rd32(mac, EP0CSR_OFF);
+
+    if (!(v & EP0_SETUPPKTRDY) && (v & EP0_MAXPKTSZ_MSK) != 64) {
+        ruby_ep0_set_maxpacket(mac);
+        ruby_trace(t, RUBY_TR_NOTE, 2, v, ruby_rd32(mac, EP0CSR_OFF), 0);
+        v = ruby_rd32(mac, EP0CSR_OFF);
+    }
+    if (v & EP0_SENTSTALL) {
+        static uint32_t stall_notes;
+
+        /* EP0_SENTSTALL is W1C; write it back to clear the stall. */
+        ruby_wr32(mac, EP0CSR_OFF,
+            (ruby_rd32(mac, EP0CSR_OFF) & EP0_W1C_BITS) | EP0_SENTSTALL);
+        if (stall_notes++ == 0 || (stall_notes & 0xf) == 0)
+            ruby_trace(t, RUBY_TR_NOTE, 3, v, 0, 0);
+    }
+    if (v & EP0_SETUPPKTRDY)
+        ruby_ep0_capture(mac, t);
+
+    v = ruby_rd32(mac, EP0CSR_OFF);
+    if (v & EP0_RXPKTRDY) {
+        uint32_t count = ruby_rd32(mac, RXCOUNT0_OFF);
+        uint32_t csr;
+
+        for (uint32_t i = 0; i < count; i++)
+            (void)ruby_rd8(mac, FIFO0_OFF);
+        csr = ruby_rd32(mac, EP0CSR_OFF) & EP0_W1C_BITS;
+        csr |= EP0_RXPKTRDY | EP0_DATAEND;
+        ruby_wr32(mac, EP0CSR_OFF, csr);
+        ruby_trace(t, RUBY_TR_STATUS, 0, v, count,
+            ruby_rd32(mac, EP0CSR_OFF));
+    }
+}
+
+static void
+ruby_ep0_thread(void *arg, wait_result_t wr)
+{
+    (void)arg;
+    (void)wr;
+    for (;;) {
+        ruby_ep0_service(ruby_mac_base, 0);
+        delay(1000);
+    }
+}
