 #define CAP_EPINFO_OFF  0x0c10
 #define TX_SENDSTALL    (1u << 21)
 #define TX_SENTSTALL    (1u << 22)
+#define TX_FLUSHFIFO    (1u << 20)
 
 #define QMU_Q_START     1u
 #define QMU_Q_STOP      4u
 #define QMU_Q_RESUME    2u
 #define QMU_Q_ACTIVE    0x8000u
+#define RUBY_EP2_STOP_SPINS     1000u
