 #define RX_TYPE(x)      (((x) & 0x3u) << 4)
@@ -1051,6 +1055,12 @@
 static uint32_t ruby_q1_last;
 static uint32_t ruby_err_last;
 static uint32_t ruby_recoveries;
+static uint32_t ruby_ep2_stop_timeouts;
+static uint32_t ruby_ep2_start_failures;
+static uint32_t ruby_ep2_recover_skipped;
+static uint32_t ruby_ep2_stop_spins_last;
+static uint32_t ruby_ep2_stop_spins_max;
