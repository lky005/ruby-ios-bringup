diff --git a/bsd/dev/ruby_ecm.c b/bsd/dev/ruby_ecm.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/ruby_ecm.c
@@ -0,0 +1,468 @@
+/*
+ * ruby (MT6877): CDC-ECM network function on ruby's MTU3 USB device
+ * stack (boot-arg ruby_enum=3, needs rubyusb=1 ruby_echo=1).
+ *
+ * The EP1 data plane (bulk OUT 0x01 / IN 0x81) carries one Ethernet frame
+ * per USB transfer:
+ *   RX: ruby's QMU hands over <= 512-byte GPD chunks; a chunk shorter than
+ *       the 512-byte max packet (or a zero-length one) ends the frame.
+ *   TX: frames sit in a length-prefixed ring; the TX pump takes at most one
+ *       max packet per GPD and never crosses a frame boundary, so every
+ *       frame's last GPD is a short packet. A frame whose length is a
+ *       multiple of 512 gets one pad byte (as sweet's ue0: IP ignores it),
+ *       so no zero-length packet is needed.
+ *
+ * The kernel interface is ue0 (sweet 0075): Ethernet ifnet, phone
+ * 192.168.7.2/24, the Mac is expected at 192.168.7.1.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/locks.h>
+#include <pexpert/pexpert.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/kpi_socket.h>
+#include <sys/sockio.h>
+#include <net/if.h>
+#include <net/if_types.h>
+#include <net/ethernet.h>
+#include <net/if_ether.h>
+#include <net/ether_if_module.h>
+#include <net/kpi_interface.h>
+#include <net/kpi_protocol.h>
+#include <netinet/in.h>
+#include <netinet/in_var.h>
+
+#include "ruby_usb_io.h"
+#include "ruby_ecm.h"
+
+#define ECM_MPS         512u
+#define ECM_FRAME_MAX   1536u
+#define ECM_TXQ_BYTES   (64u * 1024u)
+
+extern int ruby_enum_profile;
+extern uint32_t ruby_rx_buf_size;
+extern int ruby_ecm_ioeth_create(void);
+extern void ruby_ecm_ioeth_input(const uint8_t *data, uint32_t len);
+
+/* phone side MAC (the host's MAC is the iMACAddress string, 02005E77EE01) */
+static const uint8_t ecm_phone_mac[ETHER_ADDR_LEN] = {
+	0x02, 0x00, 0x5e, 0x77, 0xee, 0x02
+};
+
+static struct {
+	ifnet_t ifp;
+	int ioeth;                      /* rubyecmio=1: RubyECMEthernet */
+	lck_grp_t *grp;
+	lck_spin_t *lock;
+	int on;
+	/* RX assembly */
+	uint8_t rx[ECM_FRAME_MAX + ECM_MPS];
+	uint32_t rx_len;
+	int rx_bad;
+	/* TX ring: [u16 len][bytes]... */
+	uint8_t txq[ECM_TXQ_BYTES];
+	uint32_t txq_head, txq_tail;    /* free-running byte counters */
+	uint32_t tx_left;               /* bytes left of the frame being sent */
+	/* stats */
+	uint32_t rx_frames, rx_drops, tx_frames, tx_drops;
+} ecm;
+
+int
+ruby_ecm_enabled(void)
+{
+	return ecm.on;
+}
+
+/*
+ * Link notifications on the interrupt EP 0x83 (PIO, EP3 FIFO at
+ * FIFO0 + 3 * 0x10): NETWORK_CONNECTION(1), then CONNECTION_SPEED_CHANGE
+ * 480/480 Mb/s. macOS keeps the interface "inactive" (no IPv4) without
+ * them. Armed by SET_INTERFACE(data, alt 1), sent from the TX pump.
+ */
+#define ECM_TX3CSR0     0x0130u
+#define ECM_EP3_FIFO    (0x0300u + 3u * 0x10u)
+#define ECM_TXPKTRDY    (1u << 16)
+
+static volatile uint32_t ecm_notify_step;       /* 0 idle, 1 connect, 2 speed */
+static uint32_t ecm_notify_sent;
+
+void
+ruby_ecm_link_arm(void)
+{
+	ecm_notify_step = 1;
+	ruby_usb_tx_kick();             /* host is waiting for carrier */
+}
+
+static void
+ecm_fifo_put(vm_offset_t mac, const uint8_t *p, uint32_t n)
+{
+	for (uint32_t i = 0; i < n; i += 4) {
+		uint32_t w = (uint32_t)p[i] | ((uint32_t)p[i + 1] << 8) |
+		    ((uint32_t)p[i + 2] << 16) | ((uint32_t)p[i + 3] << 24);
+		*(volatile uint32_t *)(mac + ECM_EP3_FIFO) = w;
+	}
+}
+
+void
+ruby_ecm_link_poll(vm_offset_t mac)
+{
+	uint32_t step = ecm_notify_step;
+
+	if (!ecm.on || step == 0 || mac == 0) {
+		return;
+	}
+	if (*(volatile uint32_t *)(mac + ECM_TX3CSR0) & ECM_TXPKTRDY) {
+		return;                 /* previous notification not taken yet */
+	}
+	if (step == 1) {
+		static const uint8_t conn[8] = { 0xA1, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00 };
+		ecm_fifo_put(mac, conn, sizeof(conn));
+		*(volatile uint32_t *)(mac + ECM_TX3CSR0) = 16u | ECM_TXPKTRDY;
+		ecm_notify_step = 2;
+	} else {
+		static const uint8_t speed[16] = {
+			0xA1, 0x2A, 0x00, 0x00, 0x00, 0x00, 0x08, 0x00,
+			0x00, 0x38, 0x9C, 0x1C, 0x00, 0x38, 0x9C, 0x1C  /* 480000000 x2 */
+		};
+		ecm_fifo_put(mac, speed, sizeof(speed));
+		*(volatile uint32_t *)(mac + ECM_TX3CSR0) = 16u | ECM_TXPKTRDY;
+		ecm_notify_step = 0;
+	}
+	ecm_notify_sent++;
+	printf("RUBY ECM: link notification %u sent\n", ecm_notify_sent);
+}
+
+static void
+ecm_txq_put(const uint8_t *p, uint32_t n)
+{
+	for (uint32_t i = 0; i < n; i++) {
+		ecm.txq[(ecm.txq_head + i) % ECM_TXQ_BYTES] = p[i];
+	}
+	ecm.txq_head += n;
+}
+
+static void
+ecm_txq_get(uint8_t *p, uint32_t n)
+{
+	for (uint32_t i = 0; i < n; i++) {
+		p[i] = ecm.txq[(ecm.txq_tail + i) % ECM_TXQ_BYTES];
+	}
+	ecm.txq_tail += n;
+}
+
+int
+ruby_ecm_tx_pending(void)
+{
+	return ecm.on && (ecm.tx_left != 0 || ecm.txq_head != ecm.txq_tail);
+}
+
+/*
+ * TX pump hook (ruby_ep2_push_log): copy at most max bytes of the current
+ * frame into buf. Returns 0 when nothing is queued.
+ */
+uint32_t
+ruby_ecm_tx_dequeue(uint8_t *buf, uint32_t max)
+{
+	uint32_t n = 0;
+
+	if (!ecm.on) {
+		return 0;
+	}
+	lck_spin_lock(ecm.lock);
+	if (ecm.tx_left == 0 && ecm.txq_head != ecm.txq_tail) {
+		uint8_t h[2];
+		ecm_txq_get(h, 2);
+		ecm.tx_left = (uint32_t)h[0] | ((uint32_t)h[1] << 8);
+	}
+	if (ecm.tx_left != 0) {
+		n = ecm.tx_left < max ? ecm.tx_left : max;
+		ecm_txq_get(buf, n);
+		ecm.tx_left -= n;
+	}
+	lck_spin_unlock(ecm.lock);
+	return n;
+}
+
+/* RX hook (ruby_usb_io_rx with owner NET): one GPD chunk. */
+void
+ruby_ecm_rx(const uint8_t *data, uint32_t len)
+{
+	if (!ecm.on) {
+		return;
+	}
+	if (ecm.rx_len + len > sizeof(ecm.rx)) {
+		ecm.rx_bad = 1;         /* oversized: drop until the frame ends */
+	} else if (len) {
+		memcpy(ecm.rx + ecm.rx_len, data, len);
+		ecm.rx_len += len;
+	}
+	/*
+	 * A GPD that came back full means the transfer continues in the next
+	 * one. With ruby_rxbuf=2048 a whole frame fits one GPD (the QMU joins
+	 * packets until the short one), so every completion is a frame end;
+	 * with the default 512 a full 512-byte chunk continues.
+	 */
+	if (len != 0 && len == (ruby_rx_buf_size ? ruby_rx_buf_size : ECM_MPS)) {
+		return;
+	}
+	uint32_t flen = ecm.rx_len;
+	int bad = ecm.rx_bad;
+	ecm.rx_len = 0;
+	ecm.rx_bad = 0;
+	if (bad || flen < ETHER_HDR_LEN || flen > ECM_FRAME_MAX) {
+		ecm.rx_drops++;
+		return;
+	}
+	if (ecm.ioeth) {
+		ecm.rx_frames++;
+		ruby_ecm_ioeth_input(ecm.rx, flen);
+		return;
+	}
+	if (ecm.ifp == NULL) {
+		ecm.rx_drops++;
+		return;
+	}
+	mbuf_t m = NULL;
+	if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0 ||
+	    mbuf_mclget(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0 ||
+	    !(mbuf_flags(m) & MBUF_EXT) || mbuf_maxlen(m) < flen) {
+		if (m != NULL) {
+			mbuf_freem(m);
+		}
+		ecm.rx_drops++;
+		return;
+	}
+	struct ifnet_stat_increment_param stats = {};
+	memcpy(mbuf_data(m), ecm.rx, flen);
+	mbuf_setlen(m, flen);
+	mbuf_pkthdr_setlen(m, flen);
+	void *frame_header = mbuf_data(m);
+	mbuf_pkthdr_setrcvif(m, ecm.ifp);
+	mbuf_pkthdr_setheader(m, frame_header);
+	mbuf_pkthdr_adjustlen(m, -ETHER_HDR_LEN);
+	(void)mbuf_setdata(m, (char *)mbuf_data(m) + ETHER_HDR_LEN, mbuf_len(m) - ETHER_HDR_LEN);
+	stats.packets_in = 1;
+	stats.bytes_in = flen;
+	ecm.rx_frames++;
+	if (ecm.rx_frames <= 4) {
+		printf("RUBY ECM: rx frame %u len %u type %02x%02x\n", ecm.rx_frames,
+		    flen, ecm.rx[12], ecm.rx[13]);
+	}
+	ifnet_input(ecm.ifp, m, &stats);
+}
+
+/* Queue one Ethernet frame (ue0 and RubyECMEthernet). 0 = queued. */
+int
+ruby_ecm_queue_frame(const uint8_t *data, uint32_t len)
+{
+	uint8_t pad = 0;
+
+	if (!ecm.on || len < ETHER_HDR_LEN || len > ECM_FRAME_MAX) {
+		ecm.tx_drops++;
+		return -1;
+	}
+	uint32_t wire = len + (((len % ECM_MPS) == 0) ? 1u : 0u);   /* short packet end */
+	lck_spin_lock(ecm.lock);
+	if ((ecm.txq_head - ecm.txq_tail) + wire + 2 > ECM_TXQ_BYTES) {
+		lck_spin_unlock(ecm.lock);
+		ecm.tx_drops++;
+		return -1;
+	}
+	uint8_t h[2] = { (uint8_t)wire, (uint8_t)(wire >> 8) };
+	ecm_txq_put(h, 2);
+	ecm_txq_put(data, len);
+	if (wire != len) {
+		ecm_txq_put(&pad, 1);
+	}
+	lck_spin_unlock(ecm.lock);
+	ecm.tx_frames++;
+	ruby_usb_rx_kick();             /* IRQ mode: wake the QMU workloop */
+	return 0;
+}
+
+static errno_t
+ecm_if_output(ifnet_t ifp, mbuf_t m)
+{
+	uint32_t len = (uint32_t)mbuf_pkthdr_len(m);
+	uint8_t frame[ECM_FRAME_MAX];
+
+	if (len < ETHER_HDR_LEN || len > ECM_FRAME_MAX) {
+		mbuf_freem(m);
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+		return 0;
+	}
+	mbuf_copydata(m, 0, len, frame);
+	mbuf_freem(m);
+	if (ruby_ecm_queue_frame(frame, len) != 0) {
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+	} else {
+		ifnet_stat_increment_out(ifp, 1, len, 0);
+	}
+	return 0;
+}
+
+static errno_t
+ecm_if_ioctl(ifnet_t ifp, unsigned long cmd, void *data __unused)
+{
+	switch (cmd) {
+	case SIOCSIFADDR:
+	case SIOCAIFADDR:
+		ifnet_set_flags(ifp, IFF_UP, IFF_UP);
+		return 0;
+	case SIOCSIFFLAGS:
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		return 0;
+	default:
+		return EOPNOTSUPP;
+	}
+}
+
+static void
+ecm_if_detach(ifnet_t ifp __unused)
+{
+}
+
+void
+ruby_ecm_start(void)
+{
+	struct ifnet_init_eparams init;
+
+	if (ruby_enum_profile != 3) {
+		return;
+	}
+	ecm.grp = lck_grp_alloc_init("ruby_ecm", LCK_GRP_ATTR_NULL);
+	ecm.lock = lck_spin_alloc_init(ecm.grp, LCK_ATTR_NULL);
+
+	int io = 0;
+	PE_parse_boot_argn("rubyecmio", &io, sizeof(io));
+	if (io == 1) {
+		/* IONetworkingFamily path: configd names it and runs DHCP. */
+		ruby_usb_io_force_owner(RUBY_USB_IO_NET);
+		ecm.on = 1;
+		if (ruby_ecm_ioeth_create() == 0) {
+			ecm.ioeth = 1;
+			printf("RUBY ECM: IOEthernetController path (rubyecmio=1), EP1 owner=net\n");
+			return;
+		}
+		printf("RUBY ECM: IOEthernetController failed, falling back to ue0\n");
+	}
+
+	bzero(&init, sizeof(init));
+	init.ver = IFNET_INIT_CURRENT_VERSION;
+	init.len = sizeof(init);
+	init.flags = IFNET_INIT_LEGACY;
+	init.uniqueid = "ruby-usb-ecm";
+	init.uniqueid_len = sizeof("ruby-usb-ecm") - 1;
+	init.name = "ue";
+	init.unit = 0;
+	init.family = IFNET_FAMILY_ETHERNET;
+	init.type = IFT_ETHER;
+	init.output = ecm_if_output;
+	init.demux = ether_demux;
+	init.add_proto = ether_add_proto;
+	init.del_proto = ether_del_proto;
+	init.check_multi = ether_check_multi;
+	init.framer_extended = ether_frameout_extended;
+	init.ioctl = ecm_if_ioctl;
+	init.detach = ecm_if_detach;
+	init.broadcast_addr = etherbroadcastaddr;
+	init.broadcast_len = ETHER_ADDR_LEN;
+	if (ifnet_allocate_extended(&init, &ecm.ifp) != 0) {
+		printf("RUBY ECM: ifnet_allocate failed\n");
+		ecm.ifp = NULL;
+		return;
+	}
+	ifnet_set_addrlen(ecm.ifp, ETHER_ADDR_LEN);
+	ifnet_set_hdrlen(ecm.ifp, sizeof(struct ether_header));
+	ifnet_set_mtu(ecm.ifp, ETHERMTU);
+	ifnet_set_baudrate(ecm.ifp, 480000000);
+	ifnet_set_flags(ecm.ifp, IFF_BROADCAST | IFF_SIMPLEX | IFF_MULTICAST, 0xffff);
+	if (ifnet_attach(ecm.ifp, NULL) != 0) {
+		printf("RUBY ECM: ifnet_attach failed\n");
+		ecm.ifp = NULL;
+		return;
+	}
+	ifnet_set_lladdr(ecm.ifp, ecm_phone_mac, ETHER_ADDR_LEN);
+
+	errno_t err = proto_plumb(PF_INET, ecm.ifp);
+	socket_t so = NULL;
+	if (err == 0) {
+		err = sock_socket(PF_INET, SOCK_DGRAM, 0, NULL, NULL, &so);
+	}
+	if (err == 0) {
+		struct ifaliasreq ifra;
+		bzero(&ifra, sizeof(ifra));
+		snprintf(ifra.ifra_name, sizeof(ifra.ifra_name), "ue0");
+		struct sockaddr_in *a = (struct sockaddr_in *)&ifra.ifra_addr;
+		a->sin_len = sizeof(*a);
+		a->sin_family = AF_INET;
+		a->sin_addr.s_addr = htonl(0xc0a80702);         /* 192.168.7.2 */
+		a = (struct sockaddr_in *)&ifra.ifra_mask;
+		a->sin_len = sizeof(*a);
+		a->sin_family = AF_INET;
+		a->sin_addr.s_addr = htonl(0xffffff00);
+		a = (struct sockaddr_in *)&ifra.ifra_broadaddr;
+		a->sin_len = sizeof(*a);
+		a->sin_family = AF_INET;
+		a->sin_addr.s_addr = htonl(0xc0a807ff);
+		err = sock_ioctl(so, SIOCAIFADDR, &ifra);
+		sock_close(so);
+	}
+	ifnet_set_flags(ecm.ifp, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);
+	ruby_usb_io_force_owner(RUBY_USB_IO_NET);
+	ecm.on = 1;
+	printf("RUBY ECM: ue0 192.168.7.2/24 %s (err %d), EP1 owner=net\n",
+	    err ? "NOT configured" : "up", err);
+}
+
+void
+ruby_ecm_config_en0(void)
+{
+	socket_t so = NULL;
+	errno_t err;
+	struct ifaliasreq ifra;
+	struct ifreq ifr;
+
+	err = sock_socket(PF_INET, SOCK_DGRAM, 0, NULL, NULL, &so);
+	if (err != 0) {
+		printf("RUBY ETH: en0 socket err %d\n", err);
+		return;
+	}
+	bzero(&ifra, sizeof(ifra));
+	snprintf(ifra.ifra_name, sizeof(ifra.ifra_name), "en0");
+	struct sockaddr_in *a = (struct sockaddr_in *)&ifra.ifra_addr;
+	a->sin_len = sizeof(*a);
+	a->sin_family = AF_INET;
+	a->sin_addr.s_addr = htonl(0xc0a80702);         /* 192.168.7.2 */
+	a = (struct sockaddr_in *)&ifra.ifra_mask;
+	a->sin_len = sizeof(*a);
+	a->sin_family = AF_INET;
+	a->sin_addr.s_addr = htonl(0xffffff00);
+	a = (struct sockaddr_in *)&ifra.ifra_broadaddr;
+	a->sin_len = sizeof(*a);
+	a->sin_family = AF_INET;
+	a->sin_addr.s_addr = htonl(0xc0a807ff);
+	err = sock_ioctl(so, SIOCAIFADDR, &ifra);
+	bzero(&ifr, sizeof(ifr));
+	snprintf(ifr.ifr_name, sizeof(ifr.ifr_name), "en0");
+	ifr.ifr_flags = IFF_UP | IFF_RUNNING;
+	(void)sock_ioctl(so, SIOCSIFFLAGS, &ifr);
+	sock_close(so);
+	printf("RUBY ETH: en0 192.168.7.2/24 %s (err %d)\n",
+	    err ? "NOT configured" : "up", err);
+}
+
+void
+ruby_ecm_status(void)
+{
+	if (!ecm.on) {
+		return;
+	}
+	printf("RUBY ECM: rx %u drop %u | tx %u drop %u | txq %u left %u\n",
+	    ecm.rx_frames, ecm.rx_drops, ecm.tx_frames, ecm.tx_drops,
+	    ecm.txq_head - ecm.txq_tail, ecm.tx_left);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
