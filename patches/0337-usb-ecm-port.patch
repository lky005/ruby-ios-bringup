diff --git a/iokit/Kernel/arm/RubyECMEthernet.cpp b/iokit/Kernel/arm/RubyECMEthernet.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/RubyECMEthernet.cpp
@@ -0,0 +1,273 @@
+/*
+ * ruby (MT6877): the USB CDC-ECM link (bsd/dev/ruby_ecm.c) as a real
+ * IOEthernetController from the built-in IONetworkingFamily (0497), so the
+ * system sees an Ethernet adapter: IONetworkStack/configd name it (en*),
+ * IPConfiguration runs DHCP on it and apps get a network path.
+ *
+ * Boot-arg rubyecmio=1 selects this path instead of the kernel-only ue0.
+ * Frames still go through ruby_ecm.c's per-frame TX ring and RX assembly.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOWorkLoop.h>
+#include <IOKit/network/IOEthernetController.h>
+#include <IOKit/network/IOEthernetInterface.h>
+#include <IOKit/network/IONetworkMedium.h>
+#include <IOKit/network/IOOutputQueue.h>
+#include <sys/kpi_mbuf.h>
+
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+
+extern "C" int ruby_ecm_queue_frame(const uint8_t *frame, uint32_t len);
+extern "C" void ruby_ecm_config_en0(void);
+extern "C" kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern "C" void thread_deallocate(thread_t);
+
+class RubyECMEthernet : public IOEthernetController {
+	OSDeclareDefaultStructors(RubyECMEthernet);
+
+public:
+	IOEthernetInterface *fNetif;
+	IONetworkMedium     *fMedium;
+	IOWorkLoop          *fWorkLoop;
+	volatile bool        fEnabled;
+	uint32_t             fRx, fTx, fRxDrops, fTxDrops;
+
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	bool createWorkLoop(void) APPLE_KEXT_OVERRIDE;
+	IOWorkLoop *getWorkLoop(void) const APPLE_KEXT_OVERRIDE;
+	IOReturn enable(IONetworkInterface *netif) APPLE_KEXT_OVERRIDE;
+	IOReturn disable(IONetworkInterface *netif) APPLE_KEXT_OVERRIDE;
+	UInt32 outputPacket(mbuf_t m, void *param) APPLE_KEXT_OVERRIDE;
+	IOReturn getHardwareAddress(IOEthernetAddress *addr) APPLE_KEXT_OVERRIDE;
+	IOReturn setPromiscuousMode(bool active) APPLE_KEXT_OVERRIDE;
+	IOReturn setMulticastMode(bool active) APPLE_KEXT_OVERRIDE;
+	IOReturn setMulticastList(IOEthernetAddress *addrs, UInt32 count) APPLE_KEXT_OVERRIDE;
+	void input(const uint8_t *data, uint32_t len);
+	static void nameThread(void *arg, wait_result_t wr);
+};
+
+OSDefineMetaClassAndStructors(RubyECMEthernet, IOEthernetController);
+
+static RubyECMEthernet *gRubyEth;
+
+bool
+RubyECMEthernet::createWorkLoop(void)
+{
+	fWorkLoop = IOWorkLoop::workLoop();
+	return fWorkLoop != NULL;
+}
+
+IOWorkLoop *
+RubyECMEthernet::getWorkLoop(void) const
+{
+	return fWorkLoop;
+}
+
+bool
+RubyECMEthernet::start(IOService *provider)
+{
+	if (!IOEthernetController::start(provider)) {
+		IOLog("RUBY ETH: IOEthernetController::start failed\n");
+		return false;
+	}
+	OSDictionary *media = OSDictionary::withCapacity(1);
+	fMedium = IONetworkMedium::medium(kIOMediumEthernetAuto, 480000000);
+	if (media == NULL || fMedium == NULL ||
+	    !IONetworkMedium::addMedium(media, fMedium) ||
+	    !publishMediumDictionary(media)) {
+		IOLog("RUBY ETH: medium setup failed\n");
+		OSSafeReleaseNULL(media);
+		return false;
+	}
+	media->release();
+	setProperty("IOModel", "ruby USB CDC-ECM");
+	setProperty("IOVendor", "ruby");
+	if (!attachInterface((IONetworkInterface **)&fNetif, false)) {
+		IOLog("RUBY ETH: attachInterface failed\n");
+		return false;
+	}
+	fNetif->registerService();
+	IOLog("RUBY ETH: IOEthernetController up, interface registered\n");
+	setLinkStatus(kIONetworkLinkValid | kIONetworkLinkActive, fMedium, 480000000);
+	ruby_ecm_config_en0();
+
+	/*
+	 * configd's InterfaceNamer only names a new interface once IOKit is
+	 * quiet, and on ruby something never settles: it gave up after its
+	 * 240 s timeout. Ask IONetworkStack for the name ourselves (the same
+	 * request InterfaceNamer sends: lowest free unit from 0); configd then
+	 * finds an attached en0 and configures it (rubyecmname=0: leave it
+	 * to configd).
+	 */
+	int name = 1;
+	PE_parse_boot_argn("rubyecmname", &name, sizeof(name));
+	if (name) {
+		thread_t th;
+		retain();
+		if (kernel_thread_start((thread_continue_t)&RubyECMEthernet::nameThread,
+		    this, &th) == KERN_SUCCESS) {
+			thread_deallocate(th);
+		} else {
+			release();
+		}
+	}
+	return true;
+}
+
+void
+RubyECMEthernet::nameThread(void *arg, wait_result_t wr __unused)
+{
+	RubyECMEthernet *self = (RubyECMEthernet *)arg;
+	OSDictionary *match = IOService::serviceMatching("IONetworkStack");
+	IOService *stack = match ? IOService::waitForMatchingService(match,
+	    30ULL * NSEC_PER_SEC) : NULL;
+	OSSafeReleaseNULL(match);
+	if (stack == NULL || self->fNetif == NULL) {
+		IOLog("RUBY ETH: no IONetworkStack, naming left to configd\n");
+	} else {
+		uint64_t id = self->fNetif->getRegistryEntryID();
+		OSDictionary *cmd = OSDictionary::withCapacity(3);
+		OSNumber *type = OSNumber::withNumber(1ULL, 32);   /* lowest unit */
+		OSNumber *unit = OSNumber::withNumber(0ULL, 32);
+		OSData *eid = OSData::withBytes(&id, sizeof(id));
+		IOReturn ret = kIOReturnNoMemory;
+		if (cmd && type && unit && eid) {
+			cmd->setObject("IONetworkStackUserCommand", type);
+			cmd->setObject("IOInterfaceUnit", unit);
+			cmd->setObject("IORegistryEntryID", eid);
+			ret = stack->setProperties(cmd);
+		}
+		IOLog("RUBY ETH: asked IONetworkStack for a name: 0x%x, now %s%u\n",
+		    ret, self->fNetif->getNamePrefix(), self->fNetif->getUnitNumber());
+		OSSafeReleaseNULL(cmd);
+		OSSafeReleaseNULL(type);
+		OSSafeReleaseNULL(unit);
+		OSSafeReleaseNULL(eid);
+		stack->release();
+	}
+	self->release();
+}
+
+IOReturn
+RubyECMEthernet::enable(IONetworkInterface *netif __unused)
+{
+	fEnabled = true;
+	setLinkStatus(kIONetworkLinkValid | kIONetworkLinkActive, fMedium, 480000000);
+	IOLog("RUBY ETH: enabled, link up\n");
+	return kIOReturnSuccess;
+}
+
+IOReturn
+RubyECMEthernet::disable(IONetworkInterface *netif __unused)
+{
+	fEnabled = false;
+	setLinkStatus(kIONetworkLinkValid, NULL, 0);
+	IOLog("RUBY ETH: disabled\n");
+	return kIOReturnSuccess;
+}
+
+UInt32
+RubyECMEthernet::outputPacket(mbuf_t m, void *param __unused)
+{
+	uint8_t frame[1600];
+	size_t len = mbuf_pkthdr_len(m);
+	int queued = 0;
+
+	if (fEnabled && len >= 14 && len <= 1536 &&
+	    mbuf_copydata(m, 0, len, frame) == 0)
+		queued = ruby_ecm_queue_frame(frame, (uint32_t)len) == 0;
+	freePacket(m);
+	if (queued) {
+		fTx++;
+		if (fTx <= 6)
+			IOLog("RUBY ETH: tx %u len=%u\n", fTx, (uint32_t)len);
+	} else {
+		fTxDrops++;
+		if (fTxDrops <= 8)
+			IOLog("RUBY ETH: tx drop %u len=%u enabled=%d\n",
+			    fTxDrops, (uint32_t)len, fEnabled ? 1 : 0);
+	}
+	return kIOReturnOutputSuccess;
+}
+
+IOReturn
+RubyECMEthernet::getHardwareAddress(IOEthernetAddress *addr)
+{
+	static const uint8_t mac[6] = { 0x02, 0x00, 0x5e, 0x77, 0xee, 0x02 };
+	bcopy(mac, addr->bytes, 6);
+	return kIOReturnSuccess;
+}
+
+IOReturn
+RubyECMEthernet::setPromiscuousMode(bool active __unused)
+{
+	return kIOReturnSuccess;
+}
+
+IOReturn
+RubyECMEthernet::setMulticastMode(bool active __unused)
+{
+	return kIOReturnSuccess;
+}
+
+IOReturn
+RubyECMEthernet::setMulticastList(IOEthernetAddress *addrs __unused, UInt32 count __unused)
+{
+	return kIOReturnSuccess;
+}
+
+void
+RubyECMEthernet::input(const uint8_t *data, uint32_t len)
+{
+	if (!fEnabled || fNetif == NULL) {
+		if (++fRxDrops <= 4)
+			IOLog("RUBY ETH: rx drop %u enabled=%d\n",
+			    fRxDrops, fEnabled ? 1 : 0);
+		return;
+	}
+	mbuf_t m = allocatePacket(len);
+	if (m == NULL) {
+		return;
+	}
+	if (mbuf_copyback(m, 0, len, data, MBUF_DONTWAIT) != 0) {
+		freePacket(m);
+		return;
+	}
+	fRx++;
+	fNetif->inputPacket(m, len, 0);
+}
+
+extern "C" int
+ruby_ecm_ioeth_create(void)
+{
+	RubyECMEthernet *e = new RubyECMEthernet;
+	IOService *prov = IOService::getResourceService();
+
+	if (e == NULL || !e->init(NULL) || !e->attach(prov)) {
+		IOLog("RUBY ETH: create failed\n");
+		OSSafeReleaseNULL(e);
+		return -1;
+	}
+	if (!e->start(prov)) {
+		e->detach(prov);
+		e->release();
+		return -1;
+	}
+	e->registerService();
+	gRubyEth = e;
+	return 0;
+}
+
+extern "C" void
+ruby_ecm_ioeth_input(const uint8_t *data, uint32_t len)
+{
+	if (gRubyEth != NULL) {
+		gRubyEth->input(data, len);
+	}
+}
