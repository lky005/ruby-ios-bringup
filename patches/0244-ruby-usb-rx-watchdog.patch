 static uint32_t ruby_ep2_tx_kicks;
 static uint32_t ruby_ep2_active_seen;
 static uint32_t ruby_ep2_tx_kick_ms;
+/* 0244: same watchdog for the RX queue. */
+static uint32_t ruby_ep2_rx_kicks;
+static uint32_t ruby_ep2_rx_active_seen;
+static uint32_t ruby_ep2_rx_kick_ms;
 static uint32_t ruby_inflight;
