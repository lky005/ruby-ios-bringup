 static volatile uint32_t ruby_tx_busy;
@@ -2868,6 +2873,28 @@ ruby_ep2_tx_watchdog(vm_offset_t mac)
     ruby_ep2_tx_kicks++;
 }
 
+/*
+ * 0244: RX watchdog, mirroring the TX one.  The RQCSR ACTIVE readback
+ * also lies on this silicon, so kick the RX doorbell unconditionally
+ * every 20 ms; only fall into the full re-program when the queue still
+ * reports inactive afterwards.
+ */
+static void
+ruby_ep2_rx_watchdog(vm_offset_t mac)
+{
+    if (!ruby_rx_ready)
+        return;
+    if ((uint32_t)(ruby_ms - ruby_ep2_rx_kick_ms) < 20)
+        return;
+    ruby_ep2_rx_kick_ms = ruby_ms;
+    if (ruby_rd32(mac, RQCSR1_OFF) & QMU_Q_ACTIVE)
+        ruby_ep2_rx_active_seen++;
+    ruby_wr32(mac, RQCSR1_OFF, QMU_Q_RESUME);
+    if (!(ruby_rd32(mac, RQCSR1_OFF) & QMU_Q_ACTIVE))
+        ruby_ep2_rx_resume(mac);
+    ruby_ep2_rx_kicks++;
+}
+
