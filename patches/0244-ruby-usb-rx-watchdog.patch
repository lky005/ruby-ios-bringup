      * The drain re-arms what completed; if the queue is still inactive,
      * resume it so the next host OUT is not NAKed forever.
      */
-    if (ruby_rx_ready &&
-        !(ruby_rd32(mac, RQCSR1_OFF) & QMU_Q_ACTIVE))
-        ruby_ep2_rx_resume(mac);
+    if (ruby_rx_ready)
+        ruby_ep2_rx_watchdog(mac);
 }
 
