diff --git a/bsd/dev/ruby_usb.c b/bsd/dev/ruby_usb.c
index b605584..aef033d 100644
--- a/bsd/dev/ruby_usb.c
+++ b/bsd/dev/ruby_usb.c
@@ -62,9 +62,13 @@ extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 #define PHY_PA       0x11e40000UL
 #define GPIO_PA      0x10005000UL
 #define IFRAO_PA     0x10001000UL
-/* 0199: clock-audit regions (probe read-only). */
+/*
+ * 0199: clock-audit regions (probe read-only).  0201: APMIXED base fixed
+ * to the real MT6877 syscon (0x1000C000); the 0199 value 0x11c00000 was
+ * wrong and made the USBPLL reads unreachable.
+ */
 #define TOPCKGEN_PA  0x10000000UL
-#define APMIXED_PA   0x11c00000UL
+#define APMIXED_PA   0x1000c000UL
 
 #define IPPC_SIZE    0x100
 #define MTU3_SIZE    0x3000
@@ -1499,7 +1503,15 @@ ruby_ep0_thread(void *arg, wait_result_t wr)
 #define RUBY_RX_BUF     64
 #define RUBY_GPD_NUM    64
 #define RUBY_GPD_DESC   16
-#define RUBY_GPD_STRIDE 64
+/*
+ * 0201: vendor mtu3 uses a contiguous 16-byte GPD ring (docs/82 item 3,
+ * never tested until now).  The ring stays 64 slots = 1 KB, inside one
+ * page; four GPDs now share a 64-byte cache line, which is safe because
+ * the same-line neighbours of a published GPD are always in the free
+ * region (64 slots - 16 in-flight) and the whole-ring clean+read at the
+ * top of the push path re-loads those lines from DRAM first.
+ */
+#define RUBY_GPD_STRIDE 16
 #define RUBY_GPD_RING_SZ (RUBY_GPD_NUM * RUBY_GPD_STRIDE)
 #define RUBY_EP2_MAX_INFLIGHT 16u
 #define RUBY_EP2_STUCK_TICKS  2000u     /* ~2 s at 1 ms */
