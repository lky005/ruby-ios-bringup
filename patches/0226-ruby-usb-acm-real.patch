+                     (bits == 5 || bits == 6 || bits == 7 || bits == 8 || bits == 16);
+            if (ok) {
+                ruby_acm_line_coding[0]=lc[0]; ruby_acm_line_coding[1]=lc[1];
+                ruby_acm_line_coding[2]=lc[2]; ruby_acm_line_coding[3]=lc[3];
