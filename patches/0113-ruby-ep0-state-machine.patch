+/* Vendor IN request 0xC0/0x27: EP0 state machine counters. */
+static void
+ruby_ep0_vendor_ep0_diag(vm_offset_t mac, uint32_t t, uint32_t wlen)
+{
+    uint32_t v[16];
+
+    v[0] = 0x44305045u;         /* "EP0D" */
+    v[1] = ruby_ep0_setups;
+    v[2] = ruby_ep0_short;
+    v[3] = ruby_ep0_long;
+    v[4] = ruby_ep0_txpkts;
+    v[5] = ruby_ep0_dataends;
+    v[6] = ruby_ep0_sentstalls;
+    v[7] = ruby_ep0_rewinds;
+    v[8] = ruby_bus_resets;
+    v[9] = (ruby_config & 0xffu) | ((ruby_ep_ready & 1u) << 8) |
+        ((ruby_rx_ready & 1u) << 9);
+    v[10] = ruby_rd32(mac, EP0CSR_OFF);
+    v[11] = ruby_rd32(mac, EPISR_OFF);
+    v[12] = (ruby_ep0_tx_pending & 1u) |
+        ((ruby_ep0_tx_sent & 0xffffu) << 8);
+    v[13] = (ruby_ep0_tx_total & 0xffffu) |
+        ((ruby_ep0_tx_waits & 0xffffu) << 16);
+    v[14] = ruby_ep0_fifo_waits;
+    v[15] = ruby_ms;
+    ruby_ep0_send(mac, t, 0xc027, (const uint8_t *)v, sizeof(v), wlen);
+}
+
+/* Vendor IN request 0xC0/0x28: 200-byte pattern for the >64B path. */
+static void
+ruby_ep0_vendor_ep0_bulk(vm_offset_t mac, uint32_t t, uint32_t wlen)
+{
+    uint8_t pat[200];
+    uint32_t i;
+
+    for (i = 0; i < sizeof(pat); i++)
+        pat[i] = (uint8_t)(0xa5u ^ (i & 0xffu));
+    ruby_ep0_send(mac, t, 0xc028, pat, sizeof(pat), wlen);
+}
