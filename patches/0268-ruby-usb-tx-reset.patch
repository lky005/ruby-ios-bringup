+                        ruby_tx_mtr_add(RUBY_MTR_TX_RESET,
+                            (uint16_t)ruby_gpd_deq, ruby_inflight,
+                            ruby_rd32(mac, TX1CSR0_OFF));
+                        printf("RUBY USB TXRESET n=%u deq=%u enq=%u "
+                            "inf=%u tx0=%08x tqcsr=%08x\n",
