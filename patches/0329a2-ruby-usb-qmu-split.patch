diff --git a/bsd/dev/ruby_usb_qmu.c b/bsd/dev/ruby_usb_qmu.c
new file mode 100644
index 0000000..42b9c2f
--- /dev/null
+++ b/bsd/dev/ruby_usb_qmu.c
@@ -0,0 +1,305 @@
+/*
+ * 0329a2: L3 QMU ring ownership moved verbatim from ruby_usb.c.
+ *
+ * The GPD ring pages, their physical addresses and uncached aliases, the
+ * cache/GPD primitives and the QMU slot math move here unchanged.  The
+ * producer/drain state machine and every register write stay in
+ * ruby_usb.c, so this slice is a pure relocation and the default build
+ * must keep the 0329a behaviour.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+
+#include "ruby_hal.h"
+#include "ruby_usb_qmu.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+/* Boot-tunable ring sizes still defined in ruby_usb.c. */
+extern uint32_t ruby_tx_ring_n;
+extern uint32_t ruby_rx_ring_n;
+
+uint32_t ruby_tq_cpr_off = 0x0518;
+uint32_t ruby_tq_hiar_off = 0x0484;
+
+#define RUBY_RX_GPD_NUM 16
+#define RUBY_RX_GPD_RING_SZ (RUBY_RX_GPD_NUM * 16u)
+#define RUBY_RX_PAGE_SIZE (1u << 14)   /* PAGE_MAX_SHIFT: exclusive 16 KB page */
+
+/*
+ * 0299: RX GPD declared buflen is runtime (ruby_rx_buf_size, boot-arg
+ * ruby_rxbuf, default 512 = wMaxPacketSize).  docs/113 pinned the
+ * full-packet choke: a transfer of exactly one MPS (no short tail) never
+ * settles a 16384-declared GPD (neither short-packet nor bytes==buflen),
+ * so the RX queue wedged into the undocumented rqcsr=0x00078500 state.
+ * 512 makes the full-packet case settle on the buflen condition; larger
+ * transfers span GPDs at 512-byte granularity ? vendor mtu3_qmu.c:300
+ * declares buflen = req->length the same way.  Physical slot storage
+ * stays 16 KiB so ruby_rxbuf=16384 restores the 0261 behaviour for A/B.
+ */
+#define RUBY_RX_BUF_MAX 16384
+
+#define RUBY_GPD_NUM    64
+#define RUBY_GPD_DESC   16
+/*
+ * 0201: vendor mtu3 uses a contiguous 16-byte GPD ring (docs/82 item 3,
+ * never tested until now).  The ring stays 64 slots = 1 KB, inside one
+ * page; four GPDs now share a 64-byte cache line, which is safe because
+ * the same-line neighbours of a published GPD are always in the free
+ * region (64 slots - 16 in-flight) and the whole-ring clean+read at the
+ * top of the push path re-loads those lines from DRAM first.
+ */
+#define RUBY_GPD_STRIDE 16
+#define RUBY_GPD_RING_SZ (RUBY_GPD_NUM * RUBY_GPD_STRIDE)
+
+uint8_t ruby_gpd_ring[RUBY_GPD_RING_SZ] __attribute__((aligned(4096)));
+
+uint32_t ruby_gpd_enq;
+uint32_t ruby_gpd_deq;
+
+uint32_t ruby_inflight;
+
+uint64_t ruby_gpd_pa[RUBY_GPD_NUM];
+uint64_t ruby_ring_pa;
+/*
+ * 0204: CPU access to the TX GPD ring.  With rubydmauc=1 the ring
+ * is also mapped uncached; every CPU access then goes through that
+ * alias.  The cached BSS alias is touched once, to clean it before
+ * the switch, and never afterwards.  The QMU always uses
+ * ruby_ring_pa.
+ */
+uint8_t *ruby_gpd_ring_cpu = ruby_gpd_ring;
+vm_offset_t ruby_gpd_ring_uc;
+void *ruby_gpd_ring_alloc;
+int ruby_dma_uc;
+#define RUBY_GPD_SLOT(i) (ruby_gpd_ring_cpu + (i) * RUBY_GPD_STRIDE)
+
+/*
+ * 0310: RX GPD ring ownership.  ruby_rxuc=1 (default) maps the ring's own
+ * PAGE_MAX_SHIFT (16 KB) BSS page as an uncached alias: the page holds the
+ * 256 B ring plus explicit padding and nothing else, so the QMU keeps the
+ * same physical ring address that worked in 0309 while the CPU never
+ * shares a cache line with DMA.  ruby_rxuc=0 keeps the cached BSS path for
+ * A/B.  All ring mutations and the diagnostic snapshot are workloop-only.
+ * The 1ms EP0 thread reads the seqlock snapshot (and the read-only
+ * 0xC0/0x23/24 diag may read the ring); it never mutates the ring or runs
+ * dc civac on the UC alias.
+ */
+struct ruby_rx_gpd_page {
+    uint8_t ring[RUBY_RX_GPD_RING_SZ];
+    uint8_t pad[RUBY_RX_PAGE_SIZE - RUBY_RX_GPD_RING_SZ];
+};
+static struct ruby_rx_gpd_page ruby_rx_gpd_store
+    __attribute__((aligned(RUBY_RX_PAGE_SIZE)));
+#define ruby_rx_gpd_ring (ruby_rx_gpd_store.ring)
+uint8_t *ruby_rx_gpd_ring_cpu = ruby_rx_gpd_ring;
+vm_offset_t ruby_rx_gpd_ring_uc;
+int ruby_rx_uc = 1;
+volatile uint32_t ruby_rx_snap_seq;
+volatile uint32_t ruby_rx_snap_hwo;
+volatile uint32_t ruby_rx_snap_cur;
+uint32_t ruby_rx_snap_bad;
+uint8_t ruby_rx_buf[RUBY_RX_GPD_NUM][RUBY_RX_BUF_MAX]
+    __attribute__((aligned(4096)));
+uint64_t ruby_rx_gpd_pa[RUBY_RX_GPD_NUM];
+uint64_t ruby_rx_buf_pa[RUBY_RX_GPD_NUM];
+uint64_t ruby_rx_ring_pa;
+uint32_t ruby_rx_deq;
+volatile uint32_t ruby_rx_ready;
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern pmap_t kernel_pmap;
+
+uint64_t
+ruby_dma_pa(const void *va)
+{
+    ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)(uintptr_t)va);
+
+    if (!pn)
+        return 0;
+    return ptoa_64(pn) + ((uintptr_t)va & (PAGE_SIZE - 1));
+}
+
+void
+ruby_dc_civac(const void *va, uint32_t len)
+{
+    uintptr_t p = (uintptr_t)va & ~(uintptr_t)63;
+    uintptr_t e = (uintptr_t)va + len;
+
+    /* 0263: stores must reach the cache before the clean/invalidate. */
+    __asm__ volatile("dsb sy" ::: "memory");
+    for (; p < e; p += 64)
+        __asm__ volatile("dc civac, %0" :: "r"(p) : "memory");
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+ruby_dma_wmb(void)
+{
+    __asm__ volatile("dmb sy" ::: "memory");
+}
+
+void
+ruby_dma_mb(void)
+{
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+
+uint8_t
+ruby_gpd_chksum(uint8_t *g)
+{
+    /*
+     * 0248: vendor GPD trace (mtu3_prepare_gpd) shows dw0 byte1 = 0x00 on
+     * every working ep3in/ep2out descriptor: this kernel leaves the
+     * checksum byte zero (validation off).  A non-zero byte made the QMU
+     * silently skip descriptors after the first one.  Match the vendor.
+     */
+    (void)g;
+    return 0;
+}
+
+void
+ruby_gpd_clear(uint32_t i)
+{
+    uint8_t *g = RUBY_GPD_SLOT(i);
+    uint32_t k;
+
+    for (k = 0; k < RUBY_GPD_DESC; k++)
+        g[k] = 0;
+}
+
+uint32_t
+ruby_ep2_cur_slot(vm_offset_t mac)
+{
+    uint64_t cur_pa;
+    uint32_t txcpr, txhiar;
+
+    txcpr = ruby_rd32(mac, TQCPR1_OFF);
+    txhiar = ruby_rd32(mac, TQHIAR1_OFF);
+    cur_pa = ((uint64_t)((txhiar >> 8) & 0xfu) << 32) | txcpr;
+    if (cur_pa < ruby_ring_pa ||
+        cur_pa >= ruby_ring_pa + RUBY_GPD_RING_SZ)
+        return 0xffu;
+    return (uint32_t)((cur_pa - ruby_ring_pa) / RUBY_GPD_STRIDE);
+}
+
+uint64_t
+ruby_ep2_hwo_bits(void)
+{
+    uint64_t hwo = 0;
+    uint32_t i;
+
+    if (!ruby_dma_uc)
+        ruby_dc_civac(ruby_gpd_ring, RUBY_GPD_RING_SZ);
+    for (i = 0; i < ruby_tx_ring_n; i++)
+        if (RUBY_GPD_SLOT(i)[0] & 1u)
+            hwo |= 1ull << i;
+    return hwo;
+}
+
+uint32_t
+ruby_popcount64(uint64_t v)
+{
+    uint32_t n = 0;
+
+    while (v) {
+        n += (uint32_t)(v & 1u);
+        v >>= 1;
+    }
+    return n;
+}
+
+uint32_t
+ruby_ep2_ring_dist(uint32_t from, uint32_t to)
+{
+    return (to + ruby_tx_ring_n - from) % ruby_tx_ring_n;
+}
+
+/*
+ * 0310: set up the RX GPD ring.  ruby_rxuc=1 maps the ring's own 4 KB BSS
+ * page as an uncached alias (same physical address as 0309; the ring
+ * occupies the first 256 B and the tail is padding).  ruby_rxuc=0 keeps
+ * the legacy cached BSS ring for zero-build A/B.  Returns 1 when
+ * ruby_rx_ring_pa is valid.
+ */
+int
+ruby_rx_ring_setup(void)
+{
+    if (ruby_rx_gpd_ring_uc) {
+        ruby_rx_gpd_ring_cpu = (uint8_t *)ruby_rx_gpd_ring_uc;
+        return ruby_rx_ring_pa != 0;
+    }
+    if (ruby_rx_uc) {
+        uint64_t pa = ruby_dma_pa(ruby_rx_gpd_ring);
+        vm_offset_t uc;
+
+        if (pa && !(pa & (PAGE_SIZE - 1u))) {
+            /* clean the cached alias of the whole exclusive page */
+            ruby_dc_civac(&ruby_rx_gpd_store, RUBY_RX_PAGE_SIZE);
+            uc = ml_io_map((vm_offset_t)pa, PAGE_SIZE);
+            if (uc) {
+                ruby_rx_ring_pa = pa;
+                ruby_rx_gpd_ring_uc = uc;
+                ruby_rx_gpd_ring_cpu = (uint8_t *)uc;
+                return 1;
+            }
+            printf("RUBY USB: 0310 rx ring uc map failed pa=0x%llx\n",
+                (unsigned long long)pa);
+        } else {
+            printf("RUBY USB: 0310 rx ring pa bad 0x%llx\n",
+                (unsigned long long)pa);
+        }
+        ruby_rx_uc = 0;
+    }
+    ruby_rx_gpd_ring_cpu = ruby_rx_gpd_ring;
+    ruby_rx_ring_pa = ruby_dma_pa(ruby_rx_gpd_ring);
+    return ruby_rx_ring_pa != 0;
+}
+
+uint32_t
+ruby_ep2_rx_cur_slot(vm_offset_t mac)
+{
+    uint64_t cur_pa;
+    uint32_t rqcpr, rqhiar;
+
+    rqcpr = ruby_rd32(mac, RQCPR1_OFF);
+    rqhiar = ruby_rd32(mac, RQHIAR1_OFF);
+    cur_pa = ((uint64_t)((rqhiar >> 8) & 0xfu) << 32) | rqcpr;
+    if (cur_pa < ruby_rx_ring_pa ||
+        cur_pa >= ruby_rx_ring_pa + (ruby_rx_ring_n * 16u))
+        return 0xffu;
+    return (uint32_t)((cur_pa - ruby_rx_ring_pa) / 16u);
+}
+
+/*
+ * 0310: RX ring snapshot, workloop-only.  The seqlock lets the 1ms
+ * heartbeat read HWO/cur without touching the ring; a stuck odd sequence
+ * is counted by the reader (ruby_rx_snap_bad).
+ */
+void
+ruby_rx_snapshot_update(vm_offset_t mac)
+{
+    uint32_t i, hwo = 0, cur;
+
+    if (!ruby_rx_ready)
+        return;
+    if (!ruby_rx_uc)
+        ruby_dc_civac(ruby_rx_gpd_ring_cpu, RUBY_RX_GPD_RING_SZ);
+    for (i = 0; i < ruby_rx_ring_n; i++)
+        if (ruby_rx_gpd_ring_cpu[i * 16] & 1u)
+            hwo |= 1u << i;
+    cur = ruby_ep2_rx_cur_slot(mac);
+    ruby_rx_snap_seq++;
+    __asm__ volatile("dmb sy" ::: "memory");
+    ruby_rx_snap_hwo = hwo;
+    ruby_rx_snap_cur = cur;
+    __asm__ volatile("dmb sy" ::: "memory");
+    ruby_rx_snap_seq++;
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
