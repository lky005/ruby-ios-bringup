+extern uint32_t ruby_gpd_deq;
+extern uint32_t ruby_inflight;
+
+#define RUBY_GPD_SLOT(i) (ruby_gpd_ring_cpu + (i) * RUBY_GPD_STRIDE)
+
+/* RX GPD ring and payload state shared with the drain path. */
+extern uint8_t *ruby_rx_gpd_ring_cpu;
+extern vm_offset_t ruby_rx_gpd_ring_uc;
+extern int ruby_rx_uc;
