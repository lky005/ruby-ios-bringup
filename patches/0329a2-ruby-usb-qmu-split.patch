+extern uint64_t ruby_rx_gpd_pa[RUBY_RX_GPD_NUM];
+extern uint64_t ruby_rx_buf_pa[RUBY_RX_GPD_NUM];
+extern uint64_t ruby_rx_ring_pa;
+extern uint32_t ruby_rx_deq;
+extern volatile uint32_t ruby_rx_ready;
