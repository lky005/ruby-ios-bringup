+    ruby_wr32(mac, TX1CSR0_OFF,
+        ruby_rd32(mac, TX1CSR0_OFF) | TX_FLUSHFIFO);
+    for (i = 0; i < 500; i++) {
         if (!(ruby_rd32(mac, TQCSR1_OFF) & QMU_Q_ACTIVE))
             break;
-        delay(10);
+        delay(100);
+    }
+    ruby_wr32(mac, TX1CSR0_OFF,
+        ruby_rd32(mac, TX1CSR0_OFF) | TX_FLUSHFIFO);
+    for (i = 0; i < 100; i++) {
+        if (ruby_rd32(mac, TX1CSR0_OFF) & TX_FIFOEMPTY)
+            break;
+        delay(100);
     }
     ruby_wr32(mac, EP_RST_OFF, EP_RST_TX1_BIT);
     ruby_wr32(mac, EP_RST_OFF, 0);
@@ -2901,7 +2912,6 @@ ruby_ep2_tx_force(vm_offset_t mac)
     ruby_wr32(mac, QCR1_OFF, ruby_rd32(mac, QCR1_OFF) | (1u << 1));
     ruby_wr32(mac, TQERRIESR0_OFF,
