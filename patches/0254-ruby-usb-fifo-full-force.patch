-    ruby_ep2_tx_fifo_drain(mac);
     ruby_wr32(mac, TQSAR1_OFF, (uint32_t)pa);
     ruby_wr32(mac, TQHIAR1_OFF, (uint32_t)((pa >> 32) & 0xfu));
     ruby_wr32(mac, TQCSR1_OFF, QMU_Q_START);
@@ -2919,7 +2929,9 @@ ruby_ep2_tx_watchdog(vm_offset_t mac)
         return;
     ruby_ep2_tx_kick_ms = ruby_ms;
     if (ruby_inflight == 0) {
-        ruby_ep2_tx_fifo_drain(mac);
+        /* 0254: FLUSHFIFO without STOP is ignored while the QMU owns the
+         * FIFO; use the full stop/flush/start sequence instead. */
+        ruby_ep2_tx_force(mac);
         ruby_ep2_tx_kicks++;
         return;
     }
