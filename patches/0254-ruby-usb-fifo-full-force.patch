@@ -2882,11 +2882,22 @@ ruby_ep2_tx_force(vm_offset_t mac)
     uint64_t pa = ruby_gpd_pa[ruby_gpd_deq % RUBY_GPD_NUM];
     uint32_t i;
 
+    /* 0254: vendor stop order -- STOP, FLUSHFIFO, wait ACTIVE clear,
+     * FLUSHFIFO again, wait FIFOEMPTY; only then touch the endpoint. */
     ruby_wr32(mac, TQCSR1_OFF, QMU_Q_STOP);
