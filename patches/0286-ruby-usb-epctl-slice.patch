diff --git a/bsd/dev/ruby_usb.c b/bsd/dev/ruby_usb.c
index 4d0372c..19efb81 100644
--- a/bsd/dev/ruby_usb.c
+++ b/bsd/dev/ruby_usb.c
@@ -5017,6 +5017,7 @@ ruby_usb_heartbeat(vm_offset_t mac, vm_offset_t ippc)
     static uint32_t next_ms, last_otg, last_mac2;
     static int last_ext, primed;
     static int usb2_rt_dumped;
+    static int epctl_rt_dumped;
     uint32_t otg = ruby_rd32(ippc, IPPC_OTG_STS_OFF);
     uint32_t mac2 = ruby_rd32(mac, MAC2_INTR_STATUS_OFF);
     uint32_t seq = ruby_battery_poll_seq();
@@ -5100,6 +5101,21 @@ ruby_usb_heartbeat(vm_offset_t mac, vm_offset_t ippc)
                 off, ruby_rd32(mac, off), ruby_rd32(mac, off + 4),
                 ruby_rd32(mac, off + 8), ruby_rd32(mac, off + 0xc));
     }
+    /* 0286: one-shot runtime EPCTL / MAC CSR slices for the vendor
+     * comparison; read-only, same first-configured trigger. */
+    if (!epctl_rt_dumped && ruby_cfg_seen) {
+        epctl_rt_dumped = 1;
+        printf("RUBY USB EPCTL RT 0800..0830:\n");
+        for (off = 0x0800; off <= 0x0830; off += 0x10)
+            printf("RUBY USB EPCTLR %04x: %08x %08x %08x %08x\n",
+                off, ruby_rd32(mac, off), ruby_rd32(mac, off + 4),
+                ruby_rd32(mac, off + 8), ruby_rd32(mac, off + 0xc));
+        printf("RUBY USB MACCSR RT 1400..1430:\n");
+        for (off = 0x1400; off <= 0x1430; off += 0x10)
+            printf("RUBY USB MACCSRR %04x: %08x %08x %08x %08x\n",
+                off, ruby_rd32(mac, off), ruby_rd32(mac, off + 4),
+                ruby_rd32(mac, off + 8), ruby_rd32(mac, off + 0xc));
+    }
     if (ruby_irq_mode) {
         if (ruby_qmu_irq_mode)
             printf("RUBY USB IRQ: pass=%u mac2=%u bmu=%u qmu=%u "
@@ -6073,6 +6089,19 @@ ruby_usb_probe(void)
             off, ruby_rd32(mac, off), ruby_rd32(mac, off + 4),
             ruby_rd32(mac, off + 8), ruby_rd32(mac, off + 0xc));
 
+    /* 0286: read-only EPCTL / MAC CSR init slices, same windows the
+     * vendor peek dumps at runtime. */
+    printf("RUBY USB EPCTL INIT 0800..0830:\n");
+    for (off = 0x0800; off <= 0x0830; off += 0x10)
+        printf("RUBY USB EPCTLI %04x: %08x %08x %08x %08x\n",
+            off, ruby_rd32(mac, off), ruby_rd32(mac, off + 4),
+            ruby_rd32(mac, off + 8), ruby_rd32(mac, off + 0xc));
+    printf("RUBY USB MACCSR INIT 1400..1430:\n");
+    for (off = 0x1400; off <= 0x1430; off += 0x10)
+        printf("RUBY USB MACCSRI %04x: %08x %08x %08x %08x\n",
+            off, ruby_rd32(mac, off), ruby_rd32(mac, off + 4),
+            ruby_rd32(mac, off + 8), ruby_rd32(mac, off + 0xc));
+
     /* 0185/0272: the vendor runs with bit21 clear; the old noise quirk
      * stays behind ruby_noise=1 for A/B. */
     v = ruby_rd32(mac, BUS_PERFORMANCE - MTU3_PA);
