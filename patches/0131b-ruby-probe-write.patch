diff --git a/bsd/dev/ruby_usb.c b/bsd/dev/ruby_usb.c
--- a/bsd/dev/ruby_usb.c
+++ b/bsd/dev/ruby_usb.c
@@ -2913,6 +2913,17 @@
     }
     ruby_probe_wr_pa = pa;
     ruby_probe_wr_pending = 1;
+    /*
+     * 0131b: acknowledge the SETUP without DATAEND so the 4-byte OUT data
+     * stage can arrive.  Without this the host stalled the control transfer
+     * (EPIPE) before ruby_ep0_service() ever saw EP0_RXPKTRDY.
+     */
+    {
+        uint32_t csr = ruby_rd32(mac, EP0CSR_OFF) & EP0_W1C_BITS;
+
+        csr |= EP0_SETUPPKTRDY;
+        ruby_wr32(mac, EP0CSR_OFF, csr);
+    }
 }
 
