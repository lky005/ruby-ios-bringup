@@ -3248,6 +3259,8 @@
     PE_parse_boot_argn("rubyusb", &enable, sizeof(enable));
     PE_parse_boot_argn("rubyprobe", &probe, sizeof(probe));
     ruby_probe_enabled = (probe == 1);
+    printf("RUBY USB: probe writes %s\n",
+        ruby_probe_enabled ? "enabled" : "locked");
     if (enable != 1) {
         printf("RUBY USB: disabled (rubyusb=%d)\n", enable);
         return;
