+/*
+ * The secure monitor must tell us the group: with GICD_CTLR.DS=0 the NS
+ * view of GICD_IGROUPR is RAZ/WI and cannot be used to adjudicate.
+ */
+static long
+ruby_irq_smc_dump(uint32_t intid, uint64_t *raw)
+{
+	register uint64_t x0 __asm__("x0") = RUBY_IRQ_SMC_GIC_DUMP;
+	register uint64_t x1 __asm__("x1") = intid;
+
+	__asm__ volatile(
+	    "mov x2, xzr\n\t"
+	    "mov x3, xzr\n\t"
+	    "mov x4, xzr\n\t"
+	    "mov x5, xzr\n\t"
+	    "mov x6, xzr\n\t"
+	    "mov x7, xzr\n\t"
+	    "smc #0\n\t"
+	    : "+r"(x0), "+r"(x1)
+	    :
+	    : "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10",
+	      "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	*raw = x0;
+	return (long)x0;
+}
