+    v[2] = ruby_reenter_cnt;
+    v[3] = ruby_scan_active;
+    v[4] = ruby_scan_mutate_x;
+    v[5] = ruby_scan_skipped;
+    v[6] = ruby_lock_waits;
+    v[7] = ruby_rxwd_kicks;
+    v[8] = ruby_rxwd_restarts;
+    v[9] = ruby_rx_last_progress_pk;
