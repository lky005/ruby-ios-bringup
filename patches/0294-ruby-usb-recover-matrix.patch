+static boolean_t
+ruby_qmu_enter(void)
+{
+    boolean_t irq = FALSE;
+
+    if (ruby_lock_mode == 1)
+        irq = ml_set_interrupts_enabled(FALSE);
+    else if (ruby_lock_mode == 2 && ruby_qmu_lock_inited) {
+        lck_spin_lock(&ruby_qmu_lock);
+        ruby_lock_waits++;
+    }
+    if (ruby_owner_en)
+        ruby_crit_enter();
+    return irq;
+}
+
+static void
+ruby_qmu_exit(boolean_t irq)
+{
+    if (ruby_owner_en)
+        ruby_crit_exit();
+    if (ruby_lock_mode == 1)
+        ml_set_interrupts_enabled(irq);
+    else if (ruby_lock_mode == 2 && ruby_qmu_lock_inited)
+        lck_spin_unlock(&ruby_qmu_lock);
+}
