+/* 0294: ownership probes and optional QMU critical section.  The probes
+ * are counters only; ruby_lock=1/2 adds interrupts-off or a spinlock at
+ * the GPD publish / ring reset sites (never across delay()). */
+static void
+ruby_crit_enter(void)
+{
+    uint32_t prev = __sync_fetch_and_add(&ruby_crit_depth, 1);
+
+    if (prev != 0)
+        __sync_fetch_and_add(&ruby_reenter_cnt, 1);
+    if (ruby_scan_active)
+        __sync_fetch_and_add(&ruby_scan_mutate_x, 1);
+}
+
+static void
+ruby_crit_exit(void)
+{
+    __sync_fetch_and_sub(&ruby_crit_depth, 1);
+}
+
+static void
+ruby_scan_enter(void)
+{
+    if (ruby_crit_depth)
+        __sync_fetch_and_add(&ruby_scan_mutate_x, 1);
+    __sync_lock_test_and_set(&ruby_scan_active, 1);
+}
+
+static void
+ruby_scan_exit(void)
+{
+    __sync_lock_release(&ruby_scan_active);
+}
