+/*
+ * 0294: RX watchdog.  Traffic-gated (200 ms of no new packet), never on
+ * an idle endpoint; mode 3 is rate-limited to 1 s and 5 tries.
+ */
+static void
+ruby_rx_watchdog(vm_offset_t mac)
+{
+    if (!ruby_rx_ready || ruby_rxwd_mode == 0)
+        return;
+    if (ruby_rx_packets != ruby_rx_last_progress_pk) {
+        ruby_rx_last_progress_pk = ruby_rx_packets;
+        ruby_rx_last_progress_ms = ruby_ms;
+        ruby_rx_seen_traffic = 1;
+        ruby_rxwd_tries = 0;
+        return;
+    }
+    if (!ruby_rx_seen_traffic ||
+        (uint32_t)(ruby_ms - ruby_rx_last_progress_ms) < 200)
+        return;
+    if (ruby_qmu_irq_mode) {
+        static uint32_t req_ms;
+
+        if ((uint32_t)(ruby_ms - req_ms) >= 200) {
+            req_ms = ruby_ms;
+            ruby_qmu_rxwd_req = 1;
+            ruby_usb_irq_kick();
+        }
+        return;
+    }
+    ruby_rxwd_act(mac);
+}
