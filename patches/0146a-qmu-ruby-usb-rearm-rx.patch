+/*
+ * 0146a-qmu: the RX QMU owns its ring just like TX.  Wait for ACTIVE to
+ * clear before any EP_RST or GPD rewrite; a timeout leaves the ring alone
+ * so a later rearm/config can retry instead of corrupting live DMA.
+ */
+static int
+ruby_ep2_rx_qmu_stop(vm_offset_t mac)
+{
+    uint32_t i;
+
+    if (ruby_rd32(mac, RQCSR2_OFF) & QMU_Q_ACTIVE)
+        ruby_wr32(mac, RQCSR2_OFF, QMU_Q_STOP);
+    for (i = 0; i < RUBY_EP2_STOP_SPINS; i++) {
+        if (!(ruby_rd32(mac, RQCSR2_OFF) & QMU_Q_ACTIVE))
+            return 0;
+        delay(RUBY_EP2_STOP_SPIN_US);
+    }
+    ruby_ep2_stop_timeouts++;
+    if (ruby_ep2_stop_timeouts <= 3 ||
+        (ruby_ep2_stop_timeouts & 0x3f) == 0)
+        printf("RUBY USB: EP2 RX stop timeout timeouts=%u\n",
+            ruby_ep2_stop_timeouts);
+    return -1;
+}
