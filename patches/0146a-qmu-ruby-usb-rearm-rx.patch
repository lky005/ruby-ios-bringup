+/*
+ * 0146a-qmu: vendor parity for a corrupt RX GPD/queue: stop with a bounded
+ * wait, clear the error latches, then reset/re-arm/start the ring.  Never
+ * mark the live GPD BPS: the QMU may still own it.
+ */
+static void
+ruby_ep2_rx_recover(vm_offset_t mac)
+{
+    uint32_t err;
+
+    if (ruby_ep2_rx_qmu_stop(mac) != 0)
+        return;
+    err = ruby_rd32(mac, RQERRIR0_OFF);
+    if (err)
+        ruby_wr32(mac, RQERRIR0_OFF, err);
+    err = ruby_rd32(mac, RQERRIR1_OFF);
+    if (err)
+        ruby_wr32(mac, RQERRIR1_OFF, err);
+    ruby_ep2_rx_reset(mac, 0);
+}
