+};
+
+static vm_offset_t
+ruby_probe_lookup(uint32_t pa, uint32_t len, const char **name)
+{
+    uint32_t i;
+
+    if (pa & 3u)
+        return 0;
+    for (i = 0; i < sizeof(ruby_probe_regions) /
+        sizeof(ruby_probe_regions[0]); i++) {
+        struct ruby_probe_region *r = &ruby_probe_regions[i];
+
+        if (r->va == NULL || *r->va == 0)
+            continue;
+        if (pa < r->pa || len > r->size || pa - r->pa > r->size - len)
+            continue;
+        if (name)
+            *name = r->name;
+        return *r->va + (pa - r->pa);
+    }
+    return 0;
+}
+
+static int
+ruby_probe_read32(uint32_t pa, uint32_t *out)
+{
+    vm_offset_t va = ruby_probe_lookup(pa, 4, NULL);
+
+    if (!va)
+        return 0;
+    *out = ruby_rd32(va, 0);
+    return 1;
+}
+
+static int
+ruby_probe_write32(uint32_t pa, uint32_t val)
+{
+    vm_offset_t va = ruby_probe_lookup(pa, 4, NULL);
+
+    if (!va)
+        return 0;
+    ruby_wr32(va, 0, val);
+    return 1;
+}
