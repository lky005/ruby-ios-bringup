+static const char *
+ruby_skip_spaces(const char *s)
+{
+    while (*s == ' ' || *s == '\t')
+        s++;
+    return s;
+}
+
+static int
+ruby_parse_u32(const char **sp, uint32_t *out)
+{
+    const char *s = ruby_skip_spaces(*sp);
+    uint64_t v = 0;
+    uint32_t base = 10, digits = 0;
+
+    if (s[0] == '0' && (s[1] == 'x' || s[1] == 'X')) {
+        base = 16;
+        s += 2;
+    }
+    for (;;) {
+        uint32_t d;
+
+        if (*s >= '0' && *s <= '9')
+            d = (uint32_t)(*s - '0');
+        else if (base == 16 && *s >= 'a' && *s <= 'f')
+            d = (uint32_t)(*s - 'a' + 10);
+        else if (base == 16 && *s >= 'A' && *s <= 'F')
+            d = (uint32_t)(*s - 'A' + 10);
+        else
+            break;
+        if (v > 0xffffffffull / base)
+            return 0;
+        v = v * base + d;
+        if (v > 0xffffffffull)
+            return 0;
+        digits++;
+        s++;
+    }
+    if (!digits)
+        return 0;
+    *sp = s;
+    *out = (uint32_t)v;
+    return 1;
+}
+
+static void
+ruby_cmd_r32(uint32_t pa)
+{
+    uint32_t v;
+
+    if (!ruby_probe_read32(pa, &v)) {
+        printf("RUBY CMD: err: unmapped %08x\n", pa);
+        return;
+    }
+    printf("RUBY CMD: r32[%08x]=%08x\n", pa, v);
+}
+
+static void
+ruby_cmd_w32(uint32_t pa, uint32_t val)
+{
+    uint32_t rb;
+
+    if (!ruby_probe_enabled) {
+        printf("RUBY CMD: err: probe locked\n");
+        return;
+    }
+    if (!ruby_probe_write32(pa, val)) {
+        printf("RUBY CMD: err: unmapped %08x\n", pa);
+        return;
+    }
+    (void)ruby_probe_read32(pa, &rb);
+    ruby_seq("PROBE_W32", pa, val);
+    printf("RUBY CMD: w32[%08x]=%08x -> %08x\n", pa, val, rb);
+}
+
+static void
+ruby_cmd_dump(uint32_t pa, uint32_t count)
+{
+    const char *name = NULL;
+    uint32_t i;
+
+    if (count == 0 || count > 64) {
+        printf("RUBY CMD: err: dump count 1..64\n");
+        return;
+    }
+    if (!ruby_probe_lookup(pa, count * 4u, &name)) {
+        printf("RUBY CMD: err: unmapped %08x+%u\n", pa, count * 4u);
+        return;
+    }
+    printf("RUBY CMD: dump %s\n", name ? name : "?");
+    for (i = 0; i < count; i += 4) {
+        uint32_t v0 = 0, v1 = 0, v2 = 0, v3 = 0;
+        (void)ruby_probe_read32(pa + (i + 0u) * 4u, &v0);
+        if (i + 1u < count)
+            (void)ruby_probe_read32(pa + (i + 1u) * 4u, &v1);
+        if (i + 2u < count)
+            (void)ruby_probe_read32(pa + (i + 2u) * 4u, &v2);
+        if (i + 3u < count)
+            (void)ruby_probe_read32(pa + (i + 3u) * 4u, &v3);
+        printf("RUBY CMD: dump[%08x] %08x %08x %08x %08x\n",
+            pa + i * 4u, v0, v1, v2, v3);
+    }
+}
