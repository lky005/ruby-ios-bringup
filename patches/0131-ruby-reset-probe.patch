 /*
+ * Vendor IN 0xC0/0x2C: safe 32-bit MMIO read.
+ *   wValue = address bits 0-15, wIndex = bits 16-31, wLength = 4.
+ * Only the mapped/whitelisted regions are accepted.
+ */
+static void
+ruby_ep0_vendor_probe_read(vm_offset_t mac, uint32_t t, uint32_t value,
+    uint32_t index, uint32_t wlen)
+{
+    uint32_t pa = ((index & 0xffffu) << 16) | (value & 0xffffu);
+    uint32_t v;
+
+    if (wlen != 4 || !ruby_probe_read32(pa, &v)) {
+        ruby_ep0_stall(mac, t, 0xc02c, wlen);
+        return;
+    }
+    ruby_ep0_send(mac, t, 0xc02c, (const uint8_t *)&v, 4, wlen);
+}
+
+/*
+ * Vendor OUT 0x40/0x2D: safe 32-bit MMIO write.
+ *   wValue/wIndex = address, 4-byte data stage follows.
+ * The setup only latches the address; ruby_ep0_service() consumes the data
+ * stage, performs the write and ACKs.  Writes are locked unless rubyprobe=1.
+ */
+static void
+ruby_ep0_vendor_probe_write(vm_offset_t mac, uint32_t t, uint32_t value,
+    uint32_t index, uint32_t wlen)
+{
+    uint32_t pa = ((index & 0xffffu) << 16) | (value & 0xffffu);
+
+    if (!ruby_probe_enabled || wlen != 4 ||
+        !ruby_probe_lookup(pa, 4, NULL)) {
+        ruby_ep0_stall(mac, t, 0xc02d, wlen);
+        return;
+    }
+    ruby_probe_wr_pa = pa;
+    ruby_probe_wr_pending = 1;
+}
