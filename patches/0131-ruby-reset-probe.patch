+struct ruby_probe_region {
+    uint32_t pa;
+    uint32_t size;
+    vm_offset_t *va;
+    const char *name;
+};
+
+static struct ruby_probe_region ruby_probe_regions[] = {
+    { MTU3_PA, MTU3_SIZE, &ruby_mac_base, "mtu3" },
+    { IPPC_PA, IPPC_SIZE, &ruby_ippc_base, "ippc" },
+    { PHY_PA, PHY_SIZE, &ruby_phy_base, "phy" },
