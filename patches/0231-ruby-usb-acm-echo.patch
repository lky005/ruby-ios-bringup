+/*
+ * 0231: ACM raw echo ring.  The RX service copies each 0x01 OUT packet here;
+ * the TX producer below drains it into GPDs with no log framing, so the host
+ * reads back exactly the bytes it wrote.  Producer (RX drain) and consumer
+ * (push) run on the same owner: the QMU workloop, or the 1 ms tick when
+ * rubyqmuirq=0.
+ */
+#define RUBY_ACM_ECHO_SIZE 8192u
+static uint8_t ruby_acm_echo_buf[RUBY_ACM_ECHO_SIZE];
+static volatile uint32_t ruby_acm_echo_head;
+static volatile uint32_t ruby_acm_echo_tail;
+static uint32_t ruby_acm_echo_bytes;
+static uint32_t ruby_acm_echo_drops;
+
+static uint32_t
+ruby_acm_echo_space(void)
+{
+    return RUBY_ACM_ECHO_SIZE -
+        (ruby_acm_echo_head - ruby_acm_echo_tail);
+}
+
+static void
+ruby_acm_echo_enqueue(const uint8_t *data, uint32_t len)
+{
+    uint32_t off, first;
+
+    if (len == 0)
+        return;
+    if (len > ruby_acm_echo_space()) {
+        ruby_acm_echo_drops += len;
+        return;
+    }
+    off = ruby_acm_echo_head % RUBY_ACM_ECHO_SIZE;
+    first = RUBY_ACM_ECHO_SIZE - off;
+    if (first > len)
+        first = len;
+    memcpy(&ruby_acm_echo_buf[off], data, first);
+    if (len > first)
+        memcpy(&ruby_acm_echo_buf[0], data + first, len - first);
+    ruby_acm_echo_bytes += len;
+    ruby_dma_wmb();
+    ruby_acm_echo_head += len;
+}
+
+static uint32_t
+ruby_acm_echo_dequeue(uint8_t *out, uint32_t max)
+{
+    uint32_t avail = ruby_acm_echo_head - ruby_acm_echo_tail;
+    uint32_t off, first, n;
+
+    if (!avail)
+        return 0;
+    n = avail < max ? avail : max;
+    off = ruby_acm_echo_tail % RUBY_ACM_ECHO_SIZE;
+    first = RUBY_ACM_ECHO_SIZE - off;
+    if (first > n)
+        first = n;
+    memcpy(out, &ruby_acm_echo_buf[off], first);
+    if (n > first)
+        memcpy(out + first, &ruby_acm_echo_buf[0], n - first);
+    ruby_acm_echo_tail += n;
+    return n;
+}
