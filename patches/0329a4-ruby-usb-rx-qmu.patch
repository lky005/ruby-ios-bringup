+    /* 0262: RX maxp follows the descriptor (vendor ep1out maxp 512). */
+    ruby_wr32(mac, RX1CSR0_OFF, 512u | RX_DMAREQEN);
+    ruby_wr32(mac, RX1CSR1_OFF, RX_SLOT(ruby_rx_slot) | RX_TYPE(0));
+    /* 0258: vendor RX FIFOADDR=0 (TWRP 0x00090000); 0x40 is not a 512 B unit. */
+    ruby_wr32(mac, RX1CSR2_OFF, RX_FIFOADDR(0) | RX_FIFOSEGSIZE(9));
+    /* 0235: RX checksum engine for EP1 (BIT(16) << 1), vendor qmu_start. */
+    ruby_wr32(mac, QCR0_OFF, 1u);
+    ruby_wr32(mac, QCR3_OFF,
+        (ruby_rd32(mac, QCR3_OFF) & ~0x00000007u) | 0x00060000u);
+    ruby_wr32(mac, RQERRIESR0_OFF, ruby_rd32(mac, RQERRIESR0_OFF) |
+        QMU_RX_LEN_ERR_BIT | QMU_RX_CS_ERR_BIT);
+    ruby_wr32(mac, RQERRIESR1_OFF, ruby_rd32(mac, RQERRIESR1_OFF) |
+        QMU_RX_ZLP_ERR_BIT);
+    ruby_wr32(mac, RQSAR1_OFF, (uint32_t)ruby_rx_ring_pa);
+    ruby_wr32(mac, RQHIAR1_OFF, (uint32_t)((ruby_rx_ring_pa >> 32) & 0xfu));
+    for (i = 0; i < ruby_rx_ring_n; i++)
+        ruby_ep2_rx_arm(i);
+    ruby_wr32(mac, RQCSR1_OFF, QMU_Q_START);
+    ruby_rx_mtr_add(RUBY_RMR_RESTART, (uint16_t)ruby_rx_deq,
+        ruby_rd32(mac, RQCSR1_OFF), ruby_rx_packets);
+    ruby_rx_ready = 1;
+    ruby_seq("RXCFG_OUT", (uint32_t)ruby_rx_ring_pa, ruby_rx_ready);
+    printf("RUBY USB: EP2 RX ring uc=%d pa=0x%llx "
+        "buf=0x%llx/0x%llx/0x%llx/0x%llx\n",
+        ruby_rx_uc, ruby_rx_ring_pa, ruby_rx_buf_pa[0], ruby_rx_buf_pa[1],
+        ruby_rx_buf_pa[2], ruby_rx_buf_pa[3]);
+}
+
+void
+ruby_ep2_rx_reset(vm_offset_t mac, uint32_t reset_counters)
+{
+    uint32_t csr, i;
+
+    if (!ruby_rx_ring_pa)
+        return;
+
+    if (ruby_ep2_rx_qmu_stop(mac) != 0) {
+        printf("RUBY USB: EP2 RX stop timeout in reset\n");
+        return;
+    }
+    csr = ruby_rd32(mac, RX1CSR0_OFF) &
+        ~(RX_SENTSTALL_BIT | RX_RXPKTRDY_BIT);
+    csr = (csr & ~RX_SENDSTALL_BIT) | RX_SENTSTALL_BIT | RX_RXPKTRDY_BIT;
+    ruby_wr32(mac, RX1CSR0_OFF, csr);
+    ruby_wr32(mac, EP_RST_OFF, EP_RST_RX1_BIT);
+    ruby_wr32(mac, EP_RST_OFF, 0);
+    ruby_seq("EPRST_RX", ruby_rd32(mac, RX1CSR0_OFF),
+        ruby_rd32(mac, RQCSR1_OFF));
+
+    /* EP_RST may reset the per-endpoint configuration; restore it before
+     * re-arming the ring so every clean test starts from the same state. */
+    ruby_wr32(mac, RX1CSR0_OFF, 512u | RX_DMAREQEN);
+    ruby_wr32(mac, RX1CSR1_OFF, RX_SLOT(ruby_rx_slot) | RX_TYPE(0));
+    ruby_wr32(mac, RX1CSR2_OFF, RX_FIFOADDR(0) | RX_FIFOSEGSIZE(9));
+    /* 0235: RX checksum engine for EP1 (BIT(16) << 1), vendor qmu_start. */
+    ruby_wr32(mac, QCR0_OFF, 1u);
+    ruby_wr32(mac, QCR3_OFF,
+        (ruby_rd32(mac, QCR3_OFF) & ~0x00000007u) | 0x00060000u);
+    ruby_wr32(mac, RQERRIESR0_OFF, ruby_rd32(mac, RQERRIESR0_OFF) |
+        QMU_RX_LEN_ERR_BIT | QMU_RX_CS_ERR_BIT);
+    ruby_wr32(mac, RQERRIESR1_OFF, ruby_rd32(mac, RQERRIESR1_OFF) |
+        QMU_RX_ZLP_ERR_BIT);
+    ruby_wr32(mac, RQSAR1_OFF, (uint32_t)ruby_rx_ring_pa);
+    ruby_wr32(mac, RQHIAR1_OFF, (uint32_t)((ruby_rx_ring_pa >> 32) & 0xfu));
+
+    ruby_rx_ready = 0;
+    ruby_rx_deq = 0;
+    ruby_rx_stall_seen = 0;
+    ruby_cmd_len = 0;
+    if (reset_counters) {
+        ruby_rx_packets = 0;
+        ruby_rx_bytes = 0;
+        ruby_rx_zlp = 0;
+        ruby_rx_last_len = 0;
+        ruby_rx_crc = RUBY_FNV_OFFSET;
+        ruby_rx_errors = 0;
+        ruby_rx_empty = 0;
+        ruby_rx_done_events = 0;
+        ruby_rx_bypasses = 0;
+        ruby_rx_ext_bad = 0;
+        ruby_rx_zlp_err = 0;
+        ruby_cmd_count = 0;
+        ruby_cmd_errors = 0;
+    }
+    for (i = 0; i < ruby_rx_ring_n; i++)
+        ruby_ep2_rx_arm(i);
+    ruby_wr32(mac, RQCSR1_OFF, QMU_Q_START);
+    ruby_rx_mtr_add(RUBY_RMR_RESTART, (uint16_t)ruby_rx_deq,
+        ruby_rd32(mac, RQCSR1_OFF), ruby_rx_packets);
+    ruby_rx_ready = 1;
+}
+
+/*
+ * 0146a-qmu: vendor parity for a corrupt RX GPD/queue: stop with a bounded
+ * wait, clear the error latches, then reset/re-arm/start the ring.  Never
+ * mark the live GPD BPS: the QMU may still own it.
+ */
+void
+ruby_ep2_rx_recover(vm_offset_t mac)
+{
+    uint32_t err;
+
+    if (ruby_ep2_rx_qmu_stop(mac) != 0)
+        return;
+    err = ruby_rd32(mac, RQERRIR0_OFF);
+    if (err)
+        ruby_wr32(mac, RQERRIR0_OFF, err);
+    err = ruby_rd32(mac, RQERRIR1_OFF);
+    if (err)
+        ruby_wr32(mac, RQERRIR1_OFF, err);
+    ruby_ep2_rx_reset(mac, 0);
+}
+
+void
+ruby_ep2_rx_halt_clear(vm_offset_t mac)
+{
+    ruby_seq("HALT_RX", ruby_rd32(mac, RX1CSR0_OFF),
+        ruby_rd32(mac, RQCSR1_OFF));
+    ruby_ep2_rx_reset(mac, 0);
+}
+
+void
+ruby_ep2_rx_resume(vm_offset_t mac)
+{
+    ruby_wr32(mac, RQCSR1_OFF, QMU_Q_RESUME);
+    if (!(ruby_rd32(mac, RQCSR1_OFF) & QMU_Q_ACTIVE))
+        ruby_wr32(mac, RQCSR1_OFF, QMU_Q_RESUME);
+    ruby_rx_mtr_add(RUBY_RMR_RESUME, (uint16_t)ruby_rx_deq,
+        ruby_rd32(mac, RQCSR1_OFF), ruby_rx_packets);
+}
+
+/* 0260: read-only RX stall snapshot.  No queue mutation. */
+void
+ruby_ep2_rx_stall_dump(vm_offset_t mac)
+{
+    uint32_t i, cur, hwo = 0;
+
+    if (!ruby_rx_ready)
+        return;
+    if (!ruby_rx_uc)
+        ruby_dc_civac(ruby_rx_gpd_ring_cpu, RUBY_RX_GPD_RING_SZ);
+    for (i = 0; i < ruby_rx_ring_n; i++)
+        if (ruby_rx_gpd_ring_cpu[i * 16] & 1u)
+            hwo |= 1u << i;
+    cur = ruby_ep2_rx_cur_slot(mac);
+    printf("RUBY USB RXSTALL pk=%u done=%u deq=%u cur=%02x rqcsr=%08x "
+        "rqhiar=%08x rqcpr=%08x hwo=%04x q0=%08x q1=%08x zlperr=%u "
+        "rxerr=%u sentstall=%u rqerr0=%08x rqerr1=%08x\n",
+        ruby_rx_packets, ruby_rx_done_events, ruby_rx_deq, cur,
+        ruby_rd32(mac, RQCSR1_OFF), ruby_rd32(mac, RQHIAR1_OFF),
+        ruby_rd32(mac, RQCPR1_OFF), hwo,
+        ruby_rd32(mac, QISAR0_OFF), ruby_rd32(mac, QISAR1_OFF),
+        ruby_rx_zlp_err, ruby_rx_errors, ruby_rx_stall_seen,
+        ruby_rd32(mac, RQERRIR0_OFF), ruby_rd32(mac, RQERRIR1_OFF));
+    if (cur == 0xffu)
+        return;
+    for (i = 0; i < 4; i++) {
+        uint32_t sl = (cur + i) % ruby_rx_ring_n;
+        volatile uint8_t *g = ruby_rx_gpd_ring_cpu + sl * 16;
+
+        printf("RUBY USB RXGPD[%02u] f=%02x c=%02x len=%u next=%08x "
+            "buf=%08x\n", sl, g[0], g[1],
+            (uint32_t)(*(volatile uint16_t *)(g + 12)),
+            *(volatile uint32_t *)(g + 4),
+            *(volatile uint32_t *)(g + 8));
+    }
+    for (i = 0; i < 4; i++) {
+        uint32_t sl = (ruby_rx_deq + i) % ruby_rx_ring_n;
+        volatile uint8_t *g = ruby_rx_gpd_ring_cpu + sl * 16;
+
+        printf("RUBY USB RXGPDQ[%02u] f=%02x c=%02x len=%u next=%08x "
+            "buf=%08x\n", sl, g[0], g[1],
+            (uint32_t)(*(volatile uint16_t *)(g + 12)),
+            *(volatile uint32_t *)(g + 4),
+            *(volatile uint32_t *)(g + 8));
+    }
+}
+
+void
+ruby_rx_mtr_add(uint16_t ev, uint16_t a, uint32_t b, uint32_t c)
+{
+    uint32_t i = __sync_fetch_and_add(&ruby_rx_mtr_idx, 1) &
+        (RUBY_RX_MTR_SLOTS - 1);
+    struct ruby_rx_mtr *e = &ruby_rx_mtr[i];
+
+    e->t = ruby_ms;
+    e->ev = ev;
+    e->a = a;
+    e->b = b;
+    e->c = c;
+}
+
+void
+ruby_rx_mtr_dump(void)
+{
+    uint32_t i;
+
+    printf("RUBY USB RXMTR idx=%u desync=%u\n", ruby_rx_mtr_idx,
+        ruby_rx_desync_cnt);
+    for (i = 0; i < RUBY_RX_MTR_SLOTS; i++) {
+        struct ruby_rx_mtr *e = &ruby_rx_mtr[(ruby_rx_mtr_idx + i) &
+            (RUBY_RX_MTR_SLOTS - 1)];
+
+        if (!e->t)
+            continue;
+        printf("RUBY USB RXM[%02u] t=%u ev=%u a=%u b=%08x c=%08x\n",
+            i, e->t, e->ev, e->a, e->b, e->c);
+    }
+}
+
+void
+ruby_ep2_rx_desync_dump(vm_offset_t mac)
+{
+    uint32_t cur = ruby_ep2_rx_cur_slot(mac);
+
+    ruby_rx_mtr_add(RUBY_RMR_DESYNC, (uint16_t)ruby_rx_deq,
+        cur, ruby_rd32(mac, RQCPR1_OFF));
+    printf("RUBY USB RXDESYNC n=%u deq=%02x cur=%02x pk=%u done=%u "
+        "err=%u rqcsr=%08x rqcpr=%08x rqhiar=%08x rqerr0=%08x "
+        "rqerr1=%08x\n", ruby_rx_desync_cnt, ruby_rx_deq, cur,
+        ruby_rx_packets, ruby_rx_done_events, ruby_rx_errors,
+        ruby_rd32(mac, RQCSR1_OFF), ruby_rd32(mac, RQCPR1_OFF),
+        ruby_rd32(mac, RQHIAR1_OFF), ruby_rd32(mac, RQERRIR0_OFF),
+        ruby_rd32(mac, RQERRIR1_OFF));
+    ruby_ep2_rx_stall_dump(mac);
+    ruby_rx_mtr_dump();
+}
+
+void
+ruby_ep2_rx_poll(vm_offset_t mac)
+{
+    uint32_t q0, q1, rxq, err;
+
+    if (!ruby_rx_ready)
+        return;
+
+    if (ruby_rd32(mac, RX1CSR0_OFF) & RX_SENTSTALL_BIT)
+        ruby_rx_stall_seen = 1;
+
+    /*
+     * 0299: choke latch.  docs/113: the full-packet wedge leaves every
+     * standard error/status register at zero and only flips RXQCSR1 away
+     * from 0x8000 (ACTIVE-only).  Poll for that shape and freeze the RXGPD
+     * scene once (bounded prints) so the settle-moment evidence is in the
+     * ring without needing a second host probe round.
+     */
+    {
+        uint32_t rq = ruby_rd32(mac, RQCSR1_OFF);
+
+        if (rq != 0x8000u && (rq & QMU_Q_ACTIVE)) {
+            if (!ruby_rx_choke_latched) {
+                ruby_rx_choke_latched++;
+                if (ruby_rx_choke_latched <= 3)
+                    printf("RUBY USB: 0299 rx choke rq=%08x (full-packet "
+                        "settle watch)\n", rq);
+                ruby_rx_stall_dump_req = 1;
+            }
+        } else if (rq == 0x8000u) {
+            ruby_rx_choke_latched = 0;   /* queue healthy again */
+        }
+    }
+
+    q1 = ruby_rd32(mac, QISAR1_OFF);
+    rxq = q1 & (QISAR1_RXQ_EMPTY | QISAR1_RXQ_CSERR |
+        QISAR1_RXQ_LENERR | QISAR1_RXQ_ZLPERR);
+    if (rxq) {
+        ruby_ep2_rx_stall_dump(mac);    /* 0261: snapshot with q1 intact */
+        if (ruby_qisar1_w_en)
+            ruby_wr32(mac, QISAR1_OFF, rxq);
+        if (rxq & QISAR1_RXQ_EMPTY)
+            ruby_rx_empty++;
+        if (rxq & (QISAR1_RXQ_CSERR | QISAR1_RXQ_LENERR)) {
+            err = ruby_rd32(mac, RQERRIR0_OFF);
+            if (err)
+                ruby_wr32(mac, RQERRIR0_OFF, err);
+            ruby_rx_errors++;
+            ruby_ep2_rx_recover(mac);
+        }
+        if (rxq & QISAR1_RXQ_ZLPERR) {
+            err = ruby_rd32(mac, RQERRIR1_OFF);
+            if (err)
+                ruby_wr32(mac, RQERRIR1_OFF, err);
+            ruby_rx_zlp_err++;
+            /* A ZLP is a valid RX event; it is counted by length 0. */
+        }
+    }
+
+    q0 = ruby_rd32(mac, QISAR0_OFF);
+    /* 0232: EP1 RX done is BIT(16) << 1; acknowledge both done bits so the
+     * QMU group line drops even if EP2's bit was enabled by the old mask. */
+    if (q0 & (QMU_RX_DONE_BIT | QMU_RX_DONE_BIT_EP1)) {
+        ruby_wr32(mac, QISAR0_OFF,
+            q0 & (QMU_RX_DONE_BIT | QMU_RX_DONE_BIT_EP1));
+        if (q0 & QMU_RX_DONE_BIT_EP1)
+            ruby_rx_done_events++;
+    }
+
+    ruby_ep2_rx_drain(mac);
+    ruby_rx_snapshot_update(mac);
+
+    /*
+     * 0146a-qmu: RXQ_EMPTY means the QMU ran out of GPDs and stopped.
+     * The drain re-arms what completed; if the queue is still inactive,
+     * resume it so the next host OUT is not NAKed forever.
+     */
+    /* 0247: no idle-time RX reset; the ring stays resident after config. */
+}
+
+/*
+ * Bring the device back to the state it must have at the start of an
+ * enumeration: address 0, EP0 armed, no configured endpoints.
+ */
+
+void
+ruby_ep2_rx_drain(vm_offset_t mac)
+{
+    uint32_t cur, hwo = 0, i, n, len, done = 0, full_lap = 0;
+    uint8_t *g;
+    int raw_owner = (ruby_usb_io_owner() == RUBY_USB_IO_RAW);
+
+    if (!ruby_rx_ready)
+        return;
+
+    if (!ruby_rx_uc)
+        ruby_dc_civac(ruby_rx_gpd_ring_cpu, RUBY_RX_GPD_RING_SZ);
+    for (i = 0; i < ruby_rx_ring_n; i++)
+        if (ruby_rx_gpd_ring_cpu[i * 16] & 1u)
+            hwo |= 1u << i;
+
+    cur = ruby_ep2_rx_cur_slot(mac);
+    if (cur == 0xffu)
+        return;
+
+    /*
+     * 0309: a transfer that fills exactly one ring lap makes RQCPR wrap to
+     * deq.  The normal "drain up to cur" walk then sees zero completed GPDs
+     * even though the QMU consumed the whole ring (HWO all clear).  Treat
+     * that shape as a full lap so the completed GPDs are drained/re-armed.
+     */
+    full_lap = (cur == ruby_rx_deq && hwo == 0) ? 1u : 0u;
+
+    for (n = 0; n < ruby_rx_ring_n && (full_lap || ruby_rx_deq != cur); n++) {
+        i = ruby_rx_deq;
+        g = ruby_rx_gpd_ring_cpu + i * 16;
+        if (hwo & (1u << i)) {
+            /*
+             * 0267: the QMU can skip the ring head (its HWO stays set)
+             * and complete later slots.  Advance past the orphaned head
+             * so those completed GPDs are not stranded.  Opt-in and
+             * bounded to one ring lap per drain.
+             */
+            uint32_t dist = (cur + ruby_rx_ring_n - ruby_rx_deq) %
+                ruby_rx_ring_n;
+
+            if (!raw_owner && ruby_rx_skip_en && dist > 0 &&
+                (ruby_rd32(mac, RQCSR1_OFF) & QMU_Q_ACTIVE)) {
+                ruby_rx_skip_cnt++;
+                ruby_rx_mtr_add(RUBY_RMR_SKIP, (uint16_t)i, dist, hwo);
+                if (ruby_rx_skip_cnt <= 3 ||
+                    (ruby_rx_skip_cnt & 0x3f) == 0)
+                    printf("RUBY USB RXSKIP i=%02x dist=%u hwo=%04x "
+                        "deq=%u cur=%02x pk=%u skips=%u\n", i, dist,
+                        hwo, ruby_rx_deq, cur, ruby_rx_packets,
+                        ruby_rx_skip_cnt);
+                ruby_ep2_rx_arm(i);
+                ruby_rx_deq = (i + 1u) % ruby_rx_ring_n;
+                continue;
+            }
+            break;
+        }
+
+    ruby_dc_civac(ruby_rx_buf[i], RUBY_RX_BUF_MAX);
+        len = *(volatile uint16_t *)(g + 12) & 0xffffu;
+        if (len > RUBY_RX_BUF_MAX)
+            len = RUBY_RX_BUF_MAX;
+        /* CL-0328: leave the GPD un-rearmed when the raw ring is full;
+         * the QMU then NAKs the host instead of dropping bytes. */
+        if (raw_owner && ruby_raw_space() < len)
+            break;
+
+        ruby_rx_packets++;
+        ruby_rx_last_pkt_ms = ruby_ms;   /* 0260: stall window anchor */
+        ruby_rx_bytes += len;
+        if (len == 0)
+            ruby_rx_zlp++;
+        ruby_rx_last_len = len;
+        ruby_rx_crc = ruby_fnv1a(ruby_rx_crc, ruby_rx_buf[i], len);
+        if (ruby_usb_io_rx(ruby_rx_buf[i], len)) {
+            /* CL-0320: tty/raw consumer owns EP1 RX. */
+        } else if (ruby_echo_en) {
+            /* 0231: echo data plane; host chars are not commands. */
+            ruby_acm_echo_enqueue(ruby_rx_buf[i], len);
+            if (ruby_acm_echo_dbg_rx < 8) {
+                ruby_acm_echo_dbg_rx++;
+                printf("RUBY USB ACM RX len=%u head=%u tail=%u\n",
+                    len, ruby_acm_echo_head, ruby_acm_echo_tail);
+            }
+        } else {
+            ruby_cmd_consume(mac, ruby_rx_buf[i], len);
+        }
+
+        /* The 36-bit ext bits live in dw3 for RX; the length write must not
+         * clobber them.  Count a mismatch before re-arming the slot. */
+        if ((g[14] & 0xfu) != ((ruby_rx_buf_pa[i] >> 32) & 0xfu) ||
+            ((g[14] >> 4) & 0xfu) !=
+            ((ruby_rx_gpd_pa[(i + 1u) % ruby_rx_ring_n] >> 32) & 0xfu))
+            ruby_rx_ext_bad++;
+
+        ruby_ep2_rx_arm(i);
+        ruby_rx_deq = (i + 1u) % ruby_rx_ring_n;
+        hwo |= 1u << i;
+        done++;
+        ruby_rx_mtr_add(RUBY_RMR_DONE, (uint16_t)i, len, ruby_rx_deq);
+    }
+
+    if (done) {
+        /* 0263: the QMU reads the GPD at cur right after resume; make its
+         * armed state visible before the doorbell (U-Boot 044d7003a7). */
+        if (!ruby_rx_uc)
+            ruby_dc_civac(ruby_rx_gpd_ring_cpu + cur * 16, 16);
+        if (full_lap) {
+            ruby_rx_full_laps++;
+            if (ruby_rx_full_laps <= 4)
+                printf("RUBY USB: 0309 rx full lap n=%u cur=%02x done=%u "
+                    "rq=%08x\n", ruby_rx_ring_n, cur, done,
+                    ruby_rd32(mac, RQCSR1_OFF));
+            if (!(ruby_rd32(mac, RQCSR1_OFF) & QMU_Q_ACTIVE))
+                ruby_wr32(mac, RQCSR1_OFF, QMU_Q_START);
+            ruby_rx_mtr_add(RUBY_RMR_RESTART, (uint16_t)ruby_rx_deq,
+                ruby_rd32(mac, RQCSR1_OFF), ruby_rx_packets);
+        } else {
+            ruby_ep2_rx_resume(mac);
+        }
+    }
+    /* 0231: hand the echo bytes to the TX ring right away; the QMU workloop
+     * owns both ends, so this is the same-thread producer -> consumer step. */
+    if (ruby_echo_en && ruby_acm_echo_head != ruby_acm_echo_tail)
+        ruby_ep2_push_log(mac);
+}
+
 #endif /* ARM64_BOARD_CONFIG_SWEET */
