diff --git a/bsd/dev/ruby_usb_config.h b/bsd/dev/ruby_usb_config.h
new file mode 100644
index 0000000..b359153
--- /dev/null
+++ b/bsd/dev/ruby_usb_config.h
@@ -0,0 +1,43 @@
+#ifndef _RUBY_USB_CONFIG_H_
+#define _RUBY_USB_CONFIG_H_
+
+#include <mach/vm_types.h>
+#include <sys/types.h>
+
+/*
+ * 0330: configuration/boundary layer.  Validates the queue/FIFO boot
+ * arguments, keeps an EP0-first FIFO bitmap and refuses illegal
+ * combinations instead of silently clamping them.  With the 0328
+ * cmdline every value is legal, so the effective configuration is
+ * byte-identical to 0329a6.
+ */
+#define RUBY_USB_FIFO_UNIT      512u
+#define RUBY_USB_FIFO_TOTAL     (8u * 1024u)
+#define RUBY_USB_EP0_RESERVE    512u
+
+struct ruby_usb_fifo {
+    uint32_t total_units;
+    uint32_t ep0_units;
+    uint32_t used_units;
+    uint32_t free_units;
+    uint32_t bitmap;
+};
+
+int  ruby_usb_fifo_init(struct ruby_usb_fifo *f, uint32_t total_units,
+                        uint32_t ep0_units);
+int  ruby_usb_fifo_alloc(struct ruby_usb_fifo *f, uint32_t unit);
+void ruby_usb_fifo_release(struct ruby_usb_fifo *f, uint32_t unit);
+
+/* Values corrected by the validator (defined in ruby_usb.c). */
+extern uint32_t ruby_tx_gpd_len;
+extern uint32_t ruby_inflight_max;
+extern uint32_t ruby_tx_ring_n;
+extern uint32_t ruby_rx_ring_n;
+extern uint32_t ruby_rx_buf_size;
+extern uint32_t ruby_rx_slot;
+extern uint32_t ruby_txfbase;
+extern int      ruby_txslot;
+
+void ruby_usb_config_validate(vm_offset_t mac);
+
+#endif /* _RUBY_USB_CONFIG_H_ */
\ No newline at end of file
