+/* ---- 0332i: MS OS 1.0 (bcdUSB 2.00, WCID) ---- */
+#define RUBY_MS10_COMPAT_LEN 40u
+#define RUBY_MS10_PROPS_MAX 192u
+static uint8_t ruby_ms10_compat[RUBY_MS10_COMPAT_LEN];
+static uint8_t ruby_ms10_props[RUBY_MS10_PROPS_MAX];
+static uint32_t ruby_ms10_props_len;
+static int ruby_ms10_iface = -2;   /* -2 unbuilt, -1 none, >=0 vendor iface */
+
+static int
+ruby_ms10_on(void)
+{
+    return ruby_winusb_mode == 4;
+}
+
+static void
+ruby_ms10_build(void)
+{
+    const char *name = "DeviceInterfaceGUIDs";
+    const char *guid = "{2C4FFB48-B39B-4E6E-9D4B-6B0E7C9C0E35}";
+    uint32_t nlen = 0, glen = 0, i, off, prop, dn, total;
+    uint8_t *v;
+
+    if (ruby_ms10_iface != -2)
+        return;
+    ruby_ms10_iface = ruby_0332_vendor_iface();
+    if (ruby_ms10_iface < 0)
+        return;
+    while (name[nlen])
+        nlen++;
+    while (guid[glen])
+        glen++;
+
+    /* Extended Compat ID: header 16 B + one function section 24 B. */
+    v = ruby_ms10_compat;
+    v[0] = RUBY_MS10_COMPAT_LEN; v[1] = 0; v[2] = 0; v[3] = 0;
+    v[4] = 0x00; v[5] = 0x01;               /* bcdVersion 1.00 */
+    v[6] = 0x04; v[7] = 0x00;               /* wIndex 4 */
+    v[8] = 1;                               /* bCount */
+    for (i = 9; i < 16; i++)
+        v[i] = 0;
+    v[16] = (uint8_t)ruby_ms10_iface;       /* bFirstInterface */
+    v[17] = 0;
+    v[18] = 'W'; v[19] = 'I'; v[20] = 'N'; v[21] = 'U';
+    v[22] = 'S'; v[23] = 'B'; v[24] = 0; v[25] = 0;
+    for (i = 26; i < RUBY_MS10_COMPAT_LEN; i++)
+        v[i] = 0;
+
+    /* Extended Properties: header 16 B + one REG_MULTI_SZ property. */
+    dn = 2u * (glen + 2u);                  /* GUID + two nulls */
+    prop = 4u + 4u + 2u + 2u * (nlen + 1u) + 4u + dn;
+    total = 16u + prop;
+    if (total > sizeof(ruby_ms10_props)) {
+        printf("RUBY MS10: props overflow %u ", total);
+        ruby_ms10_iface = -1;
+        return;
+    }
+    v = ruby_ms10_props;
+    off = 0;
+    v[off++] = (uint8_t)(total & 0xffu);
+    v[off++] = (uint8_t)((total >> 8) & 0xffu);
+    v[off++] = (uint8_t)((total >> 16) & 0xffu);
+    v[off++] = (uint8_t)((total >> 24) & 0xffu);
+    v[off++] = 0x00; v[off++] = 0x01;       /* bcdVersion 1.00 */
+    v[off++] = 0x05; v[off++] = 0x00;       /* wIndex 5 */
+    v[off++] = 1;                           /* wCount */
+    for (i = 0; i < 7; i++)
+        v[off++] = 0;
+    v[off++] = (uint8_t)(prop & 0xffu);
+    v[off++] = (uint8_t)((prop >> 8) & 0xffu);
+    v[off++] = (uint8_t)((prop >> 16) & 0xffu);
+    v[off++] = (uint8_t)((prop >> 24) & 0xffu);
+    v[off++] = 0x07; v[off++] = 0;          /* REG_MULTI_SZ */
+    v[off++] = 0; v[off++] = 0;
+    v[off++] = (uint8_t)((2u * (nlen + 1u)) & 0xffu);
+    v[off++] = (uint8_t)((2u * (nlen + 1u)) >> 8);
+    for (i = 0; i < nlen; i++) {
+        v[off++] = (uint8_t)name[i];
+        v[off++] = 0;
+    }
+    v[off++] = 0; v[off++] = 0;
+    v[off++] = (uint8_t)(dn & 0xffu);
+    v[off++] = (uint8_t)((dn >> 8) & 0xffu);
+    v[off++] = (uint8_t)((dn >> 16) & 0xffu);
+    v[off++] = (uint8_t)((dn >> 24) & 0xffu);
+    for (i = 0; i < glen; i++) {
+        v[off++] = (uint8_t)guid[i];
+        v[off++] = 0;
+    }
+    v[off++] = 0; v[off++] = 0;
+    v[off++] = 0; v[off++] = 0;
+    ruby_ms10_props_len = off;
+    if (off != total) {
+        printf("RUBY MS10: props len %u != %u ", off, total);
+        ruby_ms10_iface = -1;
+        return;
+    }
+    printf("RUBY MS10: iface=%u compat=%u props=%u bcddev=%02x%02x ",
+        (unsigned)ruby_ms10_iface, RUBY_MS10_COMPAT_LEN,
+        ruby_ms10_props_len, ruby_dev_desc[13], ruby_dev_desc[12]);
+}
+
+static void
+ruby_ep0_ms10(vm_offset_t mac, uint32_t t, uint32_t index, uint32_t wlen)
+{
+    if (!ruby_ms10_on()) {
+        ruby_ep0_stall(mac, t, 0xc010, wlen);
+        return;
+    }
+    ruby_ms10_build();
+    if (ruby_ms10_iface < 0) {
+        ruby_ep0_stall(mac, t, 0xc010, wlen);
+        return;
+    }
+    if (index == 4)
+        ruby_ep0_send(mac, t, 0xc010, ruby_ms10_compat,
+            RUBY_MS10_COMPAT_LEN, wlen);
+    else if (index == 5)
+        ruby_ep0_send(mac, t, 0xc010, ruby_ms10_props,
+            ruby_ms10_props_len, wlen);
+    else
+        ruby_ep0_stall(mac, t, 0xc010, wlen);
+}
