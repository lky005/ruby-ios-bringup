 /*
+ * 0172 diagnostic: prove the EP0 thread is alive and identify which signal
+ * actually follows a physical cable pull.  Read-only; no behavior change.
+ * Print on change and at least every 5 s.
+ */
+static void
+ruby_usb_heartbeat(vm_offset_t mac, vm_offset_t ippc)
+{
+    static uint32_t next_ms, last_otg, last_mac2;
+    static int last_ext, primed;
+    uint32_t otg = ruby_rd32(ippc, IPPC_OTG_STS_OFF);
+    uint32_t mac2 = ruby_rd32(mac, MAC2_INTR_STATUS_OFF);
+    uint32_t seq = ruby_battery_poll_seq();
+    int ext = ruby_battery_last_external();
+
+    if (primed && ruby_ms < next_ms && otg == last_otg &&
+        mac2 == last_mac2 && ext == last_ext)
+        return;
+    primed = 1;
+    next_ms = ruby_ms + 5000;
+    printf("RUBY USB HB: t=%u otg=%08x mac2=%08x acr3=%08x "
+        "dmon1=%08x batt_seq=%u ext=%d\n", ruby_ms, otg, mac2,
+        ruby_phy_base ? ruby_rd32(ruby_phy_base, PHY_U2_ACR3) : 0,
+        ruby_phy_base ? ruby_rd32(ruby_phy_base, PHY_U2_DMON1) : 0,
+        seq, ext);
+    last_otg = otg;
+    last_mac2 = mac2;
+    last_ext = ext;
+}
+
+/*
  * Vendor IN request 0xC0/0x21: live EP2/QMU state for the host, so a stuck
  * queue can be inspected without another boot or a console read.
  */
