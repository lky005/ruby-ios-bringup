+void ruby_field_set(uintptr_t base, uint32_t off, uint32_t shift,
+    uint32_t width, uint32_t val);
+int ruby_pwrap_read(uintptr_t pwrap, uint16_t reg, uint16_t *val);
+
+#endif /* RUBY_HAL_H */
