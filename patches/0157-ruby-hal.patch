+
+uint32_t ruby_rd32(uintptr_t base, uint32_t off);
+void ruby_wr32(uintptr_t base, uint32_t off, uint32_t val);
+uint16_t ruby_rd16(uintptr_t base, uint32_t off);
+uint32_t ruby_mask(uint32_t width);
