diff --git a/bsd/dev/ruby_hal.c b/bsd/dev/ruby_hal.c
new file mode 100644
index 0000000..1c6a3af
--- /dev/null
+++ b/bsd/dev/ruby_hal.c
@@ -0,0 +1,102 @@
+/*
+ * Shared Ruby HAL primitives: MMIO access and the PMIF read path.
+ *
+ * Read-only users (keys, probe snapshots) get the same order/barrier
+ * semantics as the drivers they replace.  This file does not touch rails,
+ * PMIC regulators, clock gates or the WDT.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+
+#include "ruby_hal.h"
+
+#define RUBY_PWRAP_ACC     0x0880u
+#define RUBY_PWRAP_RDATA   0x0894u
+#define RUBY_PWRAP_VLDCLR  0x08a4u
+#define RUBY_PWRAP_STA     0x08a8u
+
+#define RUBY_SWINF_FSM(v)  (((v) >> 1) & 7u)
+#define RUBY_SWINF_IDLE    0u
+#define RUBY_SWINF_VLDCLR  6u
+#define RUBY_SWINF_INIT    (1u << 15)
+
+uint32_t
+ruby_rd32(uintptr_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+void
+ruby_wr32(uintptr_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+uint16_t
+ruby_rd16(uintptr_t base, uint32_t off)
+{
+	uint16_t v = *(volatile uint16_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+uint32_t
+ruby_mask(uint32_t width)
+{
+	return (1u << width) - 1u;
+}
+
+uint32_t
+ruby_field_get(uintptr_t base, uint32_t off, uint32_t shift, uint32_t width)
+{
+	return (ruby_rd32(base, off) >> shift) & ruby_mask(width);
+}
+
+void
+ruby_field_set(uintptr_t base, uint32_t off, uint32_t shift, uint32_t width,
+    uint32_t val)
+{
+	uint32_t mask = ruby_mask(width) << shift;
+	uint32_t v = ruby_rd32(base, off);
+
+	v = (v & ~mask) | ((val & ruby_mask(width)) << shift);
+	ruby_wr32(base, off, v);
+}
+
+int
+ruby_pwrap_read(uintptr_t pwrap, uint16_t reg, uint16_t *val)
+{
+	uint32_t sta, rd, i;
+
+	if (pwrap == 0 || val == NULL)
+		return EINVAL;
+	sta = ruby_rd32(pwrap, RUBY_PWRAP_STA);
+	if (!(sta & RUBY_SWINF_INIT))
+		return ENODEV;
+	for (i = 0; i < 10000; i++) {
+		if (RUBY_SWINF_FSM(ruby_rd32(pwrap, RUBY_PWRAP_STA)) ==
+		    RUBY_SWINF_IDLE)
+			break;
+	}
+	if (i == 10000)
+		return ETIMEDOUT;
+	ruby_wr32(pwrap, RUBY_PWRAP_ACC, reg);
+	for (i = 0; i < 10000; i++) {
+		if (RUBY_SWINF_FSM(ruby_rd32(pwrap, RUBY_PWRAP_STA)) ==
+		    RUBY_SWINF_VLDCLR)
+			break;
+	}
+	if (i == 10000)
+		return ETIMEDOUT;
+	rd = ruby_rd32(pwrap, RUBY_PWRAP_RDATA);
+	*val = (uint16_t)(rd & 0xffffu);
+	ruby_wr32(pwrap, RUBY_PWRAP_VLDCLR, 1);
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
