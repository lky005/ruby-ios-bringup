+    v[5] = ruby_clr81_reqs;
+    v[6] = ruby_resume_eprst_cnt;
+    v[7] = ruby_resume_vendor_cnt;
+    v[8] = ruby_ep2_tx_restarts;
+    v[9] = (ruby_recover_suppressed[0] & 0xffu) |
+        ((ruby_recover_suppressed[1] & 0xffu) << 8) |
+        ((ruby_recover_suppressed[2] & 0xffu) << 16);
+    v[10] = (uint32_t)ruby_recover_mask;
+    v[11] = ruby_txpio_tail_cnt;
+    v[12] = ruby_txpio_pkts;
+    v[13] = ruby_txpio_timeouts;
+    v[14] = ruby_push_start_fail;
+    v[15] = (ruby_gpd_enq & 0xffu) | ((ruby_gpd_deq & 0xffu) << 8) |
+        ((ruby_inflight & 0xffu) << 16);
+    ruby_ep0_send(mac, t, 0xc030, (const uint8_t *)v, sizeof(v), wlen);
