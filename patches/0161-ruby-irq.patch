+int
+ruby_eint_line_used(uint32_t line)
+{
+	int used;
+
+	if (line >= RUBY_EINT_LINES)
+		return 0;
+	ruby_eint_init();
+	if (__atomic_load_n(&g_eint_state, __ATOMIC_ACQUIRE) != 2 ||
+	    !g_eint_base)
+		return 0;
+	RUBY_EINT_LOCK();
+	used = g_eint_slots[line].used;
+	RUBY_EINT_UNLOCK();
+	return used;
+}
+
+void
+ruby_eint_mask(uint32_t line)
+{
+	uint32_t bit;
+
+	if (line >= RUBY_EINT_LINES)
+		return;
+	ruby_eint_init();
+	if (__atomic_load_n(&g_eint_state, __ATOMIC_ACQUIRE) != 2 ||
+	    !g_eint_base)
+		return;
+	bit = 1u << line;
+	RUBY_EINT_LOCK();
+	if (g_eint_slots[line].used)
+		ruby_wr32(g_eint_base, RUBY_EINT_MASK_SET, bit);
+	RUBY_EINT_UNLOCK();
+}
+
+void
+ruby_eint_unmask(uint32_t line)
+{
+	uint32_t bit;
+
+	if (line >= RUBY_EINT_LINES)
+		return;
+	ruby_eint_init();
+	if (__atomic_load_n(&g_eint_state, __ATOMIC_ACQUIRE) != 2 ||
+	    !g_eint_base)
+		return;
+	bit = 1u << line;
+	RUBY_EINT_LOCK();
+	if (g_eint_slots[line].used)
+		ruby_wr32(g_eint_base, RUBY_EINT_MASK_CLR, bit);
+	RUBY_EINT_UNLOCK();
+}
+
+int
+ruby_eint_isr_handle(uint32_t line)
+{
+	uint32_t bit, sta;
+	int hit = 0;
+
+	if (line >= RUBY_EINT_LINES)
+		return 0;
+	if (__atomic_load_n(&g_eint_state, __ATOMIC_ACQUIRE) != 2 ||
+	    !g_eint_base)
+		return 0;
+	bit = 1u << line;
+	/* Interrupt context: interrupts are already masked. */
+	lck_spin_lock(&g_eint_lock);
+	if (g_eint_slots[line].used) {
+		sta = ruby_rd32(g_eint_base, RUBY_EINT_STA);
+		if (sta & bit) {
+			ruby_wr32(g_eint_base, RUBY_EINT_MASK_SET, bit);
+			ruby_wr32(g_eint_base, RUBY_EINT_ACK, bit);
+			g_eint_slots[line].pending_count++;
+			g_eint_slots[line].ack_count++;
+			hit = 1;
+		}
+	}
+	lck_spin_unlock(&g_eint_lock);
+	return hit;
+}
+
+void
+ruby_eint_set_parent_owned(int owned)
+{
+	__atomic_store_n(&g_parent_owned, owned != 0 ? 1u : 0u,
+	    __ATOMIC_RELEASE);
+}
