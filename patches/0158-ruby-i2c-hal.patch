+/* ---- I2C bit-bang ------------------------------------------------------ */
+
+static void
+ruby_i2c_delay(struct ruby_i2c_bus *b)
+{
+	delay(5);
+	if (b->budget)
+		b->budget--;
+}
+
+static void
+ruby_scl_release(struct ruby_i2c_bus *b)
+{
+	ruby_field_set(b->gpio, b->do_off, 4, 1, 1);
+	ruby_field_set(b->gpio, b->dir_off, 4, 1, 0);
+}
+
+static void
+ruby_scl_low(struct ruby_i2c_bus *b)
+{
+	ruby_field_set(b->gpio, b->do_off, 4, 1, 0);
+	ruby_field_set(b->gpio, b->dir_off, 4, 1, 1);
+}
+
+static void
+ruby_sda_release(struct ruby_i2c_bus *b)
+{
+	ruby_field_set(b->gpio, b->do_off, 5, 1, 1);
+	ruby_field_set(b->gpio, b->dir_off, 5, 1, 0);
+}
+
+static void
+ruby_sda_low(struct ruby_i2c_bus *b)
+{
+	ruby_field_set(b->gpio, b->do_off, 5, 1, 0);
+	ruby_field_set(b->gpio, b->dir_off, 5, 1, 1);
+}
+
+/* Release SCL and wait for a slave to stop stretching it. */
+static int
+ruby_scl_high(struct ruby_i2c_bus *b)
+{
+	int i;
+
+	ruby_scl_release(b);
+	for (i = 0; i < 1000; i++) {
+		if (ruby_rd32(b->gpio, b->di_off) & (1u << 4))
+			return 1;
+		if (!b->budget)
+			return 0;
+		delay(1);
+	}
+	return 0;
+}
+
+int
+ruby_i2c_start(struct ruby_i2c_bus *b)
+{
+	b->budget = RUBY_I2C_BUDGET;
+	ruby_sda_release(b);
+	if (!ruby_scl_high(b))
+		return 0;
+	ruby_i2c_delay(b);
+	ruby_sda_low(b);
+	ruby_i2c_delay(b);
+	ruby_scl_low(b);
+	ruby_i2c_delay(b);
+	return 1;
+}
+
+void
+ruby_i2c_stop(struct ruby_i2c_bus *b)
+{
+	ruby_sda_low(b);
+	ruby_i2c_delay(b);
+	(void)ruby_scl_high(b);
+	ruby_i2c_delay(b);
+	ruby_sda_release(b);
+	ruby_i2c_delay(b);
+}
+
+static int
+ruby_i2c_write_bit(struct ruby_i2c_bus *b, int bit)
+{
+	if (bit)
+		ruby_sda_release(b);
+	else
+		ruby_sda_low(b);
+	ruby_i2c_delay(b);
+	if (!ruby_scl_high(b))
+		return 0;
+	ruby_i2c_delay(b);
+	ruby_scl_low(b);
+	ruby_i2c_delay(b);
+	return 1;
+}
+
+/* Returns the bit, or -1 on a stretched/hung SCL. */
+static int
+ruby_i2c_read_bit(struct ruby_i2c_bus *b)
+{
+	int bit;
+
+	ruby_sda_release(b);
+	ruby_i2c_delay(b);
+	if (!ruby_scl_high(b))
+		return -1;
+	ruby_i2c_delay(b);
+	bit = (ruby_rd32(b->gpio, b->di_off) & (1u << 5)) != 0;
+	ruby_scl_low(b);
+	ruby_i2c_delay(b);
+	return bit;
+}
+
+/* 1 = ACK, 0 = NAK, -1 = timeout/stuck bus. */
+int
+ruby_i2c_write_byte(struct ruby_i2c_bus *b, uint8_t val)
+{
+	int i, ack;
+
+	for (i = 7; i >= 0; i--) {
+		if (!ruby_i2c_write_bit(b, (val >> i) & 1))
+			return -1;
+	}
+	ruby_sda_release(b);
+	ruby_i2c_delay(b);
+	if (!ruby_scl_high(b))
+		return -1;
+	ruby_i2c_delay(b);
+	ack = (ruby_rd32(b->gpio, b->di_off) & (1u << 5)) == 0;
+	ruby_scl_low(b);
+	ruby_i2c_delay(b);
+	return ack ? 1 : 0;
+}
+
+int
+ruby_i2c_read_byte(struct ruby_i2c_bus *b, int ack)
+{
+	uint8_t val = 0;
+	int i, bit;
+
+	for (i = 7; i >= 0; i--) {
+		bit = ruby_i2c_read_bit(b);
+		if (bit < 0)
+			return -1;
+		if (bit)
+			val |= (uint8_t)(1u << i);
+	}
+	if (ack)
+		ruby_sda_low(b);
+	else
+		ruby_sda_release(b);
+	ruby_i2c_delay(b);
+	if (!ruby_scl_high(b))
+		return -1;
+	ruby_i2c_delay(b);
+	ruby_scl_low(b);
+	ruby_i2c_delay(b);
+	ruby_sda_release(b);
+	return val;
+}
+
+void
+ruby_i2c_recover(struct ruby_i2c_bus *b)
+{
+	int i;
+
+	ruby_sda_release(b);
+	ruby_scl_release(b);
+	delay(10);
+	for (i = 0; i < 9; i++) {
+		ruby_scl_low(b);
+		ruby_i2c_delay(b);
+		ruby_scl_release(b);
+		ruby_i2c_delay(b);
+	}
+	ruby_sda_low(b);
+	ruby_i2c_delay(b);
+	ruby_scl_release(b);
+	ruby_i2c_delay(b);
+	ruby_sda_release(b);
+	ruby_i2c_delay(b);
+	printf("%s: i2c%u recover DI=%08x\n", b->tag, (unsigned)b->bus,
+	    ruby_rd32(b->gpio, b->di_off));
+}
+
+int
+ruby_i2c_take(struct ruby_i2c_bus *b)
+{
+	uintptr_t cfg = b->cfg;
+
+	if (b->taken)
+		return 0;
+	if (!b->gpio || !cfg)
+		return ENODEV;
+	b->s_mode_scl = ruby_field_get(b->gpio, b->mode_off, b->mode_scl_shift, 4);
+	b->s_mode_sda = ruby_field_get(b->gpio, b->mode_off, b->mode_sda_shift, 4);
+	b->s_dir_scl = ruby_field_get(b->gpio, b->dir_off, 4, 1);
+	b->s_dir_sda = ruby_field_get(b->gpio, b->dir_off, 5, 1);
+	b->s_do_scl = ruby_field_get(b->gpio, b->do_off, 4, 1);
+	b->s_do_sda = ruby_field_get(b->gpio, b->do_off, 5, 1);
+	b->s_ies_scl = ruby_field_get(cfg, b->ies_off, b->ies_scl_shift, 1);
+	b->s_ies_sda = ruby_field_get(cfg, b->ies_off, b->ies_sda_shift, 1);
+	b->s_pu_scl = ruby_field_get(cfg, b->pu_off, b->pu_scl_shift, 1);
+	b->s_pu_sda = ruby_field_get(cfg, b->pu_off, b->pu_sda_shift, 1);
+	b->s_pd_scl = ruby_field_get(cfg, b->pd_off, b->pd_scl_shift, 1);
+	b->s_pd_sda = ruby_field_get(cfg, b->pd_off, b->pd_sda_shift, 1);
+	b->s_smt_scl = ruby_field_get(cfg, b->smt_off, b->smt_scl_shift, 1);
+	b->s_smt_sda = ruby_field_get(cfg, b->smt_off, b->smt_sda_shift, 1);
+	b->s_drv_scl = ruby_field_get(cfg, b->drv_scl_off, b->drv_scl_shift, 3);
+	b->s_drv_sda = ruby_field_get(cfg, b->drv_sda_off, b->drv_sda_shift, 3);
+	b->taken = 1;
+
+	ruby_field_set(b->gpio, b->mode_off, b->mode_scl_shift, 4, 0);
+	ruby_field_set(b->gpio, b->mode_off, b->mode_sda_shift, 4, 0);
+	ruby_field_set(b->gpio, b->dir_off, 4, 1, 0);
+	ruby_field_set(b->gpio, b->dir_off, 5, 1, 0);
+	ruby_field_set(b->gpio, b->do_off, 4, 1, 1);
+	ruby_field_set(b->gpio, b->do_off, 5, 1, 1);
+	ruby_field_set(cfg, b->ies_off, b->ies_scl_shift, 1, 1);
+	ruby_field_set(cfg, b->ies_off, b->ies_sda_shift, 1, 1);
+	ruby_field_set(cfg, b->pu_off, b->pu_scl_shift, 1, 1);
+	ruby_field_set(cfg, b->pu_off, b->pu_sda_shift, 1, 1);
+	ruby_field_set(cfg, b->pd_off, b->pd_scl_shift, 1, 0);
+	ruby_field_set(cfg, b->pd_off, b->pd_sda_shift, 1, 0);
+	delay(20);
+
+	if (!(ruby_rd32(b->gpio, b->di_off) & (1u << 4)) ||
+	    !(ruby_rd32(b->gpio, b->di_off) & (1u << 5))) {
+		printf("%s: i2c%u line low (mode=%08x dir=%08x do=%08x DI=%08x)\n",
+		    b->tag, (unsigned)b->bus, ruby_rd32(b->gpio, b->mode_off),
+		    ruby_rd32(b->gpio, b->dir_off), ruby_rd32(b->gpio, b->do_off),
+		    ruby_rd32(b->gpio, b->di_off));
+		ruby_i2c_recover(b);
+		if (!(ruby_rd32(b->gpio, b->di_off) & (1u << 4)) ||
+		    !(ruby_rd32(b->gpio, b->di_off) & (1u << 5))) {
+			printf("%s: i2c%u line stuck; check pull-up/pinmux\n",
+			    b->tag, (unsigned)b->bus);
+			return EIO;
+		}
+	}
+	return 0;
+}
+
+void
+ruby_i2c_release(struct ruby_i2c_bus *b)
+{
+	uintptr_t cfg = b->cfg;
+
+	if (!b->taken)
+		return;
+	ruby_field_set(b->gpio, b->mode_off, b->mode_scl_shift, 4, b->s_mode_scl);
+	ruby_field_set(b->gpio, b->mode_off, b->mode_sda_shift, 4, b->s_mode_sda);
+	ruby_field_set(b->gpio, b->dir_off, 4, 1, b->s_dir_scl);
+	ruby_field_set(b->gpio, b->dir_off, 5, 1, b->s_dir_sda);
+	ruby_field_set(b->gpio, b->do_off, 4, 1, b->s_do_scl);
+	ruby_field_set(b->gpio, b->do_off, 5, 1, b->s_do_sda);
+	ruby_field_set(cfg, b->ies_off, b->ies_scl_shift, 1, b->s_ies_scl);
+	ruby_field_set(cfg, b->ies_off, b->ies_sda_shift, 1, b->s_ies_sda);
+	ruby_field_set(cfg, b->pu_off, b->pu_scl_shift, 1, b->s_pu_scl);
+	ruby_field_set(cfg, b->pu_off, b->pu_sda_shift, 1, b->s_pu_sda);
+	ruby_field_set(cfg, b->pd_off, b->pd_scl_shift, 1, b->s_pd_scl);
+	ruby_field_set(cfg, b->pd_off, b->pd_sda_shift, 1, b->s_pd_sda);
+	ruby_field_set(cfg, b->smt_off, b->smt_scl_shift, 1, b->s_smt_scl);
+	ruby_field_set(cfg, b->smt_off, b->smt_sda_shift, 1, b->s_smt_sda);
+	ruby_field_set(cfg, b->drv_scl_off, b->drv_scl_shift, 3, b->s_drv_scl);
+	ruby_field_set(cfg, b->drv_sda_off, b->drv_sda_shift, 3, b->s_drv_sda);
+	b->taken = 0;
+}
+
+void
+ruby_i2c_bus_init(struct ruby_i2c_bus *b, uint8_t bus, uintptr_t gpio,
+    uintptr_t cfg, const char *tag)
+{
+	memset(b, 0, sizeof(*b));
+	b->bus = bus;
+	b->gpio = gpio;
+	b->cfg = cfg;
+	b->tag = tag;
+	if (bus == 5) {
+		b->dir_off = 0x040;
+		b->do_off = 0x140;
+		b->di_off = 0x240;
+		b->mode_off = 0x400;
+		b->mode_scl_shift = 16;
+		b->mode_sda_shift = 20;
+		b->ies_off = 0x080;
+		b->ies_scl_shift = 0;
+		b->ies_sda_shift = 3;
+		b->pu_off = 0x0c0;
+		b->pu_scl_shift = 0;
+		b->pu_sda_shift = 3;
+		b->pd_off = 0x0a0;
+		b->pd_scl_shift = 0;
+		b->pd_sda_shift = 3;
+		b->smt_off = 0x100;
+		b->smt_scl_shift = 21;
+		b->smt_sda_shift = 21;
+		b->drv_scl_off = 0x020;
+		b->drv_scl_shift = 24;
+		b->drv_sda_off = 0x030;
+		b->drv_sda_shift = 3;
+	} else {
+		b->dir_off = 0x010;
+		b->do_off = 0x110;
+		b->di_off = 0x210;
+		b->mode_off = 0x340;
+		b->mode_scl_shift = 16;
+		b->mode_sda_shift = 20;
+		b->ies_off = 0x050;
+		b->ies_scl_shift = 17;
+		b->ies_sda_shift = 18;
+		b->pu_off = 0x080;
+		b->pu_scl_shift = 5;
+		b->pu_sda_shift = 6;
+		b->pd_off = 0x060;
+		b->pd_scl_shift = 5;
+		b->pd_sda_shift = 6;
+		b->smt_off = 0x0f0;
+		b->smt_scl_shift = 14;
+		b->smt_sda_shift = 15;
+		b->drv_scl_off = 0x010;
+		b->drv_scl_shift = 12;
+		b->drv_sda_off = 0x010;
+		b->drv_sda_shift = 15;
+	}
+}
+
+int
+ruby_i2c_read_regs(struct ruby_i2c_bus *b, uint8_t addr, uint8_t reg,
+    uint8_t *buf, uint32_t len)
+{
+	uint32_t i;
+	int ack, v;
+
+	if (len == 0 || len > 16)
+		return EINVAL;
+	if (!ruby_i2c_start(b))
+		return ETIMEDOUT;
+	if ((ack = ruby_i2c_write_byte(b, (uint8_t)(addr << 1))) != 1)
+		goto out;
+	if ((ack = ruby_i2c_write_byte(b, reg)) != 1)
+		goto out;
+	if (!ruby_i2c_start(b)) {
+		ruby_i2c_stop(b);
+		return ETIMEDOUT;
+	}
+	if ((ack = ruby_i2c_write_byte(b, (uint8_t)((addr << 1) | 1))) != 1)
+		goto out;
+	for (i = 0; i < len; i++) {
+		v = ruby_i2c_read_byte(b, i + 1 < len);
+		if (v < 0) {
+			ruby_i2c_stop(b);
+			return ETIMEDOUT;
+		}
+		buf[i] = (uint8_t)v;
+	}
+	ruby_i2c_stop(b);
+	return 0;
+
+out:
+	ruby_i2c_stop(b);
+	return ack < 0 ? ETIMEDOUT : ENXIO;
+}
