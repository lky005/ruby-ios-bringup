diff --git a/iokit/Kernel/arm/RubyEINTInterruptController.cpp b/iokit/Kernel/arm/RubyEINTInterruptController.cpp
new file mode 100644
index 0000000..4240745
--- /dev/null
+++ b/iokit/Kernel/arm/RubyEINTInterruptController.cpp
@@ -0,0 +1,305 @@
+#include <pexpert/arm64/board_config.h>
+#if defined(SWEET)
+/*
+ * SWEET: EINT line domain behind the SPI288 parent.
+ *
+ * vectorNumber = EINT line.  The parent filter raises a line after the
+ * demux has physically masked and ACKed it; this controller only maps the
+ * line to the child IOInterruptEventSource and schedules its workloop.
+ * It never touches GICD or the parent vector.
+ */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOInterruptController.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOService.h>
+#include <libkern/c++/OSSymbol.h>
+#include <string.h>
+#include <pexpert/pexpert.h>
+
+#include "../../../bsd/dev/ruby_eint.h"
+#include "RubyEINTInterruptController.h"
+
+#define super IOInterruptController
+OSDefineMetaClassAndStructors(RubyEINTInterruptController, IOInterruptController);
+
+#define RUBY_EINT_CTRL_LINES 128u
+
+bool
+RubyEINTInterruptController::init(OSDictionary *dictionary)
+{
+	vectors = NULL;
+	fNumVectors = 0;
+	fSpurious = 0;
+	fUnhandled = 0;
+	memset(fLevel, 0, sizeof(fLevel));
+	return super::init(dictionary);
+}
+
+bool
+RubyEINTInterruptController::start(IOService *provider)
+{
+	OSSymbol *name;
+
+	if (!super::start(provider)) {
+		return false;
+	}
+	fNumVectors = RUBY_EINT_CTRL_LINES;
+	vectors = IONewZero(IOInterruptVector, fNumVectors);
+	if (!vectors) {
+		return false;
+	}
+	for (uint32_t i = 0; i < fNumVectors; i++) {
+		vectors[i].interruptLock = IOLockAlloc();
+		if (!vectors[i].interruptLock) {
+			releaseVectors();
+			return false;
+		}
+	}
+	name = (OSSymbol *)OSSymbol::withCStringNoCopy("RubyEINT");
+	if (!name || !getPlatform() ||
+	    getPlatform()->registerInterruptController(name, this) !=
+	    kIOReturnSuccess) {
+		releaseVectors();
+		return false;
+	}
+	IOLog("RUBY EINT: child controller ready vectors=%u\n", fNumVectors);
+	return true;
+}
+
+void
+RubyEINTInterruptController::releaseVectors(void)
+{
+	if (!vectors) {
+		return;
+	}
+	for (uint32_t i = 0; i < fNumVectors; i++) {
+		if (vectors[i].interruptLock) {
+			IOLockFree(vectors[i].interruptLock);
+			vectors[i].interruptLock = NULL;
+		}
+	}
+	IODelete(vectors, IOInterruptVector, fNumVectors);
+	vectors = NULL;
+}
+
+void
+RubyEINTInterruptController::free(void)
+{
+	releaseVectors();
+	super::free();
+}
+
+bool
+RubyEINTInterruptController::specForSource(IOService *nub, int source,
+    uint32_t *line, uint32_t *flags)
+{
+	IOInterruptSource *src;
+	OSData *data;
+	const struct ruby_eint_spec *spec;
+
+	if (!nub || !nub->_interruptSources || source < 0 ||
+	    source >= nub->_numInterruptSources) {
+		return false;
+	}
+	src = &nub->_interruptSources[source];
+	data = src->vectorData;
+	if (!data || data->getLength() < sizeof(struct ruby_eint_spec)) {
+		return false;
+	}
+	spec = (const struct ruby_eint_spec *)data->getBytesNoCopy();
+	*line = spec->line;
+	*flags = spec->flags;
+	return true;
+}
+
+IOInterruptVector *
+RubyEINTInterruptController::vectorForSource(IOService *nub, int source)
+{
+	uint32_t line;
+	uint32_t flags;
+
+	if (!specForSource(nub, source, &line, &flags) ||
+	    line >= fNumVectors) {
+		return NULL;
+	}
+	return &vectors[line];
+}
+
+IOReturn
+RubyEINTInterruptController::registerInterrupt(IOService *nub, int source,
+    void *target, IOInterruptHandler handler, void *refCon)
+{
+	uint32_t line;
+	uint32_t flags;
+
+	if (!vectors || !specForSource(nub, source, &line, &flags) ||
+	    line >= fNumVectors) {
+		return kIOReturnBadArgument;
+	}
+	fLevel[line] = (flags & RUBY_EINT_LEVEL) ? 1 : 0;
+	return super::registerInterrupt(nub, source, target, handler, refCon);
+}
+
+IOReturn
+RubyEINTInterruptController::unregisterInterrupt(IOService *nub, int source)
+{
+	return super::unregisterInterrupt(nub, source);
+}
+
+IOReturn
+RubyEINTInterruptController::getInterruptType(IOService *nub, int source,
+    int *interruptType)
+{
+	uint32_t line;
+	uint32_t flags;
+
+	if (!interruptType ||
+	    !specForSource(nub, source, &line, &flags)) {
+		return kIOReturnBadArgument;
+	}
+	*interruptType = (flags & RUBY_EINT_LEVEL) ?
+	    kIOInterruptTypeLevel : kIOInterruptTypeEdge;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+RubyEINTInterruptController::enableInterrupt(IOService *nub, int source)
+{
+	IOInterruptVector *vec = vectorForSource(nub, source);
+
+	if (!vec) {
+		return kIOReturnBadArgument;
+	}
+	vec->interruptDisabledSoft = 0;
+	OSMemoryBarrier();
+	if (!getPlatform()->atInterruptLevel()) {
+		while (vec->interruptActive) {
+		}
+	}
+	if (vec->interruptDisabledHard) {
+		vec->interruptDisabledHard = 0;
+		OSSynchronizeIO();
+		ruby_eint_unmask((uint32_t)(vec - vectors));
+	}
+	return kIOReturnSuccess;
+}
+
+IOReturn
+RubyEINTInterruptController::disableInterrupt(IOService *nub, int source)
+{
+	IOInterruptVector *vec = vectorForSource(nub, source);
+
+	if (!vec) {
+		return kIOReturnBadArgument;
+	}
+	vec->interruptDisabledSoft = 1;
+	OSMemoryBarrier();
+	if (!getPlatform()->atInterruptLevel()) {
+		while (vec->interruptActive) {
+		}
+	}
+	if (!vec->interruptDisabledHard) {
+		vec->interruptDisabledHard = 1;
+		ruby_eint_mask((uint32_t)(vec - vectors));
+	}
+	return kIOReturnSuccess;
+}
+
+IOReturn
+RubyEINTInterruptController::handleInterrupt(void *refCon, IOService *nub,
+    int source)
+{
+	IOInterruptVector *vec;
+
+	(void)refCon;
+	(void)nub;
+
+	if (source < 0 || (uint32_t)source >= fNumVectors || !vectors) {
+		__atomic_add_fetch(&fSpurious, 1, __ATOMIC_RELAXED);
+		return kIOReturnInvalid;
+	}
+	vec = &vectors[source];
+	if (!vec->interruptRegistered) {
+		__atomic_add_fetch(&fSpurious, 1, __ATOMIC_RELAXED);
+		return kIOReturnInvalid;
+	}
+	if (vec->interruptDisabledSoft || vec->interruptDisabledHard ||
+	    !vec->handler) {
+		__atomic_add_fetch(&fUnhandled, 1, __ATOMIC_RELAXED);
+		return kIOReturnSuccess;
+	}
+	vec->interruptActive = 1;
+	OSMemoryBarrier();
+	vec->handler(vec->target, vec->refCon, vec->nub, vec->source);
+	OSMemoryBarrier();
+	vec->interruptActive = 0;
+	return kIOReturnSuccess;
+}
+
+bool
+RubyEINTInterruptController::vectorCanBeShared(
+    IOInterruptVectorNumber vectorNumber, IOInterruptVector *vector)
+{
+	(void)vectorNumber;
+	(void)vector;
+	return false;
+}
+
+void
+RubyEINTInterruptController::initVector(
+    IOInterruptVectorNumber vectorNumber, IOInterruptVector *vector)
+{
+	(void)vectorNumber;
+	(void)vector;
+}
+
+int
+RubyEINTInterruptController::getVectorType(
+    IOInterruptVectorNumber vectorNumber, IOInterruptVector *vector)
+{
+	(void)vector;
+
+	if (vectorNumber < 0 || (uint32_t)vectorNumber >= fNumVectors) {
+		return kIOInterruptTypeEdge;
+	}
+	return fLevel[vectorNumber] ?
+	    kIOInterruptTypeLevel : kIOInterruptTypeEdge;
+}
+
+void
+RubyEINTInterruptController::disableVectorHard(
+    IOInterruptVectorNumber vectorNumber, IOInterruptVector *vector)
+{
+	(void)vector;
+
+	if (vectorNumber < 0 || (uint32_t)vectorNumber >= fNumVectors) {
+		return;
+	}
+	ruby_eint_mask((uint32_t)vectorNumber);
+}
+
+void
+RubyEINTInterruptController::enableVector(
+    IOInterruptVectorNumber vectorNumber, IOInterruptVector *vector)
+{
+	(void)vector;
+
+	if (vectorNumber < 0 || (uint32_t)vectorNumber >= fNumVectors) {
+		return;
+	}
+	ruby_eint_unmask((uint32_t)vectorNumber);
+}
+
+void
+RubyEINTInterruptController::causeVector(
+    IOInterruptVectorNumber vectorNumber, IOInterruptVector *vector)
+{
+	(void)vector;
+
+	if (vectorNumber < 0 || (uint32_t)vectorNumber >= fNumVectors) {
+		return;
+	}
+	handleInterrupt(NULL, NULL, (int)vectorNumber);
+}
+
+#endif /* SWEET */
