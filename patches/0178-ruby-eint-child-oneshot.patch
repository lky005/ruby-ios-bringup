diff --git a/iokit/Kernel/arm/SweetGoodixTouch.cpp b/iokit/Kernel/arm/SweetGoodixTouch.cpp
new file mode 100644
index 0000000..6b0581e
--- /dev/null
+++ b/iokit/Kernel/arm/SweetGoodixTouch.cpp
@@ -0,0 +1,317 @@
+#include <pexpert/arm64/board_config.h>
+#if defined(SWEET)
+/*
+ * SWEET: Goodix touch as the EINT14 child.
+ *
+ * The parent filter masks and ACKs the line in primary.  This service's
+ * event source only schedules its dedicated workloop; the action does the
+ * SPI3 frame read and HID submission, then service_done() reopens the
+ * physical line.  All control/diag commands run through the command gate
+ * on the same workloop.  There is no gt_thread.
+ */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOCommandGate.h>
+#include <IOKit/IOInterruptEventSource.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOTimerEventSource.h>
+#include <IOKit/IOWorkLoop.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSSymbol.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+
+#include "../../../bsd/dev/ruby_eint.h"
+#include "SweetGoodixTouch.h"
+
+#define super IOService
+OSDefineMetaClassAndStructors(SweetGoodixTouch, IOService);
+
+#define SWEET_GT_EINT_LINE 14u
+#define SWEET_GT_GATE_COMMAND 1u
+
+static SweetGoodixTouch *gSweetGoodixTouch;
+
+extern "C" {
+int sweet_gt_hw_start(void);
+int sweet_gt_eint_attach(void);
+int sweet_gt_eint_activate(void);
+int sweet_gt_service_frame(void);
+void sweet_gt_service_done(int ok);
+void sweet_gt_stop_service(void);
+int sweet_goodix_cmd_internal(char *cmd);
+void sweet_goodix_spi_init(void);
+}
+
+bool
+SweetGoodixTouch::init(OSDictionary *dictionary)
+{
+	fWorkLoop = NULL;
+	fGate = NULL;
+	fIRQ = NULL;
+	fInitTimer = NULL;
+	fInitDone = false;
+	fIrqEnabled = false;
+	fReady = false;
+	return super::init(dictionary);
+}
+
+bool
+SweetGoodixTouch::publishInterruptSource(void)
+{
+	OSArray *controllers = NULL;
+	OSArray *specifiers = NULL;
+	OSSymbol *name = NULL;
+	OSData *data = NULL;
+	struct ruby_eint_spec spec = {
+		.line = SWEET_GT_EINT_LINE,
+		.flags = RUBY_EINT_EDGE,
+	};
+	bool ok = false;
+
+	controllers = OSArray::withCapacity(1);
+	specifiers = OSArray::withCapacity(1);
+	name = (OSSymbol *)OSSymbol::withCStringNoCopy("RubyEINT");
+	data = OSData::withBytes(&spec, sizeof(spec));
+	if (!controllers || !specifiers || !name || !data) {
+		goto out;
+	}
+	if (!controllers->setObject(name) || !specifiers->setObject(data)) {
+		goto out;
+	}
+	ok = setProperty("IOInterruptControllers", controllers) &&
+	    setProperty("IOInterruptSpecifiers", specifiers);
+out:
+	OSSafeRelease(controllers);
+	OSSafeRelease(specifiers);
+	OSSafeRelease(name);
+	OSSafeRelease(data);
+	return ok;
+}
+
+bool
+SweetGoodixTouch::start(IOService *provider)
+{
+	int enabled = 1;
+
+	if (!super::start(provider)) {
+		return false;
+	}
+	if (PE_parse_boot_argn("sweetgt", &enabled, sizeof(enabled)) &&
+	    enabled == 0) {
+		IOLog("SWEET GT: disabled (sweetgt=0)\n");
+		return false;
+	}
+	sweet_goodix_spi_init();
+	fWorkLoop = getWorkLoop();
+	if (!fWorkLoop) {
+		return false;
+	}
+	fWorkLoop->retain();
+	fGate = IOCommandGate::commandGate(this,
+	    &SweetGoodixTouch::gateAction);
+	if (!fGate ||
+	    fWorkLoop->addEventSource(fGate) != kIOReturnSuccess) {
+		return false;
+	}
+	if (!publishInterruptSource()) {
+		return false;
+	}
+	fInitTimer = IOTimerEventSource::timerEventSource(this,
+	    &SweetGoodixTouch::initTimerAction);
+	if (!fInitTimer ||
+	    fWorkLoop->addEventSource(fInitTimer) != kIOReturnSuccess) {
+		return false;
+	}
+	gSweetGoodixTouch = this;
+	fReady = true;
+	IOLog("SWEET GT: touch service ready (kick pending)\n");
+	return true;
+}
+
+void
+SweetGoodixTouch::free(void)
+{
+	if (gSweetGoodixTouch == this) {
+		gSweetGoodixTouch = NULL;
+	}
+	if (fIRQ) {
+		fIRQ->disable();
+		if (fWorkLoop) {
+			fWorkLoop->removeEventSource(fIRQ);
+		}
+		OSSafeRelease(fIRQ);
+		fIRQ = NULL;
+	}
+	sweet_gt_stop_service();
+	if (fInitTimer) {
+		fInitTimer->cancelTimeout();
+		if (fWorkLoop) {
+			fWorkLoop->removeEventSource(fInitTimer);
+		}
+		OSSafeRelease(fInitTimer);
+		fInitTimer = NULL;
+	}
+	if (fGate) {
+		if (fWorkLoop) {
+			fWorkLoop->removeEventSource(fGate);
+		}
+		OSSafeRelease(fGate);
+		fGate = NULL;
+	}
+	if (fWorkLoop) {
+		fWorkLoop->release();
+		fWorkLoop = NULL;
+	}
+	super::free();
+}
+
+int
+SweetGoodixTouch::kickInit(void)
+{
+	if (!fInitTimer) {
+		return ENODEV;
+	}
+	fInitTimer->setTimeoutMS(1);
+	return 0;
+}
+
+int
+SweetGoodixTouch::runCommand(char *cmd)
+{
+	int ret = 1;
+	IOReturn status;
+
+	if (!fGate || !fReady) {
+		return 1;
+	}
+	status = fGate->runCommand((void *)(uintptr_t)SWEET_GT_GATE_COMMAND,
+	    cmd, &ret, NULL);
+	return status == kIOReturnSuccess ? ret : 1;
+}
+
+int
+SweetGoodixTouch::setIrqEnabledDirect(int on)
+{
+	if (!fIRQ) {
+		return ENODEV;
+	}
+	if (on) {
+		fIRQ->enable();
+		fIrqEnabled = true;
+	} else {
+		fIRQ->disable();
+		fIrqEnabled = false;
+	}
+	IOLog("SWEET GT: EINT14 irq %s\n", on ? "on" : "off");
+	return 0;
+}
+
+bool
+SweetGoodixTouch::createIrqSource(void)
+{
+	fIRQ = IOInterruptEventSource::interruptEventSource(this,
+	    &SweetGoodixTouch::irqAction, this, 0);
+	if (!fIRQ ||
+	    fWorkLoop->addEventSource(fIRQ) != kIOReturnSuccess) {
+		return false;
+	}
+	fIRQ->disable();
+	return true;
+}
+
+void
+SweetGoodixTouch::initAction(void)
+{
+	if (fInitDone) {
+		return;
+	}
+	if (!sweet_gt_hw_start()) {
+		IOLog("SWEET GT: hw start failed\n");
+		return;
+	}
+	if (!sweet_gt_eint_attach()) {
+		sweet_gt_stop_service();
+		return;
+	}
+	if (!createIrqSource()) {
+		sweet_gt_stop_service();
+		return;
+	}
+	/* Line handler is installed; unmask before opening DOM. */
+	fIRQ->enable();
+	fIrqEnabled = true;
+	if (!sweet_gt_eint_activate()) {
+		fIRQ->disable();
+		fIrqEnabled = false;
+		sweet_gt_stop_service();
+		return;
+	}
+	fInitDone = true;
+	IOLog("SWEET GT: EINT14 oneshot enabled\n");
+}
+
+void
+SweetGoodixTouch::initTimerAction(OSObject *owner,
+    IOTimerEventSource *sender)
+{
+	SweetGoodixTouch *self = (SweetGoodixTouch *)owner;
+
+	(void)sender;
+	self->initAction();
+}
+
+void
+SweetGoodixTouch::irqAction(OSObject *owner,
+    IOInterruptEventSource *sender, int count)
+{
+	SweetGoodixTouch *self = (SweetGoodixTouch *)owner;
+	int ok;
+
+	(void)sender;
+	(void)count;
+	if (!self->fInitDone) {
+		return;
+	}
+	ok = sweet_gt_service_frame();
+	sweet_gt_service_done(ok);
+}
+
+IOReturn
+SweetGoodixTouch::gateAction(OSObject *owner, void *arg0, void *arg1,
+    void *arg2, void *arg3)
+{
+	SweetGoodixTouch *self = (SweetGoodixTouch *)owner;
+	uintptr_t op = (uintptr_t)arg0;
+
+	(void)self;
+	(void)arg3;
+	if (op == SWEET_GT_GATE_COMMAND) {
+		if (arg2) {
+			*(int *)arg2 = sweet_goodix_cmd_internal((char *)arg1);
+		}
+		return kIOReturnSuccess;
+	}
+	return kIOReturnUnsupported;
+}
+
+extern "C" int
+sweet_goodix_service_cmd(char *cmd)
+{
+	return gSweetGoodixTouch ? gSweetGoodixTouch->runCommand(cmd) : 1;
+}
+
+extern "C" int
+sweet_goodix_service_kick(void)
+{
+	return gSweetGoodixTouch ? gSweetGoodixTouch->kickInit() : 1;
+}
+
+extern "C" int
+sweet_goodix_irq_set_direct(int on)
+{
+	return gSweetGoodixTouch ?
+	    gSweetGoodixTouch->setIrqEnabledDirect(on) : 1;
+}
+
+#endif /* SWEET */
