+
+private:
+	IOWorkLoop *fWorkLoop;
+	IOCommandGate *fGate;
+	IOInterruptEventSource *fIRQ;
+	IOTimerEventSource *fInitTimer;
+	bool fInitDone;
+	bool fIrqEnabled;
+	bool fReady;
+
+	bool publishInterruptSource(void);
+	bool createIrqSource(void);
+	void initAction(void);
+	static void initTimerAction(OSObject *owner,
