-        if (++sub == 10) {
+        /*
+         * Service EP0 every 10 us while the window runs.  The host answers
+         * a SETUP at microsecond scale and the hardware latches
+         * DEVICE_CONF when the SET_ADDRESS transfer ends, so a 100 us
+         * tick loses that race on some boots (the host then moves to the
+         * new address while the device is still on the old one and goes
+         * silent).  100 x 10 us still advances the 1 ms window clock.
+         */
+        delay(10);
+        if (++sub == 100) {
             sub = 0;
             t++;
             ruby_ms = t;
