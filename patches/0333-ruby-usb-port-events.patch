+/* 0333a: controller-only port events, behind rubyusb_hotplug. */
+static uint32_t ruby_evt_connect, ruby_evt_disconnect, ruby_evt_other;
+static uint32_t ruby_evt_logged, ruby_evt_epctl_idle;
+static uint32_t ruby_evt_susp_logged, ruby_evt_res_logged;
