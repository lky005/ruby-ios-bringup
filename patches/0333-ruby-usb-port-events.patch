+
+/*
+ * 0333a: EPCTL link interrupt.  The vendor map puts the link registers at
+ * EPCTL 0x0050/0x0054 (EPCTL base 0x0800); these are MAC-relative like the
+ * rest of this header.  A speed change is the only source the EPCTL group
+ * carries here; the IRQ service consumes it before the group is enabled
+ * (enable-set <= service-set) and only in rubyusb_hotplug mode.
+ */
+#define EPCTL_LINK_INTR_ENABLE_OFF 0x0850
+#define EPCTL_LINK_INTR_OFF        0x0854
+#define EPCTL_LINK_SPEED_CHG       (1u << 0)
+#define DEVICE_CONF_SPEED_MSK      0x7u
+#define DEVICE_CONF_SPEED_UNKNOWN  0u
+#define DEVICE_CONF_SPEED_FULL     1u
+#define DEVICE_CONF_SPEED_HIGH     3u
