+/*
+ * 0333b: unified port state machine.  Only the service workloop mutates
+ * ruby_port_state; the tick/IRQ contexts post ruby_port_pending bits (or
+ * call the workloop entry points) and never touch the state directly.
+ */
+enum {
+    RUBY_PORT_UNKNOWN, RUBY_PORT_ATTACHED, RUBY_PORT_CONFIGURED,
+    RUBY_PORT_SUSPENDED
+};
+enum {
+    RUBY_PORT_EV_LINK_CONN, RUBY_PORT_EV_LINK_DISC, RUBY_PORT_EV_RESET,
+    RUBY_PORT_EV_SUSPEND, RUBY_PORT_EV_RESUME, RUBY_PORT_EV_VBUS_ON,
+    RUBY_PORT_EV_VBUS_OFF, RUBY_PORT_EV_COUNT
+};
+#define RUBY_PORT_PEND_RESET    (1u << 0)
+#define RUBY_PORT_PEND_VBUS_ON  (1u << 1)
+#define RUBY_PORT_PEND_VBUS_OFF (1u << 2)
+static uint32_t ruby_port_state = RUBY_PORT_UNKNOWN;
+static volatile uint32_t ruby_port_pending;
+static uint32_t ruby_port_evts[RUBY_PORT_EV_COUNT];
+static uint32_t ruby_port_logged;
+
+/*
+ * 0333c: suspend/resume behavior, gated by rubyusb_susp.  The flag is
+ * read by the gadget-side SOF watchdog, which must not mistake a host
+ * U2 suspend for a lost port.
+ */
+volatile int ruby_usb_suspended;
+static uint32_t ruby_susp_enters, ruby_susp_exits, ruby_susp_logged;
+
+static void
+ruby_usb_susp_enter(vm_offset_t mac)
+{
+    (void)mac;
+    if (!ruby_susp_on || ruby_usb_suspended)
+        return;
+    ruby_usb_suspended = 1;
+    ruby_susp_enters++;
+    if (ruby_susp_logged < 8) {
+        ruby_susp_logged++;
+        printf("RUBY EVT: susp enter (qmu frozen)\n");
+    }
+}
+
+static void
+ruby_usb_susp_exit(vm_offset_t mac, int detached)
+{
+    (void)mac;
+    if (!ruby_usb_suspended)
+        return;
+    ruby_usb_suspended = 0;
+    ruby_susp_exits++;
+    if (!detached) {
+        /* Vendor qmu_resume semantics: re-kick, never reset the ring. */
+        ruby_qmu_push_req = 1;
+        ruby_qmu_rx_req = 1;
+        ruby_usb_irq_kick();
+    }
+    if (ruby_susp_logged < 8) {
+        ruby_susp_logged++;
+        printf("RUBY EVT: susp exit detached=%d\n", detached);
+    }
+}
+
+static void
+ruby_port_event(uint32_t ev)
+{
+    uint32_t next = ruby_port_state;
+
+    if (ev >= RUBY_PORT_EV_COUNT)
+        return;
+    ruby_port_evts[ev]++;
+    switch (ev) {
+    case RUBY_PORT_EV_LINK_CONN:
+    case RUBY_PORT_EV_VBUS_ON:
+        ruby_usb_susp_exit(ruby_mac_base, 0);
+        if (ruby_port_state == RUBY_PORT_UNKNOWN)
+            next = ruby_cfg_seen ? RUBY_PORT_CONFIGURED : RUBY_PORT_ATTACHED;
+        break;
+    case RUBY_PORT_EV_RESET:
+        ruby_usb_susp_exit(ruby_mac_base, 0);
+        if (ruby_port_state == RUBY_PORT_UNKNOWN)
+            next = RUBY_PORT_ATTACHED;
+        break;
+    case RUBY_PORT_EV_LINK_DISC:
+    case RUBY_PORT_EV_VBUS_OFF:
+        ruby_usb_susp_exit(ruby_mac_base, 1);
+        next = RUBY_PORT_UNKNOWN;
+        break;
+    case RUBY_PORT_EV_SUSPEND:
+        ruby_usb_susp_enter(ruby_mac_base);
+        if (ruby_port_state != RUBY_PORT_UNKNOWN)
+            next = RUBY_PORT_SUSPENDED;
+        break;
+    case RUBY_PORT_EV_RESUME:
+        ruby_usb_susp_exit(ruby_mac_base, 0);
+        if (ruby_port_state == RUBY_PORT_SUSPENDED)
+            next = ruby_cfg_seen ? RUBY_PORT_CONFIGURED :
+                RUBY_PORT_ATTACHED;
+        break;
+    default:
+        break;
+    }
+    if (next != ruby_port_state) {
+        if (ruby_port_logged < 16) {
+            ruby_port_logged++;
+            printf("RUBY EVT: port %u -> %u (ev=%u)\n",
+                (unsigned)ruby_port_state, (unsigned)next, (unsigned)ev);
+        }
+        ruby_port_state = next;
+    }
+}
