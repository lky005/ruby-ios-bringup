+/* 0223: Function registry (Linux usb_function analogue). Each function
+ * owns its endpoints and a setup handler. CDC-ACM ready: one function may
+ * own several interfaces (Iface0 Comm + Iface1 Data). */
+struct ruby_function {
+    const char *name;
+    int (*setup)(vm_offset_t mac, uint32_t t, uint8_t type, uint8_t req,
+                 uint32_t value, uint32_t index, uint32_t wlen);
+    void (*configure)(vm_offset_t mac);
+};
+static struct ruby_function ruby_funcs[4];
+static uint8_t ruby_n_funcs;
+static void ruby_func_register(const char *name,
+    int (*setup)(vm_offset_t, uint32_t, uint8_t, uint8_t, uint32_t, uint32_t, uint32_t),
+    void (*configure)(vm_offset_t))
+{
+    if (ruby_n_funcs < 4) {
+        ruby_funcs[ruby_n_funcs].name = name;
+        ruby_funcs[ruby_n_funcs].setup = setup;
+        ruby_funcs[ruby_n_funcs].configure = configure;
+        ruby_n_funcs++;
+    }
+}
