+++ b/bsd/kern/sweet_amfi.c
@@ -273,6 +273,21 @@ sweet_amfi_vnode_check_signature(struct vnode *vp, __unused struct label *label,
 	return 0;
 }
 
+static int
+sweet_amfi_policy_syscall(struct proc *p, int call, __unused user_addr_t arg)
+{
+	char name[32];
+	proc_name(proc_pid(p), name, sizeof(name));
+	printf("SWEET AMFI syscall: %s call=0x%x\n", name, call);
+	if (call == 0x5a) {
+		return 0;
+	}
+	if (call == 0x60) {
+		return 0x86;
+	}
+	return ENOTSUP;
+}
