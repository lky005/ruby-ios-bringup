diff --git a/bsd/dev/ruby_usb_mac.h b/bsd/dev/ruby_usb_mac.h
new file mode 100644
index 0000000..0b054bd
--- /dev/null
+++ b/bsd/dev/ruby_usb_mac.h
@@ -0,0 +1,111 @@
+#ifndef _RUBY_USB_MAC_H_
+#define _RUBY_USB_MAC_H_
+
+#include <sys/types.h>
+#include "ruby_usb_ep.h"
+
+/*
+ * 0329a6: shared MTU3 MAC register map (EP0, MAC2, LV1) plus the P2a
+ * trace tags and IPPC OTG/VBUS constants.  Offsets are MAC/IPPC
+ * relative; values move verbatim from ruby_usb.c.
+ */
+/* EP0 registers (MTU3 MAC offsets) */
+#define EP0CSR_OFF      0x0100
+#define RXCOUNT0_OFF    0x0108
+#define FIFO0_OFF       0x0300
+#define EPISR_OFF       0x0080
+
+#define EP0_SENDSTALL   (1u << 25)
+#define EP0_SENTSTALL   (1u << 22)
+#define EP0_DPHTX       (1u << 20)
+#define EP0_DATAEND     (1u << 19)
+#define EP0_TXPKTRDY    (1u << 18)
+#define EP0_SETUPPKTRDY (1u << 17)
+#define EP0_RXPKTRDY    (1u << 16)
+#define EP0_MAXPKTSZ_MSK 0x3ffu
+#define EP0_W1C_BITS    (~(EP0_RXPKTRDY | EP0_SETUPPKTRDY | EP0_SENTSTALL))
+#define EPISR_EP0ISR    (1u << 0)
+#define EPISR_SETUPEND  (1u << 16)
+
+/*
+ * MAC2 common-USB interrupt registers.  Bit 2 of the status is the host
+ * bus reset; the P9 bare-metal probe latched it there and recovered the
+ * device from it.  Offsets are MAC-relative, like the EP0 registers.
+ */
+#define MAC2_INTR_ENABLE_OFF 0x2418
+#define MAC2_INTR_STATUS_OFF 0x241c
+#define MAC2_INTR_RESET      (1u << 2)
+#define MAC2_INTR_RESUME     (1u << 1)
+#define MAC2_INTR_SUSPEND    (1u << 0)
+/* 0202: USB2 frame number; advances on every SOF a live port delivers. */
+
+/*
+ * 0196: MAC level-1 groups (vendor mtu3_hw_regs.h).  LV1ISR is RU -- read
+ * and mask with LV1IER, never write it back; the line clears when the
+ * underlying group sources clear.  The IRQ service enables only the
+ * groups it fully consumes (enable-set <= service-set): BMU/EP0 and
+ * MAC2/reset; QMU stays polled (0194 golden EP2 line) and EP_CTRL/MAC3
+ * stay off, so an enabled-but-unserviced group can never storm the line.
+ */
+#define LV1ISR_OFF      0x0000
+#define LV1IER_OFF      0x0004
+#define LV1IESR_OFF     0x0008
+#define EPIER_OFF       0x0084
+#define EPIESR_OFF      0x0088
+#define EPIECR_OFF      0x008c
+#define LV1_BMU_INTR    (1u << 0)
+#define LV1_QMU_INTR    (1u << 1)
+#define LV1_MAC3_INTR   (1u << 2)
+#define LV1_MAC2_INTR   (1u << 4)
+#define LV1_EPCTRL_INTR (1u << 5)
+#define RUBY_IRQ_LV1_SET (LV1_BMU_INTR | LV1_MAC2_INTR)
+
+/* IPPC OTG status: bit 9 is the VBUS sense (the P4 probe read it as such). */
+#define IPPC_OTG_STS_OFF 0x18
+#define OTG_VBUS_VALID   (1u << 9)
+
+/* Polls a VBUS state may take to settle; the thread polls every 1 ms. */
+#define RUBY_VBUS_DEBOUNCE 100
+
+#define RUBY_REARM_RESET  0
+
+/* P2a trace ring: snapshots and EP0 setup attempts, dumped once. */
+#define RUBY_TRACE_MAX  512
+#define RUBY_TR_SNAP    1
+#define RUBY_TR_SETUP   2
+#define RUBY_TR_STALL   3
+#define RUBY_TR_STATE   4
+#define RUBY_TR_NOTE    5
+#define RUBY_TR_RAW     6
+#define RUBY_TR_ACK     7
+#define RUBY_TR_SEND    8
+#define RUBY_TR_ADDR    9
+#define RUBY_TR_CFG     10
+#define RUBY_TR_TX      11
+
+extern uint32_t sweet_log_copy(uint64_t *pos, char *out, uint32_t max);
+extern uint64_t sweet_log_position(void);
+
+#endif /* _RUBY_USB_MAC_H_ */
+#define EP0_FIFOFULL   (1u << 23)
+#define FRAME_NUM_OFF   0x243c          /* U3D_USB20_FRAME_NUM */
+#define RUBY_REARM_ATTACH 1
+#define RUBY_TR_STATUS  12
+#define RUBY_EP0_TXBUF 512
+#define RUBY_CMD_MAX 64
+#define RUBY_EP0_SPINS       15
+#define RUBY_EP0_SPIN_US     10
+#define TX3CSR0_OFF     0x0130
+#define TX3CSR1_OFF     0x0134
+#define TX3CSR2_OFF     0x0138
+
+#define RUBY_DESC_MAX       (9 + 9 * 8 + 7 * RUBY_EP_MAX)  /* cfg+ifs+eps */
