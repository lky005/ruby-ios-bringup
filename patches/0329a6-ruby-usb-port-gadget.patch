index 0000000..d94b53b
--- /dev/null
+++ b/bsd/dev/ruby_usb_port.c
@@ -0,0 +1,870 @@
+/*
+ * 0329a6: L1 port/controller moved verbatim from ruby_usb.c.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <vm/vm_kern.h>
