+void
+ruby_ep0_standard(vm_offset_t mac, uint32_t t, uint8_t type, uint8_t req,
+    uint32_t value, uint32_t index, uint32_t wlen)
+{
+    uint16_t key = ((uint16_t)type << 8) | req;
+    const uint8_t *desc;
+    uint32_t desc_len;
+    uint8_t byte;
+    uint8_t status[2] = { 0, 0 };
+
+    (void)index;
+
+    switch (req) {
+    case 6: /* GET_DESCRIPTOR */
+        desc = ruby_descriptor(value, &desc_len);
+        if (desc == NULL)
+            ruby_ep0_stall(mac, t, key, wlen);
+        else if (wlen == 0)
+            ruby_ep0_ack(mac, t, key, wlen);
+        else
+            ruby_ep0_send(mac, t, key, desc, desc_len, wlen);
+        return;
+    case 5: /* SET_ADDRESS */
+        if (wlen != 0) {
+            ruby_ep0_stall(mac, t, key, wlen);
+            return;
+        }
+        {
+            uint32_t v = ruby_rd32(mac, DEVICE_CONF - MTU3_PA);
+
+            v &= ~0x7f000000u;
+            v |= (value & 0x7fu) << 24;
+            ruby_wr32(mac, DEVICE_CONF - MTU3_PA, v);
+            ruby_trace(t, RUBY_TR_ADDR, value & 0x7f, v, 0, 0);
+        }
+        ruby_ep0_ack(mac, t, key, wlen);
+        return;
+    case 9: /* SET_CONFIGURATION */
+        ruby_seq("CFG_IN", value, ruby_config | (ruby_cfg_seen << 8));
+        ruby_config = value & 0xff;
+        ruby_cfg_seen = 1;
+        ruby_trace(t, RUBY_TR_CFG, ruby_config, 0, 0, 0);
+        /* 0290: mode 2 pulses EP_RST before the status ACK, i.e. before the
+         * host is told to reset its own IN toggle. */
+        if (ruby_cfgrst_mode == 2 && (ruby_ep2log_on || ruby_echo_en) &&
+            !ruby_ep_ready) {
+            ruby_ep2_eprst_tx(mac);
+            ruby_seq("EPRST_PRE", ruby_cfgrst_mode, ruby_cfg_seen);
+        }
+        /*
+         * 0304: vendor composite enables functions/endpoints before the
+         * SET_CONFIGURATION status stage.  cfg_pre selects that ordering;
+         * default keeps the 0303 ACK-then-config sequence.
+         */
+        if (ruby_cfg_pre) {
+            ruby_config_eps(mac);
+            ruby_seq("CFG_PRE", ruby_cfg_pre, ruby_ep_ready);
+        }
+        ruby_ep0_ack(mac, t, key, wlen);
+        ruby_seq("CFG_STATUS", ruby_cfg_pre, ruby_ep_ready);
+        if (!ruby_cfg_pre)
+            ruby_config_eps(mac);
+        return;
+    case 8: /* GET_CONFIGURATION */
+        byte = ruby_config;
+        ruby_ep0_send(mac, t, key, &byte, 1, wlen);
+        return;
+    case 0: /* GET_STATUS */
+        ruby_ep0_send(mac, t, key, status, 2, wlen);
+        return;
+    case 10: /* GET_INTERFACE */
+        byte = 0;
+        ruby_ep0_send(mac, t, key, &byte, 1, wlen);
+        return;
+    case 11: /* SET_INTERFACE */
+        ruby_ep0_ack(mac, t, key, wlen);
+        return;
+    case 1: /* CLEAR_FEATURE */ {
+        uint32_t act = 0;
+
+        /*
+         * 0300: one path for the bulk IN halt.  0x81 and 0x82 both take
+         * the vendor stall-bit/toggle clear plus the standard QMU queue
+         * restart (ruby_tx_halt_clear).  0x01 keeps the verified 0298 RX
+         * light clear; 0x02 keeps the RX queue restart.
+         */
+        if (index == 0x81)
+            ruby_clr81_reqs++;
+        if (index == 0x01)
+            ruby_clr01_reqs++;
+        if (wlen == 0 && value == 0) {
+            if (index == 0x81 || index == 0x82 ||
+                index == ruby_tx_ep_addr) {
+                ruby_tx_halt_clear(mac);
+                act = 1;
+            } else if (index == 0x02)
+                ruby_ep2_rx_halt_clear(mac);
+            else if (index == 0x01 && ruby_clr01_en)
+                ruby_ep2_rx_halt_clear_light(mac);
+        }
+        if (act)
+            ruby_clr81_hits[act]++;
+        if (wlen == 0)
+            ruby_ep0_ack(mac, t, key, wlen);
+        else
+            ruby_ep0_stall(mac, t, key, wlen);
+        return;
+    }
+    case 3: /* SET_FEATURE */
+        if (wlen == 0)
+            ruby_ep0_ack(mac, t, key, wlen);
+        else
+            ruby_ep0_stall(mac, t, key, wlen);
+        return;
+    default:
+        /* 0223: function-level setup dispatch (vendor class later). */
+        for (int fi = 0; fi < ruby_n_funcs; fi++) {
+            if (ruby_funcs[fi].setup &&
+                ruby_funcs[fi].setup(mac, t, type, req, value, index, wlen) == 0)
+                return;
+        }
+        ruby_ep0_stall(mac, t, key, wlen);
+        return;
+    }
+}
+
+void
+ruby_ep0_capture(vm_offset_t mac, uint32_t t)
+{
+    static uint32_t last_key, last_value, last_len, retry;
+    static uint32_t short_run;
+    uint32_t count = ruby_rd32(mac, RXCOUNT0_OFF);
+    uint32_t csr = ruby_rd32(mac, EP0CSR_OFF);
+    uint32_t w0, w1, key;
+    uint32_t value, index, len;
+    uint8_t st[8];
+
+    /*
+     * A SETUP packet is 8 bytes; a short count means the packet is still
+     * arriving.  Never STALL here: the vendor ISR logs and returns, P9
+     * prints and returns.  A new SETUP or the next poll will re-read it.
+     */
+    if (count < 8) {
+        ruby_ep0_short++;
+        if (short_run++ == 0)
+            ruby_trace(t, RUBY_TR_NOTE, 1, count, csr, 0);
+        return;
+    }
+    short_run = 0;
+
+    if (count > 8) {
+        /* Stale bytes in the FIFO: drop them and let the host retry. */
+        for (uint32_t i = 0; i < count; i++)
+            (void)ruby_rd8(mac, FIFO0_OFF);
+        ruby_ep0_long++;
+        ruby_trace(t, RUBY_TR_NOTE, 7, count, csr, 0);
+        return;
+    }
+    ruby_ep0_setups++;
+
+    /*
+     * U3D_FIFO0 is a 32-bit data port.  Read both setup words from the
+     * same address; reading FIFO0+4 left RXCOUNT0=4 in the P2a trace.
+     */
+    w0 = ruby_rd32(mac, FIFO0_OFF);
+    w1 = ruby_rd32(mac, FIFO0_OFF);
+    ruby_trace(t, RUBY_TR_RAW, 0, w0, w1, ruby_rd32(mac, RXCOUNT0_OFF));
+    st[0] = w0;
+    st[1] = w0 >> 8;
+    st[2] = w0 >> 16;
+    st[3] = w0 >> 24;
+    st[4] = w1;
+    st[5] = w1 >> 8;
+    st[6] = w1 >> 16;
+    st[7] = w1 >> 24;
+
+    value = st[2] | (st[3] << 8);
+    index = st[4] | (st[5] << 8);
+    len = st[6] | (st[7] << 8);
+    key = ((uint32_t)st[0] << 8) | st[1];
+
+    if (key == last_key && value == last_value && len == last_len) {
+        retry++;
+    } else {
+        retry = 1;
+        last_key = key;
+        last_value = value;
+        last_len = len;
+    }
+    if (retry == 1 || (retry & 0xf) == 0)
+        ruby_trace(t, RUBY_TR_SETUP, key, (value << 16) | index, len, retry);
+
+    if ((st[0] & 0x60) == 0)
+        ruby_ep0_standard(mac, t, st[0], st[1], value, index, len);
+    else if (st[0] == 0xc0 && st[1] == 0x21)
+        ruby_ep0_vendor_state(mac, t, len);
+    else if (st[0] == 0xc0 && st[1] == 0x22)
+        ruby_ep0_vendor_diag(mac, t, len);
+    else if (st[0] == 0xc0 && st[1] == 0x23)
+        ruby_ep0_vendor_rx(mac, t, len);
+    else if (st[0] == 0xc0 && st[1] == 0x24)
+        ruby_ep0_vendor_rx_gpd(mac, t, len);
+    else if (st[0] == 0xc0 && st[1] == 0x26)
+        ruby_ep0_vendor_rx_reset(mac, t, len);
+    else if (st[0] == 0xc0 && st[1] == 0x27)
+        ruby_ep0_vendor_ep0_diag(mac, t, len);
+    else if (st[0] == 0xc0 && st[1] == 0x28)
+        ruby_ep0_vendor_ep0_bulk(mac, t, len);
+    else if (st[0] == 0xc0 && st[1] == 0x29)
+        ruby_ep0_vendor_txprobe(mac, t, len);
+    else if (st[0] == 0xc0 && st[1] == 0x30)
+        ruby_ep0_vendor_audit(mac, t, len);
+    else if (st[0] == 0xc0 && st[1] == 0x2a)
+        ruby_ep0_vendor_log(mac, t, value, index, len);
+    else if (st[0] == 0xc0 && st[1] == 0x2b)
+        ruby_ep0_vendor_log_info(mac, t, len);
+    else if (st[0] == 0xc0 && st[1] == 0x2c)
+        ruby_ep0_vendor_probe_read(mac, t, value, index, len);
+    else if (st[0] == 0x40 && st[1] == 0x2d)
+        ruby_ep0_vendor_probe_write(mac, t, value, index, len);
+    else if (st[0] == 0x40 && st[1] == 0x2e)
+        ruby_ep0_vendor_cmd(mac, t, value, index, len);
+    else if (st[0] == 0x21 && st[1] == 0x20) {
+        /* 0230: ACK the SETUP without DATAEND so the 7B OUT data stage can
+         * arrive -- same 0131b rule as vendor probe_write/cmd.  Without it
+         * the host stalls the transfer before ruby_ep0_service() sees
+         * EP0_RXPKTRDY (0229 left the setup unacknowledged: SetCommState
+         * ended in USBD_STATUS_XACT_ERROR, WinError 31).
+         * ruby_ep0_service completes status with RXPKTRDY|DATAEND. */
+        acm_ep0_rx.state = EP0_STATE_WAIT_LINE_CODING;
+        {
+            uint32_t csr = ruby_rd32(mac, EP0CSR_OFF) & EP0_W1C_BITS;
+
+            csr |= EP0_SETUPPKTRDY;
+            ruby_wr32(mac, EP0CSR_OFF, csr);
+        }
+    } else if (st[0] == 0x21 && st[1] == 0x22) {
+        /* CDC SET_CONTROL_LINE_STATE: store DTR/RTS from wValue */
+        ruby_acm_control_state = (uint16_t)value;
+        ruby_acm_control_state_set++;
+        ruby_ep0_ack(mac, t, key, len);
+    } else if (st[0] == 0xA1 && st[1] == 0x21) {
+        /* CDC GET_LINE_CODING: return stored 7B (not constant) */
+        ruby_ep0_send(mac, t, key, ruby_acm_line_coding, 7, len);
+    } else if (st[0] == 0xA1 && st[1] == 0x20) {
+        ruby_ep0_stall(mac, t, key, len);
+    } else
+        ruby_ep0_stall(mac, t, key, len);
+}
+
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+
+void
+ruby_ep0_service(vm_offset_t mac, uint32_t t)
+{
+    uint32_t v, epi;
+
+    /*
+     * 0196: the bus-reset two-beat moved to the callers (the polling
+     * call sites and, in IRQ mode, the service workloop pass), so the
+     * same beat is never sampled twice inside one pass.
+     */
+
+    /*
+     * EPISR is W1C and is drained every round (vendor ISR inspects
+     * EP0ISR|SETUPEND before clearing it).  SETUPEND means hardware
+     * aborted the current data stage: drop the software context, do not
+     * wait for TXPKTRDY and do not STALL.
+     */
+    epi = ruby_rd32(mac, EPISR_OFF);
+    if (epi & EPISR_SETUPEND) {
+        ruby_ep0_tx_pending = 0;
+        ruby_ep0_tx_sent = 0;
+        ruby_ep0_tx_total = 0;
+        ruby_ep0_rewinds++;
+    }
+    if (epi)
+        ruby_wr32(mac, EPISR_OFF, epi);
+
+    v = ruby_rd32(mac, EP0CSR_OFF);
+
+    if (!(v & EP0_SETUPPKTRDY) && (v & EP0_MAXPKTSZ_MSK) != 64) {
+        ruby_ep0_set_maxpacket(mac);
+        ruby_trace(t, RUBY_TR_NOTE, 2, v, ruby_rd32(mac, EP0CSR_OFF), 0);
+        v = ruby_rd32(mac, EP0CSR_OFF);
+    }
+    if (v & EP0_SENTSTALL) {
+        /* EP0_SENTSTALL is W1C; write it back to clear the stall. */
+        ruby_ep0_sentstalls++;
+        ruby_wr32(mac, EP0CSR_OFF,
+            (ruby_rd32(mac, EP0CSR_OFF) & EP0_W1C_BITS) | EP0_SENTSTALL);
+        if (ruby_ep0_sentstalls == 1 ||
+            (ruby_ep0_sentstalls & 0xf) == 0)
+            ruby_trace(t, RUBY_TR_NOTE, 3, v, 0, 0);
+    }
+    if (v & EP0_SETUPPKTRDY) {
+        /* A new SETUP aborts any unfinished data stage. */
+        ruby_ep0_tx_pending = 0;
+        ruby_ep0_tx_sent = 0;
+        ruby_ep0_tx_total = 0;
+        ruby_probe_wr_pending = 0;
+        ruby_cmd_out_pending = 0;
+        ruby_ep0_capture(mac, t);
+        return;
+    }
+    if (ruby_ep0_tx_pending)
+        ruby_ep0_tx_service(mac, t);
+
+    v = ruby_rd32(mac, EP0CSR_OFF);
+    if (v & EP0_RXPKTRDY) {
+        uint32_t count = ruby_rd32(mac, RXCOUNT0_OFF);
+        uint32_t csr;
+
+        if (acm_ep0_rx.state == EP0_STATE_WAIT_LINE_CODING) {
+            /* 0229 isolation: consume 7B into the private slot, ACK RX+DATAEND,
+             * then return BEFORE cmd_consume / TX-drain ever see these bytes. */
+            if (count == 7) {
+                ruby_ep0_read_fifo_bytes(mac, acm_ep0_rx.buf, 7);
+                {
+                    uint8_t *lc = acm_ep0_rx.buf;
+                    uint32_t baud = lc[0] | (lc[1] << 8) | (lc[2] << 16) | (lc[3] << 24);
+                    uint8_t fmt = lc[4], par = lc[5], bits = lc[6];
+                    int ok = (baud == 300 || baud == 1200 || baud == 2400 || baud == 4800 ||
+                              baud == 9600 || baud == 38400 || baud == 57600 || baud == 115200) &&
+                             fmt <= 2 && par <= 2 &&
+                             (bits == 5 || bits == 6 || bits == 7 || bits == 8 || bits == 16);
+                    if (ok) {
+                        ruby_acm_line_coding[0]=lc[0]; ruby_acm_line_coding[1]=lc[1];
+                        ruby_acm_line_coding[2]=lc[2]; ruby_acm_line_coding[3]=lc[3];
+                        ruby_acm_line_coding[4]=lc[4]; ruby_acm_line_coding[5]=lc[5];
+                        ruby_acm_line_coding[6]=lc[6];
+                        ruby_acm_line_coding_set++;
+                    }
+                }
+            } else {
+                ruby_ep0_drain_fifo(mac, count);
+            }
+            acm_ep0_rx.state = EP0_STATE_IDLE;
+            csr = ruby_rd32(mac, EP0CSR_OFF) & EP0_W1C_BITS;
+            ruby_wr32(mac, EP0CSR_OFF, csr | EP0_RXPKTRDY | EP0_DATAEND);
+            ruby_trace(t, RUBY_TR_STATUS, 1, v, count, ruby_rd32(mac, EP0CSR_OFF));
+            return;
+        }
+        if (ruby_cmd_out_pending) {
+            if (count == ruby_cmd_out_len && count <= RUBY_CMD_MAX) {
+                ruby_ep0_read_fifo_bytes(mac,
+                    (uint8_t *)ruby_cmd_line, count);
+                ruby_cmd_line[count] = '\0';
+                ruby_cmd_out_pending = 0;
+                ruby_cmd_submit(ruby_cmd_out_seq, ruby_cmd_line);
+            } else {
+                ruby_ep0_drain_fifo(mac, count);
+                ruby_cmd_out_pending = 0;
+                ruby_cmd_errors++;
+                printf("RUBY CMD[%u]: bad len=%u\n",
+                    ruby_cmd_out_seq, count);
+            }
+        } else if (ruby_probe_wr_pending) {
+            uint32_t pa = ruby_probe_wr_pa;
+            uint32_t val = 0;
+
+            ruby_probe_wr_pending = 0;
+            if (count == 4) {
+                val = ruby_rd32(mac, FIFO0_OFF);
+                if (ruby_probe_write32(pa, val)) {
+                    uint32_t rb = 0;
+
+                    (void)ruby_probe_read32(pa, &rb);
+                    ruby_seq("PROBE_W32", pa, val);
+                    printf("RUBY USB: probe w32[%08x]=%08x -> %08x\n",
+                        pa, val, rb);
+                } else {
+                    printf("RUBY USB: probe w32 unmapped %08x\n", pa);
+                }
+            } else {
+                ruby_ep0_drain_fifo(mac, count);
+                printf("RUBY USB: probe w32 bad len=%u\n", count);
+            }
+        } else {
+            ruby_ep0_drain_fifo(mac, count);
+        }
+        csr = ruby_rd32(mac, EP0CSR_OFF) & EP0_W1C_BITS;
+        csr |= EP0_RXPKTRDY | EP0_DATAEND;
+        ruby_wr32(mac, EP0CSR_OFF, csr);
+        ruby_trace(t, RUBY_TR_STATUS, 0, v, count,
+            ruby_rd32(mac, EP0CSR_OFF));
+    }
+}
+
+/*
+ * 0202: SOF-advancement watchdog.  A host port disable/enable cycle issues
+ * no bus reset the device can catch (measured: bus_resets frozen through the
+ * disable) and the MAC2 suspend interrupt never fires (suspend=0), so the
+ * device is left detached with its D+ enable bit still set and no event to
+ * recover on -- a physical replug was the only way back.  USB2 SOF is only
+ * delivered to enabled ports, so a frozen frame number while configured
+ * means the host port is gone; re-present the device with a full PHY
+ * re-attach so the host re-detects it when the port is re-enabled.
+ */
+#define RUBY_FRAME_WD_MS 500u           /* SOF frozen this long = port lost */
+
+void
+ruby_usb_frame_watchdog(vm_offset_t mac)
+{
+    static uint32_t last_frame, last_change_ms, cooldown_until;
+    static int primed;
+    uint32_t frame;
+
+    if (!ruby_cfg_seen || mac == 0) {
+        primed = 0;
+        return;
+    }
+    frame = ruby_rd32(mac, FRAME_NUM_OFF) & 0x7ffu;
+    if (!primed) {
+        primed = 1;
+        last_frame = frame;
+        last_change_ms = ruby_ms;
+        return;
+    }
+    if (frame != last_frame) {
+        last_frame = frame;
+        last_change_ms = ruby_ms;
+        return;
+    }
+    if (ruby_ms < cooldown_until)
+        return;
+    if (ruby_ms - last_change_ms < RUBY_FRAME_WD_MS)
+        return;
+    cooldown_until = ruby_ms + 5000;
+    last_change_ms = ruby_ms;
+    printf("RUBY USB: t=%u SOF frozen %u ms (cfg=1 frame=%u), re-attach\n",
+        ruby_ms, RUBY_FRAME_WD_MS, frame);
+    ruby_usb_reattach_owned(mac, ruby_phy_base);
+    ruby_enum_assist_until = ruby_ms + 15000;
+}
+
+void
+ruby_ep0_thread(void *arg, wait_result_t wr)
+{
+    (void)arg;
+    (void)wr;
+    for (;;) {
+        uint32_t now = ruby_ms;
+        int assist = ruby_enum_assist_until != 0 &&
+            now < ruby_enum_assist_until;
+
+        /*
+         * A runtime reattach happens after the boot window, where EP0 is
+         * serviced at 1 ms.  Run the boot-window 100 us cadence for a
+         * bounded time so the host's descriptor/address sequence does
+         * not lose the DATAEND race.
+         */
+        if (assist && ruby_cfg_seen &&
+            ruby_enum_assist_until > now + 200)
+            ruby_enum_assist_until = now + 200;
+        assist = ruby_enum_assist_until != 0 &&
+            now < ruby_enum_assist_until;
+        if (ruby_irq_mode) {
+            /*
+             * 0196: EP0 and the reset two-beat live on the IRQ service
+             * workloop (INTID160); this tick keeps command execution,
+             * the EP2 polls and the attach/heartbeat work only.
+             */
+        } else if (assist) {
+            for (uint32_t i = 0; i < 10; i++) {
+                ruby_usb_reset_check(ruby_mac_base);
+                ruby_ep0_service(ruby_mac_base, 0);
+                delay(100);
+            }
+        } else {
+            ruby_usb_reset_check(ruby_mac_base);
+            ruby_ep0_service(ruby_mac_base, 0);
+        }
+        ruby_cmd_tick(ruby_mac_base);
+        ruby_usb_attach_poll(ruby_mac_base, ruby_ippc_base);
+        ruby_usb_frame_watchdog(ruby_mac_base);
+        ruby_usb_heartbeat(ruby_mac_base, ruby_ippc_base);
+        if (ruby_qmu_irq_mode) {
+            /*
+             * 0197: the EP2 data plane lives on the IRQ workloop.  The
+             * tick keeps the two kick-based liveness duties only; every
+             * mutation happens on the workloop.
+             */
+            ruby_ep2_tick_assist(ruby_mac_base);
+        } else {
+            ruby_tx_recover_poll(ruby_mac_base);
+            ruby_ep2_status_poll(ruby_mac_base);
+            ruby_ep2_push_log(ruby_mac_base);
+            ruby_txbell_poll(ruby_mac_base);
+            ruby_ep2_rx_poll(ruby_mac_base);
+        }
+        ruby_ms++;
+        if (!assist)
+            delay(1000);
+    }
+}
+
+void
+ruby_ep0_vendor_state(vm_offset_t mac, uint32_t t, uint32_t wlen)
+{
+    uint32_t v[16] __attribute__((aligned(16)));
+
+    v[0] = 0x45503253u;         /* "EP2S" */
+    v[1] = (ruby_push_seq & 0xffffu) | ((ruby_gpd_enq & 0xfu) << 16) |
+        ((ruby_tx_busy & 1u) << 20) | ((ruby_ep_ready & 1u) << 21) |
+        ((ruby_stall_seen & 0xffu) << 24);
+    v[2] = ruby_push_tries;
+    v[3] = ruby_rd32(mac, QISAR0_OFF);
+    v[4] = ruby_rd32(mac, QISAR1_OFF);
+    v[5] = ruby_rd32(mac, TQERRIR0_OFF);
+    v[6] = ruby_rd32(mac, TQCSR1_OFF);
+    v[7] = ruby_rd32(mac, TX1CSR0_OFF);
+    v[8] = ruby_q1_last;
+    v[9] = ruby_err_last;
+    v[10] = ruby_recoveries;
+    v[11] = ruby_busy_ticks;
+    v[12] = ruby_rd32(mac, CAP_EP0FFSZ_OFF);
+    v[13] = ruby_rd32(mac, CAP_EPNTXFFSZ_OFF);
+    v[14] = ruby_rd32(mac, CAP_EPNRXFFSZ_OFF);
+    v[15] = ruby_rd32(mac, CAP_EPINFO_OFF);
+    ruby_ep0_send(mac, t, 0xc021, (const uint8_t *)v, sizeof(v), wlen);
+}
+
+/* 0265: read-only TX handoff black box (16 words, 0xC0/0x29). */
+void
+ruby_ep0_vendor_txprobe(vm_offset_t mac, uint32_t t, uint32_t wlen)
+{
+    uint32_t v[16] __attribute__((aligned(16)));
+
+    v[0] = 0x35325854u;         /* "TX25" */
+    v[1] = ruby_tx_kick_cnt;
+    v[2] = ruby_tx_kick_src;
+    v[3] = ruby_tx_kick_cnt ?
+        (uint32_t)(ruby_ms - ruby_tx_kick_ms) : 0xffffffffu;
+    v[4] = ruby_rd32(mac, TQCSR1_OFF);
+    v[5] = ruby_rd32(mac, TQCPR1_OFF);
+    v[6] = ruby_rd32(mac, TQHIAR1_OFF);
+    v[7] = ruby_rd32(mac, TX1CSR0_OFF);
+    v[8] = ruby_inflight;
+    v[9] = (ruby_gpd_enq & 0xffu) | ((ruby_gpd_deq & 0xffu) << 8);
+    v[10] = (uint32_t)ruby_ep2_hwo_bits();
+    v[11] = ruby_rd32(mac, QISAR0_OFF);
+    v[12] = ruby_rd32(mac, QISAR1_OFF);
+    v[13] = ruby_bulk_dup_cnt;
+    v[14] = ruby_bulk_dup_a;
+    v[15] = ruby_bulk_dup_b;
+    ruby_ep0_send(mac, t, 0xc029, (const uint8_t *)v, sizeof(v), wlen);
+}
+
+/* 0293: read-only audit counters (16 words, 0xC0/0x30). */
+__attribute__((optnone)) void
+ruby_ep0_vendor_audit(vm_offset_t mac, uint32_t t, uint32_t wlen)
+{
+    uint32_t v[16] __attribute__((aligned(16)));
+
+    v[0] = 0x33323930u;         /* "0293" */
+    v[1] = ruby_clr81_hits[0];
+    v[2] = ruby_clr81_hits[1];
+    v[3] = ruby_clr81_hits[2];
+    v[4] = ruby_clr81_hits[3];
+    v[5] = ruby_clr81_reqs;
+    v[6] = 0;                   /* 0300: EP_RST no longer fires from resume */
+    v[7] = ruby_resume_vendor_cnt;
+    v[8] = ruby_ep2_tx_restarts;
+    v[9] = (ruby_recover_suppressed[0] & 0xffu) |
+        ((ruby_recover_suppressed[1] & 0xffu) << 8) |
+        ((ruby_recover_suppressed[2] & 0xffu) << 16);
+    v[10] = (uint32_t)ruby_recover_mask;
+    v[11] = ruby_txkick_starts;
+    v[12] = ruby_tx_kick_total[RUBY_TX_SRC_PUSH];
+    v[13] = ruby_tx_reset_tries;
+    v[14] = ruby_tx_queue_started;
+    v[15] = (ruby_gpd_enq & 0xffu) | ((ruby_gpd_deq & 0xffu) << 8) |
+        ((ruby_inflight & 0xffu) << 16);
+    ruby_ep0_send(mac, t, 0xc030, (const uint8_t *)v, sizeof(v), wlen);
+}
+
+/* Vendor IN request 0xC0/0x22: read-only queue diagnostics. */
+void
+ruby_ep0_vendor_diag(vm_offset_t mac, uint32_t t, uint32_t wlen)
+{
+    uint32_t v[8];
+    uint32_t txcpr, txhiar, i;
+    uint64_t hwo = 0;
+
+    if (!ruby_dma_uc)
+        ruby_dc_civac(ruby_gpd_ring, RUBY_GPD_RING_SZ);
+    for (i = 0; i < ruby_tx_ring_n; i++)
+        if (RUBY_GPD_SLOT(i)[0] & 1u)
+            hwo |= 1ull << i;
+    txcpr = ruby_rd32(mac, TQCPR1_OFF);
+    txhiar = ruby_rd32(mac, TQHIAR1_OFF);
+
+    v[0] = 0x45503244u;         /* "EP2D" */
+    v[1] = txcpr;
+    v[2] = ((txhiar >> 8) & 0xfu) |
+        ((ruby_popcount64(hwo) & 0xffu) << 8) |
+        ((ruby_inflight & 0xfu) << 16) | ((ruby_gpd_enq & 0xfu) << 20) |
+        ((ruby_gpd_deq & 0xfu) << 24);
+    v[3] = ruby_txdone_count;
+    v[4] = ruby_recoveries;
+    v[5] = ruby_rd32(mac, QISAR0_OFF);
+    v[6] = ruby_rd32(mac, QISAR1_OFF);
+    v[7] = ruby_rd32(mac, TQERRIR0_OFF);
+    ruby_ep0_send(mac, t, 0xc022, (const uint8_t *)v, sizeof(v), wlen);
+}
+
+/* Vendor IN request 0xC0/0x23: read-only EP2 RX diagnostics. */
+void
+ruby_ep0_vendor_rx(vm_offset_t mac, uint32_t t, uint32_t wlen)
+{
+    uint32_t v[16] __attribute__((aligned(16)));
+    uint32_t hwo = 0, i;
+
+    if (!ruby_rx_uc)
+        ruby_dc_civac(ruby_rx_gpd_ring_cpu, RUBY_RX_GPD_RING_SZ);
+    for (i = 0; i < ruby_rx_ring_n; i++)
+        if (ruby_rx_gpd_ring_cpu[i * 16] & 1u)
+            hwo |= 1u << i;
+
+    v[0] = 0x45503252u;         /* "EP2R" */
+    v[1] = ruby_rx_packets;
+    v[2] = ruby_rx_bytes;
+    v[3] = ruby_rx_zlp;
+    v[4] = ruby_rx_last_len;
+    v[5] = ruby_rx_crc;
+    v[6] = ruby_rd32(mac, RQCPR1_OFF);
+    v[7] = ruby_rd32(mac, RQHIAR1_OFF);
+    v[8] = ruby_rd32(mac, RQCSR1_OFF);
+    v[9] = ruby_rd32(mac, QISAR0_OFF);
+    v[10] = ruby_rd32(mac, QISAR1_OFF);
+    v[11] = ruby_rd32(mac, RQERRIR0_OFF);
+    v[12] = ruby_rd32(mac, RQERRIR1_OFF);
+    v[13] = ruby_rx_errors;
+    v[14] = (ruby_rx_empty & 0xffffu) | ((ruby_rx_ext_bad & 0xffffu) << 16);
+    v[15] = (ruby_rx_deq & 0xfu) | ((hwo & 0xfu) << 4) |
+        ((ruby_rx_bypasses & 0xffu) << 8) |
+        ((ruby_rx_done_events & 0xffffu) << 16);
+    ruby_ep0_send(mac, t, 0xc023, (const uint8_t *)v, sizeof(v), wlen);
+}
+
+/* Vendor IN request 0xC0/0x24: raw current/prev/next RX GPD + RX CSRs. */
+__attribute__((optnone)) void
+ruby_ep0_vendor_rx_gpd(vm_offset_t mac, uint32_t t, uint32_t wlen)
+{
+    uint32_t v[16] __attribute__((aligned(16)));
+    uint32_t rqcpr, rqhiar, rqcsr, rx0, rx1, rx2, hwo = 0, cur, i;
+    uint32_t *g;
+
+    if (!ruby_rx_uc)
+        ruby_dc_civac(ruby_rx_gpd_ring_cpu, RUBY_RX_GPD_RING_SZ);
+    for (i = 0; i < ruby_rx_ring_n; i++)
+        if (ruby_rx_gpd_ring_cpu[i * 16] & 1u)
+            hwo |= 1u << i;
+
+    rqcpr = ruby_rd32(mac, RQCPR1_OFF);
+    rqhiar = ruby_rd32(mac, RQHIAR1_OFF);
+    rqcsr = ruby_rd32(mac, RQCSR1_OFF);
+    rx0 = ruby_rd32(mac, RX1CSR0_OFF);
+    rx1 = ruby_rd32(mac, RX1CSR1_OFF);
+    rx2 = ruby_rd32(mac, RX1CSR2_OFF);
+    cur = ruby_ep2_rx_cur_slot(mac);
+
+    v[0] = 0x47325045u;         /* "EP2G" */
+    v[1] = rqcpr;
+    v[2] = rqhiar;
+    v[3] = rqcsr;
+    v[4] = rx0;
+    v[5] = rx1;
+    v[6] = rx2;
+    v[7] = hwo;
+    v[8] = cur;
+    v[9] = v[10] = v[11] = v[12] = v[13] = v[14] = 0;
+    if (cur != 0xffu) {
+        uint32_t prev = (cur + ruby_rx_ring_n - 1u) % ruby_rx_ring_n;
+        uint32_t next = (cur + 1u) % ruby_rx_ring_n;
+
+        g = (uint32_t *)(ruby_rx_gpd_ring_cpu + cur * 16);
+        v[9] = g[0];
+        v[10] = g[1];
+        v[11] = g[2];
+        v[12] = g[3];
+        v[13] = *(uint32_t *)(ruby_rx_gpd_ring_cpu + prev * 16 + 12);
+        v[14] = *(uint32_t *)(ruby_rx_gpd_ring_cpu + next * 16 + 12);
+    }
+    v[15] = (ruby_rx_zlp_err & 0xffffu) |
+        ((ruby_rx_stall_seen & 1u) << 16) |
+        ((ruby_rx_ready & 1u) << 31);
+    ruby_ep0_send(mac, t, 0xc024, (const uint8_t *)v, sizeof(v), wlen);
+}
+
+/* Vendor IN request 0xC0/0x26: reset the RX ring/counters for a clean test. */
+void
+ruby_ep0_vendor_rx_reset(vm_offset_t mac, uint32_t t, uint32_t wlen)
+{
+    uint32_t v[1];
+
+    ruby_ep2_rx_reset(mac, 1);
+    v[0] = 0x4b4f5852u;         /* "RXOK" */
+    ruby_ep0_send(mac, t, 0xc026, (const uint8_t *)v, sizeof(v), wlen);
+}
+
+/* Vendor IN request 0xC0/0x27: EP0 state machine counters. */
+void
+ruby_ep0_vendor_ep0_diag(vm_offset_t mac, uint32_t t, uint32_t wlen)
+{
+    uint32_t v[16] __attribute__((aligned(16)));
+
+    v[0] = 0x44305045u;         /* "EP0D" */
+    v[1] = ruby_ep0_setups;
+    v[2] = ruby_ep0_short;
+    v[3] = ruby_ep0_long;
+    v[4] = ruby_ep0_txpkts;
+    v[5] = ruby_ep0_dataends;
+    v[6] = ruby_ep0_sentstalls;
+    v[7] = ruby_ep0_rewinds;
+    v[8] = ruby_bus_resets;
+    v[9] = (ruby_config & 0xffu) | ((ruby_ep_ready & 1u) << 8) |
+        ((ruby_rx_ready & 1u) << 9);
+    v[10] = ruby_rd32(mac, EP0CSR_OFF);
+    v[11] = ruby_rd32(mac, EPISR_OFF);
+    v[12] = (ruby_ep0_tx_pending & 1u) |
+        ((ruby_ep0_tx_sent & 0xffffu) << 8) |
+        (((ruby_ep0_fifo_blocked > 0xffu) ? 0xffu :
+            ruby_ep0_fifo_blocked) << 24);
+    v[13] = (ruby_ep0_tx_total & 0xffffu) |
+        ((ruby_ep0_tx_waits & 0xffffu) << 16);
+    v[14] = ruby_ep0_fifo_waits;
+    v[15] = ruby_ms;
+    ruby_ep0_send(mac, t, 0xc027, (const uint8_t *)v, sizeof(v), wlen);
+}
+
+/* Vendor IN request 0xC0/0x28: 200-byte pattern for the >64B path. */
+void
+ruby_ep0_vendor_ep0_bulk(vm_offset_t mac, uint32_t t, uint32_t wlen)
+{
+    uint8_t pat[200];
+    uint32_t i;
+
+    for (i = 0; i < sizeof(pat); i++)
+        pat[i] = (uint8_t)(0xa5u ^ (i & 0xffu));
+    ruby_ep0_send(mac, t, 0xc028, pat, sizeof(pat), wlen);
+}
+
+/*
+ * Vendor IN 0xC0/0x2B: SWEETLOG snapshot descriptor.  The console ring lives
+ * in sweet_ufs.c as a static array, so this never reaches into it: that file
+ * already exports sweet_log_position()/sweet_log_copy() for the EP2 stream,
+ * and the EP0 path reuses them.  Layout, little endian, 32 B:
+ *   u32 magic "SLOG" | u32 version | u32 ring size | u64 total | 3 x u32 pad
+ * The host reads this first and snapshots total, so it can stop at a boundary
+ * that will not move while it pulls the slices.
+ */
+#define RUBY_LOG_MAGIC  0x474f4c53u     /* "SLOG" */
+#define RUBY_LOG_SIZE   (4u << 20)      /* SWEET_LOG_SIZE, sweet_ufs.c */
+#define RUBY_LOG_SLICE  64u
+
+/* 0147 caps: v[1] protocol 2, v[6] caps, v[7] counters. */
+#define RUBY_CAP_EP0_CMD  (1u << 0)     /* 0x40/0x2E command channel */
+#define RUBY_CAP_COOP     (1u << 1)     /* command runs from the 1 ms tick */
+#define RUBY_CAP_SEQ      (1u << 2)     /* seq/done correlation */
+#define RUBY_CAP_EP2OUT   (1u << 3)     /* legacy EP2 OUT parser */
+#define RUBY_CAP_CMDLEN(x) (((x) & 0xffu) << 8)
+
+void
+ruby_ep0_vendor_log_info(vm_offset_t mac, uint32_t t, uint32_t wlen)
+{
+    uint64_t total = sweet_log_position();
+    uint32_t v[8];
+
+    v[0] = RUBY_LOG_MAGIC;
+    v[1] = 2;
+    v[2] = RUBY_LOG_SIZE;
+    v[3] = (uint32_t)total;
+    v[4] = (uint32_t)(total >> 32);
+    /*
+     * 0146a mode word: the host can tell which line it is talking to
+     * without scraping the boot log.  bit0 EP2 IN log, bit1 probe writes,
+     * bit2 EP2 TX QMU started, bit3 EP2 RX QMU started.
+     */
+    v[5] = (ruby_ep2log_on ? (1u << 0) : 0) |
+        (ruby_probe_enabled ? (1u << 1) : 0) |
+        (ruby_ep_ready ? (1u << 2) : 0) |
+        (ruby_rx_ready ? (1u << 3) : 0);
+    v[6] = RUBY_CAP_EP0_CMD | RUBY_CAP_COOP | RUBY_CAP_SEQ |
+        RUBY_CAP_EP2OUT | RUBY_CAP_CMDLEN(RUBY_CMD_MAX);
+    v[7] = (ruby_cmd_done & 0xffffu) |
+        ((ruby_cmd_busy & 1u) << 16) |
+        ((ruby_cmd_busy_rejects & 0xffu) << 24);
+    ruby_ep0_send(mac, t, 0xc02b, (const uint8_t *)v, sizeof(v), wlen);
+}
+
+/*
+ * Vendor IN 0xC0/0x2C: safe 32-bit MMIO read.
+ *   wValue = address bits 0-15, wIndex = bits 16-31, wLength = 4.
+ * Only the mapped/whitelisted regions are accepted.
+ */
+void
+ruby_ep0_vendor_probe_read(vm_offset_t mac, uint32_t t, uint32_t value,
+    uint32_t index, uint32_t wlen)
+{
+    uint32_t pa = ((index & 0xffffu) << 16) | (value & 0xffffu);
+    uint32_t v;
+
+    if (wlen != 4 || !ruby_probe_read32(pa, &v)) {
+        ruby_ep0_stall(mac, t, 0xc02c, wlen);
+        return;
+    }
+    ruby_ep0_send(mac, t, 0xc02c, (const uint8_t *)&v, 4, wlen);
+}
+
+/*
+ * Vendor OUT 0x40/0x2D: safe 32-bit MMIO write.
+ *   wValue/wIndex = address, 4-byte data stage follows.
+ * The setup only latches the address; ruby_ep0_service() consumes the data
+ * stage, performs the write and ACKs.  Writes are locked unless rubyprobe=1.
+ */
+void
+ruby_ep0_vendor_probe_write(vm_offset_t mac, uint32_t t, uint32_t value,
+    uint32_t index, uint32_t wlen)
+{
+    uint32_t pa = ((index & 0xffffu) << 16) | (value & 0xffffu);
+
+    if (!ruby_probe_enabled || wlen != 4 ||
+        !ruby_probe_lookup(pa, 4, NULL)) {
+        ruby_ep0_stall(mac, t, 0xc02d, wlen);
+        return;
+    }
+    ruby_probe_wr_pa = pa;
+    ruby_probe_wr_pending = 1;
+    /*
+     * 0131b: acknowledge the SETUP without DATAEND so the 4-byte OUT data
+     * stage can arrive.  Without this the host stalled the control transfer
+     * (EPIPE) before ruby_ep0_service() ever saw EP0_RXPKTRDY.
+     */
+    {
+        uint32_t csr = ruby_rd32(mac, EP0CSR_OFF) & EP0_W1C_BITS;
+
+        csr |= EP0_SETUPPKTRDY;
+        ruby_wr32(mac, EP0CSR_OFF, csr);
+    }
+}
+
+/*
+ * 0147: vendor OUT 0x40/0x2E, one command line in the data stage.
+ *   wValue = sequence, wLength = 1..64.  The setup is ACKed without
+ *   DATAEND; ruby_ep0_service() copies the line and queues it.  The
+ *   command runs from the 1 ms tick, not from the EP0/RX context.
+ */
+void
+ruby_ep0_vendor_cmd(vm_offset_t mac, uint32_t t, uint32_t value,
+    uint32_t index, uint32_t wlen)
+{
+    uint32_t csr;
+
+    (void)index;
+    if (wlen == 0 || wlen > RUBY_CMD_MAX) {
+        ruby_ep0_stall(mac, t, 0x402e, wlen);
+        return;
+    }
+    ruby_cmd_out_seq = value & 0xffffu;
+    ruby_cmd_out_len = wlen;
+    ruby_cmd_out_pending = 1;
+    csr = ruby_rd32(mac, EP0CSR_OFF) & EP0_W1C_BITS;
+    csr |= EP0_SETUPPKTRDY;
+    ruby_wr32(mac, EP0CSR_OFF, csr);
+    ruby_trace(t, RUBY_TR_NOTE, 10, value, wlen, 0);
+}
+
+/*
+ * Vendor IN 0xC0/0x2A: one slice of the console ring.
+ *   wValue = offset bits 0-15, wIndex = bits 16-31, wLength = 8..64.
+ *
+ * The offset comes straight from the host, so it is validated here:
+ * sweet_log_copy() subtracts its cursor from the total, and an offset past
+ * the end would wrap that subtraction and stream from the wrong place.  Out
+ * of range is a STALL, never a read outside the ring.
+ */
+void
+ruby_ep0_vendor_log(vm_offset_t mac, uint32_t t, uint32_t value,
+    uint32_t index, uint32_t wlen)
+{
+    uint64_t off = ((uint64_t)index << 16) | (value & 0xffffu);
+    uint64_t pos = off;
+    uint64_t total;
+    uint8_t buf[RUBY_LOG_SLICE];
+    uint32_t want, n;
+
+    /*
+     * sweet_log_copy() silently skips ahead when the cursor is more than one
+     * ring behind, which would return bytes from the wrong offset.  Refuse
+     * anything outside the live window instead, so the host sees a STALL
+     * rather than data it cannot trust.
+     */
+    total = sweet_log_position();
+    if (off >= total || total - off > RUBY_LOG_SIZE) {
+        ruby_ep0_stall(mac, t, 0xc02a, wlen);
+        return;
+    }
+    want = wlen > sizeof(buf) ? (uint32_t)sizeof(buf) : wlen;
+    n = sweet_log_copy(&pos, (char *)buf, want);
+    if (!n) {
+        ruby_ep0_stall(mac, t, 0xc02a, wlen);
+        return;
+    }
+    ruby_ep0_send(mac, t, 0xc02a, buf, n, wlen);
+}
+
+/*
+ * Put EP0 back to a known state while the device is off the bus: reset the
+ * endpoint, drop whatever the previous host left in the RX FIFO, and clear
+ * the W1C status bits.  MTU3 has no FLUSHFIFO for EP0, so TX is left alone;
+ * the next packet write overwrites it.
+ */
+void
+ruby_ep0_quiet_reset(vm_offset_t mac)
+{
+    uint32_t count, csr, i;
+
+    ruby_wr32(mac, EP_RST_OFF, 1u << 0);
+    ruby_wr32(mac, EP_RST_OFF, 0);
+
+    count = ruby_rd32(mac, RXCOUNT0_OFF);
+    if (count > 512u)
+        count = 512u;
+    for (i = 0; i < count; i++)
+        (void)ruby_rd8(mac, FIFO0_OFF);
+
+    csr = ruby_rd32(mac, EP0CSR_OFF) & EP0_W1C_BITS;
+    csr |= EP0_RXPKTRDY | EP0_SETUPPKTRDY | EP0_SENTSTALL;
+    ruby_wr32(mac, EP0CSR_OFF, csr);
+}
+
+/*
+ * Redo the detach/attach without leaving the window: used when the host
+ * never reacts to the first attach.  Same order as the probe path.
+ */
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
