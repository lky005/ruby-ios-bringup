+        vout[off++] = 16; vout[off++] = 0; vout[off++] = 16;
+        /* Iface1 Data (0x0A) */
+        vout[off++] = 9; vout[off++] = 4; vout[off++] = 1; vout[off++] = 0;
+        vout[off++] = 2; vout[off++] = 0x0A; vout[off++] = 0; vout[off++] = 0; vout[off++] = 0;
+        vout[off++] = 7; vout[off++] = 5; vout[off++] = 0x01; vout[off++] = 2;
+        /* 0264: the ACM descriptor must follow ruby_eps like the vendor path;
+         * 0262 changed the endpoint table but left this literal at 64. */
+        vout[off++] = (uint8_t)(ruby_eps[1].mps & 0xffu);
+        vout[off++] = (uint8_t)((ruby_eps[1].mps >> 8) & 0xffu);
+        vout[off++] = 0;
+        vout[off++] = 7; vout[off++] = 5; vout[off++] = 0x81; vout[off++] = 2;
+        vout[off++] = (uint8_t)(ruby_eps[3].mps & 0xffu);
+        vout[off++] = (uint8_t)((ruby_eps[3].mps >> 8) & 0xffu);
+        vout[off++] = 0;
+        vout[2] = (uint8_t)(off & 0xffu);
+        vout[3] = (uint8_t)((off >> 8) & 0xffu);
+        return off;
+    }
+    /* Vendor (default) */
+    vout[off++] = 9; vout[off++] = 2; vout[off++] = 0; vout[off++] = 0;
+    vout[off++] = 1; vout[off++] = 1; vout[off++] = 0; vout[off++] = 0x80; vout[off++] = 50;
+    vout[off++] = 9; vout[off++] = 4; vout[off++] = 0; vout[off++] = 0;
+    vout[off++] = n_eps_total; vout[off++] = 0xFF; vout[off++] = 0; vout[off++] = 0; vout[off++] = 0;
+    for (i = 0; i < RUBY_EP_MAX; i++) {
+        if (!ruby_eps[i].valid || ruby_eps[i].addr == 0x00)
+            continue;
+        vout[off++] = 7; vout[off++] = 5; vout[off++] = ruby_eps[i].addr;
+        vout[off++] = ruby_eps[i].type;
+        vout[off++] = (uint8_t)(ruby_eps[i].mps & 0xffu);
+        vout[off++] = (uint8_t)((ruby_eps[i].mps >> 8) & 0xffu);
+        vout[off++] = ruby_eps[i].interval;
+    }
+    vout[2] = (uint8_t)(off & 0xffu);
+    vout[3] = (uint8_t)((off >> 8) & 0xffu);
+    return off;
+}
+
+void
+ruby_ep0_set_maxpacket(vm_offset_t mac)
+{
+    uint32_t v = ruby_rd32(mac, EP0CSR_OFF);
+
+    v &= ~EP0_MAXPKTSZ_MSK;
+    v |= 64;
+    v &= EP0_W1C_BITS;
+    ruby_wr32(mac, EP0CSR_OFF, v);
+}
+
+/*
+ * EP0 data stage context.  A control-IN response can span several 64-byte
+ * packets; the source buffer may be on the handler's stack, so copy it
+ * first and keep the state machine's buffer independent of the caller.
+ */
+static uint8_t ruby_ep0_txbuf[RUBY_EP0_TXBUF];
+uint32_t ruby_ep0_tx_total;
+uint32_t ruby_ep0_tx_sent;
+uint32_t ruby_ep0_tx_pending;
+uint32_t ruby_ep0_tx_waits;
+uint32_t ruby_ep0_fifo_waits;
+uint32_t ruby_ep0_fifo_blocked;
+
+uint32_t ruby_ep0_setups;
+uint32_t ruby_ep0_short;
+uint32_t ruby_ep0_long;
+uint32_t ruby_ep0_txpkts;
+uint32_t ruby_ep0_dataends;
+uint32_t ruby_ep0_sentstalls;
+uint32_t ruby_ep0_rewinds;
+uint32_t ruby_bus_resets;
+
+void
+ruby_ep0_write_fifo(vm_offset_t mac, const uint8_t *src, uint32_t len)
+{
+    uint32_t i = 0;
+
+    while (i + 4 <= len) {
+        uint32_t w = (uint32_t)src[i] |
+            ((uint32_t)src[i + 1] << 8) |
+            ((uint32_t)src[i + 2] << 16) |
+            ((uint32_t)src[i + 3] << 24);
+        ruby_wr32(mac, FIFO0_OFF, w);
+        i += 4;
+    }
+    if (i + 2 <= len) {
+        uint16_t w = (uint16_t)src[i] | ((uint16_t)src[i + 1] << 8);
+
+        ruby_wr16(mac, FIFO0_OFF, w);
+        i += 2;
+    }
+    if (i < len)
+        *(volatile uint8_t *)(mac + FIFO0_OFF) = src[i];
+}
+
+/*
+ * 0147: U3D_FIFO0 is a 32-bit port.  Reading it byte-by-byte returns the
+ * same lane repeatedly; vendor ep0_read_fifo() reads words and one final
+ * word for the 1..3 byte tail.  Use the same order for the 0x2E line.
+ */
+void
+ruby_ep0_read_fifo_bytes(vm_offset_t mac, uint8_t *dst, uint32_t len)
+{
+    uint32_t i = 0;
+
+    while (i + 4 <= len) {
+        uint32_t w = ruby_rd32(mac, FIFO0_OFF);
+
+        dst[i++] = (uint8_t)(w & 0xffu);
+        dst[i++] = (uint8_t)((w >> 8) & 0xffu);
+        dst[i++] = (uint8_t)((w >> 16) & 0xffu);
+        dst[i++] = (uint8_t)((w >> 24) & 0xffu);
+    }
+    if (i < len) {
+        uint32_t w = ruby_rd32(mac, FIFO0_OFF);
+
+        while (i < len) {
+            dst[i++] = (uint8_t)(w & 0xffu);
+            w >>= 8;
+        }
+    }
+}
+
+void
+ruby_ep0_drain_fifo(vm_offset_t mac, uint32_t len)
+{
+    uint32_t i = 0;
+
+    while (i + 4 <= len) {
+        (void)ruby_rd32(mac, FIFO0_OFF);
+        i += 4;
+    }
+    if (i < len)
+        (void)ruby_rd32(mac, FIFO0_OFF);
+}
+
+/*
+ * Advance a pending IN data stage by one hardware action: load the next
+ * packet, or write DATAEND after the last one.
+ *
+ * strict=1 runs inline, right after a packet was loaded.  It waits for the
+ * condition the vendor ISR tests before it loads another packet -- TXPKTRDY
+ * clear (the SIE took the packet) and EP0_FIFOFULL clear (the FIFO has room
+ * again) -- for RUBY_EP0_SPINS x 10 us, then gives up: no STALL, the stage
+ * stays pending.
+ *
+ * DATAEND is written only by the tick path.  Writing it inline right after
+ * the last packet was taken is the one difference 0113c introduced against
+ * the enumerating 0113b, and with it the device stopped enumerating: the
+ * host answered every GET_DESCRIPTOR with a port reset even though the
+ * driver had loaded the full response and written DATAEND.
+ *
+ * strict=0 is the 1 ms service tick, kept at the 0113b rule that TXPKTRDY
+ * clear alone is enough.  So the strict test can only ever cost a tick, it
+ * can never strand a transfer that the old path would have finished.
+ *
+ * Returns 1 when the hardware was touched, 0 when the caller should wait.
+ */
+int
+ruby_ep0_tx_step(vm_offset_t mac, uint32_t t, int strict)
+{
+    uint32_t csr, n, i;
+
+    if (!ruby_ep0_tx_pending)
+        return 0;
+
+    for (i = 0;; i++) {
+        csr = ruby_rd32(mac, EP0CSR_OFF);
+        if (!(csr & EP0_TXPKTRDY))
+            break;
+        if (!strict || i >= RUBY_EP0_SPINS) {
+            if (strict)
+                ruby_ep0_tx_waits++;
+            return 0;
+        }
+        delay(RUBY_EP0_SPIN_US);
+    }
+
+    if (ruby_ep0_tx_sent < ruby_ep0_tx_total) {
+        if (strict && (csr & EP0_FIFOFULL)) {
+            ruby_ep0_fifo_blocked++;
+            return 0;
+        }
+        n = ruby_ep0_tx_total - ruby_ep0_tx_sent;
+        if (n > 64)
+            n = 64;
+        ruby_ep0_write_fifo(mac, ruby_ep0_txbuf + ruby_ep0_tx_sent, n);
+        csr = ruby_rd32(mac, EP0CSR_OFF) & EP0_W1C_BITS;
+        ruby_wr32(mac, EP0CSR_OFF, csr | EP0_TXPKTRDY);
+        ruby_ep0_tx_sent += n;
+        ruby_ep0_txpkts++;
+        return 1;
+    }
+    /* Last packet is out; leave DATAEND to the service tick (0113b timing). */
+    if (strict)
+        return 0;
+    /*
+     * On this IP EP0_FIFOFULL remains set until DATAEND is written
+     * (0105/0107 finding).  Gating DATAEND on it deadlocks short and
+     * multi-packet transfers, so count it and terminate anyway.
+     */
+    if (csr & EP0_FIFOFULL)
+        ruby_ep0_fifo_waits++;
+    csr = ruby_rd32(mac, EP0CSR_OFF) & EP0_W1C_BITS;
+    ruby_wr32(mac, EP0CSR_OFF, csr | EP0_DATAEND);
+    ruby_ep0_tx_pending = 0;
+    ruby_ep0_dataends++;
+    ruby_trace(t, RUBY_TR_SEND, 0, ruby_ep0_tx_total, 0,
+        ruby_ep0_tx_sent);
+    return 1;
+}
+
+void
+ruby_ep0_tx_pump(vm_offset_t mac, uint32_t t)
+{
+    while (ruby_ep0_tx_step(mac, t, 1))
+        ;
+}
+
+void
+ruby_ep0_ack(vm_offset_t mac, uint32_t t, uint16_t key, uint32_t wlen)
+{
+    uint32_t csr;
+
+    /*
+     * The host sends SET_ADDRESS as soon as it has the device descriptor,
+     * so this ACK can land while the previous descriptor is still in the TX
+     * FIFO.  Writing the status stage into a full FIFO made the host's
+     * xHCI Address Device command fail with a transaction error, and the
+     * host then reset the port and enumerated again.
+     *
+     * No wait here: both the vendor driver and the bare-metal probe write
+     * the status stage straight away.  The 50 ms and 2 ms waits that were
+     * tried in between only moved the failure from one host path to the
+     * other.  The trace reports the CSR so the state is visible.
+     */
+    csr = ruby_rd32(mac, EP0CSR_OFF) & EP0_W1C_BITS;
+    csr |= EP0_SETUPPKTRDY | EP0_DATAEND;
+    ruby_wr32(mac, EP0CSR_OFF, csr);
+    ruby_trace(t, RUBY_TR_ACK, key, csr, wlen, 0);
+}
+
+void
+ruby_ep0_stall(vm_offset_t mac, uint32_t t, uint16_t key, uint32_t wlen)
+{
+    uint32_t csr = ruby_rd32(mac, EP0CSR_OFF) & EP0_W1C_BITS;
+
+    csr |= EP0_SENDSTALL;
+    if (wlen == 0)
+        csr |= EP0_SETUPPKTRDY;
+    ruby_wr32(mac, EP0CSR_OFF, csr);
+    ruby_trace(t, RUBY_TR_STALL, key, csr, wlen, 0);
+}
+
+void
+ruby_ep0_send(vm_offset_t mac, uint32_t t, uint16_t key, const uint8_t *data,
+    uint32_t len, uint32_t wlen)
+{
+    uint32_t total = len < wlen ? len : wlen;
+    uint32_t csr, n, i;
+
+    if (wlen == 0) {
+        ruby_ep0_ack(mac, t, key, wlen);
+        return;
+    }
+    if (total > sizeof(ruby_ep0_txbuf))
+        total = sizeof(ruby_ep0_txbuf);
+    for (i = 0; i < total; i++)
+        ruby_ep0_txbuf[i] = data[i];
+
+    ruby_ep0_tx_total = total;
+    ruby_ep0_tx_sent = 0;
+    ruby_ep0_tx_waits = 0;
+    ruby_ep0_fifo_waits = 0;
+    ruby_ep0_fifo_blocked = 0;
+
+    csr = ruby_rd32(mac, EP0CSR_OFF) & EP0_W1C_BITS;
+    csr |= EP0_SETUPPKTRDY | EP0_DPHTX;
+    ruby_wr32(mac, EP0CSR_OFF, csr);
+
+    if (!total) {
+        ruby_ep0_tx_pending = 0;
+        ruby_wr32(mac, EP0CSR_OFF, csr | EP0_DATAEND);
+        ruby_ep0_dataends++;
+        return;
+    }
+
+    n = total > 64 ? 64 : total;
+    ruby_ep0_write_fifo(mac, ruby_ep0_txbuf, n);
+    csr = ruby_rd32(mac, EP0CSR_OFF) & EP0_W1C_BITS;
+    ruby_wr32(mac, EP0CSR_OFF, csr | EP0_TXPKTRDY);
+    ruby_ep0_tx_sent = n;
+    ruby_ep0_tx_pending = 1;
+    ruby_ep0_txpkts++;
+    ruby_trace(t, RUBY_TR_SEND, key, total, wlen, n);
+
+    /*
+     * Advance only when another packet follows: a single-packet response
+     * keeps the exact 0113b timing (load here, DATAEND on the next tick).
+     * Vendor writes the next packet from the context that saw the
+     * TXPKTRDY-clear event; leaving it to the service tick costs a tick
+     * per packet.
+     */
+    if (total > n)
+        ruby_ep0_tx_pump(mac, t);
+}
+
+/*
+ * Resume a pending IN data stage from the service tick: one step, using the
+ * 0113b rule that TXPKTRDY clear alone is enough.  A new SETUP aborts the
+ * stage (see ruby_ep0_service); no STALL here.
+ */
+void
+ruby_ep0_tx_service(vm_offset_t mac, uint32_t t)
+{
+    ruby_ep0_tx_step(mac, t, 0);
+}
+
+const uint8_t *
+ruby_descriptor(uint32_t value, uint32_t *len)
+{
+    switch (value) {
+    case 0x0100:
+        *len = sizeof(ruby_dev_desc);
+        return ruby_dev_desc;
+    case 0x0200:
+        /* 0220: rebuilt on demand; vendor never relies on its own stale cache. */
+        ruby_cfg_buf_len = ruby_build_cfg_desc(ruby_cfg_buf);
+        *len = ruby_cfg_buf_len;
+        return ruby_cfg_buf;
+    case 0x0300:
+        *len = sizeof(ruby_str_lang);
+        return ruby_str_lang;
+    case 0x0301:
+        *len = sizeof(ruby_str_mfg);
+        return ruby_str_mfg;
+    case 0x0302:
+        *len = sizeof(ruby_str_prod);
+        return ruby_str_prod;
+    case 0x0303:
+        *len = sizeof(ruby_str_ser);
+        return ruby_str_ser;
+    default:
+        return NULL;
+    }
+}
