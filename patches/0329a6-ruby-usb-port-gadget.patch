+
+static inline uint32_t
+ruby_rd32(vm_offset_t base, uint32_t off)
+{
+    uint32_t v = *(volatile uint32_t *)(base + off);
+    __asm__ volatile("dmb oshld" ::: "memory");
+    return v;
+}
+
+static inline void
+ruby_wr32(vm_offset_t base, uint32_t off, uint32_t v)
+{
+    *(volatile uint32_t *)(base + off) = v;
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+
+static inline uint8_t
+ruby_rd8(vm_offset_t base, uint32_t off)
+{
+    return *(volatile uint8_t *)(base + off);
+}
+
+void
+ruby_usb_rearm(vm_offset_t mac, uint32_t reason)
+{
+    uint32_t csr, dc, v, count, i, was_tx, was_rx;
+
+    ruby_seq("REARM_IN", reason, ruby_cfg_seen);
+    was_tx = ruby_ep_ready;
+    was_rx = ruby_rx_ready;
+    /* Drop whatever the host left in the FIFO before the reset. */
+    count = ruby_rd32(mac, RXCOUNT0_OFF);
+    for (i = 0; i < count; i++)
+        (void)ruby_rd8(mac, FIFO0_OFF);
+
+    csr = ruby_rd32(mac, EP0CSR_OFF) & EP0_W1C_BITS;
+    csr |= EP0_RXPKTRDY | EP0_SETUPPKTRDY | EP0_SENTSTALL;
+    csr &= ~EP0_MAXPKTSZ_MSK;
+    csr |= 64;
+    ruby_wr32(mac, EP0CSR_OFF, csr);
+
+    /* Drop any EP0 data stage and the latched EP0/SETUPEND events. */
+    ruby_ep0_tx_pending = 0;
+    ruby_ep0_tx_sent = 0;
+    ruby_ep0_tx_total = 0;
+    ruby_wr32(mac, EPISR_OFF, ruby_rd32(mac, EPISR_OFF));
+    /* 0147: a bus reset drops any queued/failed command, not a running one. */
+    ruby_cmd_out_pending = 0;
+    ruby_cmd_pending = 0;
+    ruby_cmd_busy = 0;
+    ruby_cmd_seq_pending = 0;
+    ruby_cmd_seq_active = 0;
+
+    dc = ruby_rd32(mac, DEVICE_CONF - MTU3_PA);
+    dc &= ~0x7f000000u;         /* device address back to 0 */
+    ruby_wr32(mac, DEVICE_CONF - MTU3_PA, dc);
+
+    ruby_config = 0;
+    ruby_cfg_seen = 0;
+    ruby_ep_ready = 0;
+    ruby_tx_busy = 0;
+    ruby_busy_ticks = 0;
+    ruby_gpd_enq = 0;
+    ruby_gpd_deq = 0;
+    ruby_inflight = 0;
+    ruby_ep2_host_seen = 0;
+    /*
+     * 0143: the ring may still hold GPDs the QMU owns (HWO=1) from
+     * before the reset.  Zeroing enq/deq/inflight without clearing the
+     * hardware ring desyncs the bookkeeping and re-delivers stale
+     * frames after the next start (measured on 0142: inflight=15 vs
+     * hwo=63).  Reset the ring while the QMU is stopped so the counters
+     * match the hardware.
+     *
+     * 0146a-qmu: stop with a bounded wait first.  If ACTIVE does not
+     * clear, leave the ring alone and let the next rearm/config retry;
+     * rewriting a live ring is the failure documented in 0143.
+     */
+    if (was_tx || (ruby_rd32(mac, TQCSR1_OFF) & QMU_Q_ACTIVE)) {
+        if (ruby_ep2_qmu_stop(mac) == 0)
+            ruby_ep2_ring_reset(mac);
+        else
+            printf("RUBY USB: EP2 TX stop timeout in rearm\n");
+    } else {
+        /* The log QMU was never started (rubyep2log=0). */
+        ruby_ep2_ring_reset(mac);
+    }
+
+    /*
+     * 0146a-qmu: same rule for RX.  Only pulse EP_RST after the QMU is
+     * inactive; a timeout leaves the endpoint and ring for the next
+     * rearm/config to retry.
+     */
+    if (was_rx || (ruby_rd32(mac, RQCSR1_OFF) & QMU_Q_ACTIVE)) {
+        if (ruby_ep2_rx_qmu_stop(mac) == 0) {
+            ruby_wr32(mac, EP_RST_OFF, EP_RST_RX1_BIT);
+            ruby_wr32(mac, EP_RST_OFF, 0);
+        } else {
+            printf("RUBY USB: EP2 RX stop timeout in rearm\n");
+        }
+    } else {
+        ruby_wr32(mac, RQCSR1_OFF, QMU_Q_STOP);
+        ruby_wr32(mac, EP_RST_OFF, EP_RST_RX1_BIT);
+        ruby_wr32(mac, EP_RST_OFF, 0);
+    }
+    ruby_rx_ready = 0;
+    ruby_rx_deq = 0;
+
+    if (reason == RUBY_REARM_ATTACH) {
+        /* The PHY lost its session with the unplug; re-assert the port. */
+        v = ruby_rd32(mac, MISC_CTRL - MTU3_PA);
+        ruby_wr32(mac, MISC_CTRL - MTU3_PA, v | 0x3u);
+        v = ruby_rd32(mac, PM_CTRL - MTU3_PA);
+        ruby_wr32(mac, PM_CTRL - MTU3_PA, v | (1u << 6) | (1u << 0));
+    }
+    ruby_seq("REARM_OUT", reason, ruby_ep_ready | (ruby_rx_ready << 1));
+}
+
+/*
+ * The host resets the bus whenever an enumeration attempt fails.  The
+ * MAC2 common-USB status latches that event; without handling it the
+ * device keeps its old address and a stale EP0 state, so the host's next
+ * attempt is answered by garbage and the device looks dead until reboot.
+ * 0196: returns 1 when the two-beat progressed (sample or confirm) so the
+ * IRQ service can tell real resets from a stuck line.
+ */
+int
+ruby_usb_reset_check(vm_offset_t mac)
+{
+    uint32_t st = ruby_rd32(mac, MAC2_INTR_STATUS_OFF);
+
+    if (!(st & MAC2_INTR_RESET)) {
+        ruby_rst_seen = 0;
+        ruby_rst_armed = 1;    /* the bit reads back clear at least once */
+        return 0;
+    }
+    if (!ruby_rst_armed)
+        return 0;           /* stuck high: not a usable reset source */
+    if (!ruby_rst_seen) {
+        /* Confirm on the next poll: a single sample may be a glitch. */
+        ruby_rst_seen = 1;
+        ruby_seq("RST_SAMPLE", st, ruby_cfg_seen);
+        return 1;
+    }
+    ruby_rst_seen = 0;
+    ruby_seq("RST_CONFIRM", st, ruby_cfg_seen);
+    ruby_wr32(mac, MAC2_INTR_STATUS_OFF, st & MAC2_INTR_RESET);
+
+    ruby_bus_resets++;
+    ruby_usb_rearm(mac, RUBY_REARM_RESET);
+    ruby_trace(0, RUBY_TR_STATE, 7, st, ruby_bus_resets, 0);
+    if (ruby_bus_resets <= 4)
+        printf("RUBY USB: t=%u host bus reset #%u, address cleared\n",
+            ruby_ms, ruby_bus_resets);
+    return 1;
+}
+
+/*
+ * 0196: one IRQ service pass, run on the RubyUSBIntService workloop
+ * (INTID160 level).  Vendor order: MAC2/common before BMU/EP0.  LV1ISR is
+ * read-only (RU); every sub-status is consumed here per its own register
+ * semantics.  Returns 1 when deferred EP0 work needs another pass --
+ * the caller requeues via its timer exactly like the old 1 ms tick.
+ */
+int
+ruby_usb_irq_pass(void)
+{
+    vm_offset_t mac = ruby_mac_base;
+    uint32_t level1, st;
+    int more = 0;
+
+    if (!ruby_irq_mode || mac == 0)
+        return 0;
+    ruby_irq_passes++;
+
+    /* Refresh the two-beat arm/sample state on every pass. */
+    ruby_usb_reset_check(mac);
+
+    level1 = ruby_rd32(mac, LV1ISR_OFF) & ruby_rd32(mac, LV1IER_OFF);
+    if (level1 & LV1_MAC2_INTR) {
+        ruby_irq_mac2++;
+        st = ruby_rd32(mac, MAC2_INTR_STATUS_OFF);
+        if (st & (MAC2_INTR_RESUME | MAC2_INTR_SUSPEND)) {
+            /* Count-only (plan v1): W1C so the group cannot storm. */
+            ruby_wr32(mac, MAC2_INTR_STATUS_OFF,
+                st & (MAC2_INTR_RESUME | MAC2_INTR_SUSPEND));
+            if (st & MAC2_INTR_RESUME)
+                ruby_irq_resume++;
+            if (st & MAC2_INTR_SUSPEND)
+                ruby_irq_suspend++;
+            st = ruby_rd32(mac, MAC2_INTR_STATUS_OFF);
+        }
+        if (!(st & MAC2_INTR_RESET)) {
+            if (++ruby_irq_idle > 1000) {
+                /* Phantom group: bounded isolation, fuse the line off. */
+                ruby_irq_idle = 0;
+                ruby_irq_fused++;
+                ruby_wr32(mac, LV1IECR - MTU3_PA, LV1_MAC2_INTR);
+                printf("RUBY USB IRQ: MAC2 fused off after 1000 idle "
+                    "passes\n");
+            }
+        } else {
+            ruby_irq_idle = 0;
+        }
+    }
+    if (level1 & LV1_BMU_INTR) {
+        ruby_irq_bmu++;
+        ruby_ep0_service(mac, ruby_ms);
+    }
+    if (level1 & LV1_QMU_INTR) {
+        uint32_t q0, q1, terr;
+        uint32_t routed = 0;
+
+        ruby_irq_qmu++;
+        q0 = ruby_rd32(mac, QISAR0_OFF);
+        q1 = ruby_rd32(mac, QISAR1_OFF);
+        terr = ruby_rd32(mac, TQERRIR0_OFF);
+        /* 0298: vendor parity arm: acknowledge TX-done in the interrupt
+         * pass instead of leaving the W1C to the deferred push pass. */
+        if (ruby_qisar0_isr_en && (q0 & RUBY_QMU_TX_DONE)) {
+            ruby_wr32(mac, QISAR0_OFF, RUBY_QMU_TX_DONE);
+            ruby_qisar0_isr_acks++;
+        }
+        /*
+         * 0197: drain the sub-statuses nothing else consumes (F1: they
+         * pull the group line regardless of QIER; enable-set <= service-
+         * set holds at the group level).  TXQ_EMPTY asserts on every
+         * normal run-dry and doubles as the refill liveness signal; the
+         * TXQ error bits have no other consumer either.  Everything
+         * routed below is W1C'd by its owning service inside the requeue
+         * pass (push_log/rx_poll/recover), so the line may stay pending
+         * until then -- the event source is hard-masked in between.
+         */
+        if ((q1 & RUBY_QMU_TXQ_BITS) && ruby_qisar1_w_en)
+            ruby_wr32(mac, QISAR1_OFF, q1 & RUBY_QMU_TXQ_BITS);
+        if (terr != 0)
+            ruby_wr32(mac, TQERRIR0_OFF, terr);
+        if ((q0 & RUBY_QMU_TX_DONE) || (q1 & QISAR1_TXQ_EMPTY)) {
+            ruby_qmu_push_req = 1;
+            routed = 1;
+        }
+        /* 0232: EP1 (0x01) RX done is BIT(16) << 1; the old mask only saw
+         * EP2's BIT(18), so rx drain never ran on EP1 data. */
+        if ((q0 & (QMU_RX_DONE_BIT | QMU_RX_DONE_BIT_EP1)) ||
+            (q1 & RUBY_QMU_RXQ_EMPTY_BITS)) {
+            ruby_qmu_rx_req = 1;
+            routed = 1;
+        }
+        if ((q1 & (QISAR1_TXQ_CSERR | QISAR1_TXQ_LENERR)) || terr != 0) {
+            ruby_qmu_recover_req = 1;
+            routed = 1;
+        }
+        if (q1 & RUBY_QMU_RXQ_ERR_BITS) {
+            ruby_qmu_rx_recover_req = 1;
+            routed = 1;
+        }
+        if (routed) {
+            ruby_irq_qmu_idle = 0;
+            more = 1;
+        } else if (++ruby_irq_qmu_idle > 1000) {
+            /* Phantom group: bounded isolation, fuse the group off. */
+            ruby_irq_qmu_idle = 0;
+            ruby_irq_qmu_fused++;
+            ruby_wr32(mac, LV1IECR - MTU3_PA, LV1_QMU_INTR);
+            printf("RUBY USB IRQ: QMU fused off after 1000 idle "
+                "passes\n");
+        }
+    }
+    if (ruby_ep0_tx_pending || ruby_rst_seen)
+        more = 1;
+    return more;
+}
+
+/* Reattach requests run on the service workloop (single EP0 owner). */
+void
+ruby_usb_irq_service_work(void)
+{
+    vm_offset_t mac = ruby_mac_base;
+
+    if (ruby_irq_reattach_req) {
+        ruby_irq_reattach_req = 0;
+        ruby_usb_reattach(mac, ruby_phy_base);
+        ruby_irq_reattach_done = 1;
+    }
+    if (!ruby_qmu_irq_mode)
+        return;
+    /*
+     * 0197: the EP2 data plane runs here only (single owner).  push/rx
+     * are bounded non-blocking passes; the recover paths own the
+     * destructive stop/flush/start sequences.  Recover runs before
+     * push/rx so a reset ring is refilled from clean state.
+     */
+    if (ruby_qmu_recover_req) {
+        ruby_qmu_recover_req = 0;
+        if (!(ruby_recover_mask & 4))
+            ruby_ep2_recover(mac);
+        else
+            ruby_recover_suppressed[2]++;
+    }
+    if (ruby_qmu_stall_req) {
+        ruby_qmu_stall_req = 0;
+        ruby_ep2_status_poll(mac);
+    }
+    if (ruby_qmu_rx_recover_req) {
+        ruby_qmu_rx_recover_req = 0;
+        ruby_ep2_rx_recover(mac);
+    }
+    if (ruby_qmu_push_req) {
+        ruby_qmu_push_req = 0;
+        ruby_ep2_push_log(mac);
+    }
+    if (ruby_qmu_bell_req) {
+        ruby_qmu_bell_req = 0;
+        ruby_txbell_poll(mac);
+    }
+    if (ruby_qmu_rx_req) {
+        ruby_qmu_rx_req = 0;
+        ruby_ep2_rx_poll(mac);
+    }
+    if (ruby_qmu_diag_req) {
+        ruby_qmu_diag_req = 0;
+        ruby_ep2_stall_dump(mac);
+    }
+    if (ruby_rx_diag_req) {
+        ruby_rx_diag_req = 0;
+        ruby_ep2_rx_stall_dump(mac);
+    }
+    /* 0299: settle-moment RXGPD dump for the full-packet choke watch. */
+    if (ruby_rx_stall_dump_req) {
+        ruby_rx_stall_dump_req = 0;
+        ruby_ep2_rx_stall_dump(mac);
+    }
+    if (ruby_rx_desync_req) {
+        ruby_rx_desync_req = 0;
+        ruby_ep2_rx_desync_dump(mac);
+    }
+    if (ruby_qmu_txrecover_req) {
+        ruby_qmu_txrecover_req = 0;
+        ruby_tx_reset_fire(mac);
+    }
+}
+
+/* 0197 G7: primary-pass occupancy, sampled by the C++ irqAction wrapper. */
+void
+ruby_usb_irq_lat_sample(uint32_t us)
+{
+    ruby_irq_lat_n++;
+    ruby_irq_lat_acc_us += us;
+    if (us > ruby_irq_lat_max_us)
+        ruby_irq_lat_max_us = us;
+}
+
+/*
+ * 0197: 1 ms liveness duties while the EP2 data plane is on the IRQ
+ * workloop (rubyqmuirq=1).  Read-only here: set request flags and kick;
+ * the workloop performs every mutation.  The primer covers the one hole
+ * events cannot see -- log text arriving while the ring is empty and the
+ * queue idle (no GPD to complete, TXQ_EMPTY already consumed).
+ */
+void
+ruby_ep2_tick_assist(vm_offset_t mac)
+{
+    ruby_tx_recover_poll(mac);
+    /* 0266: read-only RX ring desync detector (cur vs driver deq). */
+    if (ruby_rx_ready && ruby_rx_packets > 0 &&
+        ruby_rx_desync_cnt < 5) {
+        uint32_t cur = ruby_ep2_rx_cur_slot(mac);
+
+        if (cur != 0xffu && cur != ruby_rx_deq) {
+            if (!ruby_rx_desync_ms)
+                ruby_rx_desync_ms = ruby_ms;
+            else if ((uint32_t)(ruby_ms - ruby_rx_desync_ms) >= 200 &&
+                (uint32_t)(ruby_ms - ruby_rx_desync_log_ms) >= 1000) {
+                ruby_rx_desync_log_ms = ruby_ms;
+                ruby_rx_desync_cnt++;
+                if (ruby_qmu_irq_mode) {
+                    ruby_rx_desync_req = 1;
+                    ruby_usb_irq_kick();
+                } else {
+                    ruby_ep2_rx_desync_dump(mac);
+                }
+            }
+        } else {
+            ruby_rx_desync_ms = 0;
+        }
+    }
+    /* 0255: once per second, ask the workloop for a read-only stall dump. */
+    if (ruby_inflight > 0 &&
+        (uint32_t)(ruby_ms - ruby_qmu_diag_ms) >= 1000) {
+        ruby_qmu_diag_ms = ruby_ms;
+        ruby_qmu_diag_req = 1;
+        ruby_usb_irq_kick();
+    }
+    /* 0260: 1 Hz RX snapshot for 5 s after the last received packet. */
+    if (ruby_rx_ready && ruby_rx_packets > 0 &&
+        (uint32_t)(ruby_ms - ruby_rx_last_pkt_ms) < 5000 &&
+        (uint32_t)(ruby_ms - ruby_rx_last_pkt_ms) >= 1000 &&
+        (uint32_t)(ruby_ms - ruby_rx_diag_ms) >= 1000) {
+        ruby_rx_diag_ms = ruby_ms;
+        ruby_rx_diag_req = 1;
+        ruby_usb_irq_kick();
+    }
+    if ((ruby_ep_ready && ruby_ep2log_on &&
+        sweet_log_position() != ruby_log_pos) ||
+        (ruby_ep_ready && ruby_acm_echo_head != ruby_acm_echo_tail)) {
+        ruby_qmu_push_req = 1;
+        ruby_qmu_primer_kicks++;
+        ruby_usb_irq_kick();
+    }
+    if (ruby_txbell_en && ruby_ep_ready && ruby_inflight > 0 &&
+        !(ruby_rd32(mac, TX1CSR0_OFF) & TX_TXPKTRDY) &&
+        !(ruby_rd32(mac, TX1CSR0_OFF) & TX_FIFOEMPTY) &&
+        !(ruby_rd32(mac, TQCSR1_OFF) & QMU_Q_ACTIVE)) {
+        ruby_qmu_bell_req = 1;
+        ruby_usb_irq_kick();
+    }
+    if (ruby_ep_ready &&
+        (ruby_rd32(mac, TX1CSR0_OFF) & TX_SENTSTALL)) {
+        ruby_qmu_stall_req = 1;
+        ruby_usb_irq_kick();
+    }
+    if (ruby_rx_ready &&
+        (ruby_rd32(mac, RX1CSR0_OFF) & RX_SENTSTALL_BIT)) {
+        ruby_qmu_rx_recover_req = 1;
+        ruby_usb_irq_kick();
+    }
+}
+
+/* Called from RubyUSBIntService (same workloop as the pass). */
+void
+ruby_usb_reattach_impl(void)
+{
+    ruby_usb_irq_service_work();
+}
+
+/*
+ * Physical unplug.  A detach drops the PHY session and leaves the device
+ * with a stale address, so the next attach has to re-arm it or the host
+ * enumerates a device that answers at the wrong address.  The VBUS sense
+ * is debounced and only a real detach -> attach sequence re-arms, so the
+ * normal enumeration path is untouched.
+ */
+void
+ruby_usb_attach_poll(vm_offset_t mac, vm_offset_t ippc)
+{
+    static uint32_t stable, cand, count, seen_detach, attaches;
+    uint32_t v = ruby_rd32(ippc, IPPC_OTG_STS_OFF);
+    uint32_t seq = ruby_battery_poll_seq();
+    /*
+     * 0173: IPPC OTG bit9 does not follow VBUS on this board (0172
+     * heartbeat: constant 0x1ec01ec0 through a 10 s unplug).  Use the
+     * MT6360 CHRDET_EXT cache instead; assume present until the battery
+     * driver has produced its first sample.
+     */
+    uint32_t present = seq ?
+        (uint32_t)(ruby_battery_last_external() != 0) : 1;
+
+    if (present != cand) {
+        cand = present;
+        count = 0;
+        return;
+    }
+    if (++count < RUBY_VBUS_DEBOUNCE)
+        return;
+    count = 0;
+    if (present == stable)
+        return;
+    stable = present;
+
+    if (!present) {
+        seen_detach = 1;
+        ruby_trace(0, RUBY_TR_STATE, 8, v, 0, 0);
+        printf("RUBY USB: t=%u VBUS detached (ext=0 seq=%u otg=%08x)\n",
+            ruby_ms, seq, v);
+        return;
+    }
+    if (!seen_detach)
+        return;             /* attached at boot: nothing to redo */
+    seen_detach = 0;
+    attaches++;
+    /*
+     * A VBUS detach drops the U2 PHY session, so the light MAC rearm is
+     * not enough: the D+ pull-up has to be cycled before the host can see
+     * a new connect.  Reuse the 0116 boot-window sequence at runtime.
+     */
+    ruby_usb_reattach_owned(mac, ruby_phy_base);
+    ruby_enum_assist_until = ruby_ms + 15000;
+    ruby_trace(0, RUBY_TR_STATE, 9, v, attaches, 0);
+    printf("RUBY USB: t=%u fast EP0 assist 15 s\n", ruby_ms);
+    printf("RUBY USB: t=%u VBUS attached (ext=1 seq=%u), device re-attached "
+        "(otg=%08x pm=%08x misc=%08x acr3=%08x)\n", ruby_ms, seq,
+        ruby_rd32(ippc, IPPC_OTG_STS_OFF),
+        ruby_rd32(mac, PM_CTRL - MTU3_PA),
+        ruby_rd32(mac, MISC_CTRL - MTU3_PA),
+        ruby_rd32(ruby_phy_base, PHY_U2_ACR3));
+}
+
+/*
+ * 0172 diagnostic: prove the EP0 thread is alive and identify which signal
+ * actually follows a physical cable pull.  Read-only; no behavior change.
+ * Print on change and at least every 5 s.
+ */
+void
+ruby_usb_heartbeat(vm_offset_t mac, vm_offset_t ippc)
+{
+    static uint32_t next_ms, last_otg, last_mac2;
+    static int last_ext, primed;
+    static int usb2_rt_dumped;
+    static int epctl_rt_dumped;
+    uint32_t otg = ruby_rd32(ippc, IPPC_OTG_STS_OFF);
+    uint32_t mac2 = ruby_rd32(mac, MAC2_INTR_STATUS_OFF);
+    uint32_t seq = ruby_battery_poll_seq();
+    uint32_t rxcur = 0xffu, rxhwo = 0;
+    uint32_t off;
+    int ext = ruby_battery_last_external();
+
+    if (primed && ruby_ms < next_ms && otg == last_otg &&
+        mac2 == last_mac2 && ext == last_ext)
+        return;
+    primed = 1;
+    next_ms = ruby_ms + 5000;
+    printf("RUBY USB HB: t=%u otg=%08x mac2=%08x acr3=%08x acr5=%08x "
+        "dmon1=%08x batt_seq=%u ext=%d setups=%u cfg=%u busreset=%u "
+        "frame=%u assist=%u\n", ruby_ms, otg, mac2,
+        ruby_phy_base ? ruby_rd32(ruby_phy_base, PHY_U2_ACR3) : 0,
+        ruby_phy_base ? ruby_rd32(ruby_phy_base, PHY_U2_ACR5) : 0,
+        ruby_phy_base ? ruby_rd32(ruby_phy_base, PHY_U2_DMON1) : 0,
+        seq, ext, ruby_ep0_setups, ruby_cfg_seen, ruby_bus_resets,
+        ruby_rd32(mac, FRAME_NUM_OFF) & 0x7ffu,
+        ruby_enum_assist_until != 0 && ruby_ms < ruby_enum_assist_until);
+    /*
+     * 0310: the heartbeat never touches the RX ring.  It reads the
+     * workloop's seqlock snapshot; an odd/stuck sequence is the soft
+     * ownership assertion (bounded print, no panic).
+     */
+    if (ruby_rx_ready) {
+        uint32_t s1, s2, tries;
+
+        for (tries = 0; tries < 3; tries++) {
+            s1 = ruby_rx_snap_seq;
+            if (s1 & 1u)
+                continue;
+            __asm__ volatile("dmb sy" ::: "memory");
+            rxhwo = ruby_rx_snap_hwo;
+            rxcur = ruby_rx_snap_cur;
+            __asm__ volatile("dmb sy" ::: "memory");
+            s2 = ruby_rx_snap_seq;
+            if (s1 == s2)
+                break;
+        }
+        if (tries == 3) {
+            ruby_rx_snap_bad++;
+            if (ruby_rx_snap_bad <= 4)
+                printf("RUBY USB: 0310 rx snap busy seq=%08x\n",
+                    ruby_rx_snap_seq);
+            rxhwo = 0;
+            rxcur = 0xffu;
+        }
+    }
+    /* 0233: data-plane state for the ACM echo debug round. */
+    printf("RUBY USB ACM: ready=%u rx=%u echo=%u/%u drop=%u enq=%u deq=%u "
+        "inf=%u rxpk=%u rxdone=%u rxerr=%u zlp=%u "
+        "rxcur=%02x rxdeq=%02x rqhiar=%08x rxhwo=%04x "
+        "txr=%u rxr=%u act=%u kick=%u rxact=%u rxkick=%u "
+        "txk=%u txrdy=%u txrep=%u "
+        "tqerr=%08x tcsr=%08x qcr0=%08x qcr1=%08x qcr2=%08x qcr3=%08x "
+        "tqcpr=%08x rqcpr=%08x "
+        "speed=%u tx1csr1=%08x tx1csr2=%08x rx1csr1=%08x rx1csr2=%08x "
+        "q0=%08x q1=%08x tq=%08x rq=%08x\n",
+        ruby_ep_ready, ruby_rx_ready,
+        ruby_acm_echo_head, ruby_acm_echo_tail, ruby_acm_echo_drops,
+        ruby_gpd_enq, ruby_gpd_deq, ruby_inflight,
+        ruby_rx_packets, ruby_rx_done_events,
+        ruby_rx_errors, ruby_rx_zlp_err,
+        rxcur, ruby_rx_deq, ruby_rd32(mac, RQHIAR1_OFF), rxhwo,
+        ruby_ep2_tx_restarts, ruby_ep2_rx_restarts,
+        ruby_ep2_active_seen, ruby_ep2_tx_kicks,
+        ruby_ep2_rx_active_seen, ruby_ep2_rx_kicks,
+        ruby_txkick_starts, ruby_txrdy_kicks, ruby_tx_replay_bytes,
+        ruby_rd32(mac, TQERRIR0_OFF), ruby_rd32(mac, TX1CSR0_OFF),
+        ruby_rd32(mac, QCR0_OFF), ruby_rd32(mac, QCR1_OFF),
+        ruby_rd32(mac, QCR2_OFF),
+        ruby_rd32(mac, QCR3_OFF), ruby_rd32(mac, TQCPR1_OFF),
+        ruby_rd32(mac, RQCPR1_OFF),
+        ruby_rd32(mac, DEVICE_CONF - MTU3_PA) & 0x7u,
+        ruby_rd32(mac, TX1CSR1_OFF), ruby_rd32(mac, TX1CSR2_OFF),
+        ruby_rd32(mac, RX1CSR1_OFF), ruby_rd32(mac, RX1CSR2_OFF),
+        ruby_rd32(mac, QISAR0_OFF), ruby_rd32(mac, QISAR1_OFF),
+        ruby_rd32(mac, TQCSR1_OFF), ruby_rd32(mac, RQCSR1_OFF));
+    /* 0271: short register line so the console does not truncate it; the
+     * values are diffed against the vendor oracle in docs/106 20.3. */
+    printf("RUBY USB REG: busperf=%08x eprst=%08x qcr3=%08x "
+        "tx1csr1=%08x tx1csr2=%08x rx1csr0=%08x rx1csr1=%08x rx1csr2=%08x "
+        "tq=%08x tqsar1=%08x tqcpr=%08x tqhiar1=%08x "
+        "rq=%08x rqcpr=%08x q0=%08x q1=%08x\n",
+        ruby_rd32(mac, BUS_PERFORMANCE - MTU3_PA), ruby_rd32(mac, EP_RST_OFF),
+        ruby_rd32(mac, QCR3_OFF),
+        ruby_rd32(mac, TX1CSR1_OFF), ruby_rd32(mac, TX1CSR2_OFF),
+        ruby_rd32(mac, RX1CSR0_OFF), ruby_rd32(mac, RX1CSR1_OFF),
+        ruby_rd32(mac, RX1CSR2_OFF),
+        ruby_rd32(mac, TQCSR1_OFF), ruby_rd32(mac, TQSAR1_OFF),
+        ruby_rd32(mac, TQCPR1_OFF), ruby_rd32(mac, TQHIAR1_OFF),
+        ruby_rd32(mac, RQCSR1_OFF), ruby_rd32(mac, RQCPR1_OFF),
+        ruby_rd32(mac, QISAR0_OFF), ruby_rd32(mac, QISAR1_OFF));
+    /* 0285: one-shot runtime USB2 slice, after the device is configured. */
+    if (!usb2_rt_dumped && ruby_cfg_seen) {
+        usb2_rt_dumped = 1;
+        printf("RUBY USB USB2 RT 2400..2470:\n");
+        for (off = 0x2400; off <= 0x2470; off += 0x10)
+            printf("RUBY USB USB2R %04x: %08x %08x %08x %08x\n",
+                off, ruby_rd32(mac, off), ruby_rd32(mac, off + 4),
+                ruby_rd32(mac, off + 8), ruby_rd32(mac, off + 0xc));
+    }
+    /* 0286: one-shot runtime EPCTL / MAC CSR slices for the vendor
+     * comparison; read-only, same first-configured trigger. */
+    if (!epctl_rt_dumped && ruby_cfg_seen) {
+        epctl_rt_dumped = 1;
+        printf("RUBY USB EPCTL RT 0800..0830:\n");
+        for (off = 0x0800; off <= 0x0830; off += 0x10)
+            printf("RUBY USB EPCTLR %04x: %08x %08x %08x %08x\n",
+                off, ruby_rd32(mac, off), ruby_rd32(mac, off + 4),
+                ruby_rd32(mac, off + 8), ruby_rd32(mac, off + 0xc));
+        printf("RUBY USB MACCSR RT 1400..1430:\n");
+        for (off = 0x1400; off <= 0x1430; off += 0x10)
+            printf("RUBY USB MACCSRR %04x: %08x %08x %08x %08x\n",
+                off, ruby_rd32(mac, off), ruby_rd32(mac, off + 4),
+                ruby_rd32(mac, off + 8), ruby_rd32(mac, off + 0xc));
+    }
+    if (ruby_irq_mode) {
+        if (ruby_qmu_irq_mode)
+            printf("RUBY USB IRQ: pass=%u mac2=%u bmu=%u qmu=%u "
+                "qfused=%u lat_n=%u lat_avg=%u lat_max=%u "
+                "resume=%u suspend=%u idle=%u fused=%u requeue=%u\n",
+                ruby_irq_passes, ruby_irq_mac2, ruby_irq_bmu,
+                ruby_irq_qmu, ruby_irq_qmu_fused, ruby_irq_lat_n,
+                ruby_irq_lat_n ? ruby_irq_lat_acc_us / ruby_irq_lat_n : 0,
+                ruby_irq_lat_max_us, ruby_irq_resume, ruby_irq_suspend,
+                ruby_irq_idle, ruby_irq_fused, ruby_irq_requeues);
+        else
+            printf("RUBY USB IRQ: pass=%u mac2=%u bmu=%u resume=%u "
+                "suspend=%u idle=%u fused=%u requeue=%u\n",
+                ruby_irq_passes, ruby_irq_mac2, ruby_irq_bmu,
+                ruby_irq_resume, ruby_irq_suspend, ruby_irq_idle,
+                ruby_irq_fused, ruby_irq_requeues);
+    }
+    last_otg = otg;
+    last_mac2 = mac2;
+    last_ext = ext;
+}
+
+/*
+ * Vendor IN request 0xC0/0x21: live EP2/QMU state for the host, so a stuck
+ * queue can be inspected without another boot or a console read.
+ */
+
+void
+ruby_usb_reattach(vm_offset_t mac, vm_offset_t phy)
+{
+    uint32_t v;
+
+    v = ruby_rd32(mac, PM_CTRL - MTU3_PA);
+    ruby_wr32(mac, PM_CTRL - MTU3_PA, v & ~((1u << 6) | (1u << 0)));
+    v = ruby_rd32(phy, PHY_U2_ACR3);
+    ruby_wr32(phy, PHY_U2_ACR3, v & ~ACR3_EN_PU_DP);
+    /*
+     * A detach drops the PHY session and leaves a stale address behind
+     * (see ruby_usb_attach_poll).  Until 0116 this path only quieted EP0,
+     * which was harmless because the retry could only fire before the
+     * host had ever spoken.  Now that the retry can fire after a failed
+     * enumeration, the device may still be sitting on address 1 while the
+     * host restarts at address 0, so re-arm: address 0, EP0 armed, QMUs
+     * stopped, EP2 state dropped.
+     */
+    ruby_usb_rearm(mac, RUBY_REARM_RESET);
+    delay(150000);
+
+    ruby_ep0_set_maxpacket(mac);
+    /*
+     * A physical unplug drops the PHY session; re-assert the MAC session
+     * bits before the D+ pull-up goes back up, in the same order as the
+     * probe path.
+     */
+    v = ruby_rd32(mac, MISC_CTRL - MTU3_PA);
+    ruby_wr32(mac, MISC_CTRL - MTU3_PA, v | 0x3u);
+    v = ruby_rd32(phy, PHY_U2_ACR3);
+    ruby_wr32(phy, PHY_U2_ACR3, v | ACR3_EN_PU_DP);
+    delay(1000);
+    v = ruby_rd32(mac, PM_CTRL - MTU3_PA);
+    ruby_wr32(mac, PM_CTRL - MTU3_PA, v | (1u << 6) | (1u << 0));
+    delay(2000);
+}
+
+/*
+ * 0196: the reattach sequence owns EP0 (address/FIFO/QMU state), so in
+ * IRQ mode it must run on the service workloop, not in the caller's
+ * context.  The requester sets the flag, kicks the service timer and
+ * busy-waits for the done flag -- the old path blocked the same way,
+ * and there is a single requester at a time (the boot window exits
+ * before the 1 ms thread starts).
+ */
+void
+ruby_usb_reattach_owned(vm_offset_t mac, vm_offset_t phy)
+{
+    if (!ruby_irq_mode) {
+        ruby_usb_reattach(mac, phy);
+        return;
+    }
+    ruby_mac_base = mac;
+    ruby_phy_base = phy;
+    ruby_irq_reattach_done = 0;
+    ruby_irq_reattach_req = 1;
+    ruby_usb_irq_kick();
+    while (!ruby_irq_reattach_done)
+        delay(1000);
+}
+
+void
+ruby_usb_ep0_window(vm_offset_t mac, vm_offset_t ippc, vm_offset_t gpio)
+{
+    static const uint32_t snaps[] = {
+        0, 100, 500, 1000, 2000, 5000, 10000, 20000, 30000
+    };
+    uint32_t window_ms = 30000;
+    uint32_t t = 0, si = 0, sub = 0, cfg_t = 0;
+    int cfg_armed = 0;
+    uint32_t last_otg = 0, last_op = 0;
+    /*
+     * 0145: a first enumeration that gets interrupted by a re-attach
+     * needs more than 4 s to reach SET_CONFIGURATION, and running the
+     * budget out inside the 30 s window leaves the device detached so
+     * the host never sees it again.  Give each attempt 12 s and keep
+     * enough attempts left for the whole window; only the attach
+     * timing changes, the command path is untouched.
+     */
+    uint32_t attach_left = 6, retry_at = 12000;
+    uint32_t evt_seen = 0, last_evt = 0;
+    uint32_t v;
+
+    PE_parse_boot_argn("rubyusb_window_ms", &window_ms, sizeof(window_ms));
+    if (window_ms < 1000 || window_ms > 120000)
+        window_ms = 30000;
+
+    if (!(ruby_rd32(mac, EP0CSR_OFF) & EP0_SETUPPKTRDY) && !ruby_irq_mode)
+        ruby_ep0_set_maxpacket(mac);
+    printf("RUBY USB: P2b window %u ms; EP0 %s, trace ring %u\n",
+        window_ms, ruby_irq_mode ? "IRQ INTID160" : "polling",
+        RUBY_TRACE_MAX);
+
+    while (t <= window_ms) {
+        while (si < sizeof(snaps) / sizeof(snaps[0]) && t >= snaps[si]) {
+            ruby_snapshot(mac, ippc, gpio, t);
+            si++;
+        }
+
+        if (!ruby_irq_mode) {
+            ruby_usb_reset_check(mac);
+            ruby_ep0_service(mac, t);
+        }
+
+        /*
+         * The host sometimes gives up in the middle of enumeration (0116:
+         * one boot in four answers every descriptor and never sends
+         * SET_CONFIGURATION).  The 0116 condition -- setups==0 &&
+         * busresets==0 -- can never hold there: the host has already
+         * touched the device (setups 8-16, busresets 4-5), so the retry
+         * never fired once.  Watch for "not configured yet" instead.
+         *
+         * The earliest retry is 4 s, and only after the host has been
+         * quiet for 2 s, so a slow enumeration that is still making
+         * progress is never interrupted.  Three attempts at most; a
+         * successful SET_CONFIGURATION ends it for good.
+         */
+        if (ruby_ep0_setups + ruby_bus_resets != evt_seen) {
+            evt_seen = ruby_ep0_setups + ruby_bus_resets;
+            last_evt = t;
+        }
+        if (attach_left > 0 && !ruby_cfg_seen && t >= retry_at &&
+            t - last_evt >= 2000) {
+            attach_left--;
+            printf("RUBY USB: no config by t=%u (setups=%u resets=%u), "
+                "re-attach (%u left)\n",
+                t, ruby_ep0_setups, ruby_bus_resets, attach_left);
+            ruby_usb_reattach_owned(mac, ruby_phy_base);
+            retry_at = t + 12000;
+        }
+        if (ruby_cfg_seen) {
+            if (!cfg_armed) {
+                cfg_armed = 1;
+                cfg_t = t;
+            } else if (t - cfg_t >= 200) {
+                printf("RUBY USB: config at t=%u, leave window at t=%u\n",
+                    cfg_t, t);
+                break;
+            }
+        }
+
+
+
+        v = ruby_rd32(ippc, 0x18);
+        if (v != last_otg) {
+            ruby_trace(t, RUBY_TR_STATE, 1, v, 0, 0);
+            last_otg = v;
+        }
+        v = ruby_rd32(mac, USB20_OP - MTU3_PA);
+        if (v != last_op) {
+            ruby_trace(t, RUBY_TR_STATE, 2, v, 0, 0);
+            last_op = v;
+        }
+
+        delay(100);
+        if (++sub == 10) {
+            sub = 0;
+            t++;
+            ruby_ms = t;
+        }
+    }
+
+    ruby_snapshot(mac, ippc, gpio, window_ms);
+    printf("RUBY USB: trace n=%u overflow=%u\n",
+        ruby_event_count, ruby_event_overflow);
+    /*
+     * Counters in sweetlog so a boot that never enumerates still reports
+     * what EP0 did; the 0xC0/0x27 read needs a working host.
+     */
+    printf("RUBY USB: ep0 setups=%u short=%u long=%u txpkts=%u "
+        "dataends=%u sentstalls=%u rewinds=%u busresets=%u spinwaits=%u "
+        "blocked=%u fifowaits=%u pending=%u sent=%u/%u\n",
+        ruby_ep0_setups, ruby_ep0_short, ruby_ep0_long,
+        ruby_ep0_txpkts, ruby_ep0_dataends, ruby_ep0_sentstalls,
+        ruby_ep0_rewinds, ruby_bus_resets, ruby_ep0_tx_waits,
+        ruby_ep0_fifo_blocked, ruby_ep0_fifo_waits,
+        ruby_ep0_tx_pending, ruby_ep0_tx_sent, ruby_ep0_tx_total);
+    for (uint32_t i = 0; i < ruby_event_count; i++)
+        printf("RUBY USB TRACE t=%u type=%u a=%u b=%08x c=%08x d=%08x\n",
+            ruby_events[i].t, ruby_events[i].type, ruby_events[i].a,
+            ruby_events[i].b, ruby_events[i].c, ruby_events[i].d);
+    printf("RUBY USB: trace dumped; starting EP0 thread\n");
+    ruby_mac_base = mac;
+    ruby_ippc_base = ippc;
+    {
+        thread_t thr;
+
+        if (kernel_thread_start(ruby_ep0_thread, NULL, &thr) == KERN_SUCCESS)
+            thread_deallocate(thr);
+        else
+            printf("RUBY USB: EP0 thread start failed\n");
+    }
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
