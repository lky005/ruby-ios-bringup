+static void
+ruby_txpio_qstart_service(vm_offset_t mac)
+{
+    uint32_t t0, tq;
+
+    if (!ruby_txpio_qstart_pending || ruby_txpio_write_busy)
+        return;
+    if ((int32_t)(ruby_ms - ruby_txpio_qstart_due_ms) < 0)
+        return;
+    t0 = ruby_rd32(mac, TX1CSR0_OFF);
+    tq = ruby_rd32(mac, TQCSR1_OFF);
+    /* anti-collision: producer not mid-write, TXPKTRDY clear, FIFO holds
+     * a packet, QMU stopped.  Retry on the next tick otherwise. */
+    if ((t0 & TX_TXPKTRDY) || (t0 & TX_FIFOEMPTY) || (tq & QMU_Q_ACTIVE))
+        return;
+    ruby_txpio_qstart_pending = 0;
+    ruby_wr32(mac, TQCSR1_OFF, QMU_Q_START);
+    ruby_txpio_start_cnt++;
+    if (ruby_txpio_start_cnt <= 8 ||
+        (ruby_txpio_start_cnt & 0x3fu) == 0)
+        printf("RUBY USB: 0297 pio qstart n=%u ms=%d tq=%08x tx0=%08x\n",
+            ruby_txpio_start_cnt, ruby_qstart_ms,
+            ruby_rd32(mac, TQCSR1_OFF), ruby_rd32(mac, TX1CSR0_OFF));
+}
