+#ifndef _IOKIT_SWEET_KPD_H
+#define _IOKIT_SWEET_KPD_H
+
+#include <IOKit/IOService.h>
+#include <mach/vm_types.h>
+#include <stdint.h>
+
+class OSDictionary;
+
+class IOWorkLoop;
+class IOInterruptEventSource;
+class IOTimerEventSource;
+
+class SweetKPD : public IOService
+{
+	OSDeclareDefaultStructors(SweetKPD);
+
+public:
+	bool init(OSDictionary *dictionary = NULL) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void free() APPLE_KEXT_OVERRIDE;
+
+private:
+	IOWorkLoop *fWorkLoop;
+	IOInterruptEventSource *fIRQ;
+	IOTimerEventSource *fReleaseTimer;
+	vm_offset_t fKPD;
+	bool fKeyDown;
+	uint32_t fActionCount;
+	uint32_t fReleaseChecks;
+
+	bool publishInterruptSource(void);
+	bool keyDown(void);
+	void report(bool down);
+	static void irqAction(OSObject *owner, IOInterruptEventSource *sender,
+	    int count);
+	static void releaseTimer(OSObject *owner, IOTimerEventSource *sender);
+};
+
+#endif /* _IOKIT_SWEET_KPD_H */
