+/*
+ * RUBY: shared GICv3 encoding helpers for the native interrupt controller
+ * and the legacy EINT/KPD code.
+ */
+#ifndef RUBY_GIC_H
+#define RUBY_GIC_H
+
+#include <stdint.h>
+
+#define RUBY_GIC_INTID_MIN      32u
+#define RUBY_GIC_INTID_MAX      1019u
+#define RUBY_GIC_PRIO_DEFAULT   0xa0u
+
+/* MPIDR Aff3[39:32], Aff2[23:16], Aff1[15:8], Aff0[7:0]. */
+#define RUBY_GIC_MPIDR_AFF_MASK 0x000000FF00FFFFFFULL
+
+#define RUBY_GIC_EDGE           0x0u
+#define RUBY_GIC_LEVEL          0x1u
+#define RUBY_GIC_ACTIVE_LOW     0x2u
+
+struct ruby_gic_spec {
+	uint32_t intid;
+	uint32_t flags;
+};
+
+static inline uint64_t
+ruby_gic_mpidr_to_irouter(uint64_t mpidr)
+{
+	uint64_t aff0 = mpidr & 0xffu;
+	uint64_t aff1 = (mpidr >> 8) & 0xffu;
+	uint64_t aff2 = (mpidr >> 16) & 0xffu;
+	uint64_t aff3 = (mpidr >> 32) & 0xffu;
+
+	return (aff3 << 32) | (aff2 << 16) | (aff1 << 8) | aff0;
+}
+
+static inline uint32_t
+ruby_gic_bit(uint32_t intid)
+{
+	return 1u << (intid % 32u);
+}
+
+static inline uint32_t
+ruby_gic_group_off(uint32_t intid)
+{
+	return 0x080u + (intid / 32u) * 4u;
+}
+
+static inline uint32_t
+ruby_gic_isenabler_off(uint32_t intid)
+{
+	return 0x100u + (intid / 32u) * 4u;
+}
+
+static inline uint32_t
+ruby_gic_icenabler_off(uint32_t intid)
+{
+	return 0x180u + (intid / 32u) * 4u;
+}
+
+static inline uint32_t
+ruby_gic_pending_off(uint32_t intid)
+{
+	return 0x200u + (intid / 32u) * 4u;
+}
+
+static inline uint32_t
+ruby_gic_priority_off(uint32_t intid)
+{
+	return 0x400u + (intid & ~3u);
+}
+
+static inline uint32_t
+ruby_gic_priority_shift(uint32_t intid)
+{
+	return (intid & 3u) * 8u;
+}
+
+static inline uint32_t
+ruby_gic_icfgr_off(uint32_t intid)
+{
+	return 0xc00u + (intid / 16u) * 4u;
+}
+
+static inline uint32_t
+ruby_gic_icfgr_shift(uint32_t intid)
+{
+	return (intid % 16u) * 2u;
+}
+
+static inline uint32_t
+ruby_gic_irouter_off(uint32_t intid)
+{
+	return 0x6000u + intid * 8u;
+}
+
+#endif /* RUBY_GIC_H */
