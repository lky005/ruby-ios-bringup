+/*
+ * SWEET: native device IRQ dispatch hook.
+ *
+ * The GIC entry in sleh_irq() already has the real INTID and performs the
+ * EOI.  This hook lets a board interrupt controller claim that INTID
+ * without replacing the per-CPU ml_install_interrupt_handler() slot.
+ */
+#include <pexpert/pexpert.h>
+#include <pexpert/arm/pe_irq.h>
+
+static sweet_irq_dispatch_fn g_sweet_irq_fn;
+static void *g_sweet_irq_ctx;
+
+boolean_t
+sweet_irq_dispatch(uint32_t intid)
+{
+	sweet_irq_dispatch_fn fn = __atomic_load_n(&g_sweet_irq_fn,
+	    __ATOMIC_ACQUIRE);
+
+	if (fn == NULL) {
+		return FALSE;
+	}
+	return fn(intid, __atomic_load_n(&g_sweet_irq_ctx, __ATOMIC_RELAXED));
+}
+
+void
+sweet_irq_set_handler(sweet_irq_dispatch_fn fn, void *ctx)
+{
+	__atomic_store_n(&g_sweet_irq_ctx, ctx, __ATOMIC_RELAXED);
+	__atomic_store_n(&g_sweet_irq_fn, fn, __ATOMIC_RELEASE);
+}
