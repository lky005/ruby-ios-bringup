@@ -0,0 +1,217 @@
+#if defined(SWEET)
+/*
+ * SWEET: KPD volume-down button as an IOKit interrupt client.
+ *
+ * INTID138 is a level source.  The event source disables it in primary
+ * context; the workloop action reads KP_MEM1 and keeps the line masked
+ * while the key is held.  Because a masked level line cannot report the
+ * release, a timer samples the key until it goes up and then re-enables
+ * the IRQ.
+ */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOInterruptEventSource.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOTimerEventSource.h>
+#include <IOKit/IOWorkLoop.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSSymbol.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+#include "../../../bsd/dev/ruby_gic.h"
+#include "hid/IOHIDUsageTables.h"
+#include "SweetKPD.h"
+
+#define SWEET_KPD_PA     0x10010000u
+#define SWEET_KPD_SIZE   0x1000u
+#define SWEET_KPD_MEM1   0x0004u
+#define SWEET_KPD_INTID  138u
+#define SWEET_KPD_POLL_MS 10u
+
+#define super IOService
+OSDefineMetaClassAndStructors(SweetKPD, IOService);
+
+extern "C" void sweet_hid_key(int key, int down);
+extern "C" void ruby_keys_set_native_kpd(int on);
+extern "C" void ruby_keys_release_legacy_kpd_irq(void);
+extern "C" vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern "C" uint16_t ruby_rd16(uintptr_t base, uint32_t off);
+
+bool
+SweetKPD::publishInterruptSource(void)
+{
+	OSArray *controllers;
+	OSArray *specifiers;
+	OSSymbol *name;
+	OSData *data;
+	struct ruby_gic_spec spec = {
+		.intid = SWEET_KPD_INTID,
+		.flags = RUBY_GIC_LEVEL,
+	};
+	bool ok;
+
+	controllers = OSArray::withCapacity(1);
+	specifiers = OSArray::withCapacity(1);
+	name = (OSSymbol *)OSSymbol::withCStringNoCopy("RubyGIC");
+	data = OSData::withBytes(&spec, sizeof(spec));
+	if (!controllers || !specifiers || !name || !data) {
+		ok = false;
+		goto out;
+	}
+	if (!controllers->setObject(name) || !specifiers->setObject(data)) {
+		ok = false;
+		goto out;
+	}
+	ok = setProperty("IOInterruptControllers", controllers) &&
+	    setProperty("IOInterruptSpecifiers", specifiers);
+out:
+	OSSafeRelease(controllers);
+	OSSafeRelease(specifiers);
+	OSSafeRelease(name);
+	OSSafeRelease(data);
+	return ok;
+}
+
+bool
+SweetKPD::init(OSDictionary *dictionary)
+{
+	fWorkLoop = NULL;
+	fIRQ = NULL;
+	fReleaseTimer = NULL;
+	fKPD = 0;
+	fKeyDown = false;
+	fActionCount = 0;
+	fReleaseChecks = 0;
+	return super::init(dictionary);
+}
+
+bool
+SweetKPD::start(IOService *provider)
+{
+	int enabled = 0;
+	int native = 0;
+
+	if (!super::start(provider)) {
+		return false;
+	}
+	if (!PE_parse_boot_argn("rubkeys", &enabled, sizeof(enabled)) ||
+	    enabled != 1) {
+		return false;
+	}
+	if (!PE_parse_boot_argn("rubykpdirq", &native, sizeof(native)) ||
+	    native != 1) {
+		return false;
+	}
+	fKPD = ml_io_map(SWEET_KPD_PA, SWEET_KPD_SIZE);
+	if (!fKPD) {
+		return false;
+	}
+	fWorkLoop = getWorkLoop();
+	if (!fWorkLoop) {
+		return false;
+	}
+	fWorkLoop->retain();
+	if (!publishInterruptSource()) {
+		return false;
+	}
+	fIRQ = IOInterruptEventSource::interruptEventSource(this,
+	    &SweetKPD::irqAction, this, 0);
+	if (!fIRQ || fWorkLoop->addEventSource(fIRQ) != kIOReturnSuccess) {
+		return false;
+	}
+	fReleaseTimer = IOTimerEventSource::timerEventSource(this,
+	    &SweetKPD::releaseTimer);
+	if (!fReleaseTimer ||
+	    fWorkLoop->addEventSource(fReleaseTimer) != kIOReturnSuccess) {
+		return false;
+	}
+	ruby_keys_set_native_kpd(1);
+	ruby_keys_release_legacy_kpd_irq();
+	fIRQ->enable();
+	IOLog("SWEET KPD: irq index=0 intid=%u type=level\n",
+	    SWEET_KPD_INTID);
+	return true;
+}
+
+void
+SweetKPD::free(void)
+{
+	ruby_keys_set_native_kpd(0);
+	if (fReleaseTimer) {
+		fReleaseTimer->cancelTimeout();
+		if (fWorkLoop) {
+			fWorkLoop->removeEventSource(fReleaseTimer);
+		}
+		OSSafeRelease(fReleaseTimer);
+		fReleaseTimer = NULL;
+	}
+	if (fIRQ) {
+		fIRQ->disable();
+		if (fWorkLoop) {
+			fWorkLoop->removeEventSource(fIRQ);
+		}
+		OSSafeRelease(fIRQ);
+		fIRQ = NULL;
+	}
+	if (fWorkLoop) {
+		fWorkLoop->release();
+		fWorkLoop = NULL;
+	}
+	super::free();
+}
+
+bool
+SweetKPD::keyDown(void)
+{
+	return (ruby_rd16((uintptr_t)fKPD, SWEET_KPD_MEM1) & 1u) == 0;
+}
+
+void
+SweetKPD::report(bool down)
+{
+	IOLog("SWEET KPD: volume down %s\n", down ? "down" : "up");
+	sweet_hid_key(kHIDUsage_Csmr_VolumeDecrement, down ? 1 : 0);
+}
+
+void
+SweetKPD::irqAction(OSObject *owner, IOInterruptEventSource *sender,
+    int count)
+{
+	SweetKPD *self = (SweetKPD *)owner;
+
+	(void)sender;
+	(void)count;
+	self->fActionCount++;
+	if (self->keyDown()) {
+		if (!self->fKeyDown) {
+			self->fKeyDown = true;
+			self->report(true);
+		}
+		self->fIRQ->disable();
+		(void)self->fReleaseTimer->setTimeoutMS(SWEET_KPD_POLL_MS);
+	} else if (self->fKeyDown) {
+		self->fKeyDown = false;
+		self->report(false);
+	}
+}
+
+void
+SweetKPD::releaseTimer(OSObject *owner, IOTimerEventSource *sender)
+{
+	SweetKPD *self = (SweetKPD *)owner;
+
+	(void)sender;
+	self->fReleaseChecks++;
+	if (self->keyDown()) {
+		(void)self->fReleaseTimer->setTimeoutMS(SWEET_KPD_POLL_MS);
+		return;
+	}
+	if (self->fKeyDown) {
+		self->fKeyDown = false;
+		self->report(false);
+	}
+	self->fIRQ->enable();
+}
+
+#endif /* SWEET */
