--- /dev/null
+++ b/iokit/Kernel/arm/RubyGICInterruptController.cpp
@@ -0,0 +1,545 @@
+#if defined(SWEET)
+/*
+ * SWEET: board-level GICv3 SPI controller.
+ *
+ * The SWEET GIC entry (sleh_irq) already reads ICC_IAR1_EL1, handles the
+ * timer/IPI paths and writes ICC_EOIR1_EL1.  This controller only owns the
+ * INTID -> vector mapping and the per-line GIC programming; it never reads
+ * IAR or writes EOI.
+ */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOInterruptController.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOService.h>
+#include <libkern/c++/OSSymbol.h>
+#include <string.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/arm/pe_irq.h>
+
+#include "../../../bsd/dev/ruby_gic.h"
+#include "RubyGICInterruptController.h"
+
+#define super IOInterruptController
+OSDefineMetaClassAndStructors(RubyGICInterruptController, IOInterruptController);
+
+#define RUBY_GICD_PA            0x0c000000u
+#define RUBY_GICD_SIZE          0x10000u
+#define RUBY_GIC_NUM_VECTORS    1024u
+#define RUBY_GICD_CTLR          0x0000u
+#define RUBY_GICD_CTLR_RWP      0x80000000u
+#define RUBY_GICD_CTLR_ARE_NS   0x10u
+#define RUBY_GICD_CTLR_GRP1NS   0x2u
+#define RUBY_GIC_SMC_GIC_DUMP   0xc2000201u
+
+extern "C" vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern "C" void delay(int);
+
+static inline uint32_t
+gic_rd32(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+gic_wr32(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static inline uint64_t
+gic_rd64(vm_offset_t base, uint32_t off)
+{
+	uint64_t v = *(volatile uint64_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+gic_wr64(vm_offset_t base, uint32_t off, uint64_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint64_t *)(base + off) = v;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static long
+ruby_gic_smc_dump(uint32_t intid, uint64_t *raw)
+{
+	register uint64_t x0 __asm__("x0") = RUBY_GIC_SMC_GIC_DUMP;
+	register uint64_t x1 __asm__("x1") = intid;
+
+	__asm__ volatile(
+	    "mov x2, xzr\n\t"
+	    "mov x3, xzr\n\t"
+	    "mov x4, xzr\n\t"
+	    "mov x5, xzr\n\t"
+	    "mov x6, xzr\n\t"
+	    "mov x7, xzr\n\t"
+	    "smc #0\n\t"
+	    : "+r"(x0), "+r"(x1)
+	    :
+	    : "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10",
+	      "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	*raw = x0;
+	return (long)x0;
+}
+
+extern "C" boolean_t
+ruby_gic_dispatch(uint32_t intid, void *ctx)
+{
+	RubyGICInterruptController *gic = (RubyGICInterruptController *)ctx;
+
+	return gic->handleInterrupt(NULL, NULL, (int)intid) == kIOReturnSuccess;
+}
+
+bool
+RubyGICInterruptController::init(OSDictionary *dictionary)
+{
+	vectors = NULL;
+	fGICD = 0;
+	fTargetMpidr = 0;
+	fNumVectors = 0;
+	fSpurious = 0;
+	fUnhandled = 0;
+	memset(fTrigger, 0, sizeof(fTrigger));
+	memset(fRegistered, 0, sizeof(fRegistered));
+	return super::init(dictionary);
+}
+
+bool
+RubyGICInterruptController::start(IOService *provider)
+{
+	OSSymbol *name;
+
+	if (!super::start(provider)) {
+		return false;
+	}
+	fGICD = ml_io_map(RUBY_GICD_PA, RUBY_GICD_SIZE);
+	if (!fGICD) {
+		IOLog("RUBY GIC: no gicd\n");
+		return false;
+	}
+	if (!gicPreflight()) {
+		IOLog("RUBY GIC: preflight failed\n");
+		return false;
+	}
+	fNumVectors = RUBY_GIC_NUM_VECTORS;
+	vectors = IONewZero(IOInterruptVector, fNumVectors);
+	if (!vectors) {
+		return false;
+	}
+	for (uint32_t i = 0; i < fNumVectors; i++) {
+		vectors[i].interruptLock = IOLockAlloc();
+		if (!vectors[i].interruptLock) {
+			releaseVectors();
+			return false;
+		}
+	}
+	fTargetMpidr = __builtin_arm_rsr64("MPIDR_EL1") &
+	    RUBY_GIC_MPIDR_AFF_MASK;
+	name = (OSSymbol *)OSSymbol::withCStringNoCopy("RubyGIC");
+	if (!name || !getPlatform() ||
+	    getPlatform()->registerInterruptController(name, this) !=
+	    kIOReturnSuccess) {
+		releaseVectors();
+		return false;
+	}
+	sweet_irq_set_handler(ruby_gic_dispatch, this);
+	IOLog("RUBY GIC: ready gicd=%d target=%016llx vectors=%u\n",
+	    fGICD != 0, (unsigned long long)fTargetMpidr, fNumVectors);
+	return true;
+}
+
+void
+RubyGICInterruptController::releaseVectors(void)
+{
+	if (!vectors) {
+		return;
+	}
+	for (uint32_t i = 0; i < fNumVectors; i++) {
+		if (vectors[i].interruptLock) {
+			IOLockFree(vectors[i].interruptLock);
+			vectors[i].interruptLock = NULL;
+		}
+	}
+	IODelete(vectors, IOInterruptVector, fNumVectors);
+	vectors = NULL;
+}
+
+void
+RubyGICInterruptController::free(void)
+{
+	sweet_irq_set_handler(NULL, NULL);
+	if (vectors) {
+		if (fGICD) {
+			for (uint32_t i = 0; i < fNumVectors; i++) {
+				if (vectors[i].interruptRegistered) {
+					disableVectorHard(
+					    (IOInterruptVectorNumber)i,
+					    &vectors[i]);
+					vectors[i].interruptRegistered = 0;
+				}
+			}
+		}
+		releaseVectors();
+	}
+	super::free();
+}
+
+bool
+RubyGICInterruptController::gicPreflight(void)
+{
+	uint32_t ctlr = gic_rd32(fGICD, RUBY_GICD_CTLR);
+
+	if ((ctlr & (RUBY_GICD_CTLR_ARE_NS | RUBY_GICD_CTLR_GRP1NS)) !=
+	    (RUBY_GICD_CTLR_ARE_NS | RUBY_GICD_CTLR_GRP1NS)) {
+		IOLog("RUBY GIC: ctlr=%08x\n", ctlr);
+		return false;
+	}
+	return gicRwpWait();
+}
+
+bool
+RubyGICInterruptController::gicRwpWait(void)
+{
+	for (uint32_t i = 0; i < 1000; i++) {
+		if (!(gic_rd32(fGICD, RUBY_GICD_CTLR) &
+		    RUBY_GICD_CTLR_RWP)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+bool
+RubyGICInterruptController::gicValidate(uint32_t intid)
+{
+	uint64_t smc = 0;
+	long rc;
+
+	if (intid < RUBY_GIC_INTID_MIN || intid > RUBY_GIC_INTID_MAX) {
+		return false;
+	}
+	rc = ruby_gic_smc_dump(intid, &smc);
+	if (rc < 0 || ((smc >> 1) & 1u) != 1u) {
+		return false;
+	}
+	return true;
+}
+
+void
+RubyGICInterruptController::gicProgram(uint32_t intid, uint32_t flags)
+{
+	uint32_t bit = ruby_gic_bit(intid);
+	uint32_t off;
+	uint32_t v;
+
+	off = ruby_gic_group_off(intid);
+	v = gic_rd32(fGICD, off);
+	gic_wr32(fGICD, off, v | bit);
+
+	off = ruby_gic_priority_off(intid);
+	v = gic_rd32(fGICD, off);
+	v &= ~(0xffu << ruby_gic_priority_shift(intid));
+	v |= RUBY_GIC_PRIO_DEFAULT << ruby_gic_priority_shift(intid);
+	gic_wr32(fGICD, off, v);
+
+	off = ruby_gic_icfgr_off(intid);
+	v = gic_rd32(fGICD, off);
+	v &= ~(3u << ruby_gic_icfgr_shift(intid));
+	if (flags & RUBY_GIC_LEVEL) {
+		v |= 2u << ruby_gic_icfgr_shift(intid);
+	}
+	gic_wr32(fGICD, off, v);
+
+	gic_wr64(fGICD, ruby_gic_irouter_off(intid),
+	    ruby_gic_mpidr_to_irouter(fTargetMpidr));
+	gic_wr32(fGICD, ruby_gic_pending_off(intid), bit);
+	(void)gicRwpWait();
+}
+
+void
+RubyGICInterruptController::gicMask(uint32_t intid)
+{
+	gic_wr32(fGICD, ruby_gic_icenabler_off(intid), ruby_gic_bit(intid));
+	if (!getPlatform()->atInterruptLevel()) {
+		(void)gicRwpWait();
+	}
+}
+
+void
+RubyGICInterruptController::gicUnmask(uint32_t intid)
+{
+	OSSynchronizeIO();
+	gic_wr32(fGICD, ruby_gic_isenabler_off(intid), ruby_gic_bit(intid));
+	if (!getPlatform()->atInterruptLevel()) {
+		(void)gicRwpWait();
+	}
+}
+
+bool
+RubyGICInterruptController::specForSource(IOService *nub, int source,
+    uint32_t *intid, uint32_t *flags)
+{
+	IOInterruptSource *src;
+	OSData *data;
+	const struct ruby_gic_spec *spec;
+
+	if (!nub || !nub->_interruptSources || source < 0 ||
+	    source >= nub->_numInterruptSources) {
+		return false;
+	}
+	src = &nub->_interruptSources[source];
+	data = src->vectorData;
+	if (!data || data->getLength() < sizeof(struct ruby_gic_spec)) {
+		return false;
+	}
+	spec = (const struct ruby_gic_spec *)data->getBytesNoCopy();
+	*intid = spec->intid;
+	*flags = spec->flags;
+	return true;
+}
+
+IOInterruptVector *
+RubyGICInterruptController::vectorForSource(IOService *nub, int source)
+{
+	uint32_t intid;
+	uint32_t flags;
+
+	if (!specForSource(nub, source, &intid, &flags) ||
+	    intid >= fNumVectors) {
+		return NULL;
+	}
+	return &vectors[intid];
+}
+
+IOReturn
+RubyGICInterruptController::registerInterrupt(IOService *nub, int source,
+    void *target, IOInterruptHandler handler, void *refCon)
+{
+	uint32_t intid;
+	uint32_t flags;
+	IOReturn ret;
+
+	if (!vectors) {
+		return kIOReturnNotReady;
+	}
+	if (!specForSource(nub, source, &intid, &flags)) {
+		return kIOReturnBadArgument;
+	}
+	if (intid < RUBY_GIC_INTID_MIN || intid >= fNumVectors) {
+		return kIOReturnBadArgument;
+	}
+	if (fRegistered[intid]) {
+		return kIOReturnNoResources;
+	}
+	if (!gicValidate(intid)) {
+		return kIOReturnUnsupported;
+	}
+	gicProgram(intid, flags);
+	fTrigger[intid] = (flags & RUBY_GIC_LEVEL) ?
+	    kIOInterruptTypeLevel : kIOInterruptTypeEdge;
+	fRegistered[intid] = 1;
+	ret = super::registerInterrupt(nub, source, target, handler, refCon);
+	if (ret != kIOReturnSuccess) {
+		fRegistered[intid] = 0;
+	}
+	return ret;
+}
+
+IOReturn
+RubyGICInterruptController::unregisterInterrupt(IOService *nub, int source)
+{
+	uint32_t intid;
+	uint32_t flags;
+	IOReturn ret;
+
+	if (!vectors) {
+		return kIOReturnNotReady;
+	}
+	if (!specForSource(nub, source, &intid, &flags)) {
+		return kIOReturnBadArgument;
+	}
+	ret = super::unregisterInterrupt(nub, source);
+	if (ret == kIOReturnSuccess && intid < fNumVectors) {
+		fRegistered[intid] = 0;
+	}
+	return ret;
+}
+
+IOReturn
+RubyGICInterruptController::getInterruptType(IOService *nub, int source,
+    int *interruptType)
+{
+	uint32_t intid;
+	uint32_t flags;
+
+	if (!vectors || !interruptType ||
+	    !specForSource(nub, source, &intid, &flags)) {
+		return kIOReturnBadArgument;
+	}
+	*interruptType = (flags & RUBY_GIC_LEVEL) ?
+	    kIOInterruptTypeLevel : kIOInterruptTypeEdge;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+RubyGICInterruptController::enableInterrupt(IOService *nub, int source)
+{
+	uint32_t intid;
+	uint32_t flags;
+	IOInterruptVector *vec;
+
+	if (!vectors) {
+		return kIOReturnNotReady;
+	}
+	if (!specForSource(nub, source, &intid, &flags) ||
+	    intid >= fNumVectors) {
+		return kIOReturnBadArgument;
+	}
+	vec = &vectors[intid];
+	vec->interruptDisabledSoft = 0;
+	OSMemoryBarrier();
+	if (!getPlatform()->atInterruptLevel()) {
+		while (vec->interruptActive) {
+		}
+	}
+	if (vec->interruptDisabledHard) {
+		vec->interruptDisabledHard = 0;
+		gicUnmask(intid);
+	}
+	return kIOReturnSuccess;
+}
+
+IOReturn
+RubyGICInterruptController::disableInterrupt(IOService *nub, int source)
+{
+	uint32_t intid;
+	uint32_t flags;
+	IOInterruptVector *vec;
+
+	if (!vectors) {
+		return kIOReturnNotReady;
+	}
+	if (!specForSource(nub, source, &intid, &flags) ||
+	    intid >= fNumVectors) {
+		return kIOReturnBadArgument;
+	}
+	vec = &vectors[intid];
+	vec->interruptDisabledSoft = 1;
+	OSMemoryBarrier();
+	if (!getPlatform()->atInterruptLevel()) {
+		while (vec->interruptActive) {
+		}
+	}
+	if (!vec->interruptDisabledHard) {
+		vec->interruptDisabledHard = 1;
+		gicMask(intid);
+	}
+	return kIOReturnSuccess;
+}
+
+IOReturn
+RubyGICInterruptController::handleInterrupt(void *refCon, IOService *nub,
+    int source)
+{
+	IOInterruptVector *vec;
+
+	(void)refCon;
+	(void)nub;
+
+	if (source < (int)RUBY_GIC_INTID_MIN ||
+	    source > (int)RUBY_GIC_INTID_MAX || !vectors) {
+		return kIOReturnInvalid;
+	}
+	vec = &vectors[source];
+	if (!vec->interruptRegistered) {
+		return kIOReturnInvalid;
+	}
+	if (vec->interruptDisabledSoft || vec->interruptDisabledHard ||
+	    !vec->handler) {
+		__atomic_add_fetch(&fUnhandled, 1, __ATOMIC_RELAXED);
+		return kIOReturnSuccess;
+	}
+	vec->interruptActive = 1;
+	OSMemoryBarrier();
+	vec->handler(vec->target, vec->refCon, vec->nub, vec->source);
+	OSMemoryBarrier();
+	vec->interruptActive = 0;
+	return kIOReturnSuccess;
+}
+
+bool
+RubyGICInterruptController::vectorCanBeShared(
+    IOInterruptVectorNumber vectorNumber, IOInterruptVector *vector)
+{
+	(void)vectorNumber;
+	(void)vector;
+	return false;
+}
+
+void
+RubyGICInterruptController::initVector(IOInterruptVectorNumber vectorNumber,
+    IOInterruptVector *vector)
+{
+	(void)vectorNumber;
+	(void)vector;
+}
+
+int
+RubyGICInterruptController::getVectorType(IOInterruptVectorNumber vectorNumber,
+    IOInterruptVector *vector)
+{
+	(void)vector;
+
+	if (vectorNumber < 0 || (uint32_t)vectorNumber >= fNumVectors) {
+		return kIOInterruptTypeEdge;
+	}
+	return fTrigger[vectorNumber] ?
+	    kIOInterruptTypeLevel : kIOInterruptTypeEdge;
+}
+
+void
+RubyGICInterruptController::disableVectorHard(
+    IOInterruptVectorNumber vectorNumber, IOInterruptVector *vector)
+{
+	(void)vector;
+
+	if (vectorNumber < 0 || (uint32_t)vectorNumber >= fNumVectors) {
+		return;
+	}
+	gicMask((uint32_t)vectorNumber);
+}
+
+void
+RubyGICInterruptController::enableVector(
+    IOInterruptVectorNumber vectorNumber, IOInterruptVector *vector)
+{
+	(void)vector;
+
+	if (vectorNumber < 0 || (uint32_t)vectorNumber >= fNumVectors) {
+		return;
+	}
+	gicUnmask((uint32_t)vectorNumber);
+}
+
+void
+RubyGICInterruptController::causeVector(
+    IOInterruptVectorNumber vectorNumber, IOInterruptVector *vector)
+{
+	(void)vector;
+
+	if (vectorNumber < 0 || (uint32_t)vectorNumber >= fNumVectors) {
+		return;
+	}
+	gic_wr32(fGICD, ruby_gic_pending_off((uint32_t)vectorNumber),
+	    ruby_gic_bit((uint32_t)vectorNumber));
+}
+
