+#ifndef _PEXPERT_ARM_PE_IRQ_H_
+#define _PEXPERT_ARM_PE_IRQ_H_
+
+#include <mach/boolean.h>
+#include <stdint.h>
+
+typedef boolean_t (*sweet_irq_dispatch_fn)(uint32_t intid, void *ctx);
+
+/*
+ * Device IRQ dispatch hook.  sleh_irq() calls sweet_irq_dispatch() before
+ * the legacy per-CPU ml_install_interrupt_handler() slot.  A false return
+ * means no native controller owns the INTID.
+ */
+extern boolean_t sweet_irq_dispatch(uint32_t intid);
