diff --git a/bsd/dev/ruby_usb.c b/bsd/dev/ruby_usb.c
index 38fa404..1cca2f6 100644
--- a/bsd/dev/ruby_usb.c
+++ b/bsd/dev/ruby_usb.c
@@ -2005,6 +2005,10 @@ static uint32_t ruby_ep2_tx_kick_ms;
 static uint32_t ruby_ep2_rx_kicks;
 static uint32_t ruby_ep2_rx_active_seen;
 static uint32_t ruby_ep2_rx_kick_ms;
+/* 0245: forced stop/start bookkeeping. */
+static uint32_t ruby_ep2_tx_force_ms;
+static uint32_t ruby_ep2_rx_progress_ms;
+static uint32_t ruby_ep2_rx_last_pkts;
 static uint32_t ruby_inflight;
 static uint32_t ruby_ep2_host_seen;
 static volatile uint32_t ruby_tx_busy;
@@ -2850,13 +2854,70 @@ ruby_acm_echo_dequeue(uint8_t *out, uint32_t max)
