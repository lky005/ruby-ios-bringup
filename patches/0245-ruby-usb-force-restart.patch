 /*
- * 0243: TX watchdog.  Relax the wake-up gate: while descriptors are in
- * flight and 20 ms passed since the last kick, ring the doorbell
- * unconditionally -- regardless of what the ACTIVE readback says (the
- * console round showed inf=1 with tq=0, and the old !ACTIVE test could
- * skip the kick forever).  active_seen records how often the readback
- * still claimed ACTIVE at kick time.
+ * 0245: forced STOP + full re-program.  RESUME is a no-op while the
+ * readback still claims ACTIVE (console: act == kick, inf stuck), so a
+ * pseudo-active queue has to be stopped and rebuilt.
  */
+static void
+ruby_ep2_tx_force(vm_offset_t mac)
+{
+    uint64_t pa = ruby_gpd_pa[ruby_gpd_deq % RUBY_GPD_NUM];
+    uint32_t i;
+
+    ruby_wr32(mac, TQCSR1_OFF, QMU_Q_STOP);
+    for (i = 0; i < 200; i++) {
+        if (!(ruby_rd32(mac, TQCSR1_OFF) & QMU_Q_ACTIVE))
+            break;
+        delay(10);
+    }
+    ruby_wr32(mac, EP_RST_OFF, EP_RST_TX1_BIT);
+    ruby_wr32(mac, EP_RST_OFF, 0);
+    (void)ruby_rd32(mac, EP_RST_OFF);
+    ruby_wr32(mac, TX1CSR0_OFF, 512u | (1u << 29));
+    ruby_wr32(mac, TX1CSR1_OFF, 2u << 8);
+    ruby_wr32(mac, TX1CSR2_OFF, 32u | (9u << 16));
+    ruby_wr32(mac, QCR0_OFF, ruby_rd32(mac, QCR0_OFF) |
+        (1u << 0) | (1u << 1));
+    ruby_wr32(mac, QCR1_OFF, ruby_rd32(mac, QCR1_OFF) | (1u << 1));
+    ruby_wr32(mac, TQERRIESR0_OFF,
+        ruby_rd32(mac, TQERRIESR0_OFF) | (1u << 17) | (1u << 1));
+    ruby_wr32(mac, TQSAR1_OFF, (uint32_t)pa);
+    ruby_wr32(mac, TQHIAR1_OFF, (uint32_t)((pa >> 32) & 0xfu));
+    ruby_wr32(mac, TQCSR1_OFF, QMU_Q_START);
+    ruby_ep2_tx_restarts++;
+}
+
+static void
+ruby_ep2_rx_force(vm_offset_t mac)
+{
+    uint64_t pa = ruby_rx_gpd_pa[ruby_rx_deq % RUBY_RX_GPD_NUM];
+    uint32_t i;
+
+    ruby_wr32(mac, RQCSR1_OFF, QMU_Q_STOP);
+    for (i = 0; i < 200; i++) {
+        if (!(ruby_rd32(mac, RQCSR1_OFF) & QMU_Q_ACTIVE))
+            break;
+        delay(10);
+    }
+    ruby_wr32(mac, EP_RST_OFF, EP_RST_RX1_BIT);
+    ruby_wr32(mac, EP_RST_OFF, 0);
+    (void)ruby_rd32(mac, EP_RST_OFF);
+    ruby_wr32(mac, RX1CSR0_OFF, 64u | RX_DMAREQEN);
+    ruby_wr32(mac, RX1CSR1_OFF, RX_SLOT(2) | RX_TYPE(0));
+    ruby_wr32(mac, RX1CSR2_OFF, RX_FIFOADDR(0x40 >> 4) | RX_FIFOSEGSIZE(9));
+    ruby_wr32(mac, QCR0_OFF, ruby_rd32(mac, QCR0_OFF) | (1u << 17));
+    ruby_wr32(mac, QCR3_OFF,
+        (ruby_rd32(mac, QCR3_OFF) & ~QMU_RX_ZLP_BIT) | QMU_RX_COZ_BIT);
+    ruby_wr32(mac, RQERRIESR0_OFF, ruby_rd32(mac, RQERRIESR0_OFF) |
+        QMU_RX_LEN_ERR_BIT | QMU_RX_CS_ERR_BIT);
+    ruby_wr32(mac, RQERRIESR1_OFF, ruby_rd32(mac, RQERRIESR1_OFF) |
+        QMU_RX_ZLP_ERR_BIT);
+    ruby_wr32(mac, RQSAR1_OFF, (uint32_t)pa);
+    ruby_wr32(mac, RQHIAR1_OFF, (uint32_t)((pa >> 32) & 0xfu));
+    ruby_wr32(mac, RQCSR1_OFF, QMU_Q_START);
+    ruby_ep2_rx_restarts++;
+}
+
 static void
 ruby_ep2_tx_watchdog(vm_offset_t mac)
 {
@@ -2867,18 +2928,17 @@ ruby_ep2_tx_watchdog(vm_offset_t mac)
     ruby_ep2_tx_kick_ms = ruby_ms;
     if (ruby_rd32(mac, TQCSR1_OFF) & QMU_Q_ACTIVE)
         ruby_ep2_active_seen++;
-    ruby_wr32(mac, TQCSR1_OFF, QMU_Q_RESUME);
-    if (!(ruby_rd32(mac, TQCSR1_OFF) & QMU_Q_ACTIVE))
+    if ((uint32_t)(ruby_ms - ruby_ep2_tx_force_ms) >= 100) {
+        ruby_ep2_tx_force_ms = ruby_ms;
+        ruby_ep2_tx_force(mac);
+    } else {
         ruby_wr32(mac, TQCSR1_OFF, QMU_Q_RESUME);
+        if (!(ruby_rd32(mac, TQCSR1_OFF) & QMU_Q_ACTIVE))
+            ruby_wr32(mac, TQCSR1_OFF, QMU_Q_RESUME);
+    }
     ruby_ep2_tx_kicks++;
 }
 
-/*
- * 0244: RX watchdog, mirroring the TX one.  The RQCSR ACTIVE readback
- * also lies on this silicon, so kick the RX doorbell unconditionally
- * every 20 ms; only fall into the full re-program when the queue still
- * reports inactive afterwards.
- */
 static void
 ruby_ep2_rx_watchdog(vm_offset_t mac)
 {
@@ -2889,9 +2949,18 @@ ruby_ep2_rx_watchdog(vm_offset_t mac)
     ruby_ep2_rx_kick_ms = ruby_ms;
     if (ruby_rd32(mac, RQCSR1_OFF) & QMU_Q_ACTIVE)
         ruby_ep2_rx_active_seen++;
-    ruby_wr32(mac, RQCSR1_OFF, QMU_Q_RESUME);
-    if (!(ruby_rd32(mac, RQCSR1_OFF) & QMU_Q_ACTIVE))
-        ruby_ep2_rx_resume(mac);
+    if (ruby_rx_packets != ruby_ep2_rx_last_pkts) {
+        ruby_ep2_rx_last_pkts = ruby_rx_packets;
+        ruby_ep2_rx_progress_ms = ruby_ms;
+    }
+    if ((uint32_t)(ruby_ms - ruby_ep2_rx_progress_ms) >= 200) {
+        ruby_ep2_rx_force(mac);
+        ruby_ep2_rx_progress_ms = ruby_ms;
+    } else {
+        ruby_wr32(mac, RQCSR1_OFF, QMU_Q_RESUME);
+        if (!(ruby_rd32(mac, RQCSR1_OFF) & QMU_Q_ACTIVE))
+            ruby_wr32(mac, RQCSR1_OFF, QMU_Q_RESUME);
+    }
     ruby_ep2_rx_kicks++;
 }
 
