+#if CONFIG_SCHED_EDGE
+/*
+ * SWEET B4a: no performance controller recommends clusters here, so a thread group starts
+ * with its fixed priority, user interactive and user initiated buckets on the first P
+ * cluster, and its utility and background buckets on the boot cluster.
+ */
+static uint32_t
+sched_edge_default_preferred_cluster(sched_bucket_t bucket)
+{
+	if (bucket >= TH_BUCKET_SHARE_UT) {
+		return pset0.pset_cluster_id;
+	}
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	for (unsigned int i = 0; topology != NULL && i < topology->num_clusters; i++) {
+		if (topology->clusters[i].cluster_type == CLUSTER_TYPE_P) {
+			return topology->clusters[i].cluster_id;
+		}
+	}
+	return pset0.pset_cluster_id;
+}
+#endif /* CONFIG_SCHED_EDGE */
