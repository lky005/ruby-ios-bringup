+ruby_ep_tx_offsets(uint32_t ep)
+{
+    if (ep < 1u)
+        ep = 1u;
+    if (ep > 8u)
+        ep = 8u;
+    ruby_tx_csr0_off = 0x0110 + (ep - 1u) * 0x10;
+    ruby_tx_csr1_off = 0x0114 + (ep - 1u) * 0x10;
+    ruby_tx_csr2_off = 0x0118 + (ep - 1u) * 0x10;
+    ruby_tq_csr_off = 0x0510 + (ep - 1u) * 0x10;
+    ruby_tq_sar_off = 0x0514 + (ep - 1u) * 0x10;
+    ruby_tq_cpr_off = 0x0518 + (ep - 1u) * 0x10;
+    ruby_tq_hiar_off = 0x0484 + (ep - 1u) * 4;
