+/*
+ * 0334b4: real per-endpoint FIFO allocation (vendor ep_fifo_alloc).
+ *
+ * CAP_EP0FFSZ is EP0's own FIFO block, so the per-direction pool below
+ * starts at its own address 0 -- which is exactly what the verified
+ * EP1 TX/RX CSR2 values (FIFOADDR 0, SEGSIZE 9) program today.  Each
+ * endpoint takes roundup_pow2(ceil(mps / 512)) * (slot + 1) units; the
+ * TWRP register dump shows this IP running slot 2, i.e. 3 units per
+ * endpoint, so only five endpoints fit per direction and the rest are
+ * refused with a bounded print instead of overlapping segments.
+ */
+uint32_t ruby_epfifo_addr[2][16];
+static int ruby_epfifo_mapped;
+/* 0334b4: 0 is a legal FIFO address (EP1 sits at 0), so "unallocated"
+ * needs its own sentinel. */
+#define RUBY_EPFIFO_NONE 0xffffffffu
+
+static int
+epfifo_find(const struct ruby_usb_fifo *f, uint32_t units)
+{
+    uint32_t start, i;
+
+    for (start = 0; start + units <= f->total_units; start++) {
+        for (i = 0; i < units; i++)
+            if (f->bitmap & (1u << (start + i)))
+                break;
+        if (i == units)
+            return (int)start;
+    }
+    return -1;
+}
+
+int
+ruby_epfifo_map(void)
+{
+    struct ruby_usb_fifo f[2];
+    uint32_t dir, ep, units, total;
+
+    if (ruby_epfifo_mapped)
+        return 0;
+    if (!ruby_usb_cfg_cap[1] || !ruby_usb_cfg_cap[2]) {
+        printf("RUBY CFG: 0334b4 epfifo no caps\n");
+        return -1;
+    }
+    for (dir = 0; dir < 2; dir++) {
+        for (ep = 0; ep < 16u; ep++)
+            ruby_epfifo_addr[dir][ep] = RUBY_EPFIFO_NONE;
+        total = ((dir == 0) ? ruby_usb_cfg_cap[1] :
+            ruby_usb_cfg_cap[2]) / RUBY_USB_FIFO_UNIT;
+        if (total == 0 || total > 32u)
+            return -1;
+        f[dir].total_units = total;
+        f[dir].ep0_units = 0;
+        f[dir].used_units = 0;
+        f[dir].free_units = total;
+        f[dir].bitmap = 0;
+    }
+    for (ep = 1; ep <= 8; ep++) {
+        for (dir = 0; dir < 2; dir++) {
+            uint32_t slot = (dir == 0) ? (uint32_t)ruby_txslot :
+                ruby_rx_slot;
+            int start;
+
+            units = slot + 1u;      /* vendor: seg 512 B x (slot + 1) */
+            start = epfifo_find(&f[dir], units);
+            if (start < 0) {
+                ruby_epfifo_addr[dir][ep] = RUBY_EPFIFO_NONE;
+                printf("RUBY CFG: 0334b4 epfifo %s ep%u REJECT "
+                    "units=%u free=%u\n", dir ? "rx" : "tx", ep,
+                    units, f[dir].free_units);
+                continue;
+            }
+            f[dir].bitmap |= ((1u << units) - 1u) << start;
+            f[dir].used_units += units;
+            f[dir].free_units -= units;
+            ruby_epfifo_addr[dir][ep] =
+                (uint32_t)start * RUBY_USB_FIFO_UNIT;
+            printf("RUBY CFG: 0334b4 epfifo %s ep%u addr=0x%x units=%u\n",
+                dir ? "rx" : "tx", ep, ruby_epfifo_addr[dir][ep], units);
+        }
+    }
+    ruby_epfifo_mapped = 1;
+    printf("RUBY CFG: 0334b4 epfifo tx_free=%u rx_free=%u ep0_cap=%u\n",
+        f[0].free_units, f[1].free_units, ruby_usb_cfg_cap[0]);
+    return 0;
+}
