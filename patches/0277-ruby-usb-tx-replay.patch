 }
 
+/*
+ * 0277: the destructive rebuild clears the ring, but the payload of GPDs
+ * the QMU has not fetched is still in the slot buffers.  Copy it out
+ * first so it can be replayed; bytes already inside the jammed FIFO
+ * cannot be read back and stay lost (bounded by the FIFO depth).
+ */
+static void
+ruby_tx_replay_snapshot(vm_offset_t mac)
+{
+    uint32_t i, off = 0;
+    (void)mac;
+
+    ruby_tx_replay_len = 0;
+    if (!ruby_dma_uc)
+        ruby_dc_civac(ruby_gpd_ring, RUBY_GPD_RING_SZ);
+    for (i = ruby_gpd_deq; i != ruby_gpd_enq; i = (i + 1u) % RUBY_GPD_NUM) {
+        uint32_t len = *(volatile uint16_t *)(RUBY_GPD_SLOT(i) + 12) &
+            0xfffu;
+        uint32_t n;
+
+        if (!len)
+            continue;
+        n = len;
+        if (n > (uint32_t)sizeof(ruby_tx_replay_buf) - off) {
+            ruby_tx_replay_drops +=
+                n - ((uint32_t)sizeof(ruby_tx_replay_buf) - off);
+            n = (uint32_t)sizeof(ruby_tx_replay_buf) - off;
+        }
+        if (!n)
+            break;
+        memcpy(ruby_tx_replay_buf + off, ruby_bulk_buf[i], n);
+        off += n;
+    }
+    ruby_tx_replay_len = off;
+}
