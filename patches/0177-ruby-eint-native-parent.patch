diff --git a/iokit/Kernel/arm/RubyEINTParent.cpp b/iokit/Kernel/arm/RubyEINTParent.cpp
new file mode 100644
index 0000000..341aa50
--- /dev/null
+++ b/iokit/Kernel/arm/RubyEINTParent.cpp
@@ -0,0 +1,222 @@
+#include <pexpert/arm64/board_config.h>
+#if defined(SWEET)
+/*
+ * SWEET: EINT SPI288 parent as a RubyGIC vector.
+ *
+ * The filter runs in primary interrupt context and only calls the bounded
+ * EINT demux.  It never wakes a thread: under B1 the touch owner polls the
+ * DEFERRED state and calls ruby_eint_service_done().  The event source
+ * action is a no-op; the filter always returns false.
+ */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOFilterInterruptEventSource.h>
+#include <IOKit/IOInterruptEventSource.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOWorkLoop.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSSymbol.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+
+#include "../../../bsd/dev/ruby_gic.h"
+#include "../../../bsd/dev/ruby_eint.h"
+
+#include "RubyEINTParent.h"
+
+#define super IOService
+OSDefineMetaClassAndStructors(RubyEINTParent, IOService);
+
+#define RUBY_EINT_PARENT_INTID 288u
+#define RUBY_EINT_FUSE_LIMIT   16u
+
+static RubyEINTParent *gRubyEINTParent;
+
+bool
+RubyEINTParent::init(OSDictionary *dictionary)
+{
+	fWorkLoop = NULL;
+	fIRQ = NULL;
+	fHits = 0;
+	fNoPending = 0;
+	fFused = 0;
+	fEnableCount = 0;
+	fDisableCount = 0;
+	return super::init(dictionary);
+}
+
+bool
+RubyEINTParent::publishInterruptSource(void)
+{
+	OSArray *controllers = NULL;
+	OSArray *specifiers = NULL;
+	OSSymbol *name = NULL;
+	OSData *data = NULL;
+	struct ruby_gic_spec spec = {
+		.intid = RUBY_EINT_PARENT_INTID,
+		.flags = RUBY_GIC_LEVEL,
+	};
+	bool ok = false;
+
+	controllers = OSArray::withCapacity(1);
+	specifiers = OSArray::withCapacity(1);
+	name = (OSSymbol *)OSSymbol::withCStringNoCopy("RubyGIC");
+	data = OSData::withBytes(&spec, sizeof(spec));
+	if (!controllers || !specifiers || !name || !data) {
+		goto out;
+	}
+	if (!controllers->setObject(name) || !specifiers->setObject(data)) {
+		goto out;
+	}
+	ok = setProperty("IOInterruptControllers", controllers) &&
+	    setProperty("IOInterruptSpecifiers", specifiers);
+out:
+	OSSafeRelease(controllers);
+	OSSafeRelease(specifiers);
+	OSSafeRelease(name);
+	OSSafeRelease(data);
+	return ok;
+}
+
+bool
+RubyEINTParent::start(IOService *provider)
+{
+	int eint = 0;
+	int irq = 0;
+	int b1 = 0;
+	int legacy = 0;
+
+	if (!super::start(provider)) {
+		return false;
+	}
+	PE_parse_boot_argn("rubyeint", &eint, sizeof(eint));
+	PE_parse_boot_argn("rubyeintirq", &irq, sizeof(irq));
+	PE_parse_boot_argn("rubyeintb1", &b1, sizeof(b1));
+	PE_parse_boot_argn("rubyeintlegacy", &legacy, sizeof(legacy));
+	if (eint != 1 || irq != 1 || b1 != 1 || legacy != 0) {
+		return false;
+	}
+	fWorkLoop = getWorkLoop();
+	if (!fWorkLoop) {
+		return false;
+	}
+	fWorkLoop->retain();
+	if (!publishInterruptSource()) {
+		return false;
+	}
+	fIRQ = IOFilterInterruptEventSource::filterInterruptEventSource(
+	    this, &RubyEINTParent::noopAction, &RubyEINTParent::filter,
+	    this, 0);
+	if (!fIRQ ||
+	    fWorkLoop->addEventSource(fIRQ) != kIOReturnSuccess) {
+		return false;
+	}
+	/* Keep 288 masked until ruby_irq_parent_start() enables it. */
+	fIRQ->disable();
+	gRubyEINTParent = this;
+	IOLog("RUBY EINT: native parent intid=%u ready\n",
+	    RUBY_EINT_PARENT_INTID);
+	return true;
+}
+
+void
+RubyEINTParent::free(void)
+{
+	if (gRubyEINTParent == this) {
+		gRubyEINTParent = NULL;
+	}
+	if (fIRQ) {
+		fIRQ->disable();
+		if (fWorkLoop) {
+			fWorkLoop->removeEventSource(fIRQ);
+		}
+		OSSafeRelease(fIRQ);
+		fIRQ = NULL;
+	}
+	if (fWorkLoop) {
+		fWorkLoop->release();
+		fWorkLoop = NULL;
+	}
+	super::free();
+}
+
+int
+RubyEINTParent::setEnabled(int on)
+{
+	if (!fIRQ) {
+		return ENODEV;
+	}
+	if (on) {
+		fIRQ->enable();
+		fEnableCount++;
+	} else {
+		fIRQ->disable();
+		fDisableCount++;
+	}
+	return 0;
+}
+
+bool
+RubyEINTParent::isFused(void) const
+{
+	return fFused != 0;
+}
+
+bool
+RubyEINTParent::filter(OSObject *owner,
+    IOFilterInterruptEventSource *sender)
+{
+	RubyEINTParent *self = (RubyEINTParent *)owner;
+	int handled;
+
+	handled = ruby_eint_demux_isr();
+	if (handled > 0) {
+		self->fHits++;
+		self->fNoPending = 0;
+		return false;
+	}
+	if (++self->fNoPending < RUBY_EINT_FUSE_LIMIT) {
+		return false;
+	}
+
+	/*
+	 * Parent asserted without an EINT line.  Mirror the legacy fuse:
+	 * mask the parent and leave every child polling.  B1 keeps this
+	 * path free of wakeup().
+	 */
+	self->fNoPending = 0;
+	self->fFused = 1;
+	sender->disable();
+	ruby_eint_all_poll_only();
+	return false;
+}
+
+void
+RubyEINTParent::noopAction(OSObject *owner,
+    IOInterruptEventSource *sender, int count)
+{
+	(void)owner;
+	(void)sender;
+	(void)count;
+}
+
+extern "C" int
+ruby_eint_native_ready(void)
+{
+	return gRubyEINTParent ? 1 : 0;
+}
+
+extern "C" int
+ruby_eint_native_enable(int on)
+{
+	return gRubyEINTParent ?
+	    gRubyEINTParent->setEnabled(on) : ENODEV;
+}
+
+extern "C" int
+ruby_eint_native_fused(void)
+{
+	return (gRubyEINTParent && gRubyEINTParent->isFused()) ? 1 : 0;
+}
+
+#endif /* SWEET */
