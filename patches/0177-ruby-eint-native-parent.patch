@@ -0,0 +1,41 @@
+#ifndef _IOKIT_RUBY_EINT_PARENT_H
+#define _IOKIT_RUBY_EINT_PARENT_H
+
+#include <IOKit/IOService.h>
+#include <mach/vm_types.h>
+#include <stdint.h>
+
+class OSDictionary;
+class IOWorkLoop;
+class IOFilterInterruptEventSource;
+class IOInterruptEventSource;
+
+class RubyEINTParent : public IOService
+{
+	OSDeclareDefaultStructors(RubyEINTParent);
+
+public:
+	bool init(OSDictionary *dictionary = NULL) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void free() APPLE_KEXT_OVERRIDE;
+
+	int setEnabled(int on);
+	bool isFused(void) const;
+
+private:
+	IOWorkLoop *fWorkLoop;
+	IOFilterInterruptEventSource *fIRQ;
+	uint32_t fHits;
+	uint32_t fNoPending;
+	uint32_t fFused;
+	uint32_t fEnableCount;
+	uint32_t fDisableCount;
+
+	bool publishInterruptSource(void);
+	static bool filter(OSObject *owner,
+	    IOFilterInterruptEventSource *sender);
+	static void noopAction(OSObject *owner,
+	    IOInterruptEventSource *sender, int count);
+};
+
+#endif /* _IOKIT_RUBY_EINT_PARENT_H */
