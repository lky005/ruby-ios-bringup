# 0093 WIP: EP0 poll 100 us + PID 0x0002.
# Two staged changes in one round: (1) EP0 window polls every 100 us so the
# host's tight post-SET_ADDRESS request is not missed; (2) PID 0x0002 reuses
# the existing WinUSB binding so a driver selects the configuration and
# Windows issues SET_CONFIGURATION.  Failure points remain separable in the
# trace (SET_ADDRESS vs SET_CONFIGURATION).

MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
PATCHSET_SHA256=910d8117cc72eab12f56acb5e8da73721f3e0a7c34443e274b4cec59ad219428
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

KERNEL_EXPECT_EXEC_DATA=
CI_RUN_ID=
CI_KERNEL_SHA256=
CI_KERNEL_EXEC_DATA_SHA256=
CI_IMAGE_SHA256=

BOOT_CMDLINE=config/0093-boot.cmdline
