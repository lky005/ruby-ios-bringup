# 0224 = 0223 + CDC-ACM multi-interface descriptors (gated rubyusbcmd=1).
#   Default remains vendor 0xFF single-interface (0223 shape).
#   rubyusbcmd=1: Iface0 Comm (0x02) + Iface1 Data (0x0A), wTotalLength=67.
#   Structured to validate multi-interface in ruby_function (0223).
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

