# 0214 = 0213 (0212 QISAR0 completion + 0213 A/B) + C alone:
#   C (vendor mtu3_prepare_tx_gpd step 4): at push, clear the NEXT
#   GPD slot's descriptor before publishing the current one. QMU
#   follows next_gpd pointers; at the enq=63 seam a stale HWO=1 on
#   slot 0 would corrupt the walk. Implemented as
#   ruby_gpd_clear((enq+1) % 64) before ruby_gpd_clear(enq).
# TQCPR cursor, TXQ_EMPTY fast path (0213A) and supply timing are
# untouched; next-slot clear is the only variable.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
BASELINE_MANIFEST_SHA256=829d759826607027bc4a1d9818b6dd4956a312a087217b6ce7e5ce31fa3ae910
BASELINE_FILES=82
BASELINE_UPSTREAM=ios-topaz@5095ac19dbdcf37b64b81fe443f4027ad51b84bf
APPLE_XNU_TAG=xnu-8796.141.3
PATCHSET_SHA256=850f0f145be6ee917710afba98bf5ccc1b3025eea53626373edcaa15db7dd9de
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

CI_RUNNER=macos-15
CI_XCODE=16.0
CI_SDK=15.0
CI_CLANG=16.0.0

BOOT_CMDLINE=config/0214-boot.cmdline
