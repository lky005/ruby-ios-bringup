# 0169 keys: KPD IRQ for volume-down; touch remains the 0168 SPI3 line.
# Default is prefer-HW (sweetgt=3) with hwfail=20; after 20 consecutive
# frame failures the driver releases all contacts and falls back to legacy
# bit-bang. Fast bit-bang remains opt-in with `gt bus bb`.  A known
# non-touch transition frame is ignored instead of counted as a failure.
# EINT IRQ is opt-in: `rubyeintirq=0` (polling) is the safe default because
# the IRQ/waitq path produced heap ticket-lock panics under heavy UI load.
#
# KERNEL_EXPECT_EXEC_DATA pins the booted kernel; the pin rerun is the
# gate for the same patchset.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
BASELINE_MANIFEST_SHA256=829d759826607027bc4a1d9818b6dd4956a312a087217b6ce7e5ce31fa3ae910
BASELINE_FILES=82
BASELINE_UPSTREAM=ios-topaz@5095ac19dbdcf37b64b81fe443f4027ad51b84bf
APPLE_XNU_TAG=xnu-8796.141.3
PATCHSET_SHA256=5c4f2b2635a79729fa9bcab5f6f1453c861bd8ad4ac48a21158afb68a2a9b632
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

KERNEL_EXPECT_EXEC_DATA=
CI_RUN_ID=
CI_KERNEL_SHA256=
CI_KERNEL_EXEC_DATA_SHA256=
CI_IMAGE_SHA256=
CI_RUNNER=macos-15
CI_XCODE=16.0
CI_SDK=15.0
CI_CLANG=16.0.0

BOOT_CMDLINE=config/0169-boot.cmdline
