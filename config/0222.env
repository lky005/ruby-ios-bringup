# 0222 = 0221 + lock-workloop decoupling.
#   0221 500-axis dropped (290/500) because ruby_ep_complete ran `freed`
#   callbacks while holding ep->q_lock; doorbell QMU_Q_RESUME was delayed.
#   Fix: dequeue the whole burst under one lock hold, run done callbacks
#   after the lock drops. No wire change; callbacks currently NULL.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

