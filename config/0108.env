# 0108 WIP: EP2 log frames one byte below wMaxPacketSize.
#
# 0107 closed EP0, but the EP2 log pipe still delivered the same packet
# several times and only advanced after several watchdog recoveries.  The
# QMU never reported TX done for a 64-byte GPD.
#
# The verified bare-metal P9 TX path only ever sent short packets (20-byte
# heartbeat, 15-byte echo).  A 64-byte frame is exactly wMaxPacketSize, so
# the endpoint transfer has no short packet to terminate on; the QMU then
# keeps the GPD current and the FIFO stays full.  This version sends 63-byte
# frames instead, which keeps every GPD a short packet.  EP0, the QMU ring,
# the endpoint configuration, the vendor status layout and the recovery path
# are unchanged from 0107.  The existing status already exposes QISAR0, the
# busy flag and the recovery counters, which is enough to tell a missing TX
# done apart from a wedged endpoint.

MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
PATCHSET_SHA256=fa9994ca4f78ce53b7582c35df9ef7b7b77d1260ff370b5d61a28bb0fcf102fb
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

KERNEL_EXPECT_EXEC_DATA=
CI_RUN_ID=
CI_KERNEL_SHA256=
CI_KERNEL_EXEC_DATA_SHA256=
CI_IMAGE_SHA256=

BOOT_CMDLINE=config/0108-boot.cmdline
