# 0246 = 0245 + CS engine off (experiment) + tqerr/tcsr in the ACM line.
#   Hypothesis: QCR0 checksum validation skips our echo GPDs (queue
#   advances, host sees nothing).  Explicitly clear CS16B/TX_CS_EN/RX_CS_EN
#   and print TQERRIR0/TX1CSR0 to prove or refute it.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

