# 0360 = 0352 + RubyGPU kernel driver (P3.1 through the M9b v12 line).
#
#   0360a iokit/Kernel/arm/RubyGPU.{cpp,h}, RubyGPUIRQ.{cpp,h},
#         RubyGPUInternal.h: device/power/MMU/BO/submit/context driver,
#         ARM INTID487 IRQ handling, SG-backed BO allocation (P0.2-SG),
#         BO accounting caps (rubygpubomax/rubygpuvmpages) and the gated
#         rubygpudiag dump path (default off).
#   0360b iokit/Kernel/arm/RubyGPUUserAPI.h, RubyGPUUserClient.{cpp,h}:
#         the userclient UAPI (Panfrost-style kmod surface subset).
#   0360c iokit/Kernel/arm/SweetSurface.{cpp,h}: per-task surface ownership
#         and sweet_surface_owned_by(), so only the creating task may import
#         a surface's memory into a GPU BO.
#   0360d iokit/conf/files.arm64: register the RubyGPU objects and drop the
#         SweetGPUProbe object (its capability moved into the driver).
#   0360e iokit/Kernel/IOUserClient.cpp: RubyGPU selector-8 diagnostics
#         (rubygpudiag=1, default off, console-ring capped).
#   0360f iokit/Kernel/arm/SweetFramebuffer.cpp: sweetfb defaults to 60 Hz and
#         calls the driver commit hook; sweet_gpu_commit_start is implemented
#         in 0360a.
#   0361a pexpert SWEET.h / board_config.h: CPU B4a AMP (E/P clusters,
#         MAX_CPU_CLUSTERS 2, __ARM_AMP__).
#   0361b osfmk/kern/sched_clutch.c: CPU B4a Edge default cluster placement.
#   0361c bsd/dev/sweet_sample.c: CPU B4a read-only clock probe (APMIXED /
#         MCUCFG), no clock or rail writes.
#
# patchset bd125daff6521b92069340186c4837090be4154e0a363de4d7a40b36ebec560e
# (327 files: the 318 of 0352 plus 0360a-f and 0361a-c).
#
# Record-only first run on the 0360 line: KERNEL_EXPECT_EXEC_DATA stays unset,
# the workflow records the hashes; pin them once the run is green, then the
# gated run must reproduce the exec-data value exactly.
BOOT_CMDLINE=config/0360-boot.cmdline
# n/a: the CI workflow ships the kernel artifact; boot images are packed
# and hashed by the local pipeline.
CI_IMAGE_SHA256=n/a