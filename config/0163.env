# 0163 WIP: enable the EINT parent SPI from the NS kernel.
# The KO on root Android proved GICD_CTLR.DS=0 makes the NS IGROUPR view
# RAZ/WI; ATF MTK_SIP_KERNEL_GIC_DUMP (0x201) reports INTID288 as
# Group1NS/enabled.  irq arm no longer touches IGROUPR; the preflight
# logs the SMC secure view (group0 still refuses) and the enable is
# accepted only when ISENABLER[9] bit0 reads back 1.
#
# KERNEL_EXPECT_EXEC_DATA pins the booted kernel; the pin rerun is the
# gate for the same patchset.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
BASELINE_MANIFEST_SHA256=829d759826607027bc4a1d9818b6dd4956a312a087217b6ce7e5ce31fa3ae910
BASELINE_FILES=82
BASELINE_UPSTREAM=ios-topaz@5095ac19dbdcf37b64b81fe443f4027ad51b84bf
APPLE_XNU_TAG=xnu-8796.141.3
PATCHSET_SHA256=688e81db7195858b187eaa28b0bc64b6cdec19c917db7b7dec4f59a49459982c
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

KERNEL_EXPECT_EXEC_DATA=
CI_RUN_ID=
CI_KERNEL_SHA256=
CI_KERNEL_EXEC_DATA_SHA256=
CI_IMAGE_SHA256=
CI_RUNNER=macos-15
CI_XCODE=16.0
CI_SDK=15.0
CI_CLANG=16.0.0

BOOT_CMDLINE=config/0163-boot.cmdline
