# 0100 WIP: P9-style EP2 stall clear + EP_RST recovery, busy timeout, error records.
# 0099 turned EP2 TX ZLP off; the 4-packet pipe halt persisted with no
# QMU error bits visible because push cleared QISAR1/TQERRIR0 silently.
# 0100 records those bits, runs the P9 recovery on real errors (W1C SENTSTALL
# + EP_RST pulse BIT(18)), adds a ~2 s busy watchdog, and makes
# CLEAR_FEATURE(EP2 halt) run the same recovery.  Vendor state grows to 12 words.

MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
PATCHSET_SHA256=40ce7b219b78105dffc904e22bf8be48e686ac8a6486b90cbe12635fc33468ce
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

KERNEL_EXPECT_EXEC_DATA=
CI_RUN_ID=
CI_KERNEL_SHA256=
CI_KERNEL_EXEC_DATA_SHA256=
CI_IMAGE_SHA256=

BOOT_CMDLINE=config/0100-boot.cmdline
