# 0292 = 0291 + CPU PIO TX switch (ruby_txpio):
#   ruby_txpio=1 keeps TX_DMAREQEN clear and never enqueues a GPD, but still
#   programs the QMU start address and issues Q_START (the MAC needs it to
#   serialize CPU-fed FIFO packets); the ACM echo path feeds the EP1 FIFO
#   port 0x310 (auto-increment, 4/2/1-byte stores) and rings TXPKTRDY per
#   512 B chunk.  Default 0 keeps the QMU path and behavior unchanged.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
BASELINE_MANIFEST_SHA256=829d759826607027bc4a1d9818b6dd4956a312a087217b6ce7e5ce31fa3ae910
BASELINE_FILES=82
BASELINE_UPSTREAM=ios-topaz@5095ac19dbdcf37b64b81fe443f4027ad51b84bf
APPLE_XNU_TAG=xnu-8796.141.3
PATCHSET_SHA256=4c8535ecf29c48b3c7f8c00a8e8ef49afe22c9df05576c524474011fa2c0844a
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

CI_RUNNER=macos-15
CI_XCODE=16.0
CI_SDK=15.0
CI_CLANG=16.0.0

BOOT_CMDLINE=config/0292-boot.cmdline
