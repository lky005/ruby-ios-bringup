# 0298 = 0297 plus the CLEAR_FEATURE(0x01) RX clear and the PIO Q_START
# moved onto the QMU workloop (single owner with push):
#   ruby_clr01=1        CLEAR_FEATURE(0x01): W1C RX stall + EP_RST(RX1)
#   ruby_dmareq_pio=1   keep TX_DMAREQEN=0 for the whole PIO path
#   ruby_qisar1_w=0     suppress every QISAR1 write (read-only status)
#   ruby_qisar0_isr=1   W1C QISAR0 TX-done in the interrupt pass
#   ruby_clr81=1/2/3    CLEAR_FEATURE(0x81): light / heavy / W1C-only
#   ruby_resume=1/2     vendor RESUME parity / no EP_RST on the restart
#   ruby_recover=0-7    suppress in-band / SENTSTALL / IRQ auto recover
#   ruby_txpiotail=1/2/3 PIO tail: RESUME / Q_START / deferred Q_START
#   ruby_qstart_ms=0-100 deferred Q_START delay (default 1 ms)
#   ruby_lpm_fc=1       0x0860=0 and PM_CTRL bit14/13 (vendor LPM FC parity)
#   ruby_devrst_pre=1   DEV_SW_RST before port enable (vendor hw_init order)
#   Default image keeps the 0297 behavior; the matrix is selected by cmdline.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
BASELINE_MANIFEST_SHA256=829d759826607027bc4a1d9818b6dd4956a312a087217b6ce7e5ce31fa3ae910
BASELINE_FILES=82
BASELINE_UPSTREAM=ios-topaz@5095ac19dbdcf37b64b81fe443f4027ad51b84bf
APPLE_XNU_TAG=xnu-8796.141.3
PATCHSET_SHA256=b1057eb203d457a34ce074ce986b6c92d37343d0957e823850813711858b32ee
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

CI_RUNNER=macos-15
CI_XCODE=16.0
CI_SDK=15.0
CI_CLANG=16.0.0

BOOT_CMDLINE=config/0298-boot.cmdline
