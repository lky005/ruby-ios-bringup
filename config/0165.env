# 0165 WIP: EINT chained demux, default-on real interrupts.
# ruby_eint now owns the full 128-line / 4-port register map and a child
# API (attach/activate/wait/service_done/force_poll).  The GIC SPI288
# parent is started lazily by the first activation (rubyeintirq=1 by
# default); every line stays gated until its child clears the device
# source, and a line-only fuse falls back to polling without disabling
# the parent.  Touch migrates to the child model; edge lines get exactly
# one ACK in the ISR, the waiter uses a seq + assert_wait loop, and the
# ISR flushes the APB gate before the parent EOI.
#
# KERNEL_EXPECT_EXEC_DATA pins the booted kernel; the pin rerun is the
# gate for the same patchset.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
