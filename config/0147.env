# 0147 WIP: EP0 command channel + cooperative runner.
# Patch 0147 builds on 0146a-qmu.  Adds 0x40/0x2E (one command line,
# wValue=seq), a seq/done marker, 0x2B protocol 2 + caps, and a single-slot
# command runner in the existing 1 ms EP0 thread.  The legacy EP2 OUT
# parser stays as the fallback channel.  The command parser, probe commands
# and descriptors are unchanged.
#
# The test cmdline is the 0146a one (rubyep2log=0, sweetgt=0, rubyprobe=1,
# no rubypmic).  The v1 build (41315416468) exposed a FIFO read bug: the
# 0x2E line was read byte-by-byte instead of 32-bit words.  CI 41316675413
# built the fix on macos-15/Xcode 16.0; the kernel and image hashes below
# are recorded; KERNEL_EXPECT_EXEC_DATA stays empty until the device run.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

