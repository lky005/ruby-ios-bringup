# 0106 WIP: shorter FIFO drain before the EP0 status stage.
#
# 0105 made the hub path enumerate (it had failed at the device descriptor
# before), but the direct USB4 path then failed at the address stage: the
# host still saw the xHCI Address Device command fail with CompletionCode 4
# while the descriptor itself was delivered.
#
# The difference between the two paths is timing: 0105 waited up to 50 ms
# for the TX FIFO to drain before writing the status stage.  A hub tolerates
# that latency, the controller on a direct link does not.  0106 shortens the
# wait to 2 ms and reports the time actually spent in the trace, so the next
# run measures the wait instead of guessing at it.
#
# EP0, EP2 and the bus-reset recovery are otherwise unchanged from 0105.

MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
PATCHSET_SHA256=665ed9eca142994472841fb9274f0551e1f1013fc4a41714a17288a53ece5079
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

KERNEL_EXPECT_EXEC_DATA=
CI_RUN_ID=
CI_KERNEL_SHA256=
CI_KERNEL_EXEC_DATA_SHA256=
CI_IMAGE_SHA256=

BOOT_CMDLINE=config/0106-boot.cmdline
