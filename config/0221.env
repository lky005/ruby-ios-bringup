# 0221 = 0220 + XFER 1:1 GPD binding.
#   One ruby_req owns each TX GPD slot (no SG, 1 req = 1 GPD invariant).
#   push_log queues rq under ep->q_lock after publishing HWO;
#   ruby_ep2_drain completes exactly `freed` reqs in the same order.
#   done callback is NULL for now (observability via q_depth only);
#   CL-0222 wires the callback into log consumers.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

