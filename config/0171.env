# 0171 USB: on a runtime VBUS detach -> attach, redo the full PHY
# detach/attach (D+ pull-up cycle + MAC session bits) instead of the light
# MAC rearm.  0170 baseline: 4-5 replugs after boot, zero re-enumeration.
# Everything else (touch polling, keys IRQ, battery 1 s) stays the 0170 line.
#
# KERNEL_EXPECT_EXEC_DATA pins the booted kernel; the pin rerun is the
# gate for the same patchset.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
