# 0257 = 0256 + fix the five RX QMU bit macros that used EP2 positions
#   on the EP1 endpoint (COZ/ZLP/LEN/CS/ZLP_ERR), and align QCR1/QCR3 to
#   the vendor-measured 0x0006000e / 0x00060000.  TX bits were already
#   correct; RX is a copy-paste offset bug.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

