# 0212 = 0211 + QISAR0 TX-done bit migration completion (single variable:
# QISAR0 W1C bit 2 -> RUBY_QMU_TX_DONE bit 1). 0211 moved IN bulk to EP1
# (0x81) and shifted per-EP QMU bits, but five call sites still used the old
# EP2 TX-done bit 1u<<2: ruby_ep2_clear_errors (L1836), ruby_ep2_drain noq0
# gate (L2334), ruby_ep2_push_log first-done gate+W1C (L2385-2386), report
# gate (L2399) and after-kick gate (L2621). The drain gate never fired on
# EP1 and QISAR0 bit1 was never W1C'd, so the bit accumulated after boot.
# Short bursts (30 reads) passed 100%; the long run crashed at ~40 reads.
# 0212 fixes all five to RUBY_QMU_TX_DONE (1u<<1) and adds the explicit W1C.
# TQCPR cursor math, ring_dist, hwo walk and supply timing are untouched.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
BASELINE_MANIFEST_SHA256=829d759826607027bc4a1d9818b6dd4956a312a087217b6ce7e5ce31fa3ae910
BASELINE_FILES=82
BASELINE_UPSTREAM=ios-topaz@5095ac19dbdcf37b64b81fe443f4027ad51b84bf
APPLE_XNU_TAG=xnu-8796.141.3
PATCHSET_SHA256=74f86501ca0a26b175449746b470a4cd1d69ddf18358dc8b755293050dc50aca
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

CI_RUNNER=macos-15
CI_XCODE=16.0
CI_SDK=15.0
CI_CLANG=16.0.0

BOOT_CMDLINE=config/0212-boot.cmdline
