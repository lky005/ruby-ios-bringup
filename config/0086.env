# 0086 compile milestone: ruby USB P0 (MTU3 USB2 device soft-connect).
# The probe is inert unless the cmdline carries rubyusb=1.
# No booted 0086 reference exists yet: CI records the kernel hashes without
# gating.  Fill KERNEL_EXPECT_EXEC_DATA only after a 0086 kernel boots.

MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
PATCHSET_SHA256=16b8ddea008c4941a628f746e096f345eb9c2861d3a679339bd37ade78ec6abd
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

# Empty until the first 0086 kernel boots and its exec-data hash is known.
KERNEL_EXPECT_EXEC_DATA=
CI_RUN_ID=
CI_KERNEL_SHA256=
CI_KERNEL_EXEC_DATA_SHA256=
CI_IMAGE_SHA256=

BOOT_CMDLINE=config/0086-boot.cmdline
