# 0155 WIP: P3 touch re-enable on 0154 (shared I2C5 arbiter).
# 0085 already carries the Goodix GT9916R path; this change moves its
# boot-time LDO sequence under the 0154 I2C5 IOLock, so ruby_probe,
# SweetBattery and touch share one arbiter.  Touch is enabled with
# sweetgt=1; rubybatt=1 and rubyprobe=1 stay on.
#
# Touch owns MT6360 LDO3/LDO2 EN+VOUT writes during boot (P3 boundary);
# battery remains read-only.  Probe i2c5 take still sets ruby_battery_taken,
# so touch/battery fail or retry instead of interleaving on the bus.
# CI and image hashes are recorded below; KERNEL_EXPECT_EXEC_DATA stays empty
# until the device gate (touch + battery external) passes.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
BASELINE_MANIFEST_SHA256=829d759826607027bc4a1d9818b6dd4956a312a087217b6ce7e5ce31fa3ae910
BASELINE_FILES=82
BASELINE_UPSTREAM=ios-topaz@5095ac19dbdcf37b64b81fe443f4027ad51b84bf
APPLE_XNU_TAG=xnu-8796.141.3
PATCHSET_SHA256=da13b6df7cb9498f4d7b96a69e88be2af9632157829d26514af7ea5f1de8bea0
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

KERNEL_EXPECT_EXEC_DATA=
CI_RUN_ID=
CI_KERNEL_SHA256=
CI_KERNEL_EXEC_DATA_SHA256=
CI_IMAGE_SHA256=
CI_RUNNER=macos-15
CI_XCODE=16.0
CI_SDK=15.0
CI_CLANG=16.0.0

BOOT_CMDLINE=config/0155-boot.cmdline
