# 0098 WIP: EP2 live state via vendor request 0xC0/0x21 + P9 kick order.
# 0097 serialized GPDs on TX done but still stalled after one ring cycle,
# so 0098 adds a 1 ms SENTSTALL poller, CLEAR_FEATURE(EP2 halt) recovery,
# and the P9 kick order (QCR0 checksum enable + QISAR0 done clear before
# every RESUME).  Vendor IN 0xC0/0x21 returns 8 words of live QMU state
# (seq/enq/busy/tries/QISAR0-1/TQERRIR0/TQCSR2/TX2CSR0) for the host.


MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
PATCHSET_SHA256=8a4aca603acd1632bb91a54530bbd03f6e1cf7dd8601897eca6c9c464f0d63a5
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

KERNEL_EXPECT_EXEC_DATA=
CI_RUN_ID=
CI_KERNEL_SHA256=
CI_KERNEL_EXEC_DATA_SHA256=
CI_IMAGE_SHA256=

BOOT_CMDLINE=config/0095-boot.cmdline
