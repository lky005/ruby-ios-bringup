# 0177 P2a: native EINT parent on RubyGIC vector 288 (docs/66).
# Native is the default when rubyeintirq=1 and rubyeintb1=1.  The filter
# runs the bounded EINT demux in primary and never calls wakeup(); touch
# keeps the B1 polling service.  rubyeintlegacy=1 opts back to the legacy
# CPU-slot parent for A/B.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

