# 0291 = 0290 + QMU CS-engine switches and default config EP_RST off:
#   ruby_cfgrst now defaults to 0 (first-packet alignment); ruby_qcr0cs and
#   ruby_qcr1zlp are independent boot-args.  All QCR0/QCR1 writes go through
#   one helper each so a later RX init cannot clear the TX per-EP enables;
#   QCR0P/QCR1P seq lines record the programmed and read-back values.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

