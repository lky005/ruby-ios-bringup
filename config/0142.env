# 0142 WIP: EP2 IN bulk MPS 64 -> 512 (USB branch).
# Two device-side values only: the EP2 IN endpoint descriptor (bytes 4/5
# become 0, 2 -- wMaxPacketSize is 16-bit little endian) and TX2CSR0
# MAXPKTSZ 64 -> 512.  The TX FIFO segment already covers 512 B
# (TX2CSR2 SEGSIZE 9 = ilog2(512) in vendor ep_fifo_alloc semantics);
# the QMU GPD ring, frame format (63-byte short packets) and the OUT
# endpoint (MPS 64) are untouched.  Log frames stay 63 bytes in this
# version: this isolates the endpoint-width variable before any frame
# resizing.  Full-speed fallback is unsupported by design: a 512-byte
# bulk MPS is high-speed only, the DEVICE_CONF speed field is
# hardware-detected, and the enumeration gate plus a 0x2C probe read of
# DEVICE_CONF (0x11201800, bits 0:2 == 3) verify HS after boot.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
# Baseline content pin: 82 files, private content-addressed mirror.
# The mirror repo/ref/key are Actions secrets; this root is the public pin.
BASELINE_MANIFEST_SHA256=829d759826607027bc4a1d9818b6dd4956a312a087217b6ce7e5ce31fa3ae910
BASELINE_FILES=82
BASELINE_UPSTREAM=ios-topaz@5095ac19dbdcf37b64b81fe443f4027ad51b84bf
APPLE_XNU_TAG=xnu-8796.141.3
PATCHSET_SHA256=d0c5ab5e0300c6b886c884d70f56171c7446f488d1373ddfd4a8090b017974f2
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

# No booted reference yet: the first CI run records the control hashes.
KERNEL_EXPECT_EXEC_DATA=
CI_RUN_ID=
CI_KERNEL_SHA256=
CI_KERNEL_EXEC_DATA_SHA256=
CI_IMAGE_SHA256=

BOOT_CMDLINE=config/0142-boot.cmdline
