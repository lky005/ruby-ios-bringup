# 0148 WIP: read-only pwrap dump + explicit minimal pwrap init.
# Patch 0148 builds on 0147.  Adds "pwrap dump" (wrapper, PMIC clock gates
# and topckgen state, no writes) and "pwrap init" under a new rubypwrap=1
# key.  The init follows the vendor pwrap sequence up to INIT_DONE2 but
# writes only the PMIC SPI/cipher bootstrap allowlist; rails, EINT/WDT and
# automatic init are out of scope.  Commands and descriptors are unchanged.
#
# The test cmdline is the 0146a one plus rubypwrap=1 (rubyep2log=0,
# sweetgt=0, rubyprobe=1, no rubypmic).  The v1 build (41323619559) passed
# the read-only dump but pwrap init failed at reset_spislv (manual sync
# timeout).  This fix adds the vendor PMIC clock gate + wrapper soft reset
# before reset_spislv; the topckgen CLK_CFG_5 writes stay out of scope.
# CI 41326148595 built the fix on macos-15/Xcode 16.0; the kernel and image
# hashes below are recorded.  KERNEL_EXPECT_EXEC_DATA stays empty until the
# device run confirms the kernel.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
