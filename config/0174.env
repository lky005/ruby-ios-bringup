# 0174 USB: after a runtime reattach, run a 15 s 100 us EP0 assist window
# (the boot-window cadence) so the host's descriptor/address sequence does
# not lose the DATAEND race at the post-window 1 ms service.  The 0172
# heartbeat now also prints setups/cfg/busreset/assist counters.
# Detection stays on MT6360 CHRDET_EXT; PHY reattach sequence unchanged.
#
# KERNEL_EXPECT_EXEC_DATA pins the booted kernel; the pin rerun is the
# gate for the same patchset.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
