CI_KERNEL_EXEC_DATA_SHA256=62a17d48eaabb60e1ece2379824e666499f312411ac0ef5275dc0edbc1f79d03
CI_IMAGE_SHA256=663520386bd3b6537ede1fb7fb89cb809ed1cc0e0b5fc95f4247fb09659d2924
