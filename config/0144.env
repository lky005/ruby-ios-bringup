CI_KERNEL_EXEC_DATA_SHA256=737abd128af415955a9690256198953f8d047ee8fe48bcf5d314d4a4d7a18e02
CI_IMAGE_SHA256=ac7b6035b4acd8f86c044361266b1f124cf1cc3498364a466d9139071c753aab
