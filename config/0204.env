# 0204 TX GPD ring uncached alias: map the 1 KB ring through ml_io_map
# (VM_WIMG_IO) behind the rubydmauc boot arg; the cached BSS alias is
# cleaned once and never touched again.  Log payload buffers stay cached
# (dc civac) in this round.  Single variable: the CPU cache attribute of
# the TX descriptor ring.  No QMU/IRQ/PHY/RX/watchdog change.
# cmdline: 0200 minus rubyreboot=1 (control path, unused by the physical
# fastboot flow) plus rubydmauc=1; 601 B, still <= 607.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
BASELINE_MANIFEST_SHA256=829d759826607027bc4a1d9818b6dd4956a312a087217b6ce7e5ce31fa3ae910
BASELINE_FILES=82
BASELINE_UPSTREAM=ios-topaz@5095ac19dbdcf37b64b81fe443f4027ad51b84bf
APPLE_XNU_TAG=xnu-8796.141.3
PATCHSET_SHA256=1f6c891779c7eb55d4274725c0f350a0b81062a82b8b587bc29dda0c97144345
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

KERNEL_EXPECT_EXEC_DATA=
CI_RUN_ID=
CI_KERNEL_SHA256=
CI_KERNEL_EXEC_DATA_SHA256=
CI_IMAGE_SHA256=

# Booted reference: pending the first 0204 build.
CI_RUNNER=macos-15
CI_XCODE=16.0
CI_SDK=15.0
CI_CLANG=16.0.0

BOOT_CMDLINE=config/0204-boot.cmdline
