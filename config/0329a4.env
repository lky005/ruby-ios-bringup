# 0329a4 = 0329a3 + RX QMU engine relocation (arm/config/reset/
# recover/halt/resume/drain/poll) into ruby_usb_qmu.c/h.  The push/log
# producer stays in ruby_usb.c behind an exported boundary.
#
# First a4 build panicked after RXCFG_IN: clang turned rx_arm's 16-byte
# clear into an unaligned 8-byte vector store (stur d0,[x11,#1]) and
# XNU's alignment checking aborted.  The shipped a4b uses a volatile
# byte-store guard; objdump verified no unaligned vector stores.
#
# local build (a4b): kernel full ec0bf5ad..., exec f8fafb32...
# image: x16-0329a4b-rxqmu.img 26a166e7... (128 MiB, cmdline 558 B)
# negative: pre-fix a4 exec 8100d793... / image 484b5628... (panics)
KERNEL_EXPECT_EXEC_DATA=f8fafb327ca282e2ca9dcc82bef8344443125123ce8b83c800645faf6f840f5b