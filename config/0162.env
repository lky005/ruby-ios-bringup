# 0162 WIP: GIC group write/readback + MT6360 ACK/mask adjudication.
# irq arm now writes IGROUPR[9] bit0, waits RWP and reads it back; 1
# continues, 0 means the secure world ignored the NS write.  mt6360 ack
# (rubymt6360=1) writes 0xF8=0xFF and 0xD8=0x9E, then reads back the
# status/mask and GPIO4.  Polling remains the fallback.
#
# KERNEL_EXPECT_EXEC_DATA pins the booted kernel; the pin rerun is the
# gate for the same patchset.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

