# 0102 WIP: EP2 TX slot 0 (one 512B FIFO segment) + CAP read + 0.5s watchdog.
# EP2 live state: QMU sometimes misses TX done; the 2.4s busy watchdog recovered,
# but reads timed out and FIFO-full boundaries duplicated/dropped packets.  Vendor
# allocates (slot+1) 512B FIFO segments; we used slot 2 with only one.  0102 uses
# slot 0, shortens the busy watchdog to ~0.5s, and exposes CAP_EP0/TX/RXFFSZ +
# CAP_EPINFO in the 16-word vendor state.  EP0 fix from 0101 unchanged.

MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
PATCHSET_SHA256=256552feefdd8417fc1a06d12e9b33fa19f6ced09baf0a4b8f2d69ceca2f6101
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

KERNEL_EXPECT_EXEC_DATA=
CI_RUN_ID=
CI_KERNEL_SHA256=
CI_KERNEL_EXEC_DATA_SHA256=
CI_IMAGE_SHA256=

BOOT_CMDLINE=config/0102-boot.cmdline
