# 0154 WIP: P2.2 MT6360 battery v1 (read-only).
# Builds on 0152b.  Adds bsd/dev/ruby_battery.c: I2C5 bit-bang reads of VBAT
# (0x52), CHG_STAT (0x4a), FOD_STAT (0xe7) and USB_STATUS1 (0x27), plus a
# SweetBattery backend behind rubybatt=1.  The existing IOPMPowerSource
# publish/estimatePercent logic is reused; temperature stays estimated, current
# is 0/invalid, and no PMIC/charger/rail/GPIO configuration is written.
#
# I2C5 is shared with ruby_probe through an IOLock (a sleeping mutex, not a
# spinlock).  The probe's manual i2c5 take sets ruby_battery_taken(1), so a
# battery poll during that hold fails and SweetBattery keeps its last valid
# sample.  A failed I2C read never publishes 0 V or AtCriticalLevel.
# sweetbattery=1 (PM6150 SPMI) is intercepted on MT6877; only rubybatt=1 uses
# the MT6360 path.  Test cmdline is 0152b plus rubybatt=1 (no sweetbattery).
# CI and image hashes are recorded after the run; KERNEL_EXPECT_EXEC_DATA
# stays empty until the device run.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
BASELINE_MANIFEST_SHA256=829d759826607027bc4a1d9818b6dd4956a312a087217b6ce7e5ce31fa3ae910
BASELINE_FILES=82
BASELINE_UPSTREAM=ios-topaz@5095ac19dbdcf37b64b81fe443f4027ad51b84bf
APPLE_XNU_TAG=xnu-8796.141.3
PATCHSET_SHA256=bf13fb369745edfc6767eee3dfc5076e90c78de5b7d6daa0b7eae512fd64a8fe
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

KERNEL_EXPECT_EXEC_DATA=
