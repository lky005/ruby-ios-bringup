# 0213 = 0212 (Plan B, two legs in one build):
#   B (secondary): delete the QISAR1 write-back (ruby_ep2_push_log tail
#      wrote ruby_wr32(QISAR1, txq1)); vendor U3D_QISAR1 is read-update,
#      reading clears. TQERRIR0 read-then-write stays (vendor).
#   A (primary): TXQ_EMPTY fast path (ruby_ep2_push_log): when the entry
#      q1 snapshot has QISAR1_TXQ_EMPTY and inflight>0 && freed==0 &&
#      host_seen, drain immediately instead of waiting for the ~2s
#      RUBY_EP2_STUCK_TICKS fuse. No new register read.
# C (next-slot HWO clear) is planned for 0214 separately; TQCPR cursor,
# ring_dist, hwo walk and supply timing are untouched.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
BASELINE_MANIFEST_SHA256=829d759826607027bc4a1d9818b6dd4956a312a087217b6ce7e5ce31fa3ae910
BASELINE_FILES=82
BASELINE_UPSTREAM=ios-topaz@5095ac19dbdcf37b64b81fe443f4027ad51b84bf
APPLE_XNU_TAG=xnu-8796.141.3
PATCHSET_SHA256=4bf2f7cc0808ffa9f4db5dce45e79a355ec09326ca437051bc5e5fee108a3371
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

CI_RUNNER=macos-15
CI_XCODE=16.0
CI_SDK=15.0
CI_CLANG=16.0.0

BOOT_CMDLINE=config/0213-boot.cmdline
