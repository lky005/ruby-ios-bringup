# 0211 = 0207 with the EP2 IN log endpoint moved to EP1 (single variable:
# endpoint index).  bcdDevice 0x0100 -> 0x0211 so Windows rebuilds its
# descriptor/pipe cache.  TX bank renamed TX2->TX1 (0x0110/14/18, TQCSR1
# 0x0510, TQSAR1 0x0514, TQCPR1 0x0518, TQHIAR1 0x0484, EP_RST bit 17);
# per-EP QMU bits shift (QCR1 ZLP 2->1, TQERRIESR0 18/2 -> 17/1,
# RUBY_QMU_TX_DONE 2->1).  RX/command channel stays on EP2 OUT.  txdone
# needed no device change (0x22 "EP2D" v[3]; the "stuck at 0" reading was
# a host-side field mislabel of 0x21 v[3] = QISAR0).
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

