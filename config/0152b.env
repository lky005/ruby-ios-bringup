# 0152b WIP: PSCI warm-reset fastboot reboot.
# Builds on 0152.  Keeps the TOPRGU NONRST2 (0x10007000 + 0x24) low-four-bit
# boot mode = 3 (BOOT_BOOTLOADER), but replaces the WDT SWRST cold reset with
# PSCI SYSTEM_RESET (0x84000009) through the SMC conduit (the vendor DTS
# psci method="smc").  The warm reset is expected to preserve the RGU scratch
# so the bootloader sees the mode.  The LK WDT sequence (RESTART 0x1971,
# MODE 0x22000014, SWRST 0x1209) stays only as a fallback if PSCI returns.
#
# The command writes only TOPRGU and issues one SMC; no UFS/misc/PMIC/rail/KPD
# writes.  The host sends it with --no-wait and polls fastboot devices; the
# SoC resets, so there is no command done marker.  Test cmdline is 0152 plus
# the same rubyreboot=1 (sweethw=0, sweetgt=0, rubyprobe=1, rubypwrap=1,
# rubkeys=1, no rubypmic).  CI and image hashes are recorded after the run;
# KERNEL_EXPECT_EXEC_DATA stays empty until the device run.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
BASELINE_MANIFEST_SHA256=829d759826607027bc4a1d9818b6dd4956a312a087217b6ce7e5ce31fa3ae910
BASELINE_FILES=82
BASELINE_UPSTREAM=ios-topaz@5095ac19dbdcf37b64b81fe443f4027ad51b84bf
APPLE_XNU_TAG=xnu-8796.141.3
PATCHSET_SHA256=7c6ab01ad9dc31e76e7d2908d2dcc920663528a934994af599e9a3b2fd9942bc
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

KERNEL_EXPECT_EXEC_DATA=
