# 0253 = 0252 + TX FIFO maintenance.  Vendor idle tcsr has FIFOEMPTY
#   (bit24); ours stayed non-empty after aborts and the QMU then drops
#   GPDs silently.  Flush+wait FIFOEMPTY before START in tx_force, and
#   let the watchdog drain when inf=0 but the FIFO is not empty.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

