# 0092 WIP: vendor-specific interface with EP2 OUT/IN bulk.
# Single-variable change on top of 0091: the config descriptor grows from
# 18 B / 0 endpoints to 32 B / class 0xFF / 2 bulk endpoints so Windows
# should issue SET_CONFIGURATION. Endpoint re-configuration and data are
# intentionally not added yet.
# Kernel-only milestone: CI records hashes without gating.

MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
PATCHSET_SHA256=a19713509658a1f0923b6dd4e18e71d795bf82ef211d423fd2bdbdec6a7b0cae
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

KERNEL_EXPECT_EXEC_DATA=
CI_RUN_ID=
CI_KERNEL_SHA256=
CI_KERNEL_EXEC_DATA_SHA256=
CI_IMAGE_SHA256=

BOOT_CMDLINE=config/0092-boot.cmdline
