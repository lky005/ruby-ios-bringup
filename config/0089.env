# 0089 WIP: ruby USB EP0 data-stage timing fix on top of 0088.
# Single-variable change: ruby_ep0_send waits ~100 us and for
# EP0_FIFOFULL to clear before DATAEND, matching the P9-proven path.
# Kernel-only milestone: CI records hashes without gating.

MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
