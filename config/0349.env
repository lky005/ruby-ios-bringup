# 0349 = 0334 + the 0335-0340 feature patches + 0348/0349 boot-arg work.
#
# The 0335-0340 group exists because the 0348/0349 patches were written
# against a VM working tree that carried ECM, rubysh/cache and AMFI changes
# which had never been turned into patches. Without them `git apply` rejects
# 0348/0349, dxb's build.sh swallows the failure as a warning, and CI builds
# the 0334 line while reporting the 0349 patchset hash. The 0349 workflow now
# fails the job if any project patch is skipped.
#
#   0335 sweet_amfi.c AMFI policy probe
#   0336 ruby_tty.c + launchd_cache_blob.h (rubysh timeout, cache delivery)
#   0337 USB-ECM port: ruby_ecm.c/h, RubyECMEthernet.cpp, qmu frame mode,
#        IONetworkingFamily staging, conf registration
#   0338 ECM TX stall diagnostics/resume
#   0339 txsalv/txsoften (salvage + soft bell)
#   0340 PE_parse_boot_argn fix for txsalv/txsoften
#   0348 retires 21 dead boot-arg parses
#   0349 bakes the 15 steady-state knobs; cmdline 596 -> 397 B
#
# Verified on the device (boot_a, 2026-11-21): banner values all sourced
# from the compiled-in defaults, 64 MB wget 14.1 MB/s + scp push 14.3 MB/s,
# TXRESET 0 for the whole session, no panic. Not covered: EP2-5 host-side
# end-to-end, concurrency, suspend (0334 boundaries unchanged); scp pull
# stays avoided (FIFOFULL half-fetch window, large files go through HTTP).
#
# patchset b277f6585c65e053e6d552fbad54f0e2b3af1d90dd174000a6c96a13c7b65bd3
# (314 files: 82-file baseline with the 0010/0012 rewrites, 229 project
# patches through 0349 (228 .patch + 0497-stage-ionet.sh), 3 historical; canonical composition of
# ci/prepare-baseline.sh -- reproduces d87e666f... for the 0334 line exactly.)
KERNEL_EXPECT_EXEC_DATA=1fa119b0c2313d1be9595bb9f4b30a9147d8c7ada4fa70b37a32917fffc3571f
CI_KERNEL_SHA256=2eb84a6d02c8e830250b52949a72eebc54a12ae007bae9f283b15a189ddffbc9
CI_KERNEL_EXEC_DATA_SHA256=1fa119b0c2313d1be9595bb9f4b30a9147d8c7ada4fa70b37a32917fffc3571f
# n/a: the CI workflow ships the kernel artifact; boot images are packed
# and hashed by the local pipeline.
CI_IMAGE_SHA256=n/a
BOOT_CMDLINE=config/0349-boot.cmdline
