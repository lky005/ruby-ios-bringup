# 0146a-obs WIP: silence the EP2 IN log QMU for probe sessions.
# Patch 0146a adds rubyep2log=0: SET_CONFIGURATION skips ruby_ep2_config(),
# so the EP2 IN log ring is never started.  The EP0 0x2A console read and
# the EP2 OUT command parser are unchanged; the descriptor and device
# identity stay the same.  The stuck watchdog now only diagnoses a QMU
# when the host issued an IN in the last 5 s and prints at most once a
# minute; 0x2B v[5] reports the mode word (bit0 EP2 log, bit1 probe
# writes, bit2 EP2 TX QMU, bit3 EP2 RX QMU).
#
# CI 41307733796 built this patchset on macos-15/Xcode 16.0.  The kernel and
# image hashes below are recorded; KERNEL_EXPECT_EXEC_DATA stays empty until
# the device run confirms this kernel.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
