# 0202 SOF frame-number watchdog: a host port disable/enable cycle issues
# no catchable bus reset (bus_resets stays frozen) and the MAC2 suspend
# interrupt never fires, so the device is left detached until a physical
# replug.  When configured and the USB2 frame number stops advancing
# (SOF only reaches enabled ports), trigger a full PHY re-attach.
# Frames stay 0198 padded (rubypad=1); cmdline unchanged from 0200.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
BASELINE_MANIFEST_SHA256=829d759826607027bc4a1d9818b6dd4956a312a087217b6ce7e5ce31fa3ae910
BASELINE_FILES=82
BASELINE_UPSTREAM=ios-topaz@5095ac19dbdcf37b64b81fe443f4027ad51b84bf
APPLE_XNU_TAG=xnu-8796.141.3
PATCHSET_SHA256=7290d50f3d3d0d2f9a12b51cccd42fb58aa88630c91d32bae3948d171ba13a33
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

KERNEL_EXPECT_EXEC_DATA=
CI_RUN_ID=
CI_KERNEL_SHA256=
CI_KERNEL_EXEC_DATA_SHA256=
CI_IMAGE_SHA256=

# Booted reference: pending the first 0202 build.
CI_RUNNER=macos-15
CI_XCODE=16.0
CI_SDK=15.0
CI_CLANG=16.0.0

BOOT_CMDLINE=config/0200-boot.cmdline
