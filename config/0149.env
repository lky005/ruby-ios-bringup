# 0149 WIP: read-only key watcher for P2.1a.
# Patch 0149 builds on 0148 v3.  Adds "key watch [ms]" to ruby_probe.c:
# it samples the AP GPIO DI banks, the KPD status/memory words, the MT6359
# PSC event registers and PWRKEY 0xa16 at about 10 ms and prints only
# transitions.  It never writes any register; touch stays off (sweetgt=0)
# and rubypmic stays 0.
#
# The test cmdline is the 0148 one (rubyep2log=0, sweetgt=0, rubyprobe=1,
# rubypwrap=1, no rubypmic).  CI 41333710308 built the patchset on
# macos-15/Xcode 16.0; the kernel and image hashes below are recorded.
# KERNEL_EXPECT_EXEC_DATA stays empty until the key source is identified and
# the device run records this kernel.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
BASELINE_MANIFEST_SHA256=829d759826607027bc4a1d9818b6dd4956a312a087217b6ce7e5ce31fa3ae910
BASELINE_FILES=82
BASELINE_UPSTREAM=ios-topaz@5095ac19dbdcf37b64b81fe443f4027ad51b84bf
APPLE_XNU_TAG=xnu-8796.141.3
PATCHSET_SHA256=6bc5962dad17cb82b56e2f59b58f0b4be5950a705bf5180f960088ce239b05bc
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

KERNEL_EXPECT_EXEC_DATA=
CI_RUN_ID=41333710308
