# 0101 WIP: never write EP0 DATAEND while FIFOFULL; STALL on TX/FIFO timeout.
# SWEETLOG trace of 0100: enumeration reached string 0 (4 B), the data stage
# timed out with FIFOFULL set, and ruby_ep0_send still wrote DATAEND, wedging
# EP0 permanently (0x00a80440).  0101 STALLs instead of DATAEND when the host
# does not take the packet (10 ms) or FIFOFULL never clears (300 ms), so a
# failed attempt can be retried after a port reset.  EP2 side unchanged from 0100.

MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
PATCHSET_SHA256=670577f6142365a1e23eb4db6b60140e334391808121a2dbb3b2c07f29147c36
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

KERNEL_EXPECT_EXEC_DATA=
CI_RUN_ID=
CI_KERNEL_SHA256=
CI_KERNEL_EXEC_DATA_SHA256=
CI_IMAGE_SHA256=

BOOT_CMDLINE=config/0101-boot.cmdline
