# 0235 = 0234 + QCR0 checksum engine setup (vendor reference).  OnePlus
#   mtu3_core sets QMU_CS16B_EN (bit0) and qmu_start sets TX/RX_CS_EN(1)
#   (bits 1/17); ruby kept QCR0 at boot default.  With a boot-enabled CS
#   engine but no 16-byte mode, GPDs can be checksum-skipped: TX advances
#   with no wire data, RX stops after a few packets.  Also adds rxerr/zlp
#   to the ACM diag line.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
BASELINE_MANIFEST_SHA256=829d759826607027bc4a1d9818b6dd4956a312a087217b6ce7e5ce31fa3ae910
BASELINE_FILES=82
BASELINE_UPSTREAM=ios-topaz@5095ac19dbdcf37b64b81fe443f4027ad51b84bf
APPLE_XNU_TAG=xnu-8796.141.3
PATCHSET_SHA256=82068e7c79a253dd74d09a8363c2ece76bc0a6ca94125b231bc666cfca10a8cd
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

CI_RUNNER=macos-15
CI_XCODE=16.0
CI_SDK=15.0
CI_CLANG=16.0.0

BOOT_CMDLINE=config/0235-boot.cmdline
