# 0146a-qmu WIP: QMU rearm wait and RX empty/error recovery.
# Patch 0146a-qmu builds on 0146a-obs.  ruby_usb_rearm() now stops the
# TX/RX QMUs with a bounded ACTIVE wait before it rewrites a ring; a stop
# timeout leaves the ring alone for the next rearm/config.  RX empty/CS/LEN
# events recover with stop/reset/start instead of marking the live GPD BPS.
# The command parser, EP0 0x2A/0x2D, descriptors and probe commands are
# unchanged.  The test cmdline is the 0146a one (rubyep2log=0, sweetgt=0,
# rubyprobe=1, no rubypmic).
#
# CI 41312190765 built this patchset on macos-15/Xcode 16.0.  The kernel
# and image hashes below are recorded; KERNEL_EXPECT_EXEC_DATA stays empty
# until the device run confirms this kernel.
MACOS_VERSION=13.5
