# 0097 WIP: EP2 strict serialization (TX done) over the 0096 ring guard.
# One GPD in flight at a time: the shared 64 B log buffer is reused only
# after QISAR0 TX done; HWO is a safety net only.  Frames are 16B status
# header + 48B log, pushed from the EP0 thread every ~100 ms.  QISAR1
# EMPTY is acked as status, not treated as an error; TX SENTSTALL is
# cleared when seen.  MT6877 GPD checksum and Q_RESUME as in P9be.


MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
PATCHSET_SHA256=4043d2f6ffd285e397a1483104a297d7e739e0b8fb0acf50b8167462a05ecf37
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

KERNEL_EXPECT_EXEC_DATA=
CI_RUN_ID=
CI_KERNEL_SHA256=
CI_KERNEL_EXEC_DATA_SHA256=
CI_IMAGE_SHA256=

BOOT_CMDLINE=config/0095-boot.cmdline
