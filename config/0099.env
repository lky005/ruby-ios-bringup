# 0099 WIP: EP2 TX ZLP off (64-byte frames are exactly wMaxPacketSize).
# 0097 serialized GPDs on TX done; 0098 added the live 0xC0/0x21 QMU state,
# a 1 ms SENTSTALL poller, CLEAR_FEATURE(EP2 halt) recovery and the P9 kick
# order.  0099 changes one variable: clear QCR1 TX_ZLP for EP2, because the
# QMU appends a ZLP after every exactly-64-byte packet and the host pipe
# stalls after a few frames.  Everything else is unchanged.

MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
PATCHSET_SHA256=24e058439a7deed79cb7ed69ed9235c6165fc59641752317c281dddafb80ebc3
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

KERNEL_EXPECT_EXEC_DATA=
CI_RUN_ID=
CI_KERNEL_SHA256=
CI_KERNEL_EXEC_DATA_SHA256=
CI_IMAGE_SHA256=

BOOT_CMDLINE=config/0099-boot.cmdline
