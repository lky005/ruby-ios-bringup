# 0352 = 0351 + rubysh blob alignment + read-only GPU probe.
#
#   0352a bsd/dev/rubysh_blob.h: replace the embedded CL-0324 rubysh
#        (70192 bytes) with the CL-0337 build (70512 bytes, exec timeout).
#        The public 0351 kernel therefore differed from the device kernel;
#        this is the alignment patch.
#   0352b iokit/Kernel/arm/SweetGPUProbe.cpp: one-shot read-only dump of the
#        Mali window at 0x13000000 (GPU_ID/AS/JS_PRESENT, READY bits), the
#        mfgcfg window at 0x13fbf000 (CG/ASYNC/QCHANNEL/DEBUG/I2M), the SPM
#        status window, TOP/infra bus-protect, MFG PLL and the MT6359P
#        VPROC2/VSRAM_MD registers over the pwrap read channel. Gated by
#        rubygpuprobe=1, default off, no power/clock writes, runs once.
#
# patchset 40f7cefafc3a67fabaab1c9814adef5b76f64acec8017466fa3ac21086e62de6
# (318 files: 82-file baseline with the 0010/0012 rewrites, 233 project
# patches through 0352b, 3 historical; canonical composition of
# ci/prepare-baseline.sh; tip e46b470, P2a + gated MFG2-5 power path)
#
# Record-only first run on the tip: KERNEL_EXPECT_EXEC_DATA stays unset, the
# workflow records the hashes; pin them once the run is green, then the gated
# run must reproduce the exec-data value exactly.
BOOT_CMDLINE=config/0352-boot.cmdline
# n/a: the CI workflow ships the kernel artifact; boot images are packed
# and hashed by the local pipeline.
CI_IMAGE_SHA256=n/a
