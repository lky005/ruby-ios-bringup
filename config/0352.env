# 0352 = 0351 + rubysh blob alignment + read-only GPU probe.
#
#   0352a bsd/dev/rubysh_blob.h: replace the embedded CL-0324 rubysh
#        (70192 bytes) with the CL-0337 build (70512 bytes, exec timeout).
#        The public 0351 kernel therefore differed from the device kernel;
#        this is the alignment patch.
#   0352b iokit/Kernel/arm/SweetGPUProbe.cpp: one-shot read-only dump of the
#        Mali window at 0x13000000 (GPU_ID/L2/TILER/MEM/SHADER_PRESENT and
#        a few status registers). Gated by rubygpuprobe=1, default off,
#        no writes, runs once. With no boot-args the kernel behaves like
#        0351 in the GPU path.
#
# patchset 69555c80b06bc1d8d3a0c1f90162cc041605ef59f15124152617d7c7c9b8bbdb
# (318 files: 82-file baseline with the 0010/0012 rewrites, 233 project
# patches through 0352b, 3 historical; canonical composition of
# ci/prepare-baseline.sh)
#
# Kernel hashes pinned from run 45125158259 (the record-only first run on
# this line); the gated run must reproduce the exec-data value exactly.
KERNEL_EXPECT_EXEC_DATA=8a2555f39c10b2d2481a79c6e8482d1510f859e4a88f4995900773227226e055
CI_KERNEL_SHA256=0377b5c949e9f482c6980029a598b5a98ba54faae41dd3fbc07a17bb6eca043b
CI_KERNEL_EXEC_DATA_SHA256=8a2555f39c10b2d2481a79c6e8482d1510f859e4a88f4995900773227226e055
BOOT_CMDLINE=config/0352-boot.cmdline
# n/a: the CI workflow ships the kernel artifact; boot images are packed
# and hashed by the local pipeline.
CI_IMAGE_SHA256=n/a