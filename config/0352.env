# 0352 = 0351 + rubysh blob alignment + read-only GPU probe.
#
#   0352a bsd/dev/rubysh_blob.h: replace the embedded CL-0324 rubysh
#        (70192 bytes) with the CL-0337 build (70512 bytes, exec timeout).
#        The public 0351 kernel therefore differed from the device kernel;
#        this is the alignment patch.
#   0352b iokit/Kernel/arm/SweetGPUProbe.cpp: one-shot read-only dump of the
#        Mali window at 0x13000000 (GPU_ID/L2/TILER/MEM/AS/JS_PRESENT,
#        SHADER/TILER/L2_READY) and the mfgcfg window at 0x13fbf000
#        (QCHANNEL/DEBUG_SEL/DEBUG_TOP/I2M_PROT/CG enables). Gated by
#        rubygpuprobe=1, default off, no writes, runs once. With no
#        boot-args the kernel behaves like 0351 in the GPU path.
#
# patchset d5778251788f55c80b457a04755c04adfa89ca79dc1a861f0468ca87a058ddeb
# (318 files: 82-file baseline with the 0010/0012 rewrites, 233 project
# patches through 0352b, 3 historical; canonical composition of
# ci/prepare-baseline.sh; P1.5 probe revision)
#
# Kernel hashes pinned from record run 45141057223 (P1.5 revision);
# the gated run must reproduce the exec-data value exactly.
BOOT_CMDLINE=config/0352-boot.cmdline
# n/a: the CI workflow ships the kernel artifact; boot images are packed
# and hashed by the local pipeline.
CI_IMAGE_SHA256=n/a
KERNEL_EXPECT_EXEC_DATA=af98f3cf1dd5c3799bb0e9c5c573314248bf183732f44699ab459111d7758218
CI_KERNEL_SHA256=34795a029e5bf3e153eb92966b233a76155d60ceb8bb5d9fe84c9d41010ea46b
CI_KERNEL_EXEC_DATA_SHA256=af98f3cf1dd5c3799bb0e9c5c573314248bf183732f44699ab459111d7758218
