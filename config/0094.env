# 0094 WIP: EP0 persistent thread + early window exit.
# After SET_CONFIGURATION (type=10) the window keeps polling for 200 ms to
# absorb trailing requests, then leaves; a kernel thread polls EP0 every
# 1 ms forever so post-boot control requests are still serviced.
# No endpoint data path yet.

MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
PATCHSET_SHA256=3392f699b1c1ca4b20981f7682a35a404333cd6282b440b56324cd964cb19867
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

KERNEL_EXPECT_EXEC_DATA=
CI_RUN_ID=
CI_KERNEL_SHA256=
CI_KERNEL_EXEC_DATA_SHA256=
CI_IMAGE_SHA256=

BOOT_CMDLINE=config/0094-boot.cmdline
