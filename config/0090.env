# 0090 WIP: ruby USB DEVICE_CONF HS speed fix on top of 0089.
# Single-variable change: write DEVICE_CONF speed=3 (HS) instead of 0 at
# probe init, so SET_ADDRESS keeps the HW-detected speed.
# Kernel-only milestone: CI records hashes without gating.

MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
PATCHSET_SHA256=9b35086d49373bef65c230b9dbcf84eb18773d03ca51b7c7b8f32a30a508fccf
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

KERNEL_EXPECT_EXEC_DATA=
CI_RUN_ID=
CI_KERNEL_SHA256=
CI_KERNEL_EXEC_DATA_SHA256=
CI_IMAGE_SHA256=

BOOT_CMDLINE=config/0090-boot.cmdline
