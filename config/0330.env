# 0330 = 0329a6 + configuration/boundary layer.
# New ruby_usb_config.c/h validates the queue boot arguments (rejects
# illegal values instead of silently clamping), keeps an EP0-first
# 512 B FIFO bitmap per direction (ENOSPC if the reserve would be
# crossed) and prints the FIFO map once per boot.  With the 0328
# cmdline nothing is rejected; the effective configuration equals
# 0329a6.
#
# A/B: x16-0330-config-badargs.img adds ruby_txgpd=9999 ruby_txslot=9
# ruby_rxbuf=777 to the cmdline; the reject lines and normal boot are
# recorded in docs/152.
#
# local build: kernel full 033dbfc9..., exec 5aa75fa0...
# image: x16-0330-config.img 1a044340... (128 MiB, cmdline 558 B)
KERNEL_EXPECT_EXEC_DATA=5aa75fa016f3cceaff739402e9f906e6807c7f90d877d4be3f6264354ca59d5b