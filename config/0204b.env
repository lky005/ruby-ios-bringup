# 0204b: dedicated-page uncached TX GPD ring.  The 0204 full-page BSS
# array broke the ring PA linear check (EP2 map bad i=63); 0204b keeps
# the verified 1 KB/4 KB ring layout and allocates a dedicated page via
# kmem_alloc + ml_io_map.  Same single variable: the CPU cache attribute
# of the TX descriptor ring; log payload buffers stay cached.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
BASELINE_MANIFEST_SHA256=829d759826607027bc4a1d9818b6dd4956a312a087217b6ce7e5ce31fa3ae910
BASELINE_FILES=82
BASELINE_UPSTREAM=ios-topaz@5095ac19dbdcf37b64b81fe443f4027ad51b84bf
APPLE_XNU_TAG=xnu-8796.141.3
PATCHSET_SHA256=d672ed26482c88d059ffc4b33d6d24b931f5f5ea34f6925e7e0f32408aa56e30
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

KERNEL_EXPECT_EXEC_DATA=
CI_RUN_ID=
CI_KERNEL_SHA256=
CI_KERNEL_EXEC_DATA_SHA256=
CI_IMAGE_SHA256=

# Booted reference: pending the first 0204b build.
CI_RUNNER=macos-15
CI_XCODE=16.0
CI_SDK=15.0
CI_CLANG=16.0.0

BOOT_CMDLINE=config/0204b-boot.cmdline
