# 0159 WIP: N2 EINT touch probe (GPIO14 / EINT14 only).
# Adds eint status and eint touch: read GICD ISENABLER[9] (GIC_SPI 256 ->
# INTID 288), save EINT0 MASK/SENS/POL, configure bit14 falling, unmask
# only bit14, sample STA and ACK, then restore.  GPIO4/GPIO5 are not
# touched; no PMIC/rail/clock/WDT writes.
#
# KERNEL_EXPECT_EXEC_DATA stays empty until the 0159 device gate.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

