# 0164 WIP: gate the EINT IRQ output and ack the armed fallback read.
# 0163 proved SMC sees INTID288 as Group1NS and the GIC enable sticks, but
# a touch left EINT14 STA set without the parent SPI ever going pending.
# mtk_eint_hw_init() writes DOM_EN(0x400) all ones; ruby_eint now reads it
# in eint status, sets the line bit during irq arm and clears it on disarm.
# The armed wait path also ACKs a frame it read on the 100 ms timeout,
# since the GIC ISR did not run to mask/ack the line.
#
# KERNEL_EXPECT_EXEC_DATA pins the booted kernel; the pin rerun is the
# gate for the same patchset.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
