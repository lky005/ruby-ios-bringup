# 0096 WIP: EP2 ring guard + static PA + 16B diagnostic header.
# On SET_CONFIGURATION cache the GPD ring, log buffer and per-slot PAs,
# build a 4-GPD ring, and push 64-byte frames (16B status header + 48B
# text) from the EP0 thread every ~100 ms.  A slot is rewritten
# only when HWO=0, so the enqueue cursor never overwrites hardware-
# owned descriptors; QISAR1 EMPTY is acked as status, not treated as
# an error.  MT6877 GPD checksum and Q_RESUME as in P9be.

MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
PATCHSET_SHA256=6b6ecef2332806ba2a797fe230a1afac045e5fcd1fc956d3336231ff742cc13e
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

KERNEL_EXPECT_EXEC_DATA=
CI_RUN_ID=
CI_KERNEL_SHA256=
CI_KERNEL_EXEC_DATA_SHA256=
CI_IMAGE_SHA256=

BOOT_CMDLINE=config/0095-boot.cmdline
