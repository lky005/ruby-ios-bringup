# 0095 WIP: EP2 bulk IN QMU log pipe.
# On SET_CONFIGURATION configure EP2 IN (64B maxpkt, FIFO 512, bulk slot 2),
# build a 4-GPD ring in a page-aligned static area, translate VAs with
# pmap_find_phys + ptoa_64 (36-bit high nibble for XNU's 0x140000000 phys
# base), maintain the cache with dc civac (VA), and push 64-byte SWEETLOG
# increments from the EP0 thread every ~100 ms (drop if the previous GPD
# is still pending).  MT6877 GPD checksum and Q_RESUME as in P9be.

MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
PATCHSET_SHA256=38cfe2ef771cf7bb42bb4c11d65e7fbfb501c13abbb1dea71eb39e1fde35211e
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

KERNEL_EXPECT_EXEC_DATA=
CI_RUN_ID=
CI_KERNEL_SHA256=
CI_KERNEL_EXEC_DATA_SHA256=
CI_IMAGE_SHA256=

BOOT_CMDLINE=config/0095-boot.cmdline
