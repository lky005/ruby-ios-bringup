# 0156 WIP: P3 foundation R0 read-only snapshot + P2.4 battery UI.
# R0 adds an on-demand "snap found" section that reads clock gates, GPIO,
# EINT status, I2C/SPI controller control/timing registers, MT6877 scpsys
# status and the safe pwrap/MT6359 registers.  It performs no new hardware
# writes; EINT ACK, I2C DATA/FIFO, SPI TX/RX DATA and the WDT count/feed
# registers are deliberately untouched.
#
# 0156b folds in P2.4: read-only MT6360 polling moves from 30 s to 5 s
# (2 s after a charger/full state change) with a 4300 mV 100% latch.
# Touch, battery and the I2C5 arbiter keep their 0155 behavior.
#
# CI and image hashes are recorded below; KERNEL_EXPECT_EXEC_DATA stays empty
# until the device gate (R0 snapshot + battery UI) passes.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
BASELINE_MANIFEST_SHA256=829d759826607027bc4a1d9818b6dd4956a312a087217b6ce7e5ce31fa3ae910
BASELINE_FILES=82
BASELINE_UPSTREAM=ios-topaz@5095ac19dbdcf37b64b81fe443f4027ad51b84bf
APPLE_XNU_TAG=xnu-8796.141.3
PATCHSET_SHA256=5dcb2e42bdc880fc99eb3c984e6b2f2a420078451600606ccc1d493b5461711c
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
