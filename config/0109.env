# 0109 WIP: restore the verified P9 TX slot for the EP2 bulk endpoint.
#
# 0108 sent 63-byte short frames instead of 64-byte exact-multiple frames.
# The failure did not change: the host still received the same packet four
# times, the QMU TX FIFO stayed full, and no TX done advanced the ring.  The
# frame length is therefore not the root cause.
#
# The remaining endpoint-configuration difference from the verified P9 probe
# is TX_SLOT.  P9 (and the vendor U3 default) uses slot 2; the vendor U2
# default is 1; 0102 changed our value to 0.  This version sets slot 2 and
# leaves the 63-byte frame, the QMU ring, EP0 and the recovery path untouched.
#
# The vendor status request is unchanged, so the existing host tools keep
# working; QISAR0, the busy flag and the recovery counters are enough to tell
# a missing TX done apart from a wedged endpoint.

MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
PATCHSET_SHA256=d3072f6f10d457b37b475c4cb1aa5d3a1f54779fb8d2ea5e3c999b3ef73e3b2c
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

KERNEL_EXPECT_EXEC_DATA=
CI_RUN_ID=
CI_KERNEL_SHA256=
CI_KERNEL_EXEC_DATA_SHA256=
CI_IMAGE_SHA256=

BOOT_CMDLINE=config/0109-boot.cmdline
