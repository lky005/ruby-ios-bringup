# 0152 WIP: USB-triggered fastboot reboot.
# Builds on 0150.  Adds "reboot bootloader" to bsd/dev/ruby_probe.c behind
# rubyreboot=1:
#   1. TOPRGU NONRST2 (0x10007000 + 0x24) low four bits = 3
#      (BOOT_BOOTLOADER; the bootloader reads this after reset);
#   2. WDT RESTART 0x08 = 0x1971, WDT MODE 0x00 = 0x22000014
#      (KEY|EXTEN|AUTO_RESTART), WDT SWRST 0x14 = 0x1209.
# This is the LK reset sequence; without the MODE write SWRST only raises an
# interrupt and the CPU hangs.  The command writes only TOPRGU registers; no
# UFS/misc/PMIC/rail/KPD writes.  The host must not wait for the command done
# marker: the SoC resets and the host polls fastboot devices.
#
# The test cmdline is 0150 plus rubyreboot=1 (sweethw=0, sweetgt=0,
# rubyprobe=1, rubypwrap=1, rubkeys=1, no rubypmic).  CI and image hashes are
# recorded after the run; KERNEL_EXPECT_EXEC_DATA stays empty until the
# device run.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
BASELINE_MANIFEST_SHA256=829d759826607027bc4a1d9818b6dd4956a312a087217b6ce7e5ce31fa3ae910
BASELINE_FILES=82
BASELINE_UPSTREAM=ios-topaz@5095ac19dbdcf37b64b81fe443f4027ad51b84bf
APPLE_XNU_TAG=xnu-8796.141.3
PATCHSET_SHA256=3059747879ac17bacc987ea178c94f2f262cca71f08c11bd3ab10013f087d2b8
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

KERNEL_EXPECT_EXEC_DATA=
CI_RUN_ID=
CI_KERNEL_SHA256=
CI_KERNEL_EXEC_DATA_SHA256=
CI_IMAGE_SHA256=
CI_RUNNER=macos-15
CI_XCODE=16.0
CI_SDK=15.0
CI_CLANG=16.0.0

BOOT_CMDLINE=config/0152-boot.cmdline
