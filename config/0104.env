# 0104 WIP: EP0 P9 parity + a shared timeline.
#
# The hub/FS path died with "Device Descriptor Request Failed".  The device
# trace showed the cause: our own EP0 code stalled the request whenever the
# TX FIFO was still full after the drain wait.  The bare-metal P9 probe,
# which enumerates through the same hub, never stalls there: it waits for
# the FIFO as a courtesy and writes DATAEND either way.  0104 follows P9.
#
# Three changes:
#  1. EP0 no longer stalls on a stuck FIFOFULL; DATAEND is written anyway.
#     If the endpoint wedges, the host resets the port and the 0103 bus-reset
#     recovery re-arms EP0.
#  2. The bus-reset recovery also drains the EP0 FIFO, so a reset cannot
#     leave stale bytes for the next SETUP.
#  3. A millisecond counter (shared by the window and the resident thread) is
#     stamped on every trace entry and log line, so the device timeline can
#     be anchored on the host's connect event.
#
# EP2 QMU behaviour (0095-0102) is unchanged.

MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
PATCHSET_SHA256=d8f5fde59bfff7f7cd0da9cf68873a73f7d544526563d55a24979af37689d6c2
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

KERNEL_EXPECT_EXEC_DATA=
CI_RUN_ID=
CI_KERNEL_SHA256=
CI_KERNEL_EXEC_DATA_SHA256=
CI_IMAGE_SHA256=

BOOT_CMDLINE=config/0104-boot.cmdline
