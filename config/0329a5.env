# 0329a5 = 0329a4b + L0 platform relocation (IPPC wait, U3/U2 PHY
# power sequences) into ruby_usb_plat.c/h.  The platform register map
# (IPPC/clock/PHY + MAC offsets) moved to ruby_usb_plat.h; MAC offsets
# stay shared with attach/EP0.
#
# NOTE: on first flash, host PnP re-enumeration can race early probes
# and leave the RX queue stopped (rq=0) until the host settles; the
# same image passes after a quiet >=30-60 s wait.  Treat that as a host
# race, not a kernel regression.
#
# local build: kernel full cf5a493b..., exec 969e4bff...
# image: x16-0329a5-plat.img 5738f816... (128 MiB, cmdline 558 B)
KERNEL_EXPECT_EXEC_DATA=969e4bff1c6545b2669680a598e467cf6ab512e7b7fb547e2ab19cd24c89846e