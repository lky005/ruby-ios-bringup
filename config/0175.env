# 0175 P1: board GIC interrupt controller + KPD provider (docs/62).
# INTID138 is registered through RubyGIC and serviced by a level
# IOInterruptEventSource; the release is sampled by a 10 ms timer while the
# line is masked.  EINT/touch and USB stay on their existing polling paths.
# P1 test images set rubykpdirq=1; the code default is off.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
BASELINE_MANIFEST_SHA256=829d759826607027bc4a1d9818b6dd4956a312a087217b6ce7e5ce31fa3ae910
BASELINE_FILES=82
BASELINE_UPSTREAM=ios-topaz@5095ac19dbdcf37b64b81fe443f4027ad51b84bf
APPLE_XNU_TAG=xnu-8796.141.3
PATCHSET_SHA256=4b2f1008e40f37277813a727c79b55b12d0882d0d82a2b2cef7a34a74e1b8855
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

# No booted reference yet for this line; CI records the first hashes.
CI_RUNNER=macos-15
CI_XCODE=16.0
CI_SDK=15.0
CI_CLANG=16.0.0

BOOT_CMDLINE=config/0175-boot.cmdline
