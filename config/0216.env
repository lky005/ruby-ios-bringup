# 0216 = 0215 (plan stage 2, EP1 OUT RX1 light-up): reuse the EP2 OUT
#   QMU data path moved to EP1 (RX1CSR 0x0210/14/18, RQCSR1/SAR1/CPR1
#   0x0610/14/18, HIAR1 0x04c4), RX1 FIFO base 0x40 after TX1 0x20,
#   bcd still 0x0211 so Windows rebuilds pipe cache from the new
#   0x01 OUT 0x0040 descriptor. QMU_RX_DONE for EP1 is
#   (1u<<17) (vendor BIT(16)<<1). Single variable.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
BASELINE_MANIFEST_SHA256=829d759826607027bc4a1d9818b6dd4956a312a087217b6ce7e5ce31fa3ae910
BASELINE_FILES=82
BASELINE_UPSTREAM=ios-topaz@5095ac19dbdcf37b64b81fe443f4027ad51b84bf
APPLE_XNU_TAG=xnu-8796.141.3
PATCHSET_SHA256=9eff03dda037428327df64706a797246568a38594700276a3826dd7c38ec09ee
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

CI_RUNNER=macos-15
CI_XCODE=16.0
CI_SDK=15.0
CI_CLANG=16.0.0

BOOT_CMDLINE=config/0216-boot.cmdline
