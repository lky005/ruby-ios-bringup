# 0105 WIP: drain the TX FIFO before the EP0 status stage.
#
# The host issues SET_ADDRESS as soon as it has the device descriptor, so
# the ACK of that setup can land while the previous descriptor is still in
# the TX FIFO.  The 0104 device trace showed the ACK CSR with FIFOFULL set
# (0x00aa0440), and the host trace showed the matching failure: the xHCI
# Address Device command completing with CompletionCode 4 (USB Transaction
# Error).  The host then reset the port and enumerated again, forever.
#
# 0105 waits for the FIFO to drain before writing the status stage, the same
# courtesy wait the data stage already does.  EP0, EP2 and the bus-reset
# recovery are otherwise unchanged from 0104.

MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
PATCHSET_SHA256=0eb6ac807e51e6862c1a6dfa5f0d6fdc8fb613e5af2943c25ba32578989a2cb5
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

KERNEL_EXPECT_EXEC_DATA=
CI_RUN_ID=
CI_KERNEL_SHA256=
CI_KERNEL_EXEC_DATA_SHA256=
CI_IMAGE_SHA256=

BOOT_CMDLINE=config/0105-boot.cmdline
