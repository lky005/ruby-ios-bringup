# 0107 WIP: EP0 response latency back to the bare-metal P9 semantics.
#
# 0105 made the hub path enumerate, 0106 (a shorter ACK wait) did not help
# the direct path: both still failed at the address stage with the xHCI
# Address Device command completing with CompletionCode 4.
#
# Comparing against the vendor driver and the bare-metal P9 probe, which
# both enumerate through the same hub, showed two of our own delays:
#
#  - the data stage waited up to 300 ms for the TX FIFO to drain before it
#    wrote DATAEND, while P9 spins about a millisecond and writes DATAEND
#    anyway; 300 ms eats most of the host's control-transfer budget;
#  - the status stage (the SET_ADDRESS ACK) waited for the FIFO as well,
#    while both the vendor and P9 write it straight away.
#
# 0107 shortens the data-stage wait to 2 ms and removes the ACK wait.  The
# trace reports the CSR and the time spent, so the next run measures the
# timing instead of guessing at it.
#
# EP2 and the bus-reset recovery are unchanged from 0106.

MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
PATCHSET_SHA256=18edbc479b84ce7ec181c72ec9385eebeaf244fae0adee2cf517248b31e7a7ca
BASELINE_CHANGES_SHA256=1edb66332bb4daa8b1abcd6c4de77a0e88ed9c7e9bb4a2a7045a2696e53ab338

DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549

KERNEL_EXPECT_EXEC_DATA=
CI_RUN_ID=
CI_KERNEL_SHA256=
CI_KERNEL_EXEC_DATA_SHA256=
CI_IMAGE_SHA256=

BOOT_CMDLINE=config/0107-boot.cmdline
