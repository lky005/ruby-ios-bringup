# 0179 P2b retry: never gate the touch line on a frame read failure.
# service_done(false) always re-arms (MASK_CLR + ACTIVE); the dirty frame
# is dropped, fail_streak accumulates, and after 8 consecutive failures
# the WorkLoop action does one SPI FIFO reset + chip soft handshake.  No
# DOM-off/STUCK, no polling thread, no timer.  Parent fuse stays.
MACOS_VERSION=13.5
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET

